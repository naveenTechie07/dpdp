<%- include('partials/header') %>

<div class="dashboard-header mb-4" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h1 class="page-title"><%= title.split(' - ')[0] %></h1>
        <p class="page-description"><%= description %></p>
    </div>
    <button class="btn-primary" style="padding: 10px 24px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Banner
    </button>
</div>

<div class="card p-0" style="overflow: hidden; display: flex; flex-direction: column;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 350px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search banners..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span>2 rows</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                <th style="padding: 16px 24px;">Name &uarr;</th>
                <th style="padding: 16px 16px;">Position &uarr;</th>
                <th style="padding: 16px 16px;">Language &uarr;</th>
                <th style="padding: 16px 16px;">CATEGORIES</th>
                <th style="padding: 16px 16px;">Status &uarr;</th>
                <th style="padding: 16px 16px;">BRANDING</th>
                <th style="padding: 16px 24px;">Updated &uarr;</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <!-- Row 1 -->
            <tr style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="#3b82f6" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle></svg>
                        <div>
                            <div style="font-weight: 600; color: var(--text-main); margin-bottom: 4px; font-size: 14px;">DPDP_Secure Marketing Site Banner</div>
                            <div style="color: var(--text-muted); font-size: 12px;">We value your privacy</div>
                        </div>
                    </div>
                </td>
                <td style="padding: 16px 16px; color: var(--text-muted);">
                    <div style="margin-bottom: 4px;">BOTTOM</div>
                    <div>BANNER</div>
                </td>
                <td style="padding: 16px 16px; color: var(--text-muted);"></td>
                <td style="padding: 16px 16px;">
                    <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                        <span style="background: rgba(255,255,255,1); color: #3b82f6; border: 1px solid #3b82f6; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">NECESSARY</span>
                        <span style="background: rgba(255,255,255,1); color: #8b5cf6; border: 1px solid #8b5cf6; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">ANALYTICS</span>
                        <span style="background: rgba(255,255,255,1); color: #f97316; border: 1px solid #f97316; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">MARKETING</span>
                        <span style="background: rgba(255,255,255,1); color: #10b981; border: 1px solid #10b981; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">FUNCTIONAL</span>
                    </div>
                </td>
                <td style="padding: 16px 16px;">
                    <span style="background: transparent; color: var(--text-main); border: 1px solid var(--border-color); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;">Draft</span>
                </td>
                <td style="padding: 16px 16px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="display: flex; gap: 4px;">
                            <div style="width: 14px; height: 14px; border-radius: 50%; background: #3b82f6;"></div>
                            <div style="width: 14px; height: 14px; border-radius: 50%; background: #2563eb;"></div>
                            <div style="width: 14px; height: 14px; border-radius: 50%; background: #ffffff; border: 1px solid var(--border-color);"></div>
                        </div>
                        <span style="color: var(--text-muted); font-size: 12px;">Inter</span>
                    </div>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; gap: 16px;">
                        9/9/2026
                        <div style="display: flex; gap: 12px; color: var(--text-muted);">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </div>
                    </div>
                </td>
            </tr>

            <!-- Row 2 -->
            <tr style="border-bottom: 1px solid transparent; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="#3b82f6" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle></svg>
                        <div>
                            <div style="font-weight: 600; color: var(--text-main); margin-bottom: 4px; font-size: 14px;">My Cookie Banner</div>
                            <div style="color: var(--text-muted); font-size: 12px;">DPDP_Secure Cookie Consent</div>
                        </div>
                    </div>
                </td>
                <td style="padding: 16px 16px; color: var(--text-muted);">
                    <div style="margin-bottom: 4px;">BOTTOM</div>
                    <div>BANNER</div>
                </td>
                <td style="padding: 16px 16px; color: var(--text-muted);">--</td>
                <td style="padding: 16px 16px;">
                </td>
                <td style="padding: 16px 16px;">
                    <span style="background: transparent; color: var(--text-main); border: 1px solid var(--border-color); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;">Draft</span>
                </td>
                <td style="padding: 16px 16px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="display: flex; gap: 4px;">
                            <div style="width: 14px; height: 14px; border-radius: 50%; background: #3b82f6;"></div>
                            <div style="width: 14px; height: 14px; border-radius: 50%; background: #2563eb;"></div>
                            <div style="width: 14px; height: 14px; border-radius: 50%; background: #ffffff; border: 1px solid var(--border-color);"></div>
                        </div>
                        <span style="color: var(--text-muted); font-size: 12px;">Inter</span>
                    </div>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; gap: 16px;">
                        8/29/2026
                        <div style="display: flex; gap: 12px; color: var(--text-muted);">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </div>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
    
</div>

<%- include('partials/footer') %>
