<%- include('partials/header') %>
<%
  const safeBanners = (typeof banners !== 'undefined' && Array.isArray(banners)) ? banners : [];
  const pageTitle = (typeof title !== 'undefined' && title) ? title.split(' - ')[0] : 'Cookie Banners';
  const pageDesc = (typeof description !== 'undefined' && description) ? description : 'Design, brand, and publish cookie consent banners for Aarogya patient portal endpoints.';
%>

<div class="dashboard-header mb-4" style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 16px;">
    <div>
        <h1 class="page-title"><%= pageTitle %></h1>
        <p class="page-description"><%= pageDesc %></p>
    </div>
    <button onclick="openNewBannerModal()" class="btn-primary" style="padding: 10px 24px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Banner
    </button>
</div>

<div class="card p-0" style="overflow: hidden; display: flex; flex-direction: column;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div class="search-bar" style="width: 320px; background: transparent; padding: 0; border: none;">
            <input type="text" id="bannerSearch" onkeyup="filterBanners()" placeholder="Search banners..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%; font-size: 13px;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span id="bannerCountLabel"><%= safeBanners.length %> <%= safeBanners.length === 1 ? 'banner' : 'banners' %></span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <div style="overflow-x: auto;">
        <table class="data-table" id="bannersTable" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                    <th style="padding: 16px 24px;">Banner Name</th>
                    <th style="padding: 16px 16px;">Notice Text</th>
                    <th style="padding: 16px 16px;">CTA Button</th>
                    <th style="padding: 16px 16px;">Categories</th>
                    <th style="padding: 16px 16px;">Status</th>
                    <th style="padding: 16px 16px;">Created</th>
                    <th style="padding: 16px 24px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody style="font-size: 13px;">
                <% if (safeBanners.length === 0) { %>
                    <tr id="emptyBannersRow">
                        <td colspan="7" style="text-align: center; padding: 48px; color: var(--text-muted);">
                            <div style="margin-bottom: 8px;">No cookie banners configured yet.</div>
                            <div style="font-size: 12px;">Click "New Banner" to create and publish your first patient portal consent banner.</div>
                        </td>
                    </tr>
                <% } else { %>
                    <% safeBanners.forEach(function(b) { 
                        const name = b.bannerName || b.name || 'Consent Banner';
                        const text = b.bannerText || b.messageText || 'We use essential cookies under DPDP Act 2023.';
                        const btnText = b.buttonText || 'Accept Essential';
                        const isActive = b.isActive === 1 || b.isActive === true;
                        const dateStr = b.createdAt || new Date().toISOString();
                        const formattedDate = new Date(dateStr).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric' });
                    %>
                    <tr class="banner-row" style="border-bottom: 1px solid var(--border-color); transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                        <td style="padding: 16px 24px;">
                            <div style="display: flex; align-items: center; gap: 12px;">
                                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(59,130,246,0.15); border: 1px solid rgba(59,130,246,0.3); display: flex; align-items: center; justify-content: center; color: #3b82f6;">
                                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                                </div>
                                <div>
                                    <div style="font-weight: 600; color: var(--text-main); font-size: 14px;"><%= name %></div>
                                    <div style="color: var(--text-muted); font-size: 11px; font-family: monospace;">ID: <%= b.id %></div>
                                </div>
                            </div>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted); max-width: 280px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                            <%= text %>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-main); font-weight: 500;">
                            <span style="background: rgba(255,255,255,0.05); padding: 3px 8px; border-radius: 4px; border: 1px solid var(--border-color); font-size: 12px;"><%= btnText %></span>
                        </td>
                        <td style="padding: 16px 16px;">
                            <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                                <span style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700;">NECESSARY</span>
                                <span style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; border: 1px solid rgba(139, 92, 246, 0.3); padding: 2px 8px; border-radius: 10px; font-size: 10px; font-weight: 700;">ANALYTICS</span>
                            </div>
                        </td>
                        <td style="padding: 16px 16px;">
                            <% if (isActive) { %>
                                <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                            <% } else { %>
                                <span style="background: rgba(255, 255, 255, 0.05); color: var(--text-muted); border: 1px solid var(--border-color); padding: 3px 10px; border-radius: 12px; font-size: 11px; font-weight: 600;">Draft</span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;"><%= formattedDate %></td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteBanner('<%= b.id %>')" title="Delete Banner" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;" onmouseover="this.style.background='rgba(239,68,68,0.1)'" onmouseout="this.style.background='none'">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<!-- New Banner Modal -->
<div id="newBannerModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.7); backdrop-filter: blur(4px); z-index: 9999; justify-content: center; align-items: center; padding: 20px;">
    <div style="background: #111827; border: 1px solid var(--border-color); border-radius: 12px; width: 100%; max-width: 520px; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.5); overflow: hidden;">
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin: 0;">Create Cookie Consent Banner</h3>
            <button onclick="closeNewBannerModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; font-size: 20px;">&times;</button>
        </div>
        <form id="createBannerForm" onsubmit="handleCreateBanner(event)" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label for="newBannerName" style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 6px;">Banner Name</label>
                <input type="text" id="newBannerName" required value="Patient Portal Cookie Banner" style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;" placeholder="e.g. Diagnostic Portal Notice">
            </div>
            <div style="margin-bottom: 16px;">
                <label for="newBannerText" style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 6px;">Notice Message Text</label>
                <textarea id="newBannerText" rows="3" required style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px; resize: vertical;">Aarogya Diagnostic Center uses essential cookies to safeguard authentication and display lab test reports per DPDP Act 2023.</textarea>
            </div>
            <div style="margin-bottom: 16px;">
                <label for="newButtonText" style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 6px;">Button CTA Text</label>
                <input type="text" id="newButtonText" required value="Accept Essential Cookies" style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>
            <div style="margin-bottom: 24px; display: flex; align-items: center; gap: 10px;">
                <input type="checkbox" id="newBannerActive" checked style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;">
                <label for="newBannerActive" style="font-size: 13px; color: var(--text-main); cursor: pointer; margin: 0;">Publish banner immediately (Active)</label>
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 12px;">
                <button type="button" onclick="closeNewBannerModal()" class="btn-secondary" style="padding: 8px 16px; font-size: 13px;">Cancel</button>
                <button type="submit" id="saveBannerBtn" class="btn-primary" style="padding: 8px 20px; font-size: 13px;">Create Banner</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterBanners() {
    const q = document.getElementById('bannerSearch').value.toLowerCase();
    const rows = document.querySelectorAll('.banner-row');
    let visible = 0;
    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(q)) {
            r.style.display = '';
            visible++;
        } else {
            r.style.display = 'none';
        }
    });
    document.getElementById('bannerCountLabel').innerText = visible + ' banners';
}

function openNewBannerModal() {
    const modal = document.getElementById('newBannerModal');
    modal.style.display = 'flex';
}

function closeNewBannerModal() {
    const modal = document.getElementById('newBannerModal');
    modal.style.display = 'none';
}

async function handleCreateBanner(e) {
    if (e && e.preventDefault) e.preventDefault();
    const btn = document.getElementById('saveBannerBtn');
    const bannerName = document.getElementById('newBannerName').value.trim();
    const bannerText = document.getElementById('newBannerText').value.trim();
    const buttonText = document.getElementById('newButtonText').value.trim();
    const isActive = document.getElementById('newBannerActive').checked ? 1 : 0;

    btn.disabled = true;
    btn.innerHTML = 'Creating...';

    try {
        const res = await fetch('/api/cookies/banners', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                bannerName: bannerName,
                name: bannerName,
                bannerText: bannerText,
                messageText: bannerText,
                buttonText: buttonText,
                isActive: isActive
            })
        });

        const data = await res.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert('Error: ' + (data.error || 'Failed to create banner'));
            btn.disabled = false;
            btn.innerHTML = 'Create Banner';
        }
    } catch (err) {
        alert('Request failed: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = 'Create Banner';
    }
}

async function deleteBanner(id) {
    if (!confirm('Are you sure you want to delete this cookie banner?')) return;

    try {
        const res = await fetch('/api/cookies/banners/' + id, {
            method: 'DELETE'
        });
        const data = await res.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert('Delete failed: ' + (data.error || 'Server error'));
        }
    } catch (err) {
        alert('Delete failed: ' + err.message);
    }
}
</script>

<%- include('partials/footer') %>
