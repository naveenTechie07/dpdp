<%- include('partials/header') %>

<style>
    .donut-chart-consent {
        width: 140px;
        height: 140px;
        border-radius: 50%;
        background: conic-gradient(
            #10b981 0% 71.4%,
            #f59e0b 71.4% 100%
        );
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto;
    }
    .donut-inner-consent {
        width: 100px;
        height: 100px;
        background: var(--bg-card);
        border-radius: 50%;
    }
    .bar-chart-module {
        display: flex;
        align-items: flex-end;
        justify-content: space-around;
        height: 180px;
        position: relative;
        padding-bottom: 30px;
    }
    .bar-chart-module::before {
        content: '';
        position: absolute;
        top: 25%;
        left: 0;
        right: 0;
        border-top: 1px dashed rgba(255,255,255,0.2);
    }
    .bar-chart-module::after {
        content: '';
        position: absolute;
        top: 50%;
        left: 0;
        right: 0;
        border-top: 1px dashed rgba(255,255,255,0.2);
    }
    .bar-chart-module::before {
        /* additional grid lines can be styled here if needed */
    }
    .grid-line-75 {
        position: absolute;
        top: 75%;
        left: 0;
        right: 0;
        border-top: 1px dashed rgba(255,255,255,0.2);
    }
    .grid-line-0 {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        border-top: 1px solid rgba(255,255,255,0.2);
    }
    .y-labels {
        position: absolute;
        left: -20px;
        top: -8px;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        font-size: 10px;
        color: var(--text-muted);
    }
    .bar-module-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        z-index: 1;
        width: 40px;
        height: 100%;
        justify-content: flex-end;
        position: relative;
    }
    .bar-module-fill {
        width: 24px;
        border-radius: 4px 4px 0 0;
    }
    .bar-module-label {
        position: absolute;
        bottom: -24px;
        font-size: 10px;
        color: var(--text-muted);
        white-space: nowrap;
    }
</style>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Consent & preferences</h1>
        <p>Summary for this module only. Each linked screen shows one object type in a single table with its fields and actions.</p>
    </div>
    <button class="btn-secondary" style="background-color: transparent; color: var(--text-main); border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
        Dashboard
        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" style="margin-left: 4px;"><polyline points="6 9 12 15 18 9"></polyline></svg>
    </button>
</div>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card" style="padding: 24px;">
        <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Total Purposes</span>
        <h2 class="metric-value" style="margin-top: 12px; color: #3b82f6; font-size: 24px;">7</h2>
    </div>
    <div class="card metric-card" style="padding: 24px;">
        <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Ledger Records</span>
        <h2 class="metric-value" style="margin-top: 12px; color: #a855f7; font-size: 24px;">20</h2>
    </div>
    <div class="card metric-card" style="padding: 24px;">
        <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Transactions</span>
        <h2 class="metric-value" style="margin-top: 12px; color: #10b981; font-size: 24px;">40</h2>
    </div>
    <div class="card metric-card" style="padding: 24px;">
        <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Active Purposes</span>
        <h2 class="metric-value" style="margin-top: 12px; color: #10b981; font-size: 24px;">5</h2>
    </div>
</div>

<div class="metrics-grid" style="grid-template-columns: 1fr 1.5fr;">
    <!-- Purpose Status -->
    <div class="card p-4">
        <h3 style="font-size: 14px; margin: 0 0 4px 0;">Purpose Status</h3>
        <p style="font-size: 11px; color: var(--text-muted); margin: 0 0 32px 0;">Active vs draft breakdown</p>
        
        <div class="donut-chart-consent mb-4">
            <div class="donut-inner-consent"></div>
        </div>
        
        <div style="display: flex; flex-direction: column; gap: 8px; margin-top: 32px;">
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
                    <span style="color: var(--text-muted);">Active</span>
                </div>
                <span style="font-weight: 700;">5</span>
            </div>
            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 12px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #f59e0b;"></span>
                    <span style="color: var(--text-muted);">Draft</span>
                </div>
                <span style="font-weight: 700;">2</span>
            </div>
        </div>
    </div>
    
    <!-- Module Volumes -->
    <div class="card p-4">
        <h3 style="font-size: 14px; margin: 0 0 4px 0;">Module Volumes</h3>
        <p style="font-size: 11px; color: var(--text-muted); margin: 0 0 48px 0;">Record counts across consent areas</p>
        
        <div style="padding-left: 24px; padding-right: 24px; position: relative; margin-bottom: 24px;">
            <div class="bar-chart-module">
                <div class="y-labels">
                    <span>40</span>
                    <span>30</span>
                    <span>20</span>
                    <span>10</span>
                    <span>0</span>
                </div>
                <div class="grid-line-75"></div>
                <div class="grid-line-0"></div>
                
                <div class="bar-module-col">
                    <div class="bar-module-fill" style="height: 17.5%; background: #3b82f6;"></div>
                    <span class="bar-module-label">Purposes</span>
                </div>
                <div class="bar-module-col">
                    <div class="bar-module-fill" style="height: 10%; background: #10b981;"></div>
                    <span class="bar-module-label">Collection</span>
                </div>
                <div class="bar-module-col">
                    <div class="bar-module-fill" style="height: 50%; background: #a855f7;"></div>
                    <span class="bar-module-label">Ledger</span>
                </div>
                <div class="bar-module-col">
                    <div class="bar-module-fill" style="height: 100%; background: #f59e0b;"></div>
                    <span class="bar-module-label">Transactions</span>
                </div>
                <div class="bar-module-col">
                    <div class="bar-module-fill" style="height: 7.5%; background: #14b8a6;"></div>
                    <span class="bar-module-label">Policies</span>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
