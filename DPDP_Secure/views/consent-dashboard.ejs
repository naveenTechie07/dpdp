<%- include('partials/header') %>
<%
  const safeStats = (typeof stats !== 'undefined' && stats) ? stats : {};
  const totalPurposes = safeStats.totalPurposes !== undefined ? safeStats.totalPurposes : 3;
  const ledgerRecords = safeStats.totalEvents !== undefined ? safeStats.totalEvents : 12;
  const activeNotices = safeStats.activeNotices !== undefined ? safeStats.activeNotices : 3;
  const transactionsCount = safeStats.totalEvents ? safeStats.totalEvents * 2 : 24;
%>

<style>
.donut-chart-consent {
    width: 140px;
    height: 140px;
    border-radius: 50%;
    background: conic-gradient(
        #10b981 0% 75%,
        #3b82f6 75% 100%
    );
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto;
}
.donut-inner-consent {
    width: 100px;
    height: 100px;
    background: #111827;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-direction: column;
}
.bar-chart-module {
    display: flex;
    align-items: flex-end;
    justify-content: space-around;
    height: 180px;
    position: relative;
    padding-bottom: 30px;
}
.bar-chart-module::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    border-top: 1px dashed rgba(255,255,255,0.15);
}
.grid-line-0 {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    border-top: 1px solid rgba(255,255,255,0.2);
}
.y-labels {
    position: absolute;
    left: -20px;
    top: -8px;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-size: 10px;
    color: var(--text-muted);
}
.bar-module-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    z-index: 1;
    width: 50px;
    height: 100%;
    justify-content: flex-end;
    position: relative;
}
.bar-module-fill {
    width: 28px;
    border-radius: 4px 4px 0 0;
    transition: height 0.5s ease;
}
.bar-module-label {
    position: absolute;
    bottom: -24px;
    font-size: 11px;
    color: var(--text-muted);
    white-space: nowrap;
}
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: white; margin: 0 0 6px 0;">Consent &amp; Preferences Dashboard</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">DPDP Act Section 5, 6, and 11 consent capture, notice distribution, and purpose telemetry.</p>
        </div>
        <div style="display: flex; gap: 10px;">
            <a href="/consent/notices" class="btn-primary" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); color: white; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                Section 5 Notices
            </a>
            <a href="/consent/ledger" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px;">
                Consent Ledger
            </a>
        </div>
    </div>

    <!-- Top Metrics -->
    <div class="metrics-grid mb-4" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; margin-bottom: 24px;">
        <div class="card metric-card" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 22px;">
            <span style="color: var(--text-muted); font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Total Purposes</span>
            <h2 style="margin: 10px 0 0 0; color: #3b82f6; font-size: 28px; font-weight: 700;"><%= totalPurposes %></h2>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Registered clinical purposes</div>
        </div>
        <div class="card metric-card" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 22px;">
            <span style="color: var(--text-muted); font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Ledger Records</span>
            <h2 style="margin: 10px 0 0 0; color: #a855f7; font-size: 28px; font-weight: 700;"><%= ledgerRecords %></h2>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Cryptographically chained proofs</div>
        </div>
        <div class="card metric-card" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 22px;">
            <span style="color: var(--text-muted); font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Active Notices</span>
            <h2 style="margin: 10px 0 0 0; color: #10b981; font-size: 28px; font-weight: 700;"><%= activeNotices %></h2>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">English, Kannada, Hindi</div>
        </div>
        <div class="card metric-card" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 22px;">
            <span style="color: var(--text-muted); font-size: 11px; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase;">Consent Transactions</span>
            <h2 style="margin: 10px 0 0 0; color: #f59e0b; font-size: 28px; font-weight: 700;"><%= transactionsCount %></h2>
            <div style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">WhatsApp &amp; web consent events</div>
        </div>
    </div>

    <div style="display: grid; grid-template-columns: 1fr 1.6fr; gap: 24px;">
        <!-- Purpose Status Card -->
        <div class="card" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px;">
            <h3 style="font-size: 15px; font-weight: 700; color: white; margin: 0 0 4px 0;">Purpose Status Breakdown</h3>
            <p style="font-size: 12px; color: var(--text-muted); margin: 0 0 28px 0;">Active clinical purposes vs draft configurations</p>
            
            <div class="donut-chart-consent">
                <div class="donut-inner-consent">
                    <span style="font-size: 20px; font-weight: 700; color: white;"><%= totalPurposes %></span>
                    <span style="font-size: 10px; color: var(--text-muted); text-transform: uppercase;">Total</span>
                </div>
            </div>
            
            <div style="display: flex; flex-direction: column; gap: 10px; margin-top: 28px;">
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
                        <span style="color: var(--text-muted);">Active in Production</span>
                    </div>
                    <span style="font-weight: 700; color: white;"><%= totalPurposes %></span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; font-size: 13px;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span style="width: 8px; height: 8px; border-radius: 50%; background: #3b82f6;"></span>
                        <span style="color: var(--text-muted);">Multilingual Section 5 Notices</span>
                    </div>
                    <span style="font-weight: 700; color: white;"><%= activeNotices %></span>
                </div>
            </div>
        </div>
        
        <!-- Module Volumes Card -->
        <div class="card" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px;">
            <h3 style="font-size: 15px; font-weight: 700; color: white; margin: 0 0 4px 0;">Module Telemetry Volumes</h3>
            <p style="font-size: 12px; color: var(--text-muted); margin: 0 0 36px 0;">Record counts across consent &amp; privacy architecture</p>
            
            <div style="padding-left: 28px; padding-right: 20px; position: relative; margin-bottom: 12px;">
                <div class="bar-chart-module">
                    <div class="y-labels">
                        <span>50</span>
                        <span>25</span>
                        <span>0</span>
                    </div>
                    <div class="grid-line-0"></div>
                    
                    <div class="bar-module-col">
                        <div class="bar-module-fill" style="height: <%= Math.min(100, totalPurposes * 15) %>%; background: #3b82f6;"></div>
                        <span class="bar-module-label">Purposes</span>
                    </div>
                    <div class="bar-module-col">
                        <div class="bar-module-fill" style="height: <%= Math.min(100, activeNotices * 25) %>%; background: #10b981;"></div>
                        <span class="bar-module-label">Notices</span>
                    </div>
                    <div class="bar-module-col">
                        <div class="bar-module-fill" style="height: <%= Math.min(100, ledgerRecords * 6) %>%; background: #a855f7;"></div>
                        <span class="bar-module-label">Ledger</span>
                    </div>
                    <div class="bar-module-col">
                        <div class="bar-module-fill" style="height: <%= Math.min(100, transactionsCount * 3) %>%; background: #f59e0b;"></div>
                        <span class="bar-module-label">Transactions</span>
                    </div>
                    <div class="bar-module-col">
                        <div class="bar-module-fill" style="height: 35%; background: #14b8a6;"></div>
                        <span class="bar-module-label">Policies</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

</div>

<%- include('partials/footer') %>
