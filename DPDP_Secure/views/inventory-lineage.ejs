<%- include('partials/header') %>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(3, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">TOTAL LINEAGE EDGES</span>
            <h2 class="metric-value" id="metricTotalEdges" style="margin-top: 8px;"><%= (typeof totalEdges !== 'undefined') ? totalEdges : ((typeof edges !== 'undefined') ? edges.length : 1) %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">STALE EDGES</span>
            <h2 class="metric-value" id="metricStaleEdges" style="margin-top: 8px;"><%= (typeof staleEdges !== 'undefined') ? staleEdges : 0 %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">CONNECTED ASSETS</span>
            <h2 class="metric-value" id="metricConnectedAssets" style="margin-top: 8px;"><%= (typeof connectedAssets !== 'undefined') ? connectedAssets : 5 %></h2>
        </div>
    </div>
</div>

<!-- Explorer Tool -->
<div class="card mb-4" style="background: var(--bg-card); display: flex; flex-direction: column; gap: 16px;">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <h3 style="font-size: 13px; font-weight: 600; margin: 0; color: var(--text-main);">Lineage Graph Explorer</h3>
        <span id="explorerStatusBadge" style="display: none; font-size: 11px; background: rgba(59, 130, 246, 0.2); color: #60a5fa; border: 1px solid rgba(59, 130, 246, 0.4); padding: 2px 10px; border-radius: 12px; font-weight: 600;">
            Filtering active
        </span>
    </div>
    
    <div style="display: flex; gap: 16px; align-items: flex-end; flex-wrap: wrap;">
        <div style="flex: 1; min-width: 200px;">
            <label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px;">Root Asset</label>
            <div style="position: relative;">
                <select id="explorerRootAsset" style="width: 100%; appearance: none; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; font-size: 13px;">
                    <option value="">Select an asset...</option>
                    <% if (typeof assets !== 'undefined' && assets.length > 0) { %>
                        <% assets.forEach(a => { %>
                            <option value="<%= a.assetName %>"><%= a.assetName %> (<%= a.assetType || 'asset' %>)</option>
                        <% }) %>
                    <% } else { %>
                        <option value="Core Banking Database">Core Banking Database</option>
                        <option value="Customer Feedback & Survey Store">Customer Feedback & Survey Store</option>
                        <option value="Loan Origination System">Loan Origination System</option>
                        <option value="customer_kyc">customer_kyc</option>
                        <option value="loan_applications">loan_applications</option>
                    <% } %>
                </select>
                <svg style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;" viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
        </div>
        
        <div style="width: 150px;">
            <label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 8px;">Direction</label>
            <div style="position: relative;">
                <select id="explorerDirection" style="width: 100%; appearance: none; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; font-size: 13px;">
                    <option value="Both">Both</option>
                    <option value="Upstream">Upstream</option>
                    <option value="Downstream">Downstream</option>
                </select>
                <svg style="position: absolute; right: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;" viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </div>
        </div>
        
        <div style="display: flex; gap: 8px;">
            <button type="button" id="btnExploreLineage" onclick="runLineageExplorer()" class="btn-secondary" style="background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; height: 36px;">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                Explore
            </button>
            <button type="button" id="btnClearExplorer" onclick="clearLineageExplorer()" class="btn-secondary" style="display: none; background: rgba(255,255,255,0.03); color: var(--text-muted); border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; font-size: 12px; cursor: pointer; height: 36px;">
                Reset
            </button>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between;">
    <div class="title-group">
        <h1>Data Lineage</h1>
        <p>Track how data flows between systems, containers, and external processors under Section 8 DPDP Act.</p>
    </div>
    <button type="button" class="btn-primary" id="btnOpenAddEdgeModal" onclick="openAddEdgeModal(event)" style="background-color: var(--primary); color: white; border: none; padding: 8px 18px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Edge
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div class="search-bar" style="width: 320px; background: transparent; padding: 0; border: none; position: relative;">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); pointer-events: none;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
            <input type="text" id="lineageSearchInput" oninput="filterLineageEdges()" placeholder="Search source, target, or notes..." style="border: 1px solid var(--border-color); padding: 8px 12px 8px 34px; border-radius: 6px; background: rgba(0,0,0,0.2); color: var(--text-main); width: 100%; font-size: 13px;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span id="lineagePageIndicator">Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 12px 24px; font-weight: 600;">Source &#9652;</th>
                <th style="padding: 12px 8px; font-weight: 600; width: 30px; text-align: center;"></th>
                <th style="padding: 12px 24px; font-weight: 600;">Target &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Flow Type &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Notes &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">STALE</th>
                <th style="padding: 12px 24px; font-weight: 600;">Last Confirmed &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody id="lineageTableBody" style="font-size: 13px;">
            <% if (typeof edges !== 'undefined' && edges.length > 0) { %>
                <% edges.forEach(edge => { %>
                    <%
                        let badgeBg = '#e9d5ff', badgeColor = '#6b21a8';
                        const ft = (edge.flowType || 'etl').toLowerCase();
                        if (ft === 'api') { badgeBg = 'rgba(59, 130, 246, 0.2)'; badgeColor = '#60a5fa'; }
                        else if (ft === 'sync') { badgeBg = 'rgba(16, 185, 129, 0.2)'; badgeColor = '#34d399'; }
                        else if (ft === 'stream') { badgeBg = 'rgba(245, 158, 11, 0.2)'; badgeColor = '#fbbf24'; }
                        else if (ft === 'batch') { badgeBg = 'rgba(168, 85, 247, 0.2)'; badgeColor = '#c084fc'; }
                        else if (ft === 'manual') { badgeBg = 'rgba(148, 163, 184, 0.2)'; badgeColor = '#94a3b8'; }
                        else if (ft === 'sftp') { badgeBg = 'rgba(236, 72, 153, 0.2)'; badgeColor = '#f472b6'; }
                    %>
                    <tr id="edge-row-<%= edge.id %>" data-edge-id="<%= edge.id %>" data-source="<%= edge.source %>" data-target="<%= edge.target %>" data-flow="<%= edge.flowType %>" style="border-bottom: 1px solid var(--border-color); transition: background 0.15s ease;">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); white-space: nowrap;"><%= edge.source %></td>
                        <td style="padding: 16px 8px; color: #60a5fa; text-align: center; font-weight: 700;">&rarr;</td>
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); white-space: nowrap;"><%= edge.target %></td>
                        <td style="padding: 16px 24px;">
                            <span class="badge" style="background: <%= badgeBg %>; color: <%= badgeColor %>; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; text-transform: uppercase;"><%= edge.flowType || 'etl' %></span>
                        </td>
                        <td style="padding: 16px 24px; color: var(--text-muted); max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="<%= edge.notes || '' %>"><%= edge.notes || '—' %></td>
                        <td style="padding: 16px 24px;">
                            <% if (edge.isStale === 1 || edge.isStale === true || edge.stale === 1) { %>
                                <span style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;">⚠️ Stale</span>
                            <% } else { %>
                                <span style="color: var(--text-muted);">&mdash;</span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 24px; color: var(--text-muted);"><%= edge.lastConfirmed || (edge.createdAt ? new Date(edge.createdAt).toLocaleDateString() : '8/29/2026') %></td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button type="button" class="btn-delete-edge" onclick="confirmDeleteEdge('<%= edge.id %>', '<%= (edge.source || '').replace(/'/g, '\\\'') %> &rarr; <%= (edge.target || '').replace(/'/g, '\\\'') %>')" title="Delete lineage edge" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px; padding: 6px 10px; cursor: pointer; color: #f87171; display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; transition: all 0.2s;">
                                <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2" fill="none"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                Delete
                            </button>
                        </td>
                    </tr>
                <% }) %>
            <% } else { %>
                <tr id="emptyLineageRow">
                    <td colspan="8" style="padding: 40px 24px; text-align: center; color: var(--text-muted);">
                        <div style="font-size: 24px; margin-bottom: 8px;">🔗</div>
                        <div style="font-size: 14px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">No Lineage Edges Defined</div>
                        <p style="font-size: 12px; margin: 0; color: var(--text-muted);">Click the "+ Add Edge" button above to record how data flows between systems.</p>
                    </td>
                </tr>
            <% } %>
        </tbody>
    </table>
    
    <!-- Table Footer -->
    <div class="table-toolbar" style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: ADD DATA LINEAGE EDGE                                              -->
<!-- ========================================================================= -->
<div id="addEdgeModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 20px;">
    <div class="modal-box" style="background: #111827; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; max-width: 580px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); overflow: hidden;">
        <!-- Modal Header -->
        <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: flex-start; background: rgba(255,255,255,0.02);">
            <div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <div style="width: 28px; height: 28px; border-radius: 6px; background: rgba(59, 130, 246, 0.2); display: flex; align-items: center; justify-content: center; color: #60a5fa;">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </div>
                    <h3 style="margin: 0; font-size: 16px; font-weight: 700; color: var(--text-main);">Add Data Lineage Edge</h3>
                </div>
                <p style="margin: 4px 0 0 36px; font-size: 12px; color: var(--text-muted);">
                    Map data flow relationships, sync protocols, and downstream dependencies under DPDP Section 8.
                </p>
            </div>
            <button type="button" onclick="closeAddEdgeModal()" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 4px; border-radius: 4px; font-size: 18px; line-height: 1;">&times;</button>
        </div>

        <!-- Modal Form -->
        <form id="addEdgeForm" action="/api/lineage/edges/create" method="POST" onsubmit="handleEdgeFormSubmit(event)" style="padding: 20px 24px;">
            <div style="display: flex; flex-direction: column; gap: 16px;">
                <!-- Source & Target Assets -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">
                            Source Asset (Upstream) <span style="color: #ef4444;">*</span>
                        </label>
                        <input type="text" id="modalEdgeSource" name="source" list="sourceAssetOptions" required placeholder="e.g. Loan Origination System" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-main); font-size: 13px;">
                        <datalist id="sourceAssetOptions">
                            <% if (typeof assets !== 'undefined') { %>
                                <% assets.forEach(a => { %>
                                    <option value="<%= a.assetName %>"><%= a.assetName %> (<%= a.assetType || 'asset' %>)</option>
                                <% }) %>
                            <% } %>
                            <option value="Loan Origination System">Loan Origination System</option>
                            <option value="Core Banking Database">Core Banking Database</option>
                            <option value="Customer Feedback & Survey Store">Customer Feedback & Survey Store</option>
                            <option value="Clinic Reception Frontdesk Smartphone">Clinic Reception Frontdesk Smartphone</option>
                            <option value="WhatsApp Business Chat Silo">WhatsApp Business Chat Silo</option>
                            <option value="PACS DICOM Imaging Vault">PACS DICOM Imaging Vault</option>
                        </datalist>
                    </div>

                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">
                            Target Asset (Downstream) <span style="color: #ef4444;">*</span>
                        </label>
                        <input type="text" id="modalEdgeTarget" name="target" list="targetAssetOptions" required placeholder="e.g. Core Banking Database" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-main); font-size: 13px;">
                        <datalist id="targetAssetOptions">
                            <% if (typeof assets !== 'undefined') { %>
                                <% assets.forEach(a => { %>
                                    <option value="<%= a.assetName %>"><%= a.assetName %> (<%= a.assetType || 'asset' %>)</option>
                                <% }) %>
                            <% } %>
                            <option value="Core Banking Database">Core Banking Database</option>
                            <option value="PACS DICOM Imaging Vault">PACS DICOM Imaging Vault</option>
                            <option value="Loan Origination System">Loan Origination System</option>
                            <option value="AWS S3 Patient Record Archives">AWS S3 Patient Record Archives</option>
                            <option value="External Payment Gateway">External Payment Gateway</option>
                        </datalist>
                    </div>
                </div>

                <!-- Flow Type & Last Confirmed Date -->
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">
                            Flow Type / Protocol <span style="color: #ef4444;">*</span>
                        </label>
                        <select id="modalEdgeFlowType" name="flowType" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border-color); background: var(--bg-card); color: var(--text-main); font-size: 13px;">
                            <option value="etl" selected>ETL (Automated Pipeline)</option>
                            <option value="api">API (REST / GraphQL)</option>
                            <option value="sync">Sync (Continuous DB Replication)</option>
                            <option value="batch">Batch (Nightly Scheduled Export)</option>
                            <option value="stream">Stream (Kafka / Event Queue)</option>
                            <option value="manual">Manual (Staff File Export)</option>
                            <option value="sftp">SFTP (Secure File Transfer)</option>
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">
                            Last Confirmed Date
                        </label>
                        <input type="text" id="modalEdgeLastConfirmed" name="lastConfirmed" placeholder="e.g. 10/25/2026" value="10/25/2026" style="width: 100%; padding: 10px 12px; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-main); font-size: 13px;">
                    </div>
                </div>

                <!-- Stale Status Checkbox -->
                <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 6px; padding: 10px 14px;">
                    <label style="display: flex; align-items: center; gap: 10px; cursor: pointer; margin: 0; font-size: 12px; color: var(--text-main);">
                        <input type="checkbox" id="modalEdgeIsStale" name="isStale" value="1" style="width: 16px; height: 16px; cursor: pointer;">
                        <span>
                            <strong>Flag as Stale / Deprecated Flow</strong>
                            <span style="display: block; font-size: 11px; color: var(--text-muted);">Check if this pipeline is decommissioned or pending re-certification under DPDP audits.</span>
                        </span>
                    </label>
                </div>

                <!-- Notes / Description -->
                <div>
                    <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">
                        Pipeline Notes & Purpose
                    </label>
                    <textarea id="modalEdgeNotes" name="notes" rows="3" placeholder="Describe the personal data categories transmitted, triggers, frequency, and lawful purpose under Section 4/5..." style="width: 100%; padding: 8px 12px; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.3); color: var(--text-main); font-size: 12px; line-height: 1.4; resize: vertical;"></textarea>
                </div>
            </div>

            <!-- Modal Footer -->
            <div style="margin-top: 24px; display: flex; gap: 10px; justify-content: flex-end; align-items: center; border-top: 1px solid var(--border-color); padding-top: 16px;">
                <button type="button" onclick="closeAddEdgeModal()" style="padding: 8px 16px; border-radius: 6px; background: rgba(255,255,255,0.06); color: var(--text-muted); border: 1px solid var(--border-color); font-weight: 600; cursor: pointer;">Cancel</button>
                <button type="submit" id="btnSaveModalEdge" style="padding: 8px 22px; border-radius: 6px; background: var(--primary); color: white; border: none; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px; box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);">
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                    <span>Create Lineage Edge</span>
                </button>
            </div>
        </form>
    </div>
</div>

<!-- ========================================================================= -->
<!-- MODAL: CONFIRM DELETE DATA LINEAGE EDGE                                   -->
<!-- ========================================================================= -->
<div id="deleteEdgeModal" class="modal-overlay" style="display: none; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.75); backdrop-filter: blur(4px); z-index: 999999; align-items: center; justify-content: center; padding: 20px;">
    <div class="modal-box" style="background: #111827; border: 1px solid rgba(255,255,255,0.12); border-radius: 12px; max-width: 440px; width: 100%; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.7); overflow: hidden;">
        <div style="padding: 24px; text-align: center;">
            <div style="width: 48px; height: 48px; border-radius: 50%; background: rgba(239, 68, 68, 0.2); border: 1px solid rgba(239, 68, 68, 0.4); display: flex; align-items: center; justify-content: center; margin: 0 auto 16px auto; color: #ef4444;">
                <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
            </div>
            <h3 style="margin: 0 0 8px 0; font-size: 17px; color: var(--text-main);">Delete Lineage Edge?</h3>
            <p style="margin: 0; font-size: 13px; color: var(--text-muted); line-height: 1.5;">
                Are you sure you want to remove the flow connection <strong id="deleteEdgeTargetName" style="color: var(--text-main);">this edge</strong>? This will unlink these assets in the lineage graph and RoPA reporting.
            </p>
        </div>
        <div style="padding: 16px 24px; background: rgba(0,0,0,0.2); border-top: 1px solid var(--border-color); display: flex; gap: 10px; justify-content: flex-end;">
            <button type="button" onclick="closeDeleteEdgeModal()" style="padding: 8px 16px; border-radius: 6px; background: rgba(255,255,255,0.06); color: var(--text-muted); border: 1px solid var(--border-color); font-weight: 600; cursor: pointer;">Cancel</button>
            <button type="button" id="btnConfirmDeleteEdge" onclick="executeEdgeDelete()" style="padding: 8px 18px; border-radius: 6px; background: #ef4444; color: white; border: none; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                <span>Delete Edge</span>
            </button>
        </div>
    </div>
</div>

<!-- Notification Toast -->
<div id="lineageToast" style="display: none; position: fixed; bottom: 24px; right: 24px; z-index: 1000000; padding: 12px 20px; border-radius: 8px; font-size: 13px; font-weight: 600; box-shadow: 0 10px 25px rgba(0,0,0,0.5); transition: opacity 0.3s ease;"></div>

<script>
let pendingDeleteEdgeId = null;

function showLineageToast(message, type = 'success') {
    const toast = document.getElementById('lineageToast');
    if (!toast) return;
    toast.textContent = message;
    if (type === 'success') {
        toast.style.background = '#065f46';
        toast.style.color = '#34d399';
        toast.style.border = '1px solid #10b981';
    } else {
        toast.style.background = '#7f1d1d';
        toast.style.color = '#f87171';
        toast.style.border = '1px solid #ef4444';
    }
    toast.style.display = 'block';
    toast.style.opacity = '1';
    setTimeout(() => {
        toast.style.opacity = '0';
        setTimeout(() => { toast.style.display = 'none'; }, 300);
    }, 3500);
}

// Open Add Edge Modal
function openAddEdgeModal(e) {
    if (e && e.preventDefault) e.preventDefault();
    const modal = document.getElementById('addEdgeModal');
    if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        setTimeout(() => {
            const input = document.getElementById('modalEdgeSource');
            if (input) input.focus();
        }, 50);
    }
}

// Close Add Edge Modal
function closeAddEdgeModal() {
    const modal = document.getElementById('addEdgeModal');
    if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }
}

// Open Delete Confirmation Modal
function confirmDeleteEdge(edgeId, edgeLabel) {
    pendingDeleteEdgeId = edgeId;
    const nameEl = document.getElementById('deleteEdgeTargetName');
    if (nameEl) nameEl.innerHTML = edgeLabel || 'this edge';
    const modal = document.getElementById('deleteEdgeModal');
    if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
    }
}

// Close Delete Confirmation Modal
function closeDeleteEdgeModal() {
    pendingDeleteEdgeId = null;
    const modal = document.getElementById('deleteEdgeModal');
    if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
    }
}

// Execute Delete via API
async function executeEdgeDelete() {
    if (!pendingDeleteEdgeId) return;
    const btn = document.getElementById('btnConfirmDeleteEdge');
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner" style="display:inline-block;width:12px;height:12px;border:2px solid white;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;"></span> Deleting...';
    }
    
    try {
        const response = await fetch('/api/lineage/edges/' + encodeURIComponent(pendingDeleteEdgeId), {
            method: 'DELETE',
            headers: { 'Accept': 'application/json' }
        });
        
        const resData = await response.json();
        if (response.ok && resData.success !== false) {
            const row = document.getElementById('edge-row-' + pendingDeleteEdgeId) || document.querySelector(`tr[data-edge-id="${pendingDeleteEdgeId}"]`);
            if (row) {
                row.style.transition = 'opacity 0.3s ease, transform 0.3s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(20px)';
                setTimeout(() => {
                    row.remove();
                    recalculateMetrics();
                }, 300);
            }
            showLineageToast('Lineage edge deleted successfully', 'success');
            closeDeleteEdgeModal();
        } else {
            alert('Failed to delete edge: ' + (resData.error || 'Server error'));
        }
    } catch (err) {
        console.error('Delete edge error:', err);
        // Fallback to form/get
        window.location.href = '/inventory/lineage/edges/' + encodeURIComponent(pendingDeleteEdgeId) + '/delete';
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.textContent = 'Delete Edge';
        }
    }
}

// Handle Add Edge Form Submit via AJAX
async function handleEdgeFormSubmit(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSaveModalEdge');
    const source = document.getElementById('modalEdgeSource').value.trim();
    const target = document.getElementById('modalEdgeTarget').value.trim();
    const flowType = document.getElementById('modalEdgeFlowType').value;
    const lastConfirmed = document.getElementById('modalEdgeLastConfirmed').value.trim();
    const isStale = document.getElementById('modalEdgeIsStale').checked;
    const notes = document.getElementById('modalEdgeNotes').value.trim();

    if (!source || !target) {
        alert('Source and Target are required to map a lineage edge.');
        return;
    }

    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<span class="spinner" style="display:inline-block;width:12px;height:12px;border:2px solid white;border-top-color:transparent;border-radius:50%;animation:spin 1s linear infinite;"></span> Creating...';
    }

    try {
        const response = await fetch('/api/lineage/edges/create', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                source,
                target,
                flowType,
                lastConfirmed,
                isStale: isStale ? 1 : 0,
                notes
            })
        });

        const data = await response.json();
        if (response.ok && data.success) {
            const edge = data.edge;
            appendEdgeToTable(edge);
            recalculateMetrics();
            showLineageToast('Lineage edge established: ' + edge.source + ' → ' + edge.target, 'success');
            document.getElementById('addEdgeForm').reset();
            document.getElementById('modalEdgeLastConfirmed').value = '10/25/2026';
            closeAddEdgeModal();
        } else {
            alert('Error creating lineage edge: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        console.error('Create edge AJAX error:', err);
        // Fallback to standard form submit
        document.getElementById('addEdgeForm').submit();
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = '<svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2.5" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg> <span>Create Lineage Edge</span>';
        }
    }
}

// Dynamically Append Edge to Table
function appendEdgeToTable(edge) {
    const tbody = document.getElementById('lineageTableBody');
    if (!tbody) return;

    const emptyRow = document.getElementById('emptyLineageRow');
    if (emptyRow) emptyRow.remove();

    let badgeBg = '#e9d5ff', badgeColor = '#6b21a8';
    const ft = (edge.flowType || 'etl').toLowerCase();
    if (ft === 'api') { badgeBg = 'rgba(59, 130, 246, 0.2)'; badgeColor = '#60a5fa'; }
    else if (ft === 'sync') { badgeBg = 'rgba(16, 185, 129, 0.2)'; badgeColor = '#34d399'; }
    else if (ft === 'stream') { badgeBg = 'rgba(245, 158, 11, 0.2)'; badgeColor = '#fbbf24'; }
    else if (ft === 'batch') { badgeBg = 'rgba(168, 85, 247, 0.2)'; badgeColor = '#c084fc'; }
    else if (ft === 'manual') { badgeBg = 'rgba(148, 163, 184, 0.2)'; badgeColor = '#94a3b8'; }
    else if (ft === 'sftp') { badgeBg = 'rgba(236, 72, 153, 0.2)'; badgeColor = '#f472b6'; }

    const safeSource = escapeHtml(edge.source);
    const safeTarget = escapeHtml(edge.target);
    const safeNotes = escapeHtml(edge.notes || '—');
    const safeDate = escapeHtml(edge.lastConfirmed || '10/25/2026');
    const staleHtml = (edge.isStale == 1 || edge.isStale === true) 
        ? '<span style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3); padding: 2px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;">⚠️ Stale</span>'
        : '<span style="color: var(--text-muted);">&mdash;</span>';

    const tr = document.createElement('tr');
    tr.id = 'edge-row-' + edge.id;
    tr.setAttribute('data-edge-id', edge.id);
    tr.setAttribute('data-source', edge.source);
    tr.setAttribute('data-target', edge.target);
    tr.setAttribute('data-flow', edge.flowType);
    tr.style.borderBottom = '1px solid var(--border-color)';
    tr.style.transition = 'background 0.15s ease';

    tr.innerHTML = `
        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); white-space: nowrap;">${safeSource}</td>
        <td style="padding: 16px 8px; color: #60a5fa; text-align: center; font-weight: 700;">&rarr;</td>
        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); white-space: nowrap;">${safeTarget}</td>
        <td style="padding: 16px 24px;">
            <span class="badge" style="background: ${badgeBg}; color: ${badgeColor}; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; text-transform: uppercase;">${escapeHtml(edge.flowType || 'etl')}</span>
        </td>
        <td style="padding: 16px 24px; color: var(--text-muted); max-width: 320px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${safeNotes}">${safeNotes}</td>
        <td style="padding: 16px 24px;">${staleHtml}</td>
        <td style="padding: 16px 24px; color: var(--text-muted);">${safeDate}</td>
        <td style="padding: 16px 24px; text-align: right;">
            <button type="button" class="btn-delete-edge" onclick="confirmDeleteEdge('${edge.id}', '${safeSource} &rarr; ${safeTarget}')" title="Delete lineage edge" style="background: rgba(239, 68, 68, 0.1); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 6px; padding: 6px 10px; cursor: pointer; color: #f87171; display: inline-flex; align-items: center; gap: 4px; font-size: 11px; font-weight: 600; transition: all 0.2s;">
                <svg viewBox="0 0 24 24" width="13" height="13" stroke="currentColor" stroke-width="2" fill="none"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                Delete
            </button>
        </td>
    `;

    tbody.prepend(tr);
}

// Recalculate Top Metrics Counter
function recalculateMetrics() {
    const rows = document.querySelectorAll('#lineageTableBody tr[data-edge-id]');
    const totalEl = document.getElementById('metricTotalEdges');
    const staleEl = document.getElementById('metricStaleEdges');
    const connEl = document.getElementById('metricConnectedAssets');

    if (totalEl) totalEl.textContent = rows.length;

    let staleCount = 0;
    const connectedSet = new Set();
    rows.forEach(r => {
        const src = r.getAttribute('data-source');
        const tgt = r.getAttribute('data-target');
        if (src) connectedSet.add(src.trim());
        if (tgt) connectedSet.add(tgt.trim());
        if (r.innerHTML.includes('Stale')) staleCount++;
    });

    if (staleEl) staleEl.textContent = staleCount;
    if (connEl && connectedSet.size > 0) connEl.textContent = connectedSet.size;
}

// Search Filter
function filterLineageEdges() {
    const input = document.getElementById('lineageSearchInput');
    const query = (input ? input.value : '').toLowerCase().trim();
    const rows = document.querySelectorAll('#lineageTableBody tr[data-edge-id]');

    rows.forEach(row => {
        const text = row.textContent.toLowerCase();
        row.style.display = text.includes(query) ? '' : 'none';
    });
}

// Explorer Tool Filter
function runLineageExplorer() {
    const rootAsset = document.getElementById('explorerRootAsset').value;
    const direction = document.getElementById('explorerDirection').value;
    const statusBadge = document.getElementById('explorerStatusBadge');
    const clearBtn = document.getElementById('btnClearExplorer');

    if (!rootAsset) {
        alert('Please select a Root Asset to explore its lineage graph.');
        return;
    }

    const rows = document.querySelectorAll('#lineageTableBody tr[data-edge-id]');
    let matchedCount = 0;

    rows.forEach(row => {
        const src = (row.getAttribute('data-source') || '').toLowerCase();
        const tgt = (row.getAttribute('data-target') || '').toLowerCase();
        const rLower = rootAsset.toLowerCase();

        let match = false;
        if (direction === 'Both') {
            match = (src === rLower || tgt === rLower);
        } else if (direction === 'Upstream') {
            // Upstream means flows where target is this asset
            match = (tgt === rLower);
        } else if (direction === 'Downstream') {
            // Downstream means flows where source is this asset
            match = (src === rLower);
        }

        if (match) {
            row.style.display = '';
            row.style.backgroundColor = 'rgba(59, 130, 246, 0.08)';
            matchedCount++;
        } else {
            row.style.display = 'none';
            row.style.backgroundColor = '';
        }
    });

    if (statusBadge) {
        statusBadge.textContent = `Showing ${matchedCount} flows for "${rootAsset}" (${direction})`;
        statusBadge.style.display = 'inline-block';
    }
    if (clearBtn) clearBtn.style.display = 'inline-flex';
}

function clearLineageExplorer() {
    const rows = document.querySelectorAll('#lineageTableBody tr[data-edge-id]');
    rows.forEach(r => {
        r.style.display = '';
        r.style.backgroundColor = '';
    });
    document.getElementById('explorerRootAsset').value = '';
    const statusBadge = document.getElementById('explorerStatusBadge');
    const clearBtn = document.getElementById('btnClearExplorer');
    if (statusBadge) statusBadge.style.display = 'none';
    if (clearBtn) clearBtn.style.display = 'none';
}

function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

// Bind DOM Events
document.addEventListener('DOMContentLoaded', () => {
    const addBtn = document.getElementById('btnOpenAddEdgeModal');
    if (addBtn) {
        addBtn.addEventListener('click', (e) => openAddEdgeModal(e));
    }

    // Modal background dismissal
    const addModal = document.getElementById('addEdgeModal');
    if (addModal) {
        addModal.addEventListener('click', (e) => {
            if (e.target === addModal) closeAddEdgeModal();
        });
    }

    const delModal = document.getElementById('deleteEdgeModal');
    if (delModal) {
        delModal.addEventListener('click', (e) => {
            if (e.target === delModal) closeDeleteEdgeModal();
        });
    }

    // Escape key listener
    document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') {
            closeAddEdgeModal();
            closeDeleteEdgeModal();
        }
    });
});
</script>

<style>
@keyframes spin {
    to { transform: rotate(360deg); }
}
.data-table tbody tr:hover {
    background: rgba(255, 255, 255, 0.02);
}
</style>

<%- include('partials/footer') %>
