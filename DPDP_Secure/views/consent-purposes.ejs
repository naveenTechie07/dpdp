<%- include('partials/header') %>
<%
  const safePurposes = (typeof purposes !== 'undefined' && Array.isArray(purposes)) ? purposes : [];
%>

<style>
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}
.modal-overlay.active {
    display: flex;
}
.modal-content {
    background: #111827;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 100%;
    max-width: 520px;
    padding: 24px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
}
.form-input {
    width: 100%;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--border-color);
    color: white;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    box-sizing: border-box;
    margin-bottom: 16px;
}
.action-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
}
.action-btn:hover { background: rgba(255,255,255,0.1); }
.action-btn.del { color: #fca5a5; background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); }
.action-btn.del:hover { background: rgba(239, 68, 68, 0.2); }
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: white; margin: 0 0 6px 0;">Consent Purposes Registry</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">DPDP Act Section 6 specified purpose definitions. Consent must be tied to clear, unambiguous clinical or statutory purposes.</p>
        </div>
        <button onclick="openModal()" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 18px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Purpose
        </button>
    </div>

    <div class="card p-0" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden;">
        <!-- Table Toolbar -->
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <input type="text" placeholder="Search purposes by name or code..." oninput="filterPurposes(this.value)" style="border: 1px solid var(--border-color); padding: 8px 14px; border-radius: 6px; background: rgba(0,0,0,0.25); color: white; font-size: 13px; width: 320px;">
            <div style="font-size: 12px; color: var(--text-muted);">
                Showing <%= safePurposes.length %> registered purposes
            </div>
        </div>

        <!-- Data Table -->
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase; background: rgba(0,0,0,0.15);">
                    <th style="padding: 14px 24px; font-weight: 600;">Purpose Name &amp; Code</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Description</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Status</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Created</th>
                    <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="purposesTableBody" style="font-size: 13px;">
                <% if (safePurposes.length === 0) { %>
                    <tr>
                        <td colspan="5" style="padding: 36px; text-align: center; color: var(--text-muted);">
                            No consent purposes defined. Click "New Purpose" to add one.
                        </td>
                    </tr>
                <% } else { %>
                    <% safePurposes.forEach(p => { %>
                        <tr class="purpose-row" id="row-<%= p.id %>" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 16px 24px; width: 320px;">
                                <div style="font-weight: 600; color: white; margin-bottom: 4px;"><%= p.purposeName %></div>
                                <div style="color: #93c5fd; font-size: 11px; font-family: monospace;"><%= p.purposeCode %></div>
                            </td>
                            <td style="padding: 16px 16px; color: var(--text-muted); line-height: 1.4; max-width: 400px;">
                                <%= p.description || 'Clinical purpose specification' %>
                            </td>
                            <td style="padding: 16px 16px;">
                                <% if (p.isActive) { %>
                                    <span style="display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                                        Active
                                    </span>
                                <% } else { %>
                                    <span style="display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                                        Draft
                                    </span>
                                <% } %>
                            </td>
                            <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">
                                <%= p.createdAt ? new Date(p.createdAt).toLocaleDateString() : 'Live' %>
                            </td>
                            <td style="padding: 16px 24px; text-align: right;">
                                <button class="action-btn del" onclick="deletePurpose('<%= p.id %>', '<%= p.purposeName %>')">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

</div>

<!-- Create Purpose Modal -->
<div class="modal-overlay" id="createPurposeModal" onclick="if(event.target===this) closeModal()">
    <div class="modal-content">
        <h2 style="font-size: 17px; font-weight: 700; color: white; margin: 0 0 6px 0;">Define Consent Purpose</h2>
        <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 20px 0;">Specify clear, lawful processing boundaries under DPDP Act Section 6.</p>
        
        <form id="createPurposeForm" onsubmit="handleCreatePurpose(event)">
            <label style="display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 6px;">Purpose Title <span style="color: #ef4444;">*</span></label>
            <input type="text" id="pName" class="form-input" placeholder="e.g. Pathology Diagnostic Reporting" required>
            
            <label style="display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 6px;">Purpose Code <span style="color: #ef4444;">*</span></label>
            <input type="text" id="pCode" class="form-input" placeholder="e.g. PURP-PATHOLOGY-REPORTING" required>
            
            <label style="display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 6px;">Purpose Description</label>
            <textarea id="pDesc" class="form-input" style="height: 70px; resize: none;" placeholder="Explain exactly why personal medical data is processed..."></textarea>
            
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
                <input type="checkbox" id="pIsActive" checked style="width: 18px; height: 18px; accent-color: #3b82f6;">
                <label for="pIsActive" style="font-size: 13px; color: white; cursor: pointer;">Activate immediately for WhatsApp &amp; web consent</label>
            </div>
            
            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" onclick="closeModal()" class="action-btn" style="padding: 10px 18px;">Cancel</button>
                <button type="submit" id="btnSubmitPurpose" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                    Save Purpose
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function filterPurposes(q) {
    const rows = document.querySelectorAll('.purpose-row');
    const term = (q || '').toLowerCase();
    rows.forEach(r => {
        r.style.display = r.innerText.toLowerCase().includes(term) ? '' : 'none';
    });
}

function openModal() {
    document.getElementById('createPurposeModal').classList.add('active');
}

function closeModal() {
    document.getElementById('createPurposeModal').classList.remove('active');
}

async function handleCreatePurpose(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitPurpose');
    btn.disabled = true;
    btn.innerText = 'Saving...';

    const purposeName = document.getElementById('pName').value.trim();
    const purposeCode = document.getElementById('pCode').value.trim();
    const description = document.getElementById('pDesc').value.trim();
    const isActive = document.getElementById('pIsActive').checked ? 1 : 0;

    try {
        const res = await fetch('/api/consent/purposes', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ purposeName, purposeCode, description, isActive })
        });
        const data = await res.json();
        if (data.success) {
            closeModal();
            window.location.reload();
        } else {
            alert('Failed to save purpose: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerText = 'Save Purpose';
    }
}

async function deletePurpose(id, name) {
    if (!confirm(`Are you sure you want to delete consent purpose "${name}"?`)) return;
    try {
        const res = await fetch(`/api/consent/purposes/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            const row = document.getElementById(`row-${id}`);
            if (row) row.remove();
            else window.location.reload();
        } else {
            alert('Failed to delete purpose: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    }
}
</script>

<%- include('partials/footer') %>
