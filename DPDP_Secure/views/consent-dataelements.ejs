<%- include('partials/header') %>
<%
  const safeElements = (typeof elements !== 'undefined' && Array.isArray(elements)) ? elements : [];
%>

<style>
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}
.modal-overlay.active { display: flex; }
.modal-content {
    background: #111827;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 100%;
    max-width: 500px;
    padding: 24px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
}
.form-input {
    width: 100%;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--border-color);
    color: white;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    box-sizing: border-box;
    margin-bottom: 16px;
}
.action-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
}
.action-btn:hover { background: rgba(255,255,255,0.1); }
.action-btn.del { color: #fca5a5; background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); }
.action-btn.del:hover { background: rgba(239, 68, 68, 0.2); }
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: white; margin: 0 0 6px 0;">Data Elements Registry</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Define reusable field types and Indian personal data categories for consent collection point forms.</p>
        </div>
        <button onclick="openModal()" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 18px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Data Element
        </button>
    </div>

    <div class="card p-0" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden;">
        <!-- Table Toolbar -->
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <input type="text" placeholder="Search data elements..." oninput="filterElements(this.value)" style="border: 1px solid var(--border-color); padding: 8px 14px; border-radius: 6px; background: rgba(0,0,0,0.25); color: white; font-size: 13px; width: 320px;">
            <div style="font-size: 12px; color: var(--text-muted);">
                Showing <%= safeElements.length %> elements
            </div>
        </div>

        <!-- Data Table -->
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase; background: rgba(0,0,0,0.15);">
                    <th style="padding: 14px 24px; font-weight: 600;">Element Name</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Classification Category</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Sensitivity Tier</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Created</th>
                    <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="elementsTableBody" style="font-size: 13px;">
                <% if (safeElements.length === 0) { %>
                    <tr>
                        <td colspan="5" style="padding: 36px; text-align: center; color: var(--text-muted);">
                            No data elements defined. Click "New Data Element" to register one.
                        </td>
                    </tr>
                <% } else { %>
                    <% safeElements.forEach(el => { %>
                        <tr class="element-row" id="row-<%= el.id %>" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 16px 24px; font-weight: 600; color: white;">
                                <%= el.elementName %>
                            </td>
                            <td style="padding: 16px 16px;">
                                <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; background: rgba(59, 130, 246, 0.15); color: #93c5fd; font-family: monospace;">
                                    <%= el.elementType || 'GENERAL_DATA' %>
                                </span>
                            </td>
                            <td style="padding: 16px 16px;">
                                <% if (el.isSensitive) { %>
                                    <span style="display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 700; background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.25);">
                                        High Sensitivity PII
                                    </span>
                                <% } else { %>
                                    <span style="display: inline-block; padding: 2px 10px; border-radius: 12px; font-size: 11px; font-weight: 600; background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.25);">
                                        Standard Element
                                    </span>
                                <% } %>
                            </td>
                            <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">
                                <%= el.createdAt ? new Date(el.createdAt).toLocaleDateString() : 'Live' %>
                            </td>
                            <td style="padding: 16px 24px; text-align: right;">
                                <button class="action-btn del" onclick="deleteElement('<%= el.id %>', '<%= el.elementName %>')">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

</div>

<!-- Create Data Element Modal -->
<div class="modal-overlay" id="createElementModal" onclick="if(event.target===this) closeModal()">
    <div class="modal-content">
        <h2 style="font-size: 17px; font-weight: 700; color: white; margin: 0 0 6px 0;">Register Data Element</h2>
        <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 20px 0;">Define attributes for consent notice forms and PII detection mapping.</p>
        
        <form id="createElementForm" onsubmit="handleCreateElement(event)">
            <label style="display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 6px;">Element Title <span style="color: #ef4444;">*</span></label>
            <input type="text" id="elName" class="form-input" placeholder="e.g. Diagnostic Ultrasound Report" required>
            
            <label style="display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 6px;">Classification Category</label>
            <select id="elType" class="form-input" style="appearance: none;">
                <option value="SPECIAL_CATEGORY_HEALTH">Special Category Health / Clinical Diagnostic</option>
                <option value="GOVERNMENT_ID">Government Identification (Aadhaar, PAN, ABHA)</option>
                <option value="CONTACT_IDENTIFIER">Contact Identifier (WhatsApp, Phone, Email)</option>
                <option value="FINANCIAL_PII">Financial &amp; Billing (UPI, Bank Account)</option>
            </select>
            
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
                <input type="checkbox" id="elIsSensitive" checked style="width: 18px; height: 18px; accent-color: #3b82f6;">
                <label for="elIsSensitive" style="font-size: 13px; color: white; cursor: pointer;">Flag as High Sensitivity Personal Data under DPDP Section 9</label>
            </div>
            
            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" onclick="closeModal()" class="action-btn" style="padding: 10px 18px;">Cancel</button>
                <button type="submit" id="btnSubmitElement" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                    Save Element
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function filterElements(q) {
    const rows = document.querySelectorAll('.element-row');
    const term = (q || '').toLowerCase();
    rows.forEach(r => {
        r.style.display = r.innerText.toLowerCase().includes(term) ? '' : 'none';
    });
}

function openModal() {
    document.getElementById('createElementModal').classList.add('active');
}

function closeModal() {
    document.getElementById('createElementModal').classList.remove('active');
}

async function handleCreateElement(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitElement');
    btn.disabled = true;
    btn.innerText = 'Saving...';

    const elementName = document.getElementById('elName').value.trim();
    const elementType = document.getElementById('elType').value;
    const isSensitive = document.getElementById('elIsSensitive').checked ? 1 : 0;

    try {
        const res = await fetch('/api/consent/data-elements', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ elementName, elementType, isSensitive })
        });
        const data = await res.json();
        if (data.success) {
            closeModal();
            window.location.reload();
        } else {
            alert('Failed to save element: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerText = 'Save Element';
    }
}

async function deleteElement(id, name) {
    if (!confirm(`Are you sure you want to delete data element "${name}"?`)) return;
    try {
        const res = await fetch(`/api/consent/data-elements/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            const row = document.getElementById(`row-${id}`);
            if (row) row.remove();
            else window.location.reload();
        } else {
            alert('Failed to delete element: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    }
}
</script>

<%- include('partials/footer') %>
