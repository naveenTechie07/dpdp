<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || '500 - Server Error | DPDP_Secure' %></title>
    <link rel="stylesheet" href="/css/style.css">
    <style>
        body {
            background: #0b0f19;
            color: #f3f4f6;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            margin: 0;
            padding: 20px;
            box-sizing: border-box;
        }
        .error-card {
            background: rgba(17, 24, 39, 0.85);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(16px);
            border-radius: 12px;
            padding: 40px;
            max-width: 550px;
            width: 100%;
            text-align: center;
            box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
        }
        .badge {
            display: inline-block;
            background: rgba(239, 68, 68, 0.15);
            color: #ef4444;
            border: 1px solid rgba(239, 68, 68, 0.3);
            padding: 4px 12px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            margin-bottom: 16px;
        }
        h1 {
            color: #ffffff;
            font-size: 24px;
            margin: 0 0 12px 0;
        }
        p {
            color: #9ca3af;
            font-size: 14px;
            line-height: 1.6;
            margin: 0 0 24px 0;
        }
        .btn-home {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            background: #3b82f6;
            color: #ffffff;
            padding: 10px 20px;
            border-radius: 6px;
            font-weight: 600;
            text-decoration: none;
            transition: background 0.2s;
        }
        .btn-home:hover {
            background: #2563eb;
        }
    </style>
</head>
<body>
    <div class="error-card">
        <span class="badge">500 Server Notice</span>
        <h1><%= title %></h1>
        <p><%= description || 'An unexpected condition was encountered. All personal data operations remain protected.' %></p>
        <a href="/" class="btn-home">Return to Dashboard</a>
    </div>
</body>
</html>
