<%- include('partials/header') %>
<%
  const rawSettings = (typeof settings !== 'undefined' && settings) ? settings : {};
  const safeSettings = Array.isArray(rawSettings) 
    ? rawSettings.reduce((acc, curr) => { if(curr && curr.settingKey) acc[curr.settingKey] = curr.settingValue; return acc; }, {})
    : rawSettings;
  const getSetting = (k, def) => (safeSettings[k] !== undefined && safeSettings[k] !== null ? safeSettings[k] : def);
  const isGuidanceOn = getSetting('dpdpa_guidance', 'enabled') === 'enabled';
  const isAadhaarRedactOn = getSetting('auto_redact_aadhaar', 'enabled') === 'enabled';
  const isTaxLockOn = getSetting('enforce_cgst_tax_lock', 'enabled') === 'enabled';
%>

<style>
.settings-section-title {
    font-size: 15px;
    font-weight: 700;
    color: white;
    margin: 0 0 4px 0;
}
.settings-section-desc {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 16px 0;
}
.settings-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
}
.form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
}
.form-label {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: white;
    margin-bottom: 8px;
}
.form-input {
    width: 100%;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--border-color);
    color: white;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    box-sizing: border-box;
}
.toggle-switch-ui {
    width: 44px;
    height: 24px;
    background: #374151;
    border-radius: 12px;
    position: relative;
    cursor: pointer;
    transition: background 0.2s;
}
.toggle-switch-ui.active {
    background: #3b82f6;
}
.toggle-switch-ui::after {
    content: '';
    position: absolute;
    top: 2px;
    left: 2px;
    width: 20px;
    height: 20px;
    background: white;
    border-radius: 50%;
    transition: left 0.2s;
}
.toggle-switch-ui.active::after {
    left: 22px;
}
.alert-banner {
    background: rgba(234, 179, 8, 0.1);
    border: 1px solid rgba(234, 179, 8, 0.25);
    color: #fde047;
    padding: 12px 16px;
    border-radius: 8px;
    font-size: 12px;
    margin-top: 16px;
}
.toast-msg {
    position: fixed;
    bottom: 24px;
    right: 24px;
    background: #10b981;
    color: white;
    padding: 12px 20px;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 10px 15px -3px rgba(0,0,0,0.4);
    display: none;
    z-index: 1000;
}
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <div style="margin-bottom: 32px; display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: white; margin: 0 0 6px 0;">General Settings</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Configure tenant-wide statutory governance, DPO bindings, and DPDP Act compliance parameters.</p>
        </div>
        <button onclick="saveAllSettings()" id="btnSaveTop" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 24px; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer;">
            Save Settings
        </button>
    </div>

    <!-- Regulatory Guidance Card -->
    <div class="settings-card">
        <h2 class="settings-section-title">Regulatory Guidance & Statutory Controls</h2>
        <p class="settings-section-desc">Controls contextual DPDPA 2023 compliance hints, automated Indian identifier redaction, and Section 36 tax retention locks.</p>
        
        <div style="display: flex; flex-direction: column; gap: 14px;">
            <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; gap: 14px; align-items: center;">
                    <div style="background: rgba(59, 130, 246, 0.15); padding: 8px; border-radius: 6px; color: #60a5fa;">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                    </div>
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: white;">DPDPA Section Guidance Banners</div>
                        <div style="font-size: 12px; color: var(--text-muted);">Displays statutory citation banners across admin modules (Section 4, 8, 10, 11, 12, 13).</div>
                    </div>
                </div>
                <div class="toggle-switch-ui <%= isGuidanceOn ? 'active' : '' %>" id="toggleGuidance" onclick="toggleSwitch('toggleGuidance')"></div>
            </div>

            <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; gap: 14px; align-items: center;">
                    <div style="background: rgba(16, 185, 129, 0.15); padding: 8px; border-radius: 6px; color: #34d399;">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                    </div>
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: white;">Aadhaar & PAN Auto-Masking Engine</div>
                        <div style="font-size: 12px; color: var(--text-muted);">Automatically mask first 8 digits of Aadhaar (XXXX-XXXX-1234) upon informal file discovery.</div>
                    </div>
                </div>
                <div class="toggle-switch-ui <%= isAadhaarRedactOn ? 'active' : '' %>" id="toggleAadhaar" onclick="toggleSwitch('toggleAadhaar')"></div>
            </div>

            <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; display: flex; align-items: center; justify-content: space-between;">
                <div style="display: flex; gap: 14px; align-items: center;">
                    <div style="background: rgba(245, 158, 11, 0.15); padding: 8px; border-radius: 6px; color: #fbbf24;">
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                    </div>
                    <div>
                        <div style="font-size: 14px; font-weight: 600; color: white;">CGST Act Sec 36 Statutory Tax Lock</div>
                        <div style="font-size: 12px; color: var(--text-muted);">Enforce mandatory 72-month tax lock preventing DSR erasure on clinic diagnostic billing invoices.</div>
                    </div>
                </div>
                <div class="toggle-switch-ui <%= isTaxLockOn ? 'active' : '' %>" id="toggleTaxLock" onclick="toggleSwitch('toggleTaxLock')"></div>
            </div>
        </div>
    </div>

    <!-- Controller & DPO Details Card -->
    <div class="settings-card">
        <h2 class="settings-section-title">Data Fiduciary & DPO Details</h2>
        <p class="settings-section-desc">DPDP Act Section 8(9) designated Data Protection Officer contact details published on public notices and DSR receipts.</p>
        
        <div class="form-grid-2">
            <div>
                <label class="form-label">Legal Entity Name <span style="color: #ef4444;">*</span></label>
                <input type="text" id="legal_entity_name" class="form-input" value="<%= getSetting('legal_entity_name', 'Aarogya Diagnostic Center') %>">
            </div>
            <div>
                <label class="form-label">Designated DPO Name <span style="color: #ef4444;">*</span></label>
                <input type="text" id="data_protection_officer" class="form-input" value="<%= getSetting('data_protection_officer', 'Dr. Suresh Rao') %>">
            </div>
        </div>
        
        <div style="margin-bottom: 20px;">
            <label class="form-label">Registered Clinic Address <span style="color: #ef4444;">*</span></label>
            <textarea id="registered_address" class="form-input" style="height: 64px; resize: none;"><%= getSetting('registered_address', '12/4, 100 Feet Road, HAL 2nd Stage, Indiranagar, Bengaluru, Karnataka 560038') %></textarea>
        </div>
        
        <div class="form-grid-2" style="margin-bottom: 0;">
            <div>
                <label class="form-label">DPO Email Address <span style="color: #ef4444;">*</span></label>
                <input type="email" id="dpo_email" class="form-input" value="<%= getSetting('dpo_email', 'dpo@aarogyaclinic.in') %>">
            </div>
            <div>
                <label class="form-label">DPO Phone Number <span style="color: #ef4444;">*</span></label>
                <input type="text" id="dpo_phone" class="form-input" value="<%= getSetting('dpo_phone', '+91 9845012345') %>">
            </div>
        </div>
    </div>

    <!-- Bot Protection Card -->
    <div class="settings-card">
        <h2 class="settings-section-title">Automated Form Bot Protection</h2>
        <p class="settings-section-desc">Protect public consent collection forms and DSR intake endpoints against automated credential stuffing and DDoS.</p>
        
        <div class="form-grid-2" style="margin-bottom: 12px;">
            <div>
                <label class="form-label">Cloudflare Turnstile Site Key</label>
                <input type="text" id="turnstile_site_key" class="form-input" value="<%= getSetting('turnstile_site_key', '0x4AAAAAAAbcde12345') %>" placeholder="Turnstile site key">
            </div>
            <div>
                <label class="form-label">Cloudflare Turnstile Secret Key</label>
                <input type="password" id="turnstile_secret_key" class="form-input" value="<%= getSetting('turnstile_secret_key', '••••••••••••••••••••') %>">
            </div>
        </div>
        
        <div class="alert-banner">
            <span style="font-weight: 700;">Offline Resilience Mode Active:</span> In hackathon sandbox and local offline environments, synthetic nonces validate transparently without external Cloudflare egress.
        </div>
    </div>

    <!-- Supabase Cloud Backend Card -->
    <div class="settings-card" style="border-color: rgba(16, 185, 129, 0.3); background: linear-gradient(180deg, rgba(16, 185, 129, 0.04), rgba(15, 23, 42, 0.6));">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
            <div>
                <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                    <span style="font-size: 18px;">⚡</span>
                    <h2 class="settings-section-title" style="margin: 0;">Supabase Cloud Backend (PostgreSQL)</h2>
                    <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 12px;">
                        LIVE CLOUD SYNC
                    </span>
                </div>
                <p class="settings-section-desc" style="margin: 0;">Multi-tenant PostgreSQL cloud persistence hosted in South Asia (Mumbai, ap-south-1) with cryptographic SHA-256 ledger mirroring.</p>
            </div>
            <button type="button" onclick="pingSupabaseLive()" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.4); padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">
                Test Live Ping
            </button>
        </div>

        <div class="form-grid-2" style="margin-bottom: 16px;">
            <div>
                <label class="form-label">Supabase Project Reference</label>
                <input type="text" readonly class="form-input" style="font-family: monospace; color: #34d399;" value="bxiuiopomqpwxmslllhl">
            </div>
            <div>
                <label class="form-label">Cloud Deployment Region</label>
                <input type="text" readonly class="form-input" value="ap-south-1 (South Asia - Mumbai, AWS)">
            </div>
        </div>

        <div style="background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); border-radius: 8px; padding: 14px 16px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
            <div>
                <div style="font-size: 13px; font-weight: 600; color: white; display: flex; align-items: center; gap: 6px;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981; box-shadow: 0 0 6px #10b981;"></span>
                    <span>Database Synchronizer: Ready</span>
                </div>
                <div style="font-size: 11px; color: var(--text-muted); margin-top: 2px;">Synchronizes local SQLite audit trails, consent events, and DSR tickets to Supabase PostgreSQL.</div>
            </div>
            <div style="display: flex; gap: 8px;">
                <button type="button" onclick="triggerSupabaseSync()" id="btnSupabaseSync" style="background: #059669; color: white; border: none; padding: 8px 16px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer; box-shadow: 0 2px 8px rgba(5, 150, 105, 0.4);">
                    🔄 Trigger Cloud Sync
                </button>
            </div>
        </div>
        <div id="supabaseSyncStatusBox" style="display: none; margin-top: 12px; font-size: 12px; padding: 10px 14px; border-radius: 6px;"></div>
    </div>

    <script>
        function pingSupabaseLive() {
            fetch('/api/system/supabase-status')
                .then(r => r.json())
                .then(data => {
                    if (data && data.supabase) {
                        alert('⚡ Supabase Cloud Live Ping:\n\n' +
                              'Status: ' + (data.supabase.connected ? '🟢 CONNECTED' : '🔴 DISCONNECTED') + '\n' +
                              'Latency: ' + data.supabase.latencyMs + 'ms\n' +
                              'Region: ' + data.supabase.region + ' (Mumbai)\n' +
                              'Project: ' + data.supabase.projectRef + '\n' +
                              'Timestamp: ' + data.supabase.timestamp);
                    }
                })
                .catch(err => alert('Error checking Supabase: ' + err.message));
        }

        function triggerSupabaseSync() {
            const btn = document.getElementById('btnSupabaseSync');
            const box = document.getElementById('supabaseSyncStatusBox');
            btn.disabled = true;
            btn.textContent = 'Syncing...';
            box.style.display = 'block';
            box.style.background = 'rgba(59, 130, 246, 0.1)';
            box.style.color = '#60a5fa';
            box.style.border = '1px solid rgba(59, 130, 246, 0.3)';
            box.textContent = 'Initiating cloud synchronization with Supabase PostgreSQL...';

            fetch('/api/system/supabase-sync', { method: 'POST' })
                .then(r => r.json())
                .then(data => {
                    btn.disabled = false;
                    btn.textContent = '🔄 Trigger Cloud Sync';
                    box.style.background = 'rgba(16, 185, 129, 0.1)';
                    box.style.color = '#34d399';
                    box.style.border = '1px solid rgba(16, 185, 129, 0.3)';
                    box.textContent = '✓ Cloud synchronization complete. Data backed up to Supabase Cloud.';
                })
                .catch(err => {
                    btn.disabled = false;
                    btn.textContent = '🔄 Trigger Cloud Sync';
                    box.style.background = 'rgba(239, 68, 68, 0.1)';
                    box.style.color = '#f87171';
                    box.style.border = '1px solid rgba(239, 68, 68, 0.3)';
                    box.textContent = 'Sync notice: ' + err.message;
                });
        }
    </script>


    <div style="display: flex; justify-content: flex-end; margin-bottom: 32px;">
        <button onclick="saveAllSettings()" id="btnSaveBottom" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 12px 32px; border-radius: 6px; font-size: 14px; font-weight: 600; cursor: pointer;">
            Save All Settings
        </button>
    </div>

</div>

<div id="toastSuccess" class="toast-msg">
    Settings saved successfully!
</div>

<script>
function toggleSwitch(id) {
    document.getElementById(id).classList.toggle('active');
}

async function saveSettingItem(key, value) {
    return fetch('/api/settings/general', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ settingKey: key, settingValue: value })
    });
}

async function saveAllSettings() {
    const btnTop = document.getElementById('btnSaveTop');
    const btnBottom = document.getElementById('btnSaveBottom');
    btnTop.disabled = true;
    btnBottom.disabled = true;
    btnTop.innerText = 'Saving...';
    btnBottom.innerText = 'Saving...';

    const payload = [
        { key: 'dpdpa_guidance', value: document.getElementById('toggleGuidance').classList.contains('active') ? 'enabled' : 'disabled' },
        { key: 'auto_redact_aadhaar', value: document.getElementById('toggleAadhaar').classList.contains('active') ? 'enabled' : 'disabled' },
        { key: 'enforce_cgst_tax_lock', value: document.getElementById('toggleTaxLock').classList.contains('active') ? 'enabled' : 'disabled' },
        { key: 'legal_entity_name', value: document.getElementById('legal_entity_name').value.trim() },
        { key: 'data_protection_officer', value: document.getElementById('data_protection_officer').value.trim() },
        { key: 'registered_address', value: document.getElementById('registered_address').value.trim() },
        { key: 'dpo_email', value: document.getElementById('dpo_email').value.trim() },
        { key: 'dpo_phone', value: document.getElementById('dpo_phone').value.trim() },
        { key: 'turnstile_site_key', value: document.getElementById('turnstile_site_key').value.trim() }
    ];

    try {
        for (const item of payload) {
            await saveSettingItem(item.key, item.value);
        }
        
        const toast = document.getElementById('toastSuccess');
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 3000);
    } catch (err) {
        alert('Failed to save settings: ' + err.message);
    } finally {
        btnTop.disabled = false;
        btnBottom.disabled = false;
        btnTop.innerText = 'Save Settings';
        btnBottom.innerText = 'Save All Settings';
    }
}
</script>

<%- include('partials/footer') %>
