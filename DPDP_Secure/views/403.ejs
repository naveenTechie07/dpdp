<%- include('partials/header') %>

<div style="display: flex; align-items: center; justify-content: center; min-height: 60vh; padding: 20px;">
    <div class="glass-card" style="max-width: 520px; width: 100%; padding: 40px; text-align: center;">
        <div style="width: 56px; height: 56px; border-radius: 12px; background: rgba(239, 68, 68, 0.15); color: #f87171; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px auto;">
            <svg viewBox="0 0 24 24" width="28" height="28" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
        </div>
        <span class="badge-pill danger" style="margin-bottom: 12px;">403 Access Restricted</span>
        <h2 style="font-size: 22px; font-weight: 700; color: #ffffff; margin-bottom: 8px;">Role Authorization Required</h2>
        <p style="font-size: 13px; color: var(--text-muted); line-height: 1.5; margin-bottom: 24px;">
            Your active role <strong style="color: #60a5fa;"><%= typeof userRole !== 'undefined' ? userRole : 'USER' %></strong> does not possess statutory authorization to execute this operation under India DPDP Act, 2023 Section 8 Fiduciary policies.
        </p>

        <% if (typeof requiredRoles !== 'undefined' && Array.isArray(requiredRoles) && requiredRoles.length > 0) { %>
            <div style="background: rgba(0, 0, 0, 0.3); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px; margin-bottom: 24px; text-align: left; font-size: 12px;">
                <div style="color: var(--text-muted); margin-bottom: 4px;">Permitted Statutory Roles:</div>
                <div style="display: flex; gap: 6px; flex-wrap: wrap;">
                    <% requiredRoles.forEach(r => { %>
                        <span class="badge-pill info"><%= r %></span>
                    <% }); %>
                </div>
            </div>
        <% } %>

        <div style="display: flex; gap: 12px; justify-content: center;">
            <a href="/" class="btn-secondary">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                Return to Dashboard
            </a>
            <a href="/auth/login" class="btn-primary">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                Switch Role (Fast-Track)
            </a>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
