<%- include('partials/header') %>
<%
  const safePreferences = (typeof preferences !== 'undefined' && Array.isArray(preferences)) ? preferences : [];
%>

<style>
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 1000;
}
.modal-overlay.active { display: flex; }
.modal-content {
    background: #111827;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 100%;
    max-width: 500px;
    padding: 24px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
}
.form-input {
    width: 100%;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--border-color);
    color: white;
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    box-sizing: border-box;
    margin-bottom: 16px;
}
.action-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: white;
    padding: 6px 12px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
}
.action-btn:hover { background: rgba(255,255,255,0.1); }
.action-btn.del { color: #fca5a5; background: rgba(239, 68, 68, 0.1); border-color: rgba(239, 68, 68, 0.2); }
.action-btn.del:hover { background: rgba(239, 68, 68, 0.2); }
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: white; margin: 0 0 6px 0;">Preference Library</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Configure granular channel preferences (WhatsApp, SMS, Email) and communication choices for patients.</p>
        </div>
        <button onclick="openModal()" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 18px; border-radius: 6px; font-weight: 600; font-size: 13px; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Preference
        </button>
    </div>

    <div class="card p-0" style="background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 12px; overflow: hidden;">
        <!-- Table Toolbar -->
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <input type="text" placeholder="Search preferences..." oninput="filterPrefs(this.value)" style="border: 1px solid var(--border-color); padding: 8px 14px; border-radius: 6px; background: rgba(0,0,0,0.25); color: white; font-size: 13px; width: 300px;">
            <div style="font-size: 12px; color: var(--text-muted);">
                Showing <%= safePreferences.length %> preferences
            </div>
        </div>

        <!-- Data Table -->
        <table style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase; background: rgba(0,0,0,0.15);">
                    <th style="padding: 14px 24px; font-weight: 600;">Preference Name</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Default Value</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Scope</th>
                    <th style="padding: 14px 16px; font-weight: 600;">Created</th>
                    <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="prefsTableBody" style="font-size: 13px;">
                <% if (safePreferences.length === 0) { %>
                    <tr>
                        <td colspan="5" style="padding: 36px; text-align: center; color: var(--text-muted);">
                            No preferences defined. Click "New Preference" to add one.
                        </td>
                    </tr>
                <% } else { %>
                    <% safePreferences.forEach(pf => { %>
                        <tr class="pref-row" id="row-<%= pf.id %>" style="border-bottom: 1px solid rgba(255,255,255,0.05);">
                            <td style="padding: 16px 24px; font-weight: 600; color: white;">
                                <%= pf.preferenceName %>
                            </td>
                            <td style="padding: 16px 16px;">
                                <span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; background: rgba(59, 130, 246, 0.15); color: #93c5fd; font-family: monospace;">
                                    <%= pf.preferenceValue || 'opt-in' %>
                                </span>
                            </td>
                            <td style="padding: 16px 16px;">
                                <% if (pf.isGlobal) { %>
                                    <span style="font-size: 11px; font-weight: 600; color: #34d399; background: rgba(16, 185, 129, 0.15); padding: 2px 8px; border-radius: 12px;">Global Clinic Default</span>
                                <% } else { %>
                                    <span style="font-size: 11px; color: var(--text-muted); background: rgba(255, 255, 255, 0.08); padding: 2px 8px; border-radius: 12px;">Patient Optional</span>
                                <% } %>
                            </td>
                            <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">
                                <%= pf.createdAt ? new Date(pf.createdAt).toLocaleDateString() : 'Live' %>
                            </td>
                            <td style="padding: 16px 24px; text-align: right;">
                                <button class="action-btn del" onclick="deletePref('<%= pf.id %>', '<%= pf.preferenceName %>')">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

</div>

<!-- Create Preference Modal -->
<div class="modal-overlay" id="createPrefModal" onclick="if(event.target===this) closeModal()">
    <div class="modal-content">
        <h2 style="font-size: 17px; font-weight: 700; color: white; margin: 0 0 6px 0;">New Channel Preference</h2>
        <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 20px 0;">Configure options for data principal self-service management.</p>
        
        <form id="createPrefForm" onsubmit="handleCreatePref(event)">
            <label style="display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 6px;">Preference Name <span style="color: #ef4444;">*</span></label>
            <input type="text" id="prefName" class="form-input" placeholder="e.g. WhatsApp Critical Lab Alerts" required>
            
            <label style="display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 6px;">Default Value</label>
            <select id="prefValue" class="form-input" style="appearance: none;">
                <option value="opt-in">Opt-in (Enabled by default)</option>
                <option value="opt-out">Opt-out (Disabled by default)</option>
                <option value="mandatory">Mandatory Statutory (Cannot opt-out)</option>
            </select>
            
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 24px;">
                <input type="checkbox" id="prefIsGlobal" checked style="width: 18px; height: 18px; accent-color: #3b82f6;">
                <label for="prefIsGlobal" style="font-size: 13px; color: white; cursor: pointer;">Global clinic default across all branches</label>
            </div>
            
            <div style="display: flex; gap: 12px; justify-content: flex-end;">
                <button type="button" onclick="closeModal()" class="action-btn" style="padding: 10px 18px;">Cancel</button>
                <button type="submit" id="btnSubmitPref" class="btn-primary" style="background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer;">
                    Save Preference
                </button>
            </div>
        </form>
    </div>
</div>

<script>
function filterPrefs(q) {
    const rows = document.querySelectorAll('.pref-row');
    const term = (q || '').toLowerCase();
    rows.forEach(r => {
        r.style.display = r.innerText.toLowerCase().includes(term) ? '' : 'none';
    });
}

function openModal() {
    document.getElementById('createPrefModal').classList.add('active');
}

function closeModal() {
    document.getElementById('createPrefModal').classList.remove('active');
}

async function handleCreatePref(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitPref');
    btn.disabled = true;
    btn.innerText = 'Saving...';

    const preferenceName = document.getElementById('prefName').value.trim();
    const preferenceValue = document.getElementById('prefValue').value;
    const isGlobal = document.getElementById('prefIsGlobal').checked ? 1 : 0;

    try {
        const res = await fetch('/api/consent/preferences', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ preferenceName, preferenceValue, isGlobal })
        });
        const data = await res.json();
        if (data.success) {
            closeModal();
            window.location.reload();
        } else {
            alert('Failed to save preference: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerText = 'Save Preference';
    }
}

async function deletePref(id, name) {
    if (!confirm(`Are you sure you want to delete preference "${name}"?`)) return;
    try {
        const res = await fetch(`/api/consent/preferences/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            const row = document.getElementById(`row-${id}`);
            if (row) row.remove();
            else window.location.reload();
        } else {
            alert('Failed to delete preference: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    }
}
</script>

<%- include('partials/footer') %>
