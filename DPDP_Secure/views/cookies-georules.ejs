<%- include('partials/header') %>

<div class="dashboard-header mb-4">
    <div>
        <h1 class="page-title"><%= title.split(' - ')[0] %></h1>
        <p class="page-description"><%= description %></p>
    </div>
</div>

<div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px; margin-bottom: 24px;">
    <div style="display: flex; gap: 24px; margin-bottom: 20px;">
        <div style="flex: 1;">
            <input type="text" value="EU" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
        </div>
        <div style="flex: 2;">
            <input type="text" value="GDPR Rule" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
        </div>
    </div>
    <div style="margin-bottom: 20px; position: relative;">
        <select style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px; appearance: none;">
            <option value="OPT_IN" selected>OPT_IN</option>
            <option value="OPT_OUT">OPT_OUT</option>
        </select>
        <div style="position: absolute; right: 12px; top: 0; bottom: 0; display: flex; align-items: center; pointer-events: none; color: var(--text-muted);">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </div>
    </div>
    <div style="display: flex; gap: 32px; margin-bottom: 24px;">
        <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-main); cursor: pointer;">
            <input type="checkbox" style="width: 16px; height: 16px; accent-color: var(--primary-color);">
            Analytics default
        </label>
        <label style="display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-main); cursor: pointer;">
            <input type="checkbox" style="width: 16px; height: 16px; accent-color: var(--primary-color);">
            Marketing default
        </label>
    </div>
    <div>
        <button class="btn-primary" style="padding: 10px 24px; font-size: 14px;">Add geo rule</button>
    </div>
</div>

<div class="card p-0" style="overflow: hidden; display: flex; flex-direction: column;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 350px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search geo rules..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span>1 row</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                <th style="padding: 16px 24px;">ID &uarr;</th>
                <th style="padding: 16px 16px;">Region &uarr;</th>
                <th style="padding: 16px 16px;">Rule &uarr;</th>
                <th style="padding: 16px 16px;">Mode &uarr;</th>
                <th style="padding: 16px 16px;">Analytics &uarr;</th>
                <th style="padding: 16px 16px;">Marketing &uarr;</th>
                <th style="padding: 16px 24px;">Created &uarr;</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <tr style="border-bottom: 1px solid transparent; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px; color: var(--text-muted);">#1</td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">IN</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">India DPDPA OPT_OUT</td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">OPT OUT</span>
                </td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Yes</span>
                </td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(255, 255, 255, 0.05); color: var(--text-main); border: 1px solid var(--border-color); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">No</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        29 Aug 2026, 03:03 pm
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
    
    <!-- Table Footer (Bottom Pagination bar for exact visual match) -->
    <div style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
