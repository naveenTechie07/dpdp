// ==========================================
// STATUTORY RETENTION LIVE ENGINE CALCULATION
// ==========================================
let retentionDebounceTimer = null;

function triggerRetentionCalc() {
    clearTimeout(retentionDebounceTimer);
    retentionDebounceTimer = setTimeout(async () => {
        const sourceId = document.getElementById('ropaSourceId')?.value || '';
        const purpose = document.getElementById('ropaPurpose')?.value || '';
        const dataCategories = document.getElementById('ropaDataCategories')?.value || '';
        const piiList = dataCategories.split(/[,&/]/).map(s => s.trim()).filter(Boolean);

        try {
            const queryParams = new URLSearchParams({
                sourceId,
                purpose,
                piiCategories: piiList.join(',')
            });
            const res = await fetch(`/api/ropa/retention-recommendation?${queryParams.toString()}`);
            const data = await res.json();
            if (data.success && data.data) {
                const rec = data.data;
                const durationEl = document.getElementById('recommendedDurationText');
                const citationEl = document.getElementById('statutoryCitationText');
                const triggerEl = document.getElementById('statutoryTriggerText');
                const badgeEl = document.getElementById('retentionRuleBadge');
                const periodInput = document.getElementById('ropaRetentionPeriod');

                if (durationEl) durationEl.textContent = `${rec.retentionPeriodMonths} Months (${Math.round(rec.retentionPeriodMonths / 12)} Years)`;
                if (citationEl) citationEl.textContent = rec.statutoryReference;
                if (triggerEl) triggerEl.textContent = rec.triggerEvent;
                if (badgeEl) badgeEl.textContent = rec.matchedRule;
                if (periodInput && (!periodInput.value || periodInput.value === '36 Months' || periodInput.value === '24 Months' || periodInput.value === '84 Months')) {
                    periodInput.value = `${rec.retentionPeriodMonths} Months`;
                }
            }
        } catch (e) {
            console.warn('[ROPA] Failed to calculate retention:', e);
        }
    }, 250);
}

function handleSourceChange(siloId) {
    if (!siloId) return;
    const catInput = document.getElementById('ropaDataCategories');
    if (siloId.includes('WHATSAPP')) {
        catInput.value = 'Identity (Aadhaar), Contact (Mobile, Bengaluru Address), Clinical Health Diagnostics';
    } else if (siloId.includes('BILLING') || siloId.includes('EXCEL')) {
        catInput.value = 'Financial (GSTIN, PAN, Invoice Amount, Payment Mode, UPI ID), Contact (Phone)';
    } else if (siloId.includes('CLAIMS')) {
        catInput.value = 'Aadhaar UID, Policy Number, Claim Amount, ICD-10 Diagnosis, Doctor Prescriptions';
    } else if (siloId.includes('PDF')) {
        catInput.value = 'Aadhaar UID, Clinical Lab Reports, Blood Investigation Summary';
    }
    triggerRetentionCalc();
}

// Initial Graph Load
document.addEventListener('DOMContentLoaded', () => {
    loadAndRenderGraph();

    // 1. Text Search Filter
    const filterText = document.getElementById('filterText');
    if (filterText) {
        filterText.addEventListener('input', (e) => {
            const query = e.target.value.toLowerCase().trim();
            const rows = document.querySelectorAll('#ropaTableBody tr');
            rows.forEach(r => {
                const text = r.textContent.toLowerCase();
                r.style.display = text.includes(query) ? '' : 'none';
            });
        });
    }

    // 2. Status Filter
    const filterStatus = document.getElementById('filterStatus');
    if (filterStatus) {
        filterStatus.addEventListener('change', (e) => {
            const val = e.target.value.toLowerCase();
            const rows = document.querySelectorAll('#ropaTableBody tr');
            rows.forEach(r => {
                if (val === 'all') {
                    r.style.display = '';
                } else {
                    const statusBadge = r.querySelector('.badge-status');
                    const text = statusBadge ? statusBadge.textContent.toLowerCase() : '';
                    r.style.display = text.includes(val) ? '' : 'none';
                }
            });
        });
    }

    // 3. Create/Edit Form Submission
    const form = document.getElementById('ropaForm');
    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Saving...';

            const payload = {
                activityName: document.getElementById('ropaActivityName').value.trim(),
                dataCategories: document.getElementById('ropaDataCategories').value.trim(),
                purpose: document.getElementById('ropaPurpose').value.trim(),
                legalBasis: document.getElementById('ropaLegalBasis').value,
                retentionPeriod: document.getElementById('ropaRetentionPeriod').value.trim(),
                storageLocation: document.getElementById('ropaStorageLocation').value.trim(),
                securitySafeguards: document.getElementById('ropaSecuritySafeguards').value.trim()
            };

            try {
                const method = currentEditId ? 'PUT' : 'POST';
                const url = currentEditId ? '/api/ropa/' + currentEditId : '/api/ropa/create';
                const resp = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await resp.json();
                if (data.success) {
                    showToast(currentEditId ? 'RoPA record updated successfully!' : 'RoPA record created successfully!');
                    closeRoPAModal();
                    loadAndRenderGraph();
                    setTimeout(() => window.location.reload(), 700);
                } else {
                    alert('Failed: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
    }
});

function showToast(msg) {
    const toast = document.getElementById('ropaToast');
    const toastMsg = document.getElementById('ropaToastMsg');
    if (toast && toastMsg) {
        toastMsg.textContent = msg;
        toast.style.display = 'flex';
        setTimeout(() => { toast.style.display = 'none'; }, 4000);
    }
}

function openRoPAModal(activityName = '', dataCategories = '', purpose = '', legalBasis = 'Section 6 - Consent', retentionPeriod = '36 Months', storageLocation = '', securitySafeguards = '', id = '') {
    document.getElementById('ropaActivityName').value = activityName;
    document.getElementById('ropaDataCategories').value = dataCategories;
    document.getElementById('ropaPurpose').value = purpose;
    document.getElementById('ropaLegalBasis').value = legalBasis || 'Section 6 - Consent';
    document.getElementById('ropaRetentionPeriod').value = retentionPeriod || '36 Months';
    document.getElementById('ropaStorageLocation').value = storageLocation;
    document.getElementById('ropaSecuritySafeguards').value = securitySafeguards || 'Verhoeff tokenization, AES-256 local encryption, Zero Cloud Egress';
    currentEditId = id;
    document.getElementById('modalTitle').textContent = currentEditId ? 'Edit Processing Activity' : 'Create New Processing Activity';
    document.getElementById('ropaModal').style.display = 'flex';
    triggerRetentionCalc();
}

function closeRoPAModal() {
    document.getElementById('ropaModal').style.display = 'none';
    currentEditId = null;
    document.getElementById('ropaForm').reset();
}

function editRoPA(id, activityName, dataCategories, purpose, legalBasis, retentionPeriod, storageLocation, securitySafeguards) {
    openRoPAModal(activityName, dataCategories, purpose, legalBasis, retentionPeriod, storageLocation, securitySafeguards, id);
}

function deleteRoPA(id, name) {
    if (!confirm(`Are you sure you want to delete the statutory activity "${name}"? This will be recorded in the audit trail.`)) return;
    fetch('/api/ropa/' + id, { method: 'DELETE' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showToast(`Deleted activity '${name}' successfully.`);
                const row = document.getElementById('ropa-row-' + id);
                if (row) row.remove();
                loadAndRenderGraph();
            } else {
                alert('Failed to delete: ' + (data.error || 'Unknown error'));
            }
        })
        .catch(err => alert('Request failed: ' + err.message));
}

function syncRoPA() {
    const btn = document.getElementById('btnSyncRoPA');
    const originalText = btn ? btn.innerHTML : '';
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '⚡ Syncing from 7 Connectors...';
    }
    fetch('/api/ropa/generate', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                showToast(`RoPA synchronized! Found ${data.count || 6} statutory activities mapped to connectors.`);
                loadAndRenderGraph();
                setTimeout(() => window.location.reload(), 700);
            } else {
                alert('Sync failed: ' + (data.error || 'Unknown error'));
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
            }
        })
        .catch(err => {
            alert('Request failed: ' + err.message);
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        });
}

function getSiloIcon(type) {
    if (type.includes('RDBMS') || type.includes('CORE') || type.includes('DATABASE')) {
        return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#60a5fa" stroke-width="2"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>';
    }
    if (type.includes('CLOUD') || type.includes('OBJECT')) {
        return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#a78bfa" stroke-width="2"><path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"></path></svg>';
    }
    if (type.includes('PDF')) {
        return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#f87171" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>';
    }
    if (type.includes('SPREADSHEET') || type.includes('EXCEL') || type.includes('CSV')) {
        return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#34d399" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="3" y1="15" x2="21" y2="15"></line><line x1="9" y1="3" x2="9" y2="21"></line><line x1="15" y1="3" x2="15" y2="21"></line></svg>';
    }
    if (type.includes('CHAT') || type.includes('WHATSAPP')) {
        return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"></path></svg>';
    }
    return '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#94a3b8" stroke-width="2"><path d="M13 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"></path><polyline points="13 2 13 9 20 9"></polyline></svg>';
}

function getRiskBadge(risk) {
    const r = (risk || 'MEDIUM').toUpperCase();
    if (r === 'CRITICAL') return '<span class="badge" style="background: rgba(239, 68, 68, 0.2); color: #f87171; font-size: 9px; padding: 2px 6px;">CRITICAL</span>';
    if (r === 'HIGH') return '<span class="badge" style="background: rgba(245, 158, 11, 0.2); color: #fbbf24; font-size: 9px; padding: 2px 6px;">HIGH RISK</span>';
    if (r === 'LOW') return '<span class="badge" style="background: rgba(16, 185, 129, 0.2); color: #34d399; font-size: 9px; padding: 2px 6px;">LOW</span>';
    return '<span class="badge" style="background: rgba(99, 102, 241, 0.2); color: #818cf8; font-size: 9px; padding: 2px 6px;">MEDIUM</span>';
}

function mapSilosToRoPA(ropaId, activityName) {
    currentRoPAId = ropaId;
    document.getElementById('modalActivityName').textContent = 'Map Silos: ' + activityName;
    const siloList = document.getElementById('siloMappingList');
    siloList.innerHTML = '<div style="padding: 16px; text-align: center; color: var(--text-muted); font-size: 12px;">Loading informal repositories & enterprise connectors...</div>';

    const renderList = (silos) => {
        siloList.innerHTML = '';
        if (!silos || silos.length === 0) {
            siloList.innerHTML = '<div style="padding: 16px; text-align: center; color: var(--text-muted); font-size: 12px;">No silos discovered yet.</div>';
            return;
        }
        const mappedArray = currentRoPASiloMap[ropaId] || [];
        silos.forEach(silo => {
            const isChecked = mappedArray.includes(silo.id);
            const item = document.createElement('div');
            item.className = 'silo-item';
            item.style.cssText = `display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-radius: 6px; cursor: pointer; transition: background 0.15s ease; border: 1px solid ${isChecked ? 'rgba(99, 102, 241, 0.4)' : 'transparent'}; background: ${isChecked ? 'rgba(99, 102, 241, 0.12)' : 'rgba(255,255,255,0.02)'};`;
            
            item.innerHTML = `
                <input type="checkbox" value="${silo.id}" ${isChecked ? 'checked' : ''} style="cursor: pointer; width: 15px; height: 15px; accent-color: #6366f1;">
                <div style="display: flex; align-items: center; gap: 8px; flex: 1;">
                    <div style="width: 28px; height: 28px; border-radius: 6px; background: rgba(255,255,255,0.06); display: flex; align-items: center; justify-content: center;">
                        ${getSiloIcon(silo.siloType || '')}
                    </div>
                    <div>
                        <div style="font-size: 12px; font-weight: 600; color: #ffffff;">${silo.siloName || 'Unnamed Connector'}</div>
                        <div style="font-size: 10px; color: var(--text-muted); font-family: monospace;">${silo.filePath || silo.id}</div>
                    </div>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                    ${getRiskBadge(silo.riskLevel)}
                    <span style="font-size: 10px; color: var(--text-muted);">${silo.siloType || 'DATA_SILO'}</span>
                </div>
            `;

            item.addEventListener('click', (e) => {
                if (e.target.tagName !== 'INPUT') {
                    const cb = item.querySelector('input[type="checkbox"]');
                    cb.checked = !cb.checked;
                }
                const cb = item.querySelector('input[type="checkbox"]');
                item.style.background = cb.checked ? 'rgba(99, 102, 241, 0.12)' : 'rgba(255,255,255,0.02)';
                item.style.borderColor = cb.checked ? 'rgba(99, 102, 241, 0.4)' : 'transparent';
            });

            siloList.appendChild(item);
        });
    };

    if (availableSilosCache && availableSilosCache.length > 0) {
        renderList(availableSilosCache);
    } else {
        fetch('/api/silos')
            .then(res => res.json())
            .then(data => {
                if (data.success && data.data) {
                    availableSilosCache = data.data;
                    renderList(data.data);
                } else {
                    siloList.innerHTML = '<div style="padding: 16px; color: #ef4444; font-size: 12px;">Failed to load silos.</div>';
                }
            })
            .catch(err => {
                siloList.innerHTML = `<div style="padding: 16px; color: #ef4444; font-size: 12px;">Error: ${err.message}</div>`;
            });
    }

    document.getElementById('siloMappingModal').style.display = 'flex';
}

function closeSiloModal() {
    document.getElementById('siloMappingModal').style.display = 'none';
    currentRoPAId = null;
    const search = document.getElementById('siloSearchInput');
    if (search) search.value = '';
}

function toggleAllSilos(select) {
    const checkboxes = document.querySelectorAll('#siloMappingList input[type="checkbox"]');
    checkboxes.forEach(cb => {
        cb.checked = select;
        const item = cb.closest('.silo-item');
        if (item) {
            item.style.background = select ? 'rgba(99, 102, 241, 0.12)' : 'rgba(255,255,255,0.02)';
            item.style.borderColor = select ? 'rgba(99, 102, 241, 0.4)' : 'transparent';
        }
    });
}

function saveSiloMappings() {
    if (!currentRoPAId) return;
    const btn = document.getElementById('btnSaveSilos');
    const originalText = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const checkboxes = document.querySelectorAll('#siloMappingList input[type="checkbox"]:checked');
    const siloIds = Array.from(checkboxes).map(cb => cb.value);

    fetch(`/api/ropa/${currentRoPAId}/silos`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ siloIds })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            currentRoPASiloMap[currentRoPAId] = siloIds;
            const cell = document.getElementById('ropa-silos-' + currentRoPAId);
            if (cell) {
                if (data.silos && data.silos.length > 0) {
                    let badgesHtml = '<div style="display: flex; flex-wrap: wrap; gap: 4px;">';
                    data.silos.forEach(s => {
                        badgesHtml += `
                            <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3); padding: 3px 8px; border-radius: 6px; font-size: 10px; font-weight: 600; display: inline-flex; align-items: center; gap: 4px;" title="${s.siloType}: ${s.filePath || ''}">
                                <span style="width: 5px; height: 5px; border-radius: 50%; background: #818cf8;"></span>
                                ${s.siloName}
                            </span>
                        `;
                    });
                    badgesHtml += '</div>';
                    cell.innerHTML = badgesHtml;
                } else {
                    cell.innerHTML = '<span class="badge" style="background: rgba(148, 163, 184, 0.1); color: #94a3b8; padding: 4px 8px; border-radius: 6px; font-size: 10px;">No silos mapped</span>';
                }
            }

            closeSiloModal();
            showToast(`Mapped ${siloIds.length} silos to activity successfully.`);
            loadAndRenderGraph();
        } else {
            alert('Failed to save mappings: ' + (data.error || 'Unknown error'));
        }
    })
    .catch(err => {
        alert('Request failed: ' + err.message);
    })
    .finally(() => {
        btn.disabled = false;
        btn.textContent = originalText;
    });
}

// Close modals and inspector when clicking outside ("every where")
window.addEventListener('click', (e) => {
    const backdrop = document.getElementById('nodeInspectorBackdrop');
    if (e.target === backdrop) closeNodeInspector(e);

    const ropaModal = document.getElementById('ropaModal');
    if (e.target === ropaModal) closeRoPAModal();

    const siloModal = document.getElementById('siloMappingModal');
    if (e.target === siloModal) closeSiloModal();
});

// Click outside drawer dismisser
document.addEventListener('mousedown', (e) => {
    const drawer = document.getElementById('nodeInspectorDrawer');
    if (drawer && drawer.style.display === 'flex') {
        if (!drawer.contains(e.target) && !e.target.closest('.lineage-card')) {
            closeNodeInspector(e);
        }
    }
});

// Global Escape Key to close any open modal or drawer
window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' || e.keyCode === 27) {
        closeNodeInspector(e);
        closeRoPAModal();
        closeSiloModal();
    }
});
</script>

