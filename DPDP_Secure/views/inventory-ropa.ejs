                    <input type="text" id="ropaRetentionPeriod" class="form-input" style="width: 100%; padding: 10px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: rgba(255,255,255,0.05); color: #ffffff; font-size: 13px;" placeholder="e.g., 36 Months" value="36 Months">
