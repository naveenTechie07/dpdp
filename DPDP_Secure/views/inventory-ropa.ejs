<%- include('partials/header') %>

<!-- Top RoPA Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">STATUTORY ACTIVITIES</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= (typeof ropaRecords !== 'undefined' && ropaRecords) ? ropaRecords.length : 3 %> <span style="font-size: 12px; font-weight: 400; color: var(--success);">&#9679; Compliant</span></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">STATUTORY RETENTION BASIS</span>
            <h2 class="metric-value" style="margin-top: 8px; color: var(--primary);">CGST Sec 36 / DPDP</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">LAWFUL BASIS</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #34d399;">Section 6 Consent</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">SECURITY SAFEGUARDS</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #a5b4fc;">0 Cloud Egress</h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between;">
    <div class="title-group">
        <h1>Record of Processing Activities (RoPA)</h1>
        <p>Statutory Record of Processing Activities maintained under <strong>Section 8(4) of the DPDP Act, 2023</strong> read with Rule 6.</p>
    </div>
    <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <button class="btn-primary" style="padding: 8px 16px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="openRoPAModal()">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Activity
        </button>
        <button class="btn-secondary" style="background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="syncRoPA()">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></path><path d="M12 6v6l4 2"></path></svg>
            Sync from Silos
        </button>
        <a href="/api/ropa/export-csv" class="btn-secondary" style="background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px;">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            📊 Export CSV
        </a>
        <a href="/inventory/ropa/print" target="_blank" class="btn-primary" style="background: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px;">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 6 2 18 2 18 9"></polyline><rect x="6" y="14" width="12" height="8"></rect></svg>
            📄 Print Register
        </a>
    </div>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.1);">
        <div style="font-size: 13px; font-weight: 700; color: var(--text-main);">
            Section 8(4) Lawful Processing Registry &mdash; Aarogya Diagnostic Center
        </div>
        <div style="display: flex; gap: 8px;">
            <select id="filterStatus" class="form-select" style="padding: 6px 12px; border-radius: 6px; border: 1px solid var(--border-color); background: rgba(255,255,255,0.05); color: var(--text-main); font-size: 11px;">
                <option value="all">All Statuses</option>
                <option value="active">Active</option>
                <option value="inactive">Inactive</option>
                <option value="retired">Retired</option>
            </select>
            <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">
                Statutory Register Active
            </span>
        </div>
    </div>

    <!-- RoPA Data Table -->
    <div style="overflow-x: auto;">
        <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                    <th style="padding: 14px 20px; font-weight: 600; width: 22%;">Activity Name</th>
                    <th style="padding: 14px 20px; font-weight: 600; width: 24%;">Categories of Personal Data</th>
                    <th style="padding: 14px 20px; font-weight: 600; width: 16%;">Purpose</th>
                    <th style="padding: 14px 20px; font-weight: 600; width: 14%;">Legal Basis</th>
                    <th style="padding: 14px 20px; font-weight: 600; width: 12%;">Retention Period</th>
                    <th style="padding: 14px 20px; font-weight: 600; width: 10%;">Storage Location</th>
                    <th style="padding: 14px 20px; font-weight: 600; width: 10%;">Status</th>
                    <th style="padding: 14px 20px; font-weight: 600; width: 8%;">Status</th>
                <th style="padding: 14px 20px; font-weight: 600; width: 10%;">Mapped Silos</th>
                <th style="padding: 14px 20px; font-weight: 600; width: 12%;">Actions</th>
                </tr>
            </thead>
            <tbody id="ropaTableBody">
                <% if (typeof ropaRecords !== 'undefined' && ropaRecords && ropaRecords.length > 0) { %>
                    <% ropaRecords.forEach(function(r) { %>
                        <tr id="ropa-row-<%= r.id %>" style="border-bottom: 1px solid var(--border-color);">
                            <td style="padding: 14px 20px; font-weight: 600; color: var(--text-main);">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--primary);"></span>
                                    <%= r.activityName %>
                                </div>
                            </td>
                            <td style="padding: 14px 20px; color: var(--text-muted); font-size: 12px; line-height: 1.5;">
                                <%= r.dataCategories %>
                            </td>
                            <td style="padding: 14px 20px; font-size: 12px; color: var(--text-main);">
                                <%= r.purpose %>
                            </td>
                            <td style="padding: 14px 20px;">
                                <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 4px 8px; border-radius: 6px; font-size: 11px; font-weight: 600;">
                                    <%= r.legalBasis %>
                                </span>
                            </td>
                            <td style="padding: 14px 20px; font-size: 12px; color: var(--text-main);">
                                <div style="font-weight: 600;"><%= r.retentionPeriod %></div>
                                <div style="font-size: 11px; margin-top: 2px;"><%= r.storageLocation %></div>
                            </td>
                            <td style="padding: 14px 20px; font-size: 11px; color: var(--text-muted);">
                                <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; padding: 4px 8px; border-radius: 6px; font-size: 10px; font-weight: 600;">Active</span>
                            </td>
                            <td style="padding: 14px 20px; font-size: 11px; color: var(--text-muted);" id="ropa-silos-<%= r.id %>">
                                <span class="badge" style="background: rgba(99, 102, 241, 0.1); color: #6366f1; padding: 4px 8px; border-radius: 6px; font-size: 10px;">No silos mapped</span>
                            </td>
                            <td style="padding: 14px 20px; text-align: right;">
                                <div class="btn-group" style="display: flex; gap: 6px;">
                                    <button class="btn-sm btn-primary" onclick="editRoPA('<%= r.id %>', '<%= r.activityName.replace(/'/g, "\\'") %>', '<%= r.dataCategories.replace(/'/g, "\\'") %>', '<%= r.purpose.replace(/'/g, "\\'") %>', '<%= r.legalBasis.replace(/'/g, "\\'") %>', '<%= r.retentionPeriod.replace(/'/g, "\\'") %>', '<%= r.storageLocation.replace(/'/g, "\\'") %>', '<%= r.securitySafeguards.replace(/'/g, "\\'") %>')" title="Edit">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4"></path><polyline points="18 6 12 12 6 18"></polyline></svg>
                                    </button>
                                    <button class="btn-sm btn-secondary" onclick="mapSilosToRoPA('<%= r.id %>', '<%= r.activityName.replace(/'/g, "\\'") %>')" title="Map Silos">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2L3 14h9l-1 8 10-12h-4l14-8z"></path></svg>
                                    </button>
                                    <button class="btn-sm btn-danger" onclick="deleteRoPA('<%= r.id %>', '<%= r.activityName.replace(/'/g, "\\'") %>')" title="Delete">
                                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6h8a2 2 0 0 1 2 2h7a2 2 0 0 0 2-2v-4h2"></path></svg>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr style="border-bottom: 1px solid var(--border-color);">
                        <td colspan="9" style="padding: 40px 20px; text-align: center; color: var(--text-muted);">
                            <div style="display: flex; align-items: center; justify-content: center; gap: 8px;">
                                <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"></rect><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v5"></path><line x1="17" y1="11" x2="17" y2="13"></line><line x1="7" y1="11" x2="7" y2="13"></line></svg>
                                <span>No records found. Create your first processing activity.</span>
                            </div>
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Table Footer -->
    <div style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.15);">
        <span style="font-size: 12px; color: var(--text-muted);">
            Certified compliant under Section 8(4) & Rule 6 of the Digital Personal Data Protection Act, 2023.
        </span>
        <span style="font-size: 12px; color: var(--text-muted);">
            Data Protection Officer: <strong>Dr. Ananya Sen (dpo@aarogyaclinic.in)</strong>
        </span>
    </div>
</div>

<!-- Create/Edit RoPA Modal -->
<div id="ropaModal" class="modal-overlay" style="display: none;">
    <div class="modal-content" style="max-width: 600px; width: 90%;">
        <div class="modal-header">
            <h3 id="modalTitle">Create New Processing Activity</h3>
            <button class="btn-close" onclick="closeRoPAModal()" style="background: none; border: none; font-size: 20px; color: var(--text-muted); cursor: pointer;">&times;</button>
        </div>
        <form id="ropaForm" style="padding: 20px;">
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Activity Name <span style="color: var(--red);">*</span></label>
                <input type="text" id="ropaActivityName" class="form-input" placeholder="e.g., Patient Booking via WhatsApp" required>
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Categories of Personal Data</label>
                <input type="text" id="ropaDataCategories" class="form-input" placeholder="e.g., Name, Phone, Aadhaar, Medical History">
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Purpose of Processing <span style="color: var(--red);">*</span></label>
                <input type="text" id="ropaPurpose" class="form-input" placeholder="e.g., Patient registration for diagnostics" required>
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Legal Basis</label>
                <select id="ropaLegalBasis" class="form-select">
                    <option value="Section 6 - Consent">Section 6 - Consent</option>
                    <option value="Section 4 - Lawful Purpose">Section 4 - Lawful Purpose</option>
                    <option value="Section 8(7) - Legal Obligation">Section 8(7) - Legal Obligation</option>
                    <option value="Section 7 - Legitimate Interests">Section 7 - Legitimate Interests</option>
                </select>
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Retention Period</label>
                <input type="text" id="ropaRetentionPeriod" class="form-input" placeholder="e.g., 3 Years for clinical records" value="3 Years">
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Storage Location</label>
                <input type="text" id="ropaStorageLocation" class="form-input" placeholder="e.g., Local server / Billing software">
            </div>
            <div class="form-group" style="margin-bottom: 16px;">
                <label class="form-label">Security Safeguards</label>
                <input type="text" id="ropaSecuritySafeguards" class="form-input" placeholder="e.g., Encryption, Access controls, Audit logs">
            </div>
            <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                <button type="button" class="btn-secondary" onclick="closeRoPAModal()" style="padding: 10px 20px;">Cancel</button>
                <button type="submit" class="btn-primary" style="padding: 10px 24px; font-weight: 600;">Save Record</button>
            </div>
        </form>
    </div>
</div>

<script>
let currentEditId = null;
let currentRoPAId = null;
let currentRoPASiloMap = {}; // Maps ropaId -> array of siloIds

document.addEventListener('DOMContentLoaded', () => {
    const btnResynthesize = document.getElementById('btnResynthesizeRoPA');
    if (btnResynthesize) {
        btnResynthesize.addEventListener('click', async () => {
            btnResynthesize.disabled = true;
            btnResynthesize.textContent = 'Synthesizing...';
            try {
                const resp = await fetch('/api/ropa/generate', { method: 'POST' });
                const data = await resp.json();
                if (data.success) {
                    alert('RoPA successfully synthesized from all discovered informal silos!');
                    window.location.reload();
                } else {
                    alert('Synthesis failed: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            } finally {
                btnResynthesize.disabled = false;
                btnResynthesize.textContent = 'Re-Synthesize RoPA';
            }
        });
    }

    const form = document.getElementById('ropaForm');
    if (form) {
        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            const originalText = btn.textContent;
            btn.disabled = true;
            btn.textContent = 'Saving...';

            const payload = {
                activityName: document.getElementById('ropaActivityName').value,
                dataCategories: document.getElementById('ropaDataCategories').value,
                purpose: document.getElementById('ropaPurpose').value,
                legalBasis: document.getElementById('ropaLegalBasis').value,
                retentionPeriod: document.getElementById('ropaRetentionPeriod').value,
                storageLocation: document.getElementById('ropaStorageLocation').value,
                securitySafeguards: document.getElementById('ropaSecuritySafeguards').value
            };

            try {
                const method = currentEditId ? 'PUT' : 'POST';
                const url = currentEditId ? '/api/ropa/' + currentEditId : '/api/ropa/create';
                const resp = await fetch(url, {
                    method,
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const data = await resp.json();
                if (data.success) {
                    alert(currentEditId ? 'RoPA record updated successfully!' : 'RoPA record created successfully!');
                    window.location.reload();
                } else {
                    alert('Failed: ' + (data.error || 'Unknown error'));
                }
            } catch (err) {
                alert('Request failed: ' + err.message);
            } finally {
                btn.disabled = false;
                btn.textContent = originalText;
            }
        });
    }
});

function openRoPAModal(activityName = '', dataCategories = '', purpose = '', legalBasis = '', retentionPeriod = '', storageLocation = '', securitySafeguards = '', id = '') {
    document.getElementById('ropaActivityName').value = activityName;
    document.getElementById('ropaDataCategories').value = dataCategories;
    document.getElementById('ropaPurpose').value = purpose;
    document.getElementById('ropaLegalBasis').value = legalBasis;
    document.getElementById('ropaRetentionPeriod').value = retentionPeriod;
    document.getElementById('ropaStorageLocation').value = storageLocation;
    document.getElementById('ropaSecuritySafeguards').value = securitySafeguards;
    currentEditId = id;
    document.getElementById('modalTitle').textContent = currentEditId ? 'Edit Processing Activity' : 'Create New Processing Activity';
    document.getElementById('ropaModal').style.display = 'block';
}

function closeRoPAModal() {
    document.getElementById('ropaModal').style.display = 'none';
    currentEditId = null;
    document.getElementById('ropaForm').reset();
}

function editRoPA(id, activityName, dataCategories, purpose, legalBasis, retentionPeriod, storageLocation, securitySafeguards) {
    openRoPAModal(activityName, dataCategories, purpose, legalBasis, retentionPeriod, storageLocation, securitySafeguards, id);
}

function deleteRoPA(id, name) {
    if (!confirm(`Are you sure you want to delete the activity "${name}"? This cannot be undone.`)) return;
    fetch('/api/ropa/' + id, { method: 'DELETE' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert('RoPA record deleted successfully!');
                window.location.reload();
            } else {
                alert('Failed: ' + (data.error || 'Unknown error'));
            }
        })
        .catch(err => alert('Request failed: ' + err.message));
}

function syncRoPA() {
    fetch('/api/ropa/generate', { method: 'POST' })
        .then(r => r.json())
        .then(data => {
            if (data.success) {
                alert('RoPA synthesized successfully! Found ' + data.count + ' processing activities.');
                window.location.reload();
            } else {
                alert('Failed: ' + (data.error || 'Unknown error'));
            }
        })
        .catch(err => alert('Request failed: ' + err.message));
}

// Close modal when clicking outside
window.addEventListener('click', (e) => {
    const modal = document.getElementById('ropaModal');
    if (e.target === modal) closeRoPAModal();
    const siloModal = document.getElementById('siloMappingModal');
    if (e.target === siloModal) closeSiloModal();
});

function mapSilosToRoPA(ropaId, activityName) {
    currentRoPAId = ropaId;
    document.getElementById('modalActivityName').textContent = activityName;
    
    // Fetch silos
    fetch('/api/silos')
        .then(res => res.json())
        .then(data => {
            if (data.success) {
                const siloList = document.getElementById('siloMappingList');
                siloList.innerHTML = '';
                data.data.forEach(silo => {
                    const isAlreadyMapped = currentRoPASiloMap[ropaId] && currentRoPASiloMap[ropaId].includes(silo.id);
                    const checkbox = document.createElement('div');
                    checkbox.className = 'silo-checkbox';
                    checkbox.innerHTML = `
                        <label style="display: flex; align-items: center; cursor: pointer; padding: 8px; border-radius: 6px; ${isAlreadyMapped ? 'background: rgba(99, 102, 241, 0.1);' : ''}">
                            <input type="checkbox" value="${silo.id}" ${isAlreadyMapped ? 'checked' : ''} style="margin-right: 8px;">
                            <span>${silo.siloName || silo.name || 'Unnamed Silo'}</span>
                            <span style="font-size: 10px; color: var(--text-muted); margin-left: auto;">${silo.siloType || 'Unknown'}</span>
                        </label>
                    `;
                    siloList.appendChild(checkbox);
                });
            }
        })
        .catch(err => console.error('Failed to fetch silos:', err));

    document.getElementById('siloMappingModal').style.display = 'block';
}

function closeSiloModal() {
    document.getElementById('siloMappingModal').style.display = 'none';
    currentRoPAId = null;
}

function saveSiloMappings() {
    if (!currentRoPAId) return;
    
    const checkboxes = document.querySelectorAll('#siloMappingList input[type="checkbox"]:checked');
    const siloIds = Array.from(checkboxes).map(cb => cb.value);
    
    // First remove all existing mappings for this RoPA
    fetch(`/api/ropa/${currentRoPAId}/silos`, {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' }
    }).then(() => {
        // Then add selected ones
        if (siloIds.length > 0) {
            return Promise.all(siloIds.map(siloId =>
                fetch('/api/ropa/' + currentRoPAId + '/silos', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ siloId })
                })
            ));
        }
    }).then(results => {
        closeSiloModal();
        alert('Silo mappings updated successfully!');
        window.location.reload();
    }).catch(err => {
        alert('Request failed: ' + err.message);
    });
}
</script>

<!-- Silo Mapping Modal -->
<div id="siloMappingModal" class="modal-overlay" style="display: none;">
    <div class="modal-content" style="max-width: 500px; width: 90%;">
        <div class="modal-header">
            <h3 id="modalActivityName">Map Silos to Activity</h3>
            <button class="btn-close" onclick="closeSiloModal()" style="background: none; border: none; font-size: 20px; color: var(--text-muted); cursor: pointer;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 20px;">
            <div style="margin-bottom: 16px;">
                <label class="form-label">Select informal systems to map to this activity:</label>
            </div>
            <div id="siloMappingList" style="max-height: 300px; overflow-y: auto; border: 1px solid var(--border-color); border-radius: 8px; padding: 10px; background: rgba(255,255,255,0.03);">
                <!-- Silos will be populated here -->
            </div>
        </div>
        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
            <button type="button" class="btn-secondary" onclick="closeSiloModal()" style="padding: 10px 20px;">Cancel</button>
            <button type="button" class="btn-primary" onclick="saveSiloMappings()" style="padding: 10px 24px; font-weight: 600;">Save Mappings</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>