<%- include('partials/header') %>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">TOTAL ACTIVITIES</span>
            <h2 class="metric-value" style="margin-top: 8px;">3</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">ACTIVE</span>
            <h2 class="metric-value" style="margin-top: 8px;">3</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">DPIA REQUIRED</span>
            <h2 class="metric-value" style="margin-top: 8px;">1</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">CONSENT-BASED</span>
            <h2 class="metric-value" style="margin-top: 8px;">2</h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Processing Activities (RoPA)</h1>
        <p>Record of Processing Activities as required by GDPR Art. 30 &mdash; legal basis, data assets, and DPIA status.</p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button class="btn-secondary" style="background: rgba(255,255,255,0.05); color: var(--text-main); border: 1px solid var(--border-color); padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
            Export Full RoPA
        </button>
        <button class="btn-primary" style="background-color: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            New Activity
        </button>
    </div>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search activities..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 12px 24px; font-weight: 600;">Activity &#9652;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Business Function &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Legal Basis &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">DPIA</th>
                <th style="padding: 12px 24px; font-weight: 600;">Linked<br>Assets</th>
                <th style="padding: 12px 24px; font-weight: 600;">Status &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Organization</th>
                <th style="padding: 12px 24px; font-weight: 600;"></th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <!-- Row 1 -->
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); width: 25%;">BNPL Underwriting & Risk Assessment</td>
                <td style="padding: 16px 24px; color: var(--text-muted);">Credit Operations</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: #bbf7d0; color: #166534; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;">consent</span></td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: #fef08a; color: #854d0e; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;">Required</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">0</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">Tenant-wide</td>
                <td style="padding: 16px 24px; display: flex; gap: 12px; align-items: center; justify-content: flex-end;">
                    <a href="#" style="color: #8b5cf6; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 4px; text-decoration: none;">
                        <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        View
                    </a>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </td>
            </tr>
            <!-- Row 2 -->
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); width: 25%;">KYC Verification & Credit Bureau Reporting</td>
                <td style="padding: 16px 24px; color: var(--text-muted);">Compliance</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-main); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600; display: inline-block; text-align: center;">legal<br>obligation</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 24px; color: var(--text-muted);">0</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">Tenant-wide</td>
                <td style="padding: 16px 24px; display: flex; gap: 12px; align-items: center; justify-content: flex-end;">
                    <a href="#" style="color: #8b5cf6; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 4px; text-decoration: none;">
                        <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        View
                    </a>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </td>
            </tr>
            <!-- Row 3 -->
            <tr>
                <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); width: 25%;">Product Feedback & Survey Collection</td>
                <td style="padding: 16px 24px; color: var(--text-muted);">Customer<br>Experience</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: #bbf7d0; color: #166534; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;">consent</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 24px; color: var(--text-muted);">0</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; justify-content: space-between; background: rgba(255,255,255,0.05); padding: 4px 12px; border-radius: 6px;">
                        <span>DPDP_Secure Mumbai HQ</span>
                        <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                </td>
                <td style="padding: 16px 24px; display: flex; gap: 12px; align-items: center; justify-content: flex-end;">
                    <a href="#" style="color: #8b5cf6; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 4px; text-decoration: none;">
                        <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        View
                    </a>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="7 10 12 15 17 10"></polyline><line x1="12" y1="15" x2="12" y2="3"></line></svg>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                </td>
            </tr>
        </tbody>
    </table>
    
    <!-- Table Footer -->
    <div class="table-toolbar" style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
