            card.style.transform = 'translateY(-2px) scale(1.02)';
            card.style.boxShadow = '0 8px 24px rgba(0,0,0,0.12)';
        });
        card.addEventListener('mouseleave', () => {
            card.style.transform = 'none';
            card.style.boxShadow = '0 2px 8px rgba(0,0,0,0.06)';
        });

        // Click to Open Inspector
        card.addEventListener('click', (e) => {
            if (e && e.stopPropagation) e.stopPropagation();
            openNodeInspector(node);
        });

        container.appendChild(card);

        // Store bounding rect for edge connections
        nodeRects[node.id] = {
            x: node.position.x,
            y: node.position.y,
            w: cardWidth,
            h: card.offsetHeight || 90
        };
    });

    // 2. Render SVG Bezier Edges
    setTimeout(() => {
        // Re-read heights after DOM layout
        Object.keys(nodeRects).forEach(id => {
            const el = document.getElementById(`node-el-${id}`);
            if (el) {
                nodeRects[id].h = el.offsetHeight;
            }
        });

        edges.forEach(edge => {
            const src = nodeRects[edge.source];
            const tgt = nodeRects[edge.target];
            if (!src || !tgt) return;

            // Start point: right center of source
            const x1 = src.x + src.w;
            const y1 = src.y + (src.h / 2);

            // End point: left center of target
            const x2 = tgt.x;
            const y2 = tgt.y + (tgt.h / 2);

            // Cubic Bezier curve control points
            const dx = Math.max(35, (x2 - x1) * 0.45);
            const cx1 = x1 + dx;
            const cy1 = y1;
            const cx2 = x2 - dx;
            const cy2 = y2;

            const pathData = `M ${x1} ${y1} C ${cx1} ${cy1}, ${cx2} ${cy2}, ${x2} ${y2}`;

            let edgeClass = 'flow-edge-blue';
            if (edge.style?.stroke === '#8b5cf6') edgeClass = 'flow-edge-purple';
            if (edge.style?.stroke === '#10b981') edgeClass = 'flow-edge-emerald';
            if (edge.style?.stroke === '#f43f5e') edgeClass = 'flow-edge-rose';

            const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
            path.setAttribute('d', pathData);
            path.setAttribute('class', edgeClass);
            edgesGroup.appendChild(path);
        });
    }, 50);
}

// ==========================================
// CANVAS PAN & ZOOM INTERACTIVITY
// ==========================================
function updateCanvasTransform() {
    const stage = document.getElementById('lineageGraphStage');
    if (stage) {
        stage.style.transform = `translate(${canvasPanX}px, ${canvasPanY}px) scale(${canvasScale})`;
    }
}

function zoomCanvas(factor) {
    canvasScale = Math.min(Math.max(canvasScale * factor, 0.4), 2.2);
    updateCanvasTransform();
}

function resetCanvasZoom() {
    canvasScale = 1.0;
    canvasPanX = 15;
    canvasPanY = 15;
    updateCanvasTransform();
}

// Drag to Pan
const viewport = document.getElementById('lineageCanvasViewport');
if (viewport) {
    viewport.addEventListener('mousedown', (e) => {
        if (e.target.closest('.lineage-card') || e.target.closest('button')) return;
        isPanning = true;
        startPanX = e.clientX - canvasPanX;
        startPanY = e.clientY - canvasPanY;
        viewport.style.cursor = 'grabbing';
    });

    window.addEventListener('mousemove', (e) => {
        if (!isPanning) return;
        canvasPanX = e.clientX - startPanX;
        canvasPanY = e.clientY - startPanY;
        updateCanvasTransform();
    });

    window.addEventListener('mouseup', () => {
        isPanning = false;
        if (viewport) viewport.style.cursor = 'grab';
    });

    // Wheel to Zoom
    viewport.addEventListener('wheel', (e) => {
        e.preventDefault();
        const factor = e.deltaY < 0 ? 1.08 : 0.92;
        zoomCanvas(factor);
    }, { passive: false });
}

