<script>
let currentEditId = null;
let currentRoPAId = null;
let currentRoPASiloMap = <%- JSON.stringify(typeof currentRoPASiloMap !== 'undefined' ? currentRoPASiloMap : {}) %>;
let availableSilosCache = <%- JSON.stringify(typeof silos !== 'undefined' ? silos : []) %>;

// Canvas Pan & Zoom State
let canvasScale = 1.0;
let canvasPanX = 10;
let canvasPanY = 10;
let isPanning = false;
let startPanX = 0;
let startPanY = 0;
let graphDataCache = null;

// ==========================================
// VIEW SWITCHING (GRAPH <-> TABLE)
// ==========================================
function switchView(viewName) {
    const graphView = document.getElementById('ropaGraphView');
    const tableView = document.getElementById('ropaTableView');
    const btnGraph = document.getElementById('btnViewGraph');
    const btnTable = document.getElementById('btnViewTable');

    if (viewName === 'graph') {
        graphView.style.display = 'block';
        tableView.style.display = 'none';
        btnGraph.style.background = '#3b82f6';
        btnGraph.style.color = '#ffffff';
        btnGraph.classList.add('active');
        btnTable.style.background = 'transparent';
        btnTable.style.color = 'var(--text-muted)';
        btnTable.classList.remove('active');
        if (!graphDataCache) loadAndRenderGraph();
    } else {
        graphView.style.display = 'none';
        tableView.style.display = 'block';
        btnTable.style.background = '#3b82f6';
        btnTable.style.color = '#ffffff';
        btnTable.classList.add('active');
        btnGraph.style.background = 'transparent';
        btnGraph.style.color = 'var(--text-muted)';
        btnGraph.classList.remove('active');
    }
}

// ==========================================
// LOAD & RENDER LINEAGE & FLOW ARCHITECTURE
// ==========================================
async function loadAndRenderGraph() {
    const container = document.getElementById('lineageNodesContainer');
    const edgesGroup = document.getElementById('lineageEdgesGroup');
    if (!container || !edgesGroup) return;

    container.innerHTML = '<div style="padding: 40px; text-align: center; color: #64748b; font-size: 13px;">Synthesizing relationship graph from live SQLite findings...</div>';
    edgesGroup.innerHTML = '';

    try {
        const resp = await fetch('/api/ropa/graph');
        const data = await resp.json();
        if (!data.success) throw new Error(data.error || 'Failed to load graph data');

        graphDataCache = data;
        renderGraphNodes(data.nodes, data.edges);
    } catch (err) {
        container.innerHTML = `<div style="padding: 40px; text-align: center; color: #ef4444; font-size: 13px;">Failed to load Lineage Graph: ${err.message}</div>`;
    }
}

function renderGraphNodes(nodes, edges) {
    const container = document.getElementById('lineageNodesContainer');
    const edgesGroup = document.getElementById('lineageEdgesGroup');
    container.innerHTML = '';
    edgesGroup.innerHTML = '';

    if (!nodes || nodes.length === 0) {
        container.innerHTML = '<div style="padding: 40px; text-align: center; color: #64748b; font-size: 13px;">No data lineage nodes detected. Click Sync Connectors above.</div>';
        return;
    }

    const nodeRects = {};

    // 1. Render HTML Cards
    nodes.forEach(node => {
        const card = document.createElement('div');
        card.id = `node-el-${node.id}`;
        card.className = `lineage-card node-type-${node.type}`;
        
        let cardStyles = `position: absolute; left: ${node.position.x}px; top: ${node.position.y}px; border-radius: 8px; padding: 10px 14px; font-size: 11px; cursor: pointer; transition: all 0.15s ease; box-shadow: 0 2px 8px rgba(0,0,0,0.06);`;
        let innerHtml = '';
        let cardWidth = 200;

        if (node.type === 'dataSourceNode') {
            cardWidth = 200;
            cardStyles += `width: ${cardWidth}px; background: #eef2ff; border: 1.5px solid #818cf8; color: #1e1b4b;`;
            innerHtml = `
                <!-- Port Circle Right -->
                <div class="port-handle port-right" style="position: absolute; right: -6px; top: 50%; transform: translateY(-50%); width: 10px; height: 10px; border-radius: 50%; background: #4f46e5; border: 2px solid #ffffff; box-shadow: 0 0 0 1px #818cf8;"></div>

                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
                    <span style="font-size: 9px; font-weight: 800; background: #4338ca; color: #ffffff; padding: 2px 6px; border-radius: 4px; letter-spacing: 0.5px; text-transform: uppercase;">DATA SOURCE</span>
                </div>
                <div style="font-weight: 800; font-size: 12px; color: #0f172a; margin-bottom: 6px; word-break: break-word; line-height: 1.3;">
                    ${node.data.label}
                </div>
                <div style="display: flex; align-items: center; justify-content: space-between; font-size: 10px; color: #475569;">
                    <span>Type: ${node.data.sourceType || 'FILE'}</span>
                    <span style="background: #e0e7ff; color: #3730a3; padding: 1px 6px; border-radius: 4px; font-weight: 700;">${node.data.findingsCount} PII findings</span>
                </div>
            `;
        } else if (node.type === 'dataElementNode') {
            cardWidth = 190;
            cardStyles += `width: ${cardWidth}px; background: #fffbeb; border: 1.5px solid #f59e0b; color: #78350f;`;
            innerHtml = `
                <!-- Port Circles Left & Right -->
                <div class="port-handle port-left" style="position: absolute; left: -6px; top: 50%; transform: translateY(-50%); width: 10px; height: 10px; border-radius: 50%; background: #f59e0b; border: 2px solid #ffffff; box-shadow: 0 0 0 1px #f59e0b;"></div>
