<%- include('partials/header') %>
<%
  const safeRoles = (typeof roles !== 'undefined' && Array.isArray(roles)) ? roles : [];
%>

<style>
.rbac-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 24px;
}
.rbac-toolbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 24px;
    border-bottom: 1px solid var(--border-color);
}
.search-users {
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--border-color);
    color: white;
    padding: 8px 12px;
    border-radius: 6px;
    font-size: 13px;
    width: 250px;
}
.rbac-table {
    width: 100%;
    border-collapse: collapse;
}
.rbac-table th {
    text-align: left;
    padding: 12px 20px;
    font-size: 11px;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
    border-bottom: 1px solid var(--border-color);
}
.rbac-table td {
    padding: 14px 20px;
    font-size: 13px;
    color: white;
    border-bottom: 1px solid rgba(255,255,255,0.05);
}
.rbac-table tr:hover {
    background: rgba(255,255,255,0.02);
}
.role-pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 11px;
    background: rgba(59, 130, 246, 0.15);
    color: #93c5fd;
    border: 1px solid rgba(59, 130, 246, 0.25);
    margin: 2px 2px;
}
.btn-outline {
    background: transparent;
    border: 1px solid var(--border-color);
    color: white;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-outline:hover {
    background: rgba(255,255,255,0.05);
}
.btn-primary {
    background: #3b82f6;
    border: 1px solid #2563eb;
    color: white;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 13px;
    font-weight: 600;
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    transition: all 0.2s;
}
.btn-primary:hover {
    background: #2563eb;
}

/* Modal Styles */
.modal-overlay {
    position: fixed;
    top: 0; right: 0; bottom: 0; left: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(3px);
    z-index: 1000;
    display: none;
    align-items: center;
    justify-content: center;
}
.modal-overlay.active {
    display: flex;
}
.modal-content {
    background: #111827;
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 540px;
    max-width: 90vw;
    overflow: hidden;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
}
.modal-header {
    background: rgba(255,255,255,0.05);
    padding: 16px 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
}
.modal-title {
    font-size: 16px;
    font-weight: 700;
    color: white;
    margin: 0;
}
.modal-close {
    width: 28px; height: 28px;
    background: rgba(255,255,255,0.1);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    color: white; cursor: pointer; border: none;
}
.modal-body {
    padding: 24px;
}
.form-group {
    margin-bottom: 16px;
}
.form-label {
    display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 8px;
}
.form-input {
    width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: white; padding: 10px 12px; border-radius: 6px; font-size: 13px; box-sizing: border-box;
}
.action-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: white;
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 12px;
    cursor: pointer;
    transition: all 0.2s;
}
.action-btn:hover {
    background: rgba(255,255,255,0.1);
}
.action-btn.del {
    color: #fca5a5;
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
}
.action-btn.del:hover {
    background: rgba(239, 68, 68, 0.2);
}
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: white; margin: 0 0 6px 0;">Roles &amp; Access Permissions (RBAC)</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Enforce DPDP Act Section 8(5) least-privilege security controls across clinic operators, clinicians, and auditors.</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn-primary" onclick="openAddRoleModal()">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Create Role
            </button>
        </div>
    </div>

    <!-- Active Roles Table -->
    <div class="rbac-card">
        <div class="rbac-toolbar">
            <h2 style="font-size: 15px; font-weight: 700; color: white; margin: 0;">Defined Tenant Roles</h2>
            <input type="text" class="search-users" placeholder="Search roles..." oninput="filterRoles(this.value)">
        </div>
        
        <table class="rbac-table">
            <thead>
                <tr>
                    <th>Role Name</th>
                    <th>Permissions Granted</th>
                    <th>Type</th>
                    <th>Created</th>
                    <th style="text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody id="rolesTableBody">
                <% if (safeRoles.length === 0) { %>
                    <tr>
                        <td colspan="5" style="padding: 32px; text-align: center; color: var(--text-muted);">
                            No custom roles found.
                        </td>
                    </tr>
                <% } else { %>
                    <% safeRoles.forEach(r => { %>
                        <tr class="role-row" id="row-role-<%= r.id %>">
                            <td style="font-weight: 600; color: white;">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span style="display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: #3b82f6;"></span>
                                    <%= r.roleName %>
                                </div>
                            </td>
                            <td>
                                <div style="display: flex; flex-wrap: wrap; gap: 4px;">
                                    <% (r.permissions ? r.permissions.split(',') : []).forEach(p => { %>
                                        <span class="role-pill"><%= p.trim() %></span>
                                    <% }) %>
                                </div>
                            </td>
                            <td>
                                <% if (r.isSystem) { %>
                                    <span style="font-size: 11px; padding: 2px 8px; border-radius: 12px; background: rgba(16, 185, 129, 0.2); color: #34d399; font-weight: 600;">System Protected</span>
                                <% } else { %>
                                    <span style="font-size: 11px; padding: 2px 8px; border-radius: 12px; background: rgba(255, 255, 255, 0.08); color: var(--text-muted);">Custom Role</span>
                                <% } %>
                            </td>
                            <td style="color: var(--text-muted); font-size: 12px;">
                                <%= r.createdAt ? new Date(r.createdAt).toLocaleDateString() : 'Active' %>
                            </td>
                            <td style="text-align: right;">
                                <% if (!r.isSystem) { %>
                                    <button class="action-btn del" onclick="deleteRole('<%= r.id %>', '<%= r.roleName %>')">Delete</button>
                                <% } else { %>
                                    <span style="font-size: 11px; color: var(--text-muted);">&mdash;</span>
                                <% } %>
                            </td>
                        </tr>
                    <% }) %>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- User Assignments Table -->
    <div class="rbac-card">
        <div class="rbac-toolbar">
            <h2 style="font-size: 15px; font-weight: 700; color: white; margin: 0;">Clinic User Role Bindings</h2>
            <div style="font-size: 12px; color: var(--text-muted);">4 Active Clinic Staff</div>
        </div>
        
        <table class="rbac-table">
            <thead>
                <tr>
                    <th>User &amp; Email</th>
                    <th>Designated Title</th>
                    <th>Bound Role</th>
                    <th>Org Unit</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>
                        <div style="font-weight: 600; color: white;">Ramesh Kumar</div>
                        <div style="font-size: 11px; color: var(--text-muted);">ramesh@aarogyaclinic.in</div>
                    </td>
                    <td>SME Owner &amp; Managing Director</td>
                    <td><span class="role-pill" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border-color: rgba(16, 185, 129, 0.3);">SME Owner &amp; Data Protection Officer</span></td>
                    <td style="color: var(--text-muted);">Indiranagar HQ</td>
                    <td><span style="font-size: 11px; color: #34d399; font-weight: 600;">Active</span></td>
                </tr>
                <tr>
                    <td>
                        <div style="font-weight: 600; color: white;">Deepa Nair</div>
                        <div style="font-size: 11px; color: var(--text-muted);">reception@aarogyaclinic.in</div>
                    </td>
                    <td>Frontdesk Receptionist</td>
                    <td><span class="role-pill">Clinic Receptionist</span></td>
                    <td style="color: var(--text-muted);">Indiranagar HQ</td>
                    <td><span style="font-size: 11px; color: #34d399; font-weight: 600;">Active</span></td>
                </tr>
                <tr>
                    <td>
                        <div style="font-weight: 600; color: white;">Dr. Anita K.</div>
                        <div style="font-size: 11px; color: var(--text-muted);">dr.anita@aarogyaclinic.in</div>
                    </td>
                    <td>Consultant Radiologist</td>
                    <td><span class="role-pill">Clinic Receptionist</span></td>
                    <td style="color: var(--text-muted);">HAL Collection Silo</td>
                    <td><span style="font-size: 11px; color: #34d399; font-weight: 600;">Active</span></td>
                </tr>
                <tr>
                    <td>
                        <div style="font-weight: 600; color: white;">NABL Auditor Guest</div>
                        <div style="font-size: 11px; color: var(--text-muted);">auditor@dpdpsecure.in</div>
                    </td>
                    <td>Accreditation Auditor</td>
                    <td><span class="role-pill" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border-color: rgba(245, 158, 11, 0.3);">External DPDP Compliance Auditor</span></td>
                    <td style="color: var(--text-muted);">External Auditor</td>
                    <td><span style="font-size: 11px; color: #fbbf24; font-weight: 600;">Read-Only Audit</span></td>
                </tr>
            </tbody>
        </table>
    </div>

</div>

<!-- Create Role Modal -->
<div class="modal-overlay" id="addRoleModal" onclick="if(event.target===this) closeAddRoleModal()">
    <div class="modal-content">
        <div class="modal-header">
            <h2 class="modal-title">Create New Role</h2>
            <button class="modal-close" onclick="closeAddRoleModal()">
                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>
        <div class="modal-body">
            <form id="createRoleForm" onsubmit="handleCreateRole(event)">
                <div class="form-group">
                    <label class="form-label">Role Title <span style="color: #ef4444;">*</span></label>
                    <input type="text" id="newRoleName" class="form-input" placeholder="e.g. Senior Pathology Technician" required>
                </div>

                <div class="form-group">
                    <label class="form-label">Grant Permissions <span style="color: #ef4444;">*</span></label>
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 14px;">
                        <label style="display: flex; gap: 8px; font-size: 12px; color: white; cursor: pointer;">
                            <input type="checkbox" name="rolePerm" value="discovery:scan" checked> discovery:scan
                        </label>
                        <label style="display: flex; gap: 8px; font-size: 12px; color: white; cursor: pointer;">
                            <input type="checkbox" name="rolePerm" value="consent:capture" checked> consent:capture
                        </label>
                        <label style="display: flex; gap: 8px; font-size: 12px; color: white; cursor: pointer;">
                            <input type="checkbox" name="rolePerm" value="dsr:intake"> dsr:intake
                        </label>
                        <label style="display: flex; gap: 8px; font-size: 12px; color: white; cursor: pointer;">
                            <input type="checkbox" name="rolePerm" value="dsr:approve"> dsr:approve
                        </label>
                        <label style="display: flex; gap: 8px; font-size: 12px; color: white; cursor: pointer;">
                            <input type="checkbox" name="rolePerm" value="audit:read" checked> audit:read
                        </label>
                        <label style="display: flex; gap: 8px; font-size: 12px; color: white; cursor: pointer;">
                            <input type="checkbox" name="rolePerm" value="taxlock:override"> taxlock:override
                        </label>
                    </div>
                </div>

                <div style="display: flex; gap: 12px; margin-top: 24px;">
                    <button type="submit" id="btnSubmitRole" class="btn-primary" style="flex: 1; padding: 10px; justify-content: center;">
                        Save Role
                    </button>
                    <button type="button" onclick="closeAddRoleModal()" class="action-btn" style="flex: 1; padding: 10px;">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
function filterRoles(q) {
    const rows = document.querySelectorAll('.role-row');
    const term = (q || '').toLowerCase();
    rows.forEach(r => {
        r.style.display = r.innerText.toLowerCase().includes(term) ? '' : 'none';
    });
}

function openAddRoleModal() {
    document.getElementById('addRoleModal').classList.add('active');
}

function closeAddRoleModal() {
    document.getElementById('addRoleModal').classList.remove('active');
}

async function handleCreateRole(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitRole');
    const roleName = document.getElementById('newRoleName').value.trim();
    const perms = Array.from(document.querySelectorAll('input[name="rolePerm"]:checked')).map(c => c.value);

    if (!roleName) return alert('Role name is required');
    if (perms.length === 0) return alert('Select at least one permission');

    btn.disabled = true;
    btn.innerText = 'Saving...';

    try {
        const res = await fetch('/api/settings/roles', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ roleName, permissions: perms.join(','), isSystem: 0 })
        });
        const data = await res.json();
        if (data.success) {
            closeAddRoleModal();
            window.location.reload();
        } else {
            alert('Failed to create role: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerText = 'Save Role';
    }
}

async function deleteRole(id, name) {
    if (!confirm(`Are you sure you want to delete role "${name}"?`)) return;
    try {
        const res = await fetch(`/api/settings/roles/${id}`, { method: 'DELETE' });
        const data = await res.json();
        if (data.success) {
            const row = document.getElementById(`row-role-${id}`);
            if (row) row.remove();
            else window.location.reload();
        } else {
            alert('Failed to delete role: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    }
}
</script>

<%- include('partials/footer') %>
