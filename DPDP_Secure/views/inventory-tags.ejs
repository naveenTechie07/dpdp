<%- include('partials/header') %>

<% 
const tagsList = (typeof tags !== 'undefined' && Array.isArray(tags)) ? tags : [];
const totalTags = tagsList.length;
const systemTags = tagsList.filter(t => t.category === 'SYSTEM' || t.category === 'GOVERNMENT_ID' || t.category === 'IDENTIFIER').length;
const highSensTags = tagsList.filter(t => (parseInt(t.sensitivityWeight) || 0) >= 75).length;
%>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(3, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">TOTAL TAGS</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalTags %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">SYSTEM & IDENTIFIERS</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= systemTags %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">HIGH SENSITIVITY (&ge;75%)</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= highSensTags %></h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Classification Tags</h1>
        <p>Define PII/sensitivity categories that classify data elements across your inventory.</p>
    </div>
    <button class="btn-primary" style="background-color: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="window.location.href='/inventory/tags/create'">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Tag
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" id="tag-search" placeholder="Search tags..." onkeyup="filterTags()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalTags %> rows</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="tags-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 12px 24px; font-weight: 600;">Tag Name &#9652;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Category &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Sub-category &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Sensitivity Weight &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Created &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (tagsList.length === 0) { %>
                <tr>
                    <td colspan="6" style="padding: 32px; text-align: center; color: var(--text-muted);">No tags defined yet. Click "New Tag" to create a classification.</td>
                </tr>
            <% } else { %>
                <% tagsList.forEach(tag => { 
                    const weight = parseInt(tag.sensitivityWeight) || 50;
                    const barColor = weight >= 80 ? '#ef4444' : (weight >= 60 ? '#f59e0b' : '#3b82f6');
                %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="tag-row">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <span style="width: 10px; height: 10px; border-radius: 50%; background: <%= tag.colorTag || '#8b5cf6' %>;"></span>
                                <span><%= tag.tagName %></span>
                            </div>
                            <% if (tag.description) { %>
                                <div style="font-size: 11px; color: var(--text-muted); font-weight: normal; margin-top: 2px;"><%= tag.description %></div>
                            <% } %>
                        </td>
                        <td style="padding: 16px 24px;">
                            <span class="badge" style="background: rgba(139, 92, 246, 0.15); color: #8b5cf6; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;"><%= tag.category %></span>
                        </td>
                        <td style="padding: 16px 24px; color: var(--text-muted);"><%= tag.subCategory || '&mdash;' %></td>
                        <td style="padding: 16px 24px;">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <div style="width: 70px; height: 5px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
                                    <div style="height: 100%; width: <%= weight %>%; background: <%= barColor %>;"></div>
                                </div>
                                <span style="font-size: 12px; font-weight: 600; color: var(--text-main); width: 35px;"><%= weight %>%</span>
                            </div>
                        </td>
                        <td style="padding: 16px 24px; color: var(--text-muted); font-size: 12px;">
                            <%= tag.createdAt ? new Date(tag.createdAt).toLocaleDateString() : 'Active' %>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteTag('<%= tag.id %>')" title="Delete Tag" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
    
    <!-- Table Footer -->
    <div class="table-toolbar" style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<script>
function filterTags() {
    const q = document.getElementById('tag-search').value.toLowerCase();
    document.querySelectorAll('.tag-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function deleteTag(id) {
    if (!confirm('Are you sure you want to delete this classification tag?')) return;
    try {
        const res = await fetch(`/api/tags/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting tag: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting tag');
    }
}
</script>

<%- include('partials/footer') %>
