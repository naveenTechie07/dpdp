<%- include('partials/header') %>

<!-- Dashboard Top Header -->
<div class="dashboard-header">
    <div class="title-group">
        <h1 style="font-size: 24px; font-weight: 700; color: #ffffff; letter-spacing: -0.5px;">Executive Compliance Dashboard</h1>
        <p style="color: var(--text-muted); font-size: 13px;">
            <strong style="color: #60a5fa;"><%= (typeof tenant !== 'undefined' && tenant && tenant.name) ? tenant.name : 'Aarogya Diagnostic Center' %></strong> &bull; Indiranagar, Bengaluru &bull; Real-Time DPDP Act, 2023 Posture
        </p>
    </div>
    <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
        <span class="badge-pill success">
            <span class="status-dot-active"></span>
            DPDP Status: Verified Compliant
        </span>
        <button class="btn-primary" onclick="window.location.href='/discovery/connectors'">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path><polyline points="9 11 12 14 22 4"></polyline></svg>
            Trigger New Scan
        </button>
    </div>
</div>

<!-- 1. Hero Compliance Health & Statutory Exposure Banner -->
<div class="hero-compliance-banner">
    <!-- Compliance Health Score Gauge -->
    <div class="glass-card compliance-health-box">
        <div class="radial-gauge-container">
            <svg class="radial-gauge-svg" width="110" height="110" viewBox="0 0 110 110">
                <circle class="gauge-bg-circle" cx="55" cy="55" r="45"></circle>
                <circle class="gauge-fill-circle" cx="55" cy="55" r="45" 
                        stroke-dasharray="282.7" 
                        stroke-dashoffset="<%= 282.7 - (282.7 * (complianceScore || 84)) / 100 %>"></circle>
            </svg>
            <div class="radial-gauge-number">
                <div class="val"><%= complianceScore || 84 %></div>
                <div class="tot">/ 100</div>
            </div>
        </div>
        <div style="flex: 1;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
                <span class="badge-pill success">Low Regulatory Risk</span>
                <span style="font-size: 11px; color: var(--text-muted);">Section 8(4) &amp; Rule 5 Validated</span>
            </div>
            <h3 style="font-size: 16px; font-weight: 700; color: #ffffff; margin-bottom: 4px;">Statutory Compliance Health</h3>
            <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                All 3 informal data silos cataloged with Verhoeff-verified Aadhaar tokens and dynamic WhatsApp consent ledgers.
            </p>
        </div>
    </div>

    <!-- Statutory Penalty Exposure Shield -->
    <div class="glass-card statutory-exposure-box">
        <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 8px;">
                <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; color: var(--text-muted); letter-spacing: 0.5px;">Statutory Exposure Defense</div>
                <span class="badge-pill info">Section 33 Protected</span>
            </div>
            <div class="exposure-amount">₹0 Active Penalties</div>
            <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                Avoided up to <strong style="color: #f87171;">₹250 Crore</strong> statutory fine exposure under DPDP Act Schedule 2 through automated informal data discovery and 72-hour breach readiness.
            </p>
        </div>
        <div style="display: flex; gap: 16px; margin-top: 14px; font-size: 12px;">
            <div><span style="color: #34d399; font-weight: 700;">100%</span> <span style="color: var(--text-muted);">Notice Delivery</span></div>
            <div><span style="color: #fbbf24; font-weight: 700;">1 Active</span> <span style="color: var(--text-muted);">CGST Tax Lock</span></div>
            <div><span style="color: #60a5fa; font-weight: 700;">&lt; 72h</span> <span style="color: var(--text-muted);">DPBI SLA Armed</span></div>
        </div>
    </div>
</div>

<!-- 2. The 4 Statutory Pillar Command Cards -->
<div class="pillar-command-grid">
    <!-- Card 1: Data Discovery & RoPA -->
    <div class="glass-card pillar-card">
        <div>
            <div class="pillar-header">
                <div>
                    <div class="pillar-title">Pillar 1: Discovery</div>
                    <div class="pillar-stat-main"><%= (typeof silosCount !== 'undefined') ? silosCount : 3 %> Silos Active</div>
                </div>
                <div class="pillar-icon-box" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">
                    <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                </div>
            </div>
            <div class="pillar-stat-sub" style="margin-bottom: 6px;">
                <strong style="color: #ffffff;"><%= (typeof piiCount !== 'undefined') ? piiCount : 1420 %></strong> Indian PII Items Discovered
            </div>
            <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                WhatsApp chats, Google Forms leads &amp; CSV billing files indexed in RoPA.
            </p>
        </div>
        <a href="/discovery/connectors" class="pillar-action-link">
            <span>Scan Silos &amp; RoPA</span>
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
    </div>

    <!-- Card 2: Consent & Multilingual Notices -->
    <div class="glass-card pillar-card">
        <div>
            <div class="pillar-header">
                <div>
                    <div class="pillar-title">Pillar 2: Consent</div>
                    <div class="pillar-stat-main"><%= (typeof activeNoticesCount !== 'undefined') ? activeNoticesCount : 3 %> Notices Live</div>
                </div>
                <div class="pillar-icon-box" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
                    <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                </div>
            </div>
            <div class="pillar-stat-sub" style="margin-bottom: 6px;">
                <strong style="color: #34d399;">94.2%</strong> WhatsApp Opt-In Rate
            </div>
            <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                Kannada, Hindi &amp; English notices with SHA-256 tamper-evident chaining.
            </p>
        </div>
        <a href="/consent/collection-points" class="pillar-action-link">
            <span>Manage Consent Ledger</span>
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
    </div>

    <!-- Card 3: Citizen Rights & DSR -->
    <div class="glass-card pillar-card">
        <div>
            <div class="pillar-header">
                <div>
                    <div class="pillar-title">Pillar 3: Citizen DSR</div>
                    <div class="pillar-stat-main"><%= (typeof pendingDsrCount !== 'undefined') ? pendingDsrCount : 1 %> Open Ticket</div>
                </div>
                <div class="pillar-icon-box" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24;">
                    <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                </div>
            </div>
            <div class="pillar-stat-sub" style="margin-bottom: 6px;">
                <strong style="color: #fbbf24;"><%= (typeof taxLockedCount !== 'undefined') ? taxLockedCount : 1 %></strong> CGST Section 36 Tax Lock
            </div>
            <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                Dual-track resolver safely redacts informal marketing chats while locking invoices.
            </p>
        </div>
        <a href="/privacy/requests" class="pillar-action-link">
            <span>Resolve DSR Queue</span>
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
    </div>

    <!-- Card 4: Breach Triage & DPBI -->
    <div class="glass-card pillar-card">
        <div>
            <div class="pillar-header">
                <div>
                    <div class="pillar-title">Pillar 4: Breach Triage</div>
                    <div class="pillar-stat-main"><%= (typeof activeIncidentsCount !== 'undefined') ? activeIncidentsCount : 0 %> Breaches Active</div>
                </div>
                <div class="pillar-icon-box" style="background: rgba(239, 68, 68, 0.15); color: #f87171;">
                    <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                </div>
            </div>
            <div class="pillar-stat-sub" style="margin-bottom: 6px;">
                <span class="badge-pill success">72h SLA Armed</span>
            </div>
            <p style="font-size: 12px; color: var(--text-muted); line-height: 1.4;">
                Automated breach triage engine ready for DPBI &amp; Data Principal dispatches.
            </p>
        </div>
        <a href="/incidents/management" class="pillar-action-link">
            <span>Incident Command</span>
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
    </div>
</div>

<!-- 3. Interactive Quick-Action Dock -->
<div class="quick-action-dock">
    <a href="/discovery/connectors" class="dock-btn">
        <span class="dock-icon">⚡</span>
        <div>
            <div>Scan New Silo</div>
            <div style="font-size: 11px; font-weight: 400; color: var(--text-muted);">WhatsApp / Excel / CSV</div>
        </div>
    </a>
    <a href="/consent/collection-points" class="dock-btn">
        <span class="dock-icon">💬</span>
        <div>
            <div>Send WhatsApp Notice</div>
            <div style="font-size: 11px; font-weight: 400; color: var(--text-muted);">Section 5 Multilingual</div>
        </div>
    </a>
    <a href="/privacy/requests" class="dock-btn">
        <span class="dock-icon">🛡️</span>
        <div>
            <div>Resolve Erasure Request</div>
            <div style="font-size: 11px; font-weight: 400; color: var(--text-muted);">Tax-Lock Collision Check</div>
        </div>
    </a>
    <a href="/incidents/management" class="dock-btn">
        <span class="dock-icon">🚨</span>
        <div>
            <div>Triage Security Incident</div>
            <div style="font-size: 11px; font-weight: 400; color: var(--text-muted);">72h DPBI Dossier Dispatch</div>
        </div>
    </a>
</div>

<!-- 4. Connected Informal Silos Compliance Posture Table -->
<div class="glass-card silos-table-card">
    <div class="table-header-row">
        <div>
            <h3 style="font-size: 15px; font-weight: 700; color: #ffffff;">Connected Informal Data Silos Posture</h3>
            <p style="font-size: 12px; color: var(--text-muted);">Discovered informal systems mapped to statutory safeguards (Section 8)</p>
        </div>
        <a href="/inventory/ropa" class="btn-outline">
            Export RoPA (Art. 30 / Sec. 8)
        </a>
    </div>
    
    <table class="data-table">
        <thead>
            <tr>
                <th>Data Silo &amp; Location</th>
                <th>Silo Type</th>
                <th>Discovered Indian PII</th>
                <th>Statutory Safeguards Applied</th>
                <th>Statutory Retention Status</th>
            </tr>
        </thead>
        <tbody>
            <tr>
                <td>
                    <div style="font-weight: 600; color: #ffffff;">clinic_reception_chat.txt</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Reception Desk Phone (WhatsApp Business)</div>
                </td>
                <td><span class="badge-pill info">Informal Chat</span></td>
                <td>
                    <div>Aadhaar (8), Mobile (12), Clinical Diagnoses (6)</div>
                    <div style="font-size: 11px; color: #34d399;">Verhoeff Checksum Validated</div>
                </td>
                <td>
                    <span class="badge-pill success">Tokenized in RoPA</span>
                </td>
                <td>
                    <span class="badge-pill warning">Informal Silo Redactable</span>
                </td>
            </tr>
            <tr>
                <td>
                    <div style="font-weight: 600; color: #ffffff;">customer_leads.csv</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Google Forms Intake / Marketing Desk</div>
                </td>
                <td><span class="badge-pill purple">Spreadsheet Silo</span></td>
                <td>
                    <div>Names (45), Phone Numbers (45), Locations (12)</div>
                    <div style="font-size: 11px; color: #60a5fa;">Direct Marketing Leads</div>
                </td>
                <td>
                    <span class="badge-pill success">Section 5 Notice Dispatched</span>
                </td>
                <td>
                    <span class="badge-pill info">Revocable Consent Track</span>
                </td>
            </tr>
            <tr>
                <td>
                    <div style="font-weight: 600; color: #ffffff;">invoices_billing.csv</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Local Billing Software Export</div>
                </td>
                <td><span class="badge-pill warning">Financial / Billing</span></td>
                <td>
                    <div>PAN (18), GSTIN (12), Patient Invoices (24)</div>
                    <div style="font-size: 11px; color: #fbbf24;">Statutory Tax Records</div>
                </td>
                <td>
                    <span class="badge-pill warning">CGST Sec 36 Retention Lock</span>
                </td>
                <td>
                    <strong style="color: #fbbf24; font-size: 12px;">Locked (Mandatory 6-Year Retention)</strong>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<!-- 5. Recent Activity Feed -->
<div class="glass-card activity-feed-card">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
        <div>
            <h3 style="font-size: 15px; font-weight: 700; color: #ffffff;">Real-Time Statutory Audit Trail</h3>
            <p style="font-size: 12px; color: var(--text-muted);">Chronological event logging for DPBI evidentiary compliance</p>
        </div>
        <a href="/settings/audit-log" class="btn-outline">View Complete Audit Log</a>
    </div>

    <div class="timeline-list">
        <% if (typeof recentActivity !== 'undefined' && Array.isArray(recentActivity) && recentActivity.length > 0) { %>
            <% recentActivity.forEach((item) => { %>
                <div class="timeline-item">
                    <div class="timeline-dot <%= item.action && item.action.includes('TAX') ? 'warning' : (item.action && item.action.includes('INCIDENT') ? 'danger' : 'success') %>"></div>
                    <div class="timeline-content">
                        <div class="timeline-meta">
                            <span class="timeline-actor"><%= item.actor %> &bull; <span style="font-weight: 400; color: #60a5fa;"><%= item.action %></span></span>
                            <span class="timeline-time"><%= item.timestamp %></span>
                        </div>
                        <div style="font-size: 12px; font-weight: 600; color: #f8fafc; margin-bottom: 2px;">
                            Resource: <%= item.resource %>
                        </div>
                        <div class="timeline-details">
                            <%= item.details %>
                        </div>
                    </div>
                </div>
            <% }); %>
        <% } else { %>
            <div style="padding: 16px; color: var(--text-muted); font-size: 13px;">No recent audit activity recorded.</div>
        <% } %>
    </div>
</div>

<script>
async function triggerDemoReset() {
    const btn = document.getElementById('btnInstantDemo');
    if (!btn) return;
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<span>⏳ Resetting Demo Environment...</span>';
    btn.style.opacity = '0.7';

    try {
        const res = await fetch('/api/demo/reset', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' }
        });
        const data = await res.json();
        if (data.success) {
            btn.innerHTML = '<span>✓ Demo Reset Complete!</span>';
            btn.style.background = '#10b981';
            btn.style.color = '#ffffff';
            setTimeout(() => {
                window.location.reload();
            }, 600);
        } else {
            alert('Demo Reset Error: ' + (data.error || 'Unknown error'));
            btn.disabled = false;
            btn.innerHTML = origHtml;
            btn.style.opacity = '1';
        }
    } catch (err) {
        alert('Network error connecting to /api/demo/reset: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = origHtml;
        btn.style.opacity = '1';
    }
}
</script>

<%- include('partials/footer') %>
