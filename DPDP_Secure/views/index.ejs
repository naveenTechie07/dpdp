<%- include('partials/header') %>

<div class="dashboard-header">
    <div class="title-group">
        <h1>Compliance Dashboard</h1>
        <p>DPDP_Secure Payments Pvt Ltd &bull; Wednesday, 16 September 2026</p>
    </div>
    <div class="status-badge">System healthy</div>
</div>

<!-- Top Metrics -->
<div class="metrics-grid">
    <div class="card metric-card">
        <div class="metric-info">
            <span class="metric-label">CONSENT EVENTS</span>
            <h2 class="metric-value blue">40</h2>
        </div>
        <div class="metric-icon blue-bg">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info">
            <span class="metric-label">CONSENT RATE</span>
            <h2 class="metric-value orange">78%</h2>
        </div>
        <div class="metric-icon orange-bg">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info">
            <span class="metric-label">OPEN DPRR</span>
            <h2 class="metric-value orange">8</h2>
        </div>
        <div class="metric-icon orange-bg">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info">
            <span class="metric-label">OPEN INCIDENTS</span>
            <h2 class="metric-value red">1</h2>
        </div>
        <div class="metric-icon red-bg">
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
        </div>
    </div>
</div>

<!-- Main Details Grid -->
<div class="details-grid">
    
    <!-- Consent Management -->
    <div class="card detail-card">
        <div class="card-header">
            <h3>Consent Management</h3>
            <a href="#" class="view-link">View &rarr;</a>
        </div>
        <div class="card-body consent-body">
            <!-- CSS Donut Chart -->
            <div class="donut-chart-container">
                <div class="donut-chart"></div>
            </div>
            <div class="consent-stats">
                <div class="stat-row">
                    <span>Total Events</span>
                    <strong>40</strong>
                </div>
                <div class="stat-row">
                    <span><span class="dot green"></span> Granted</span>
                    <strong class="green-text">31</strong>
                </div>
                <div class="stat-row">
                    <span><span class="dot red"></span> Withdrawn</span>
                    <strong class="red-text">9</strong>
                </div>
                <div class="progress-bar-container mt-2">
                    <div class="progress-label"><span>Consent Rate</span> <span class="orange-text">78%</span></div>
                    <div class="progress-track"><div class="progress-fill orange-bg" style="width: 78%"></div></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Privacy Rights -->
    <div class="card detail-card">
        <div class="card-header">
            <h3>Privacy Rights (DPRR)</h3>
            <a href="#" class="view-link">View &rarr;</a>
        </div>
        <div class="card-body">
            <div class="big-numbers">
                <div class="number-box">
                    <strong>8</strong>
                    <span>TOTAL</span>
                </div>
                <div class="number-box active orange">
                    <strong>8</strong>
                    <span>OPEN</span>
                </div>
                <div class="number-box">
                    <strong>0</strong>
                    <span>OVERDUE</span>
                </div>
            </div>
            <div class="list-stats mt-3">
                <div class="list-row"><span><span class="dot blue"></span> ACCESS</span> <strong>2</strong></div>
                <div class="list-row"><span><span class="dot red"></span> DELETE</span> <strong>3</strong></div>
                <div class="list-row"><span><span class="dot orange"></span> CORRECT</span> <strong>2</strong></div>
            </div>
        </div>
    </div>

    <!-- Cookie Compliance -->
    <div class="card detail-card">
        <div class="card-header">
            <h3>Cookie Compliance</h3>
            <a href="#" class="view-link">View &rarr;</a>
        </div>
        <div class="card-body">
            <div class="big-numbers">
                <div class="number-box">
                    <strong>2</strong>
                    <span>SCANS</span>
                </div>
                <div class="number-box active green">
                    <strong>2</strong>
                    <span>COMPLETED</span>
                </div>
                <div class="number-box active blue">
                    <strong>0</strong>
                    <span>BANNERS LIVE</span>
                </div>
            </div>
            <div class="info-box mt-3 flex-between">
                <div>
                    <div class="info-url">https://www.dpdpsecure.in</div>
                    <div class="info-sub">Latest scan - 0 trackers found</div>
                </div>
                <div class="pill green">COMPLETED</div>
            </div>
        </div>
    </div>

    <!-- Assessment & PIA/DPIA -->
    <div class="card detail-card">
        <div class="card-header">
            <h3>Assessment & PIA/DPIA</h3>
            <a href="#" class="view-link">View &rarr;</a>
        </div>
        <div class="card-body">
            <div class="big-numbers">
                <div class="number-box">
                    <strong>3</strong>
                    <span>TOTAL</span>
                </div>
                <div class="number-box active red">
                    <strong>1</strong>
                    <span>HIGH RISK</span>
                </div>
                <div class="number-box active orange">
                    <strong>2</strong>
                    <span>OVERDUE</span>
                </div>
            </div>
            <div class="list-stats mt-3 bordered">
                <div class="list-row"><span>In Progress</span> <strong class="blue-text">3</strong></div>
                <div class="list-row"><span>Open Mitigations</span> <strong class="orange-text">2</strong></div>
            </div>
        </div>
    </div>

    <!-- Incident Management -->
    <div class="card detail-card">
        <div class="card-header">
            <h3>Incident Management</h3>
            <a href="#" class="view-link">View &rarr;</a>
        </div>
        <div class="card-body">
            <div class="big-numbers">
                <div class="number-box">
                    <strong>2</strong>
                    <span>TOTAL</span>
                </div>
                <div class="number-box active orange">
                    <strong>1</strong>
                    <span>OPEN</span>
                </div>
                <div class="number-box active red">
                    <strong>1</strong>
                    <span>CRIT/HIGH OPEN</span>
                </div>
            </div>
            <div class="pill-group mt-3">
                <span class="pill-small orange">High: 1</span>
                <span class="pill-small gray">Low: 1</span>
            </div>
        </div>
    </div>

    <!-- Data & AI Governance -->
    <div class="card detail-card">
        <div class="card-header">
            <h3>Data & AI Governance</h3>
            <a href="#" class="view-link">Data &rarr; | AI &rarr;</a>
        </div>
        <div class="card-body">
            <div class="big-numbers">
                <div class="number-box active green-light">
                    <strong>5</strong>
                    <span>DATA ASSETS</span>
                </div>
                <div class="number-box active purple">
                    <strong>1</strong>
                    <span>AI MODELS</span>
                </div>
                <div class="number-box active green-light">
                    <strong>1</strong>
                    <span>IN PRODUCTION</span>
                </div>
            </div>
            <div class="mt-3">
                <div class="info-sub mb-1">DATA BY CLASSIFICATION</div>
                <div class="list-row"><span><span class="dot gray"></span> unclassified</span> <strong>5</strong></div>
            </div>
        </div>
    </div>

</div>

<!-- DPDPA Compliance Readiness -->
<div class="compliance-readiness mt-4">
    <div class="readiness-header">
        <div class="flex-align-center gap-2">
            <svg viewBox="0 0 24 24" width="18" height="18" stroke="#10b981" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <h3 class="readiness-title">DPDPA Compliance Readiness</h3>
            <span class="pill-badge orange-outline">HIGH</span>
            <span class="readiness-subtitle">— Swish DPDPA GapAssessment</span>
        </div>
        <a href="#" class="view-link-red">Full Report &rarr;</a>
    </div>
    
    <div class="readiness-body">
        <div class="gauge-section">
            <div class="circular-gauge">
                <div class="gauge-inner">
                    <span class="gauge-value">58</span>
                    <span class="gauge-total">/ 100</span>
                </div>
            </div>
            <div class="gauge-label">7 sections</div>
        </div>
        
        <div class="progress-bars-section">
            <div class="progress-col">
                <div class="progress-row">
                    <span class="p-label">Consent Mgmt</span>
                    <div class="p-track"><div class="p-fill orange-bg-solid" style="width: 50%"></div></div>
                    <span class="p-value orange">50%</span>
                </div>
                <div class="progress-row">
                    <span class="p-label">Rights</span>
                    <div class="p-track"><div class="p-fill orange-bg-solid" style="width: 53%"></div></div>
                    <span class="p-value orange">53%</span>
                </div>
                <div class="progress-row">
                    <span class="p-label">Fiduciary Duties</span>
                    <div class="p-track"><div class="p-fill yellow-bg-solid" style="width: 63%"></div></div>
                    <span class="p-value yellow">63%</span>
                </div>
                <div class="progress-row">
                    <span class="p-label">SDF</span>
                    <div class="p-track"><div class="p-fill yellow-bg-solid" style="width: 60%"></div></div>
                    <span class="p-value yellow">60%</span>
                </div>
            </div>
            
            <div class="progress-divider"></div>
            
            <div class="progress-col">
                <div class="progress-row">
                    <span class="p-label">Cross-border</span>
                    <div class="p-track"><div class="p-fill yellow-bg-solid" style="width: 60%"></div></div>
                    <span class="p-value yellow">60%</span>
                </div>
                <div class="progress-row">
                    <span class="p-label">Children</span>
                    <div class="p-track"><div class="p-fill yellow-bg-solid" style="width: 60%"></div></div>
                    <span class="p-value yellow">60%</span>
                </div>
                <div class="progress-row">
                    <span class="p-label">Data Governance</span>
                    <div class="p-track"><div class="p-fill yellow-bg-solid" style="width: 60%"></div></div>
                    <span class="p-value yellow">60%</span>
                </div>
            </div>
        </div>
    </div>
    
    <div class="readiness-footer">
        <div><span class="dot red"></span> Weakest: <strong>Consent Mgmt <span class="orange">50%</span></strong></div>
        <div><span class="dot green"></span> Strongest: <strong>Fiduciary Duties <span class="yellow">63%</span></strong></div>
    </div>
</div>

