<%- include('partials/header') %>

<% 
const evidenceList = (typeof evidence !== 'undefined' && Array.isArray(evidence)) ? evidence : [];
const totalEvidence = evidenceList.length;
const verifiedCount = evidenceList.filter(e => e.verified === 1 || e.verified === '1' || e.verified === true).length;
const auditCount = evidenceList.filter(e => e.documentType === 'AUDIT_REPORT' || e.documentType === 'ACCREDITATION').length;
%>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(3, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Total Evidence</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalEvidence %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Verified Documents</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #10b981;"><%= verifiedCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Audits & Certifications</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #3b82f6;"><%= auditCount %></h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between; display: flex;">
    <div class="title-group">
        <h1 class="page-title"><%= (typeof title !== 'undefined' ? title : 'Compliance Evidence').split(' - ')[0] %></h1>
        <p class="page-description">Statutory certificates, audit reports, DPBI dossiers, NABL accreditations, and DPA contracts.</p>
    </div>
    <button class="btn-primary" onclick="document.getElementById('upload-evidence-modal').style.display='flex'" style="padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Upload Evidence
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" id="evidence-search" placeholder="Search compliance evidence..." onkeyup="filterEvidence()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalEvidence %> documents</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="evidence-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 14px 24px; font-weight: 600;">Document Name &#9652;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Type &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Signatory / Uploader &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Status &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Valid Until &#8597;</th>
                <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (evidenceList.length === 0) { %>
                <tr>
                    <td colspan="6" style="padding: 32px; text-align: center; color: var(--text-muted);">No compliance evidence uploaded yet. Click "Upload Evidence" to file statutory proof.</td>
                </tr>
            <% } else { %>
                <% evidenceList.forEach(ev => { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="ev-row">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="#3b82f6" stroke-width="2" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                                <span><%= ev.documentName %></span>
                            </div>
                        </td>
                        <td style="padding: 16px 16px;">
                            <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">
                                <%= ev.documentType || 'DOCUMENT' %>
                            </span>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted);"><%= ev.uploadedBy || 'DPO Office' %></td>
                        <td style="padding: 16px 16px;">
                            <% if (ev.verified === 1 || ev.verified === '1' || ev.verified === true) { %>
                                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Verified (✓)</span>
                            <% } else { %>
                                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Pending Review</span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">
                            <%= ev.expiryDate ? ev.expiryDate.split('T')[0] : 'Indefinite' %>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteEvidence('<%= ev.id %>')" title="Delete Evidence" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Upload Evidence Modal Overlay -->
<div id="upload-evidence-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card p-0" style="width: 520px; background: #0f172a; border: 1px solid #334155; box-shadow: 0 20px 30px rgba(0,0,0,0.6); border-radius: 12px; overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; background: #1e293b;">
            <h2 style="font-size: 16px; font-weight: 600; color: #f8fafc; margin: 0;">Register Compliance Evidence</h2>
            <button onclick="document.getElementById('upload-evidence-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <form id="add-ev-form" onsubmit="handleUploadEvidence(event)" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Document Name *</label>
                <input type="text" id="evName" required placeholder="e.g. NABL ISO 15189 Accreditation Certificate" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Document Type</label>
                    <select id="evType" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        <option value="ACCREDITATION">ACCREDITATION</option>
                        <option value="AUDIT_REPORT">AUDIT_REPORT</option>
                        <option value="BREACH_INTIMATION">BREACH_INTIMATION (Form DPBI-IR1)</option>
                        <option value="LEGAL_CONTRACT">LEGAL_CONTRACT (DPA)</option>
                        <option value="POLICY_RECORD">POLICY_RECORD</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Signatory / Uploader</label>
                    <input type="text" id="evUploader" value="Dr. Aruna V. (Lab Director)" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Verification Status</label>
                    <select id="evVerified" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        <option value="1">Verified & Validated (✓)</option>
                        <option value="0">Pending Review</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Expiry Date</label>
                    <input type="date" id="evExpiry" value="2027-03-31" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Save Evidence</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('upload-evidence-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: #334155; border: 1px solid #475569; color: #f8fafc;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterEvidence() {
    const q = document.getElementById('evidence-search').value.toLowerCase();
    document.querySelectorAll('.ev-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function handleUploadEvidence(e) {
    e.preventDefault();
    const documentName = document.getElementById('evName').value.trim();
    const documentType = document.getElementById('evType').value;
    const uploadedBy = document.getElementById('evUploader').value.trim();
    const verified = parseInt(document.getElementById('evVerified').value) || 0;
    const expiryDate = document.getElementById('evExpiry').value;

    try {
        const res = await fetch('/api/governance/evidence', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ documentName, documentType, uploadedBy, verified, expiryDate, fileSize: 1840000 })
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error creating evidence: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error submitting evidence');
    }
}

async function deleteEvidence(id) {
    if (!confirm('Are you sure you want to delete this evidence document?')) return;
    try {
        const res = await fetch(`/api/governance/evidence/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting evidence: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting evidence');
    }
}
</script>

<%- include('partials/footer') %>
