<%- include('partials/header') %>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(3, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Total Evidence</span>
            <h2 class="metric-value" style="margin-top: 8px;">2</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Active</span>
            <h2 class="metric-value" style="margin-top: 8px;">2</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Certificates</span>
            <h2 class="metric-value" style="margin-top: 8px;">0</h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Compliance Evidence</h1>
        <p>Store and manage certificates, audit reports, DPIAs, contracts, and other compliance documents.</p>
    </div>
    <button class="btn-primary" style="background-color: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        Upload Evidence
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search compliance evidence..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 12px 24px; font-weight: 600;">Evidence &#9652;</th>
                <th style="padding: 12px 16px; font-weight: 600;">Linked Objects</th>
                <th style="padding: 12px 16px; font-weight: 600;">Type &#8597;</th>
                <th style="padding: 12px 16px; font-weight: 600;">Regulation &#8597;</th>
                <th style="padding: 12px 16px; font-weight: 600;">File &#8597;</th>
                <th style="padding: 12px 16px; font-weight: 600;">Attachment</th>
                <th style="padding: 12px 16px; font-weight: 600;">Size &#8597;</th>
                <th style="padding: 12px 16px; font-weight: 600;">Expires &#8597;</th>
                <th style="padding: 12px 16px; font-weight: 600;">Status &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;"></th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <!-- Row 1 -->
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); width: 20%; line-height: 1.5;">RBI KYC Compliance<br>Audit Report</td>
                <td style="padding: 16px 16px; line-height: 1.6;">
                    <a href="#" style="color: #3b82f6; text-decoration: none; display: block;">KYC Verification & Credit<br>Bureau Reporting</a>
                    <a href="#" style="color: #3b82f6; text-decoration: none; display: block; margin-top: 4px;">BNPL Credit Scoring AI<br>DPIA</a>
                </td>
                <td style="padding: 16px 16px;">
                    <span class="badge" style="background: #e0e7ff; color: #4338ca; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700; display: inline-block; margin-bottom: 4px;">audit</span><br>
                    <span class="badge" style="background: #e0e7ff; color: #4338ca; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700; display: inline-block;">report</span>
                </td>
                <td style="padding: 16px 16px; color: var(--text-muted); line-height: 1.5;">RBI KYC Master<br>Direction 2016</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; text-align: right;">
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </td>
            </tr>
            <!-- Row 2 -->
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main); width: 20%; line-height: 1.5;">RBI KYC Compliance<br>Audit Report</td>
                <td style="padding: 16px 16px; line-height: 1.6;">
                    <a href="#" style="color: #3b82f6; text-decoration: none; display: block;">KYC Verification & Credit<br>Bureau Reporting</a>
                </td>
                <td style="padding: 16px 16px;">
                    <span class="badge" style="background: #e0e7ff; color: #4338ca; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700; display: inline-block; margin-bottom: 4px;">audit</span><br>
                    <span class="badge" style="background: #e0e7ff; color: #4338ca; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700; display: inline-block;">report</span>
                </td>
                <td style="padding: 16px 16px; color: var(--text-muted); line-height: 1.5;">RBI KYC Master<br>Direction 2016</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">&mdash;</td>
                <td style="padding: 16px 16px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; text-align: right;">
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M3 6h18"></path><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </td>
            </tr>
        </tbody>
    </table>
    
    <!-- Table Footer -->
    <div class="table-toolbar" style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
