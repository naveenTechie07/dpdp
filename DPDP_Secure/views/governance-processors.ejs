<%- include('partials/header') %>

<% 
const procsList = (typeof processors !== 'undefined' && Array.isArray(processors)) ? processors : [];
const totalProcs = procsList.length;
const dpaSignedCount = procsList.filter(p => p.dpaSigned === 1 || p.dpaSigned === '1' || p.dpaSigned === true).length;
const highRiskCount = procsList.filter(p => p.riskLevel === 'HIGH' || p.riskLevel === 'CRITICAL').length;
%>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Total Processors</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalProcs %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">DPA Signed</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #10b981;"><%= dpaSignedCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">High / Critical Risk</span>
            <h2 class="metric-value" style="margin-top: 8px; color: <%= highRiskCount > 0 ? '#ef4444' : '#10b981' %>;"><%= highRiskCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Compliance Status</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #3b82f6;">100% Active</h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between; display: flex;">
    <div class="title-group">
        <h1 class="page-title"><%= (typeof title !== 'undefined' ? title : 'Data Processors').split(' - ')[0] %></h1>
        <p class="page-description">Vendor register &mdash; data processors, sub-processors, DPA status, and statutory risk assessments.</p>
    </div>
    <button class="btn-primary" onclick="document.getElementById('add-processor-modal').style.display='flex'" style="padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Processor
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" id="proc-search" placeholder="Search processors..." onkeyup="filterProcessors()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalProcs %> records</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="procs-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 14px 24px; font-weight: 600;">Processor Name &#9652;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Service Type &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Jurisdiction &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Risk Tier &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">DPA Status &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Data Categories</th>
                <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (procsList.length === 0) { %>
                <tr>
                    <td colspan="7" style="padding: 32px; text-align: center; color: var(--text-muted);">No third-party processors recorded. Click "Add Processor" to register a vendor.</td>
                </tr>
            <% } else { %>
                <% procsList.forEach(p => { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="proc-row">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">
                            <div><%= p.processorName %></div>
                        </td>
                        <td style="padding: 16px 16px;">
                            <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 600;"><%= p.serviceType || 'Service' %></span>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted);"><%= p.jurisdiction || 'India' %></td>
                        <td style="padding: 16px 16px;">
                            <% if (p.riskLevel === 'LOW') { %>
                                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">LOW</span>
                            <% } else if (p.riskLevel === 'MEDIUM') { %>
                                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">MEDIUM</span>
                            <% } else { %>
                                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;"><%= p.riskLevel || 'HIGH' %></span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 16px;">
                            <% if (p.dpaSigned === 1 || p.dpaSigned === '1' || p.dpaSigned === true) { %>
                                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Signed</span>
                            <% } else { %>
                                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Pending</span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px; max-width: 200px;">
                            <%= p.dataCategories || 'Diagnostic / Patient' %>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteProcessor('<%= p.id %>')" title="Delete Processor" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Add Processor Modal Overlay -->
<div id="add-processor-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card p-0" style="width: 520px; background: #0f172a; border: 1px solid #334155; box-shadow: 0 20px 30px rgba(0,0,0,0.6); border-radius: 12px; overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; background: #1e293b;">
            <h2 style="font-size: 16px; font-weight: 600; color: #f8fafc; margin: 0;">Register Data Processor</h2>
            <button onclick="document.getElementById('add-processor-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <form id="add-proc-form" onsubmit="handleAddProcessor(event)" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Processor / Vendor Name *</label>
                <input type="text" id="procName" required placeholder="e.g. Tele-Radiology Specialists Pvt Ltd" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Service Type</label>
                    <input type="text" id="procService" placeholder="e.g. Pathology Lab / Cloud" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Jurisdiction / Country</label>
                    <input type="text" id="procCountry" value="India" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Risk Tier</label>
                    <select id="procRisk" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        <option value="LOW">LOW</option>
                        <option value="MEDIUM">MEDIUM</option>
                        <option value="HIGH">HIGH</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">DPA Executed?</label>
                    <select id="procDpa" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        <option value="1">Yes - Signed (DPA Active)</option>
                        <option value="0">No - Pending Execution</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Data Categories Handled</label>
                <input type="text" id="procDataCategories" placeholder="e.g. Blood panels, Biopsy, Aadhaar, Phone numbers" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Save Data Processor</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('add-processor-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: #334155; border: 1px solid #475569; color: #f8fafc;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterProcessors() {
    const q = document.getElementById('proc-search').value.toLowerCase();
    document.querySelectorAll('.proc-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function handleAddProcessor(e) {
    e.preventDefault();
    const processorName = document.getElementById('procName').value.trim();
    const serviceType = document.getElementById('procService').value.trim();
    const jurisdiction = document.getElementById('procCountry').value.trim();
    const riskLevel = document.getElementById('procRisk').value;
    const dpaSigned = parseInt(document.getElementById('procDpa').value) || 0;
    const dataCategories = document.getElementById('procDataCategories').value.trim();

    try {
        const res = await fetch('/api/governance/processors', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ processorName, serviceType, jurisdiction, riskLevel, dpaSigned, dataCategories })
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error creating processor: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error submitting processor');
    }
}

async function deleteProcessor(id) {
    if (!confirm('Are you sure you want to delete this data processor?')) return;
    try {
        const res = await fetch(`/api/governance/processors/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting processor: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting processor');
    }
}
</script>

<%- include('partials/footer') %>
