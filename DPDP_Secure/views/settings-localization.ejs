<script>
    function switchTab(tabId) {
        // Update tabs
        document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
        event.target.classList.add('active');

        // Update content panels
        document.querySelectorAll('.loc-panel').forEach(p => p.classList.remove('active'));
        document.getElementById('tab-' + tabId).classList.add('active');

        // Update right text
        const rightText = document.getElementById('last-updated-text');
        if (tabId === 'messages') {
            rightText.innerHTML = '7 overrides';
            rightText.style.color = 'white';
            rightText.style.fontWeight = '600';
        } else {
            rightText.innerHTML = 'Last updated 29 Aug 2026, 03:03 pm';
            rightText.style.color = 'var(--text-muted)';
            rightText.style.fontWeight = 'normal';
        }
    }
</script>

