<%- include('partials/header') %>
<%
  const safeLocales = (typeof locales !== 'undefined' && Array.isArray(locales)) ? locales : [];
  const defaultLocale = safeLocales.find(l => l.isDefault) || safeLocales[0] || { language: 'English' };
%>

<style>
.loc-tabs {
    display: flex;
    justify-content: center;
    margin-bottom: 24px;
}
.loc-tabs-inner {
    display: flex;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 4px;
}
.loc-tab {
    padding: 8px 18px;
    color: var(--text-muted);
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    border-radius: 6px;
    transition: all 0.2s;
}
.loc-tab.active {
    background: #3b82f6;
    color: white;
}
.loc-content-card {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    padding: 24px;
    margin-bottom: 24px;
}
.loc-section-title {
    font-size: 16px;
    font-weight: 700;
    color: white;
    margin: 0 0 4px 0;
}
.loc-section-subtitle {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0 0 24px 0;
}
.loc-label {
    display: block; font-size: 13px; font-weight: 600; color: white; margin-bottom: 8px;
}
.loc-select {
    width: 100%; max-width: 400px; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: white; padding: 10px 12px; border-radius: 6px; font-size: 13px;
}
.lang-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    margin-bottom: 32px;
}
.lang-card {
    background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 12px 14px; display: flex; align-items: center; gap: 10px; color: white; font-size: 13px; cursor: pointer; transition: all 0.2s;
}
.lang-card.active {
    border-color: #3b82f6;
    background: rgba(59, 130, 246, 0.1);
}
.lang-card input[type="checkbox"] {
    accent-color: #3b82f6; width: 15px; height: 15px; cursor: pointer;
}
.lang-code {
    color: var(--text-muted); font-size: 11px; margin-left: auto; font-family: monospace;
}
.loc-panel {
    display: none;
}
.loc-panel.active {
    display: block;
}
.loc-btn-primary {
    background: #3b82f6; border: 1px solid #2563eb; color: white; padding: 10px 20px; border-radius: 6px; font-size: 13px; font-weight: 600; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; transition: all 0.2s;
}
.loc-btn-primary:hover {
    background: #2563eb;
}
.toggle-switch-ui {
    width: 44px; height: 24px; background: #374151; border-radius: 12px; position: relative; cursor: pointer; transition: background 0.2s;
}
.toggle-switch-ui.active { background: #3b82f6; }
.toggle-switch-ui::after {
    content: ''; position: absolute; top: 2px; left: 2px; width: 20px; height: 20px; background: white; border-radius: 50%; transition: left 0.2s;
}
.toggle-switch-ui.active::after { left: 22px; }
.loc-table {
    width: 100%; border-collapse: collapse;
}
.loc-table th {
    text-align: left; padding: 12px 16px; font-size: 11px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; border-bottom: 1px solid var(--border-color); background: rgba(0,0,0,0.15);
}
.loc-table td {
    padding: 14px 16px; font-size: 13px; color: white; border-bottom: 1px solid rgba(255,255,255,0.05); vertical-align: top;
}
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: white; margin: 0 0 6px 0;">Localization &amp; Multilingual Notices</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">DPDP Act Section 5(3) mandatory 8th Schedule Indian languages management for patient consent forms.</p>
        </div>
        <div style="color: var(--text-muted); font-size: 12px;" id="last-updated-text">
            3 Configured Languages (English, Kannada, Hindi)
        </div>
    </div>

    <!-- TABS -->
    <div class="loc-tabs">
        <div class="loc-tabs-inner">
            <div class="loc-tab active" onclick="switchTab('consumer')">Eighth Schedule Languages</div>
            <div class="loc-tab" onclick="switchTab('messages')">Notice Translations</div>
            <div class="loc-tab" onclick="switchTab('settings')">Language Settings</div>
            <div class="loc-tab" onclick="switchTab('bundle')">Portal Live Preview</div>
        </div>
    </div>

    <!-- 1. SCHEDULE 8 LANGUAGES TAB -->
    <div id="tab-consumer" class="loc-panel active">
        <div class="loc-content-card">
            <h2 class="loc-section-title">Active Patient Notice Languages</h2>
            <p class="loc-section-subtitle">Languages available to patients in WhatsApp intake bots, physical notice QR codes, and SMS consent confirmations.</p>
            
            <div style="margin-bottom: 24px;">
                <label class="loc-label">Default Clinic Locale</label>
                <select class="loc-select" id="defaultLocaleSelect" onchange="updateDefaultLocale(this.value)">
                    <option value="English" <%= defaultLocale.language === 'English' ? 'selected' : '' %>>English (en-IN)</option>
                    <option value="Kannada" <%= defaultLocale.language === 'Kannada' ? 'selected' : '' %>>ಕನ್ನಡ - Kannada (kn-IN)</option>
                    <option value="Hindi" <%= defaultLocale.language === 'Hindi' ? 'selected' : '' %>>हिन्दी - Hindi (hi-IN)</option>
                </select>
            </div>

            <h3 style="font-size: 14px; font-weight: 600; color: white; margin-bottom: 14px;">Active Clinic Languages in Bengaluru</h3>
            <div class="lang-grid">
                <label class="lang-card active">
                    <input type="checkbox" checked disabled>
                    <span style="font-weight: 600;">English</span>
                    <span class="lang-code">en-IN</span>
                </label>
                <label class="lang-card active">
                    <input type="checkbox" checked disabled>
                    <span style="font-weight: 600;">ಕನ್ನಡ (Kannada)</span>
                    <span class="lang-code">kn-IN</span>
                </label>
                <label class="lang-card active">
                    <input type="checkbox" checked disabled>
                    <span style="font-weight: 600;">हिन्दी (Hindi)</span>
                    <span class="lang-code">hi-IN</span>
                </label>
                <label class="lang-card">
                    <input type="checkbox">
                    <span>தமிழ் (Tamil)</span>
                    <span class="lang-code">ta-IN</span>
                </label>
                <label class="lang-card">
                    <input type="checkbox">
                    <span>తెలుగు (Telugu)</span>
                    <span class="lang-code">te-IN</span>
                </label>
                <label class="lang-card">
                    <input type="checkbox">
                    <span>മലയാളം (Malayalam)</span>
                    <span class="lang-code">ml-IN</span>
                </label>
                <label class="lang-card">
                    <input type="checkbox">
                    <span>मराठी (Marathi)</span>
                    <span class="lang-code">mr-IN</span>
                </label>
                <label class="lang-card">
                    <input type="checkbox">
                    <span>বাংলা (Bengali)</span>
                    <span class="lang-code">bn-IN</span>
                </label>
            </div>
            
            <div style="display: flex; justify-content: flex-end;">
                <button class="loc-btn-primary" onclick="alert('Language preferences saved successfully!')">
                    Save Active Locales
                </button>
            </div>
        </div>
    </div>

    <!-- 2. NOTICE TRANSLATIONS TAB -->
    <div id="tab-messages" class="loc-panel">
        <div class="loc-content-card">
            <h2 class="loc-section-title">Notice String Translations</h2>
            <p class="loc-section-subtitle">Real-time localized strings delivered to patient WhatsApp chats and digital consent notices under Section 5.</p>
            
            <table class="loc-table" style="margin-bottom: 24px;">
                <thead>
                    <tr>
                        <th style="width: 120px;">Language</th>
                        <th style="width: 140px;">Translation Key</th>
                        <th>Localized Value</th>
                        <th style="width: 140px;">Updated</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (safeLocales.length === 0) { %>
                        <tr>
                            <td colspan="4" style="text-align: center; color: var(--text-muted); padding: 24px;">
                                No translations recorded.
                            </td>
                        </tr>
                    <% } else { %>
                        <% safeLocales.forEach(loc => { 
                            let parsed = {};
                            try { parsed = typeof loc.translations === 'string' ? JSON.parse(loc.translations) : (loc.translations || {}); } catch(e) {}
                        %>
                            <% Object.entries(parsed).forEach(([k, v]) => { %>
                                <tr>
                                    <td>
                                        <span style="font-weight: 600; color: white;"><%= loc.language %></span>
                                        <% if (loc.isDefault) { %>
                                            <span style="display: inline-block; font-size: 10px; background: rgba(59, 130, 246, 0.2); color: #93c5fd; padding: 1px 6px; border-radius: 8px; margin-left: 4px;">Default</span>
                                        <% } %>
                                    </td>
                                    <td style="font-family: monospace; font-size: 12px; color: #93c5fd;"><%= k %></td>
                                    <td style="color: white;"><%= v %></td>
                                    <td style="color: var(--text-muted); font-size: 11px;"><%= loc.updatedAt ? new Date(loc.updatedAt).toLocaleDateString() : 'Live' %></td>
                                </tr>
                            <% }) %>
                        <% }) %>
                    <% } %>
                </tbody>
            </table>

            <div style="background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
                <h3 style="font-size: 14px; font-weight: 600; color: white; margin: 0 0 16px 0;">Add / Override Localized String</h3>
                <form id="transForm" onsubmit="handleSaveTranslation(event)">
                    <div style="display: grid; grid-template-columns: 200px 200px 1fr auto; gap: 14px; align-items: flex-end;">
                        <div>
                            <label class="loc-label">Language</label>
                            <select id="transLang" class="loc-select" style="max-width: 100%;">
                                <option value="English">English</option>
                                <option value="Kannada">Kannada</option>
                                <option value="Hindi">Hindi</option>
                            </select>
                        </div>
                        <div>
                            <label class="loc-label">String Key</label>
                            <input type="text" id="transKey" placeholder="e.g. welcome" value="welcome" class="loc-select" style="max-width: 100%; box-sizing: border-box;" required>
                        </div>
                        <div>
                            <label class="loc-label">Translated Text</label>
                            <input type="text" id="transVal" placeholder="Enter translated text..." class="loc-select" style="max-width: 100%; box-sizing: border-box;" required>
                        </div>
                        <button type="submit" class="loc-btn-primary" style="padding: 10px 18px;">
                            Save Translation
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- 3. SETTINGS TAB -->
    <div id="tab-settings" class="loc-panel">
        <div class="loc-content-card">
            <h2 class="loc-section-title">Language Automation Settings</h2>
            <p class="loc-section-subtitle">Configures Section 5 linguistic compliance defaults and automatic script transliteration.</p>
            
            <div style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: white; margin: 0 0 4px 0;">Automated Kannada / Hindi Notice Generation</h3>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 0;">Automatically generate draft Section 5 notices in Kannada and Hindi whenever a new clinical processing purpose is created.</p>
                </div>
                <div class="toggle-switch-ui active" onclick="this.classList.toggle('active')"></div>
            </div>

            <div style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px;">
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: white; margin: 0 0 4px 0;">Patient Auto-Language Detection via WhatsApp Silo</h3>
                    <p style="font-size: 12px; color: var(--text-muted); margin: 0;">Detect incoming WhatsApp message script (Kannada, Devanagari, English) and respond in the patient's preferred language.</p>
                </div>
                <div class="toggle-switch-ui active" onclick="this.classList.toggle('active')"></div>
            </div>

            <button class="loc-btn-primary" onclick="alert('Language automation settings saved!')">Save Language Settings</button>
        </div>
    </div>

    <!-- 4. LIVE BUNDLE PREVIEW TAB -->
    <div id="tab-bundle" class="loc-panel">
        <div class="loc-content-card">
            <h2 class="loc-section-title">Multilingual Live Bundle Inspection</h2>
            <p class="loc-section-subtitle">Side-by-side inspection of localized clinical notices delivered to Aarogya Diagnostic Center patients.</p>
            
            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
                <!-- English -->
                <div style="background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                        <span style="font-size: 15px; font-weight: 700; color: white;">English (en-IN)</span>
                        <span style="font-size: 11px; padding: 2px 8px; border-radius: 10px; background: rgba(59, 130, 246, 0.2); color: #93c5fd;">Default</span>
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; margin-bottom: 4px;">welcome</div>
                    <div style="font-size: 13px; color: white; margin-bottom: 16px;">Welcome to Aarogya Privacy Portal</div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; margin-bottom: 4px;">consentNotice</div>
                    <div style="font-size: 13px; color: white; line-height: 1.4;">Healthcare Diagnostic &amp; Patient Scheduling Notice</div>
                </div>

                <!-- Kannada -->
                <div style="background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                        <span style="font-size: 15px; font-weight: 700; color: white;">ಕನ್ನಡ (kn-IN)</span>
                        <span style="font-size: 11px; padding: 2px 8px; border-radius: 10px; background: rgba(16, 185, 129, 0.2); color: #34d399;">Active</span>
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; margin-bottom: 4px;">welcome</div>
                    <div style="font-size: 13px; color: white; margin-bottom: 16px;">ಆರೋಗ್ಯ ಗೌಪ್ಯತೆ ಪೋರ್ಟಲ್‌ಗೆ ಸುಸ್ವಾಗತ</div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; margin-bottom: 4px;">consentNotice</div>
                    <div style="font-size: 13px; color: white; line-height: 1.4;">ಆರೋಗ್ಯ ರೋಗನಿರ್ಣಯ ಮತ್ತು ನೇಮಕಾತಿ ಸೂಚನೆ</div>
                </div>

                <!-- Hindi -->
                <div style="background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); border-radius: 8px; padding: 20px;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 14px;">
                        <span style="font-size: 15px; font-weight: 700; color: white;">हिन्दी (hi-IN)</span>
                        <span style="font-size: 11px; padding: 2px 8px; border-radius: 10px; background: rgba(16, 185, 129, 0.2); color: #34d399;">Active</span>
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; margin-bottom: 4px;">welcome</div>
                    <div style="font-size: 13px; color: white; margin-bottom: 16px;">आरोग्य गोपनीयता पोर्टल में आपका स्वागत है</div>
                    <div style="font-size: 11px; color: var(--text-muted); font-family: monospace; margin-bottom: 4px;">consentNotice</div>
                    <div style="font-size: 13px; color: white; line-height: 1.4;">आरोग्य डायग्नोस्टिक एवं रोगी परामर्श सूचना</div>
                </div>
            </div>
        </div>
    </div>

</div>

<script>
function switchTab(tabId) {
    document.querySelectorAll('.loc-tab').forEach(t => t.classList.remove('active'));
    event.target.classList.add('active');

    document.querySelectorAll('.loc-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('tab-' + tabId).classList.add('active');
}

async function handleSaveTranslation(e) {
    e.preventDefault();
    const language = document.getElementById('transLang').value;
    const key = document.getElementById('transKey').value.trim();
    const val = document.getElementById('transVal').value.trim();

    try {
        const transObj = {};
        transObj[key] = val;
        const res = await fetch('/api/settings/localization', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                language,
                translations: JSON.stringify(transObj)
            })
        });
        const data = await res.json();
        if (data.success) {
            alert(`Translation for "${key}" in ${language} saved successfully!`);
            window.location.reload();
        } else {
            alert('Failed to save translation: ' + (data.error || 'Unknown error'));
        }
    } catch (err) {
        alert('Error: ' + err.message);
    }
}
</script>

<%- include('partials/footer') %>
