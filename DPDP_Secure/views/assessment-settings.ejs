<%- include('partials/header') %>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Assessment Settings</h1>
    </div>
</div>

<div class="card" style="padding: 40px; max-width: 800px;">
    <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; margin-bottom: 24px;">
        <h3 style="margin: 0 0 16px 0; font-size: 16px;">Notifications</h3>
        <p style="color: var(--text-muted); font-size: 13px; line-height: 1.5; margin: 0 0 24px 0;">
            Control which events trigger an email to the relevant party. Email delivery requires a configured SMTP provider under <strong style="color: var(--text-main);">Notification Center &rarr; Settings</strong>.
        </p>
        
        <div style="display: flex; flex-direction: column; gap: 24px;">
            <!-- Toggle 1 -->
            <div style="display: flex; gap: 16px;">
                <div style="margin-top: 2px;">
                    <label class="switch" style="position: relative; display: inline-block; width: 36px; height: 20px;">
                        <input type="checkbox" checked style="opacity: 0; width: 0; height: 0;">
                        <span class="slider round" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #4f46e5; transition: .4s; border-radius: 20px;">
                            <span style="position: absolute; content: ''; height: 16px; width: 16px; left: 2px; bottom: 2px; background-color: white; transition: .4s; border-radius: 50%; transform: translateX(16px);"></span>
                        </span>
                    </label>
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 14px; margin-bottom: 4px;">Notify assignee on assignment</div>
                    <div style="color: var(--text-muted); font-size: 12px;">Send an email to the assignee when they are added to a DPIA or PIA section.</div>
                </div>
            </div>

            <!-- Toggle 2 -->
            <div style="display: flex; gap: 16px;">
                <div style="margin-top: 2px;">
                    <label class="switch" style="position: relative; display: inline-block; width: 36px; height: 20px;">
                        <input type="checkbox" style="opacity: 0; width: 0; height: 0;">
                        <span class="slider round" style="position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: rgba(255,255,255,0.2); transition: .4s; border-radius: 20px;">
                            <span style="position: absolute; content: ''; height: 16px; width: 16px; left: 2px; bottom: 2px; background-color: white; transition: .4s; border-radius: 50%;"></span>
                        </span>
                    </label>
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 14px; margin-bottom: 4px;">Notify reviewer on status change</div>
                    <div style="color: var(--text-muted); font-size: 12px;">Send an email to the current reviewer whenever the assessment status is updated.</div>
                </div>
            </div>
        </div>
    </div>
    
    <div style="color: var(--text-muted); font-size: 11px; margin-bottom: 24px;">Last updated &middot; 8 Sept 2026</div>
    
    <button class="btn-primary" style="background-color: var(--primary); color: white; border: none; padding: 10px 24px; border-radius: 6px; font-weight: 600; cursor: pointer;">
        Save Settings
    </button>
</div>

<%- include('partials/footer') %>
