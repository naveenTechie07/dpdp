<%- include('partials/header') %>

<style>
.key-form-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8px;
    display: block;
}
.key-input {
    width: 100%;
    background: rgba(0,0,0,0.2);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    margin-bottom: 24px;
}
.scope-group {
    border: 1px solid var(--border-color);
    border-radius: 6px;
    margin-top: 12px;
    background: rgba(0,0,0,0.1);
}
.scope-header {
    padding: 12px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    border-bottom: 1px solid var(--border-color);
}
.scope-list {
    padding: 12px;
}
.checkbox-row {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    margin-bottom: 12px;
}
.checkbox-row:last-child {
    margin-bottom: 0;
}
.action-btn {
    background: rgba(255,255,255,0.05);
    border: 1px solid rgba(255,255,255,0.1);
    color: white;
    padding: 6px 12px;
    border-radius: 16px;
    font-size: 12px;
    font-weight: 500;
    cursor: pointer;
}
.action-btn:hover {
    background: rgba(255,255,255,0.1);
}
.action-btn.revoke {
    background: rgba(239, 68, 68, 0.1);
    border-color: rgba(239, 68, 68, 0.2);
    color: #fca5a5;
}
.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 100;
}
.modal-overlay.active {
    display: flex;
}
.modal-content {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 100%;
    max-width: 500px;
    padding: 24px;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
}
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <div style="margin-bottom: 32px;">
        <h1 style="font-size: 20px; font-weight: 700; color: var(--text-main); margin: 0 0 8px 0;">API Key Vault</h1>
        <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Generate service keys for web, mobile, and backend integrations.</p>
    </div>

    <div style="display: grid; grid-template-columns: 350px 1fr; gap: 24px;">
        <!-- Left: Create new API key -->
        <div class="card">
            <h2 style="font-size: 16px; font-weight: 600; color: white; margin: 0 0 24px 0;">Create new API key</h2>
            
            <label class="key-form-label">Key name <span style="color: #ef4444;">*</span></label>
            <input type="text" class="key-input" placeholder="e.g. production-web">
            
            <label class="key-form-label" style="margin-bottom: 4px;">Scopes</label>
            <input type="text" class="key-input" placeholder="Search scope code or description..." style="margin-bottom: 0;">
            
            <div class="scope-group" style="margin-bottom: 24px;">
                <div class="scope-header">
                    <div>
                        <div style="font-size: 13px; font-weight: 600; color: white;">Consent Management</div>
                        <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">CONSENT_LEDGER &middot; 1 scope</div>
                    </div>
                    <div style="font-size: 11px; color: var(--text-muted);">0 selected</div>
                </div>
                <div class="scope-list">
                    <label class="checkbox-row">
                        <input type="checkbox" style="margin-top: 2px;">
                        <span style="font-size: 13px; color: var(--text-main);">Select all</span>
                    </label>
                    <div style="margin: 8px 0; border-bottom: 1px solid var(--border-color);"></div>
                    <label class="checkbox-row">
                        <input type="checkbox" style="margin-top: 2px;">
                        <div>
                            <div style="font-size: 13px; font-weight: 600; color: white; margin-bottom: 2px;">consent.capture</div>
                            <div style="font-size: 12px; color: var(--text-muted);">Capture end-user consent events</div>
                        </div>
                    </label>
                </div>
            </div>
            
            <label class="key-form-label">Expiry date <span style="font-weight: 400; color: var(--text-muted);">(optional)</span></label>
            <div style="position: relative;">
                <input type="text" class="key-input" placeholder="dd-mm-yyyy" style="padding-right: 36px;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="position: absolute; right: 12px; top: 11px; color: var(--text-muted);"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
            </div>
            
            <button class="btn-primary" style="background: #be185d; border: 1px solid #9d174d; color: white; padding: 12px; border-radius: 6px; font-size: 14px; font-weight: 600; width: 100%;">Generate API Key</button>
        </div>

        <!-- Right: Existing keys -->
        <div class="card p-0">
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color);">
                <h2 style="font-size: 16px; font-weight: 600; color: white; margin: 0;">Existing keys</h2>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="padding-left: 24px;">NAME</th>
                            <th>PREFIX</th>
                            <th>SCOPES</th>
                            <th>STATUS</th>
                            <th>EXPIRES</th>
                            <th>CREATED</th>
                            <th style="padding-right: 24px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding-left: 24px; font-weight: 600; color: white;">dpdp_secure-web</td>
                            <td><span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; background: rgba(255,255,255,0.05); color: var(--text-muted); font-family: monospace;">cmp_fs_web</span></td>
                            <td style="color: var(--text-muted);">none</td>
                            <td><span style="display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">Active</span></td>
                            <td style="color: var(--text-muted);">Never</td>
                            <td style="color: var(--text-muted);">29 Aug 2026, 03:03 pm</td>
                            <td style="padding-right: 24px;">
                                <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                    <button class="action-btn">Usage</button>
                                    <button class="action-btn" onclick="openModal()">Edit scopes</button>
                                    <button class="action-btn revoke">Revoke</button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-left: 24px; font-weight: 600; color: white;">dpdp_secure-mobile</td>
                            <td><span style="display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; background: rgba(255,255,255,0.05); color: var(--text-muted); font-family: monospace;">cmp_fs_mob</span></td>
                            <td style="color: var(--text-muted);">none</td>
                            <td><span style="display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; background: rgba(16, 185, 129, 0.2); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3);">Active</span></td>
                            <td style="color: var(--text-muted);">Never</td>
                            <td style="color: var(--text-muted);">29 Aug 2026, 03:03 pm</td>
                            <td style="padding-right: 24px;">
                                <div style="display: flex; gap: 8px; justify-content: flex-end;">
                                    <button class="action-btn">Usage</button>
                                    <button class="action-btn" onclick="openModal()">Edit scopes</button>
                                    <button class="action-btn revoke">Revoke</button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Overlay -->
<div class="modal-overlay" id="editScopesModal">
    <div class="modal-content">
        <h2 style="font-size: 18px; font-weight: 700; color: white; margin: 0 0 4px 0;">Edit scopes</h2>
        <p style="color: var(--text-muted); font-size: 13px; margin: 0 0 24px 0;">dpdp_secure-mobile &mdash; changes apply immediately; the key itself never changes.</p>
        
        <input type="text" class="key-input" placeholder="Search scope code or description..." style="margin-bottom: 0;">
        
        <div class="scope-group" style="margin-bottom: 24px;">
            <div class="scope-header">
                <div>
                    <div style="font-size: 13px; font-weight: 600; color: white;">Consent Management</div>
                    <div style="font-size: 11px; color: var(--text-muted); text-transform: uppercase;">CONSENT_LEDGER &middot; 1 scope</div>
                </div>
                <div style="font-size: 11px; color: var(--text-muted);">0 selected</div>
            </div>
            <div class="scope-list">
                <label class="checkbox-row">
                    <input type="checkbox" style="margin-top: 2px;">
                    <span style="font-size: 13px; color: var(--text-main);">Select all</span>
                </label>
                <div style="margin: 8px 0; border-bottom: 1px solid var(--border-color);"></div>
                <label class="checkbox-row">
                    <input type="checkbox" style="margin-top: 2px;">
                    <div>
                        <div style="font-size: 13px; font-weight: 600; color: white; margin-bottom: 2px;">consent.capture</div>
                        <div style="font-size: 12px; color: var(--text-muted);">Capture end-user consent events</div>
                    </div>
                </label>
            </div>
        </div>
        
        <div style="display: flex; gap: 12px; justify-content: flex-end;">
            <button onclick="closeModal()" class="action-btn" style="padding: 10px 20px; font-size: 14px; background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); border-radius: 6px;">Cancel</button>
            <button class="btn-primary" style="background: #be185d; border: 1px solid #9d174d; color: white; padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 600;">Save changes</button>
        </div>
    </div>
</div>

<script>
function openModal() {
    document.getElementById('editScopesModal').classList.add('active');
}
function closeModal() {
    document.getElementById('editScopesModal').classList.remove('active');
}
</script>

<%- include('partials/footer') %>
