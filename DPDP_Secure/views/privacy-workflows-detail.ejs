<%- include('partials/header') %>

<div class="dashboard-header mb-4">
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
        <a href="/privacy/workflows" style="color: var(--text-muted); display: flex; align-items: center; text-decoration: none;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
        </a>
        <h1 class="page-title" style="margin-bottom: 0;"><%= title.split(' - ')[0] %></h1>
        <span style="color: var(--text-muted); font-size: 12px; cursor: pointer; text-decoration: underline;">edit</span>
    </div>
    <p class="page-description" style="margin-bottom: 4px;"><%= description %></p>
    <div style="color: var(--text-muted); font-size: 12px;">3 stages</div>
</div>

<div style="display: flex; gap: 24px; align-items: flex-start;">
    
    <!-- Left Column: Stages -->
    <div class="card p-0" style="flex: 1; min-width: 300px;">
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <h2 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0;">Stages</h2>
            <button class="btn-secondary" style="padding: 6px 12px; font-size: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main); display: flex; align-items: center; gap: 6px;">
                <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add Stage
            </button>
        </div>
        
        <div style="display: flex; flex-direction: column;">
            
            <!-- Stage 1 -->
            <div id="stage-intake" class="stage-item active" onclick="selectStage('intake')" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; align-items: flex-start; gap: 16px; cursor: pointer; background: #f3f4f6; color: #111827;">
                <div style="width: 28px; height: 28px; border-radius: 50%; background: #6366f1; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0;">
                    1
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 14px; margin-bottom: 2px;">Intake</div>
                    <div style="font-size: 12px; opacity: 0.7;">2 task templates</div>
                </div>
            </div>

            <!-- Stage 2 -->
            <div id="stage-processing" class="stage-item" onclick="selectStage('processing')" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; align-items: flex-start; gap: 16px; cursor: pointer; color: var(--text-main);">
                <div style="width: 28px; height: 28px; border-radius: 50%; background: #f59e0b; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0;">
                    2
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 14px; margin-bottom: 2px;">Processing</div>
                    <div style="color: var(--text-muted); font-size: 12px;">2 task templates</div>
                </div>
            </div>

            <!-- Stage 3 -->
            <div style="padding: 16px 24px; display: flex; align-items: flex-start; gap: 16px; cursor: pointer; color: var(--text-main);">
                <div style="width: 28px; height: 28px; border-radius: 50%; background: #10b981; color: white; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; flex-shrink: 0;">
                    3
                </div>
                <div>
                    <div style="font-weight: 600; font-size: 14px; margin-bottom: 2px; display: flex; align-items: center; gap: 8px;">
                        Resolved
                        <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">Terminal</span>
                    </div>
                    <div style="color: var(--text-muted); font-size: 12px;">0 task templates</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Right Column: Task Templates -->
    <div class="card p-0" style="flex: 2;">
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <h2 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0; display: flex; align-items: center; gap: 8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="opacity: 0.6;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
                Task Templates &mdash; <span id="current-stage-name" style="color: var(--text-muted); font-weight: 400;">Intake</span>
            </h2>
            <button class="btn-secondary" style="padding: 6px 12px; font-size: 12px; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main); display: flex; align-items: center; gap: 6px;">
                <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add Template
            </button>
        </div>

        <!-- Intake Templates -->
        <div id="templates-intake" style="display: block;">
            
            <div style="padding: 24px; border-bottom: 1px solid var(--border-color); display: flex; gap: 16px; align-items: flex-start;">
                <div style="color: var(--text-muted); font-weight: 600; font-size: 14px; margin-top: 2px;">1</div>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;">
                            Send DPDPA acknowledgement
                            <span style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">Mandatory</span>
                        </div>
                        <button style="background: none; border: none; color: var(--text-muted); cursor: pointer;"><svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                    </div>
                    <div style="color: var(--text-muted); font-size: 11px; margin-bottom: 12px;">Assignee: privacy_admin@dpdpsecure.in &nbsp;&nbsp; Due: 3d after stage entry</div>
                    <div style="color: var(--text-muted); font-size: 12px; font-style: italic;">"Acknowledge within 72 hours per DPDPA 2023."</div>
                </div>
            </div>

            <div style="padding: 24px; display: flex; gap: 16px; align-items: flex-start;">
                <div style="color: var(--text-muted); font-weight: 600; font-size: 14px; margin-top: 2px;">2</div>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;">
                            Verify identity via OTP
                            <span style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">Mandatory</span>
                        </div>
                        <button style="background: none; border: none; color: var(--text-muted); cursor: pointer;"><svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                    </div>
                    <div style="color: var(--text-muted); font-size: 11px; margin-bottom: 12px;">Assignee: privacy_admin@dpdpsecure.in &nbsp;&nbsp; Due: 2d after stage entry</div>
                    <div style="color: var(--text-muted); font-size: 12px; font-style: italic;">"Confirm via registered mobile OTP and PAN (for financial data requests)."</div>
                </div>
            </div>

        </div>

        <!-- Processing Templates (Hidden by default) -->
        <div id="templates-processing" style="display: none;">
            
            <div style="padding: 24px; border-bottom: 1px solid var(--border-color); display: flex; gap: 16px; align-items: flex-start;">
                <div style="color: var(--text-muted); font-weight: 600; font-size: 14px; margin-top: 2px;">1</div>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;">
                            Retrieve data from all DPDP_Secure systems
                            <span style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">Mandatory</span>
                        </div>
                        <button style="background: none; border: none; color: var(--text-muted); cursor: pointer;"><svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2-2v2"></path></svg></button>
                    </div>
                    <div style="color: var(--text-muted); font-size: 11px; margin-bottom: 12px;">Assignee: ops_admin@dpdpsecure.in &nbsp;&nbsp; Due: 14d after stage entry</div>
                    <div style="color: var(--text-muted); font-size: 12px; font-style: italic;">"Pull records from loan origination, CRM, UPI history, and credit bureau submissions."</div>
                </div>
            </div>

            <div style="padding: 24px; display: flex; gap: 16px; align-items: flex-start;">
                <div style="color: var(--text-muted); font-weight: 600; font-size: 14px; margin-top: 2px;">2</div>
                <div style="flex-grow: 1;">
                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                        <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px; display: flex; align-items: center; gap: 8px;">
                            Check RBI retention obligations before deletion
                            <span style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">Mandatory</span>
                        </div>
                        <button style="background: none; border: none; color: var(--text-muted); cursor: pointer;"><svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg></button>
                    </div>
                    <div style="color: var(--text-muted); font-size: 11px; margin-bottom: 12px;">Assignee: dpo@dpdpsecure.in &nbsp;&nbsp; Due: 7d after stage entry</div>
                    <div style="color: var(--text-muted); font-size: 12px; font-style: italic;">"Confirm RBI KYC Master Direction retention requirements (7 - 10 years) before executing any erasure."</div>
                </div>
            </div>

        </div>

    </div>
</div>

<script>
    function selectStage(stage) {
        // Reset styles
        document.getElementById('stage-intake').style.background = 'transparent';
        document.getElementById('stage-intake').style.color = 'var(--text-main)';
        document.getElementById('stage-intake').querySelector('div > div:nth-child(2)').style.color = 'var(--text-muted)';
        
        document.getElementById('stage-processing').style.background = 'transparent';
        document.getElementById('stage-processing').style.color = 'var(--text-main)';
        document.getElementById('stage-processing').querySelector('div > div:nth-child(2)').style.color = 'var(--text-muted)';

        // Hide all templates
        document.getElementById('templates-intake').style.display = 'none';
        document.getElementById('templates-processing').style.display = 'none';

        // Apply active styles
        const activeStage = document.getElementById(`stage-${stage}`);
        activeStage.style.background = '#f3f4f6';
        activeStage.style.color = '#111827';
        activeStage.querySelector('div > div:nth-child(2)').style.color = 'rgba(17, 24, 39, 0.7)';

        // Show active templates
        document.getElementById(`templates-${stage}`).style.display = 'block';

        // Update header text
        document.getElementById('current-stage-name').innerText = stage.charAt(0).toUpperCase() + stage.slice(1);
    }
</script>

<%- include('partials/footer') %>
