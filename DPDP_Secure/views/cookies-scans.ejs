<%- include('partials/header') %>

<div class="dashboard-header mb-4">
    <div>
        <h1 class="page-title">Site scans</h1>
        <p class="page-description">Crawl a website to automatically discover cookies, pixels, and tracking SDKs.</p>
    </div>
</div>

<div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px; margin-bottom: 24px;">
    <div style="display: flex; gap: 24px; align-items: flex-end;">
        <div style="flex: 2;">
            <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Website URL</label>
            <input type="text" value="https://" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
        </div>
        <div style="flex: 1; display: flex; gap: 16px; align-items: flex-end;">
            <div>
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Max pages</label>
                <div style="position: relative;">
                    <input type="number" value="50" style="width: 80px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                    <div style="position: absolute; right: 8px; top: 0; bottom: 0; display: flex; flex-direction: column; justify-content: center; gap: 4px;">
                        <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="3" fill="none"><polyline points="18 15 12 9 6 15"></polyline></svg>
                        <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="3" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                </div>
            </div>
            <div style="display: flex; align-items: center; gap: 8px; padding-bottom: 10px;">
                <input type="checkbox" style="width: 16px; height: 16px; accent-color: #ec4899; cursor: pointer;">
                <span style="font-size: 13px; color: var(--text-main);">Scan all pages</span>
            </div>
        </div>
        <div style="display: flex; gap: 12px;">
            <button class="btn-secondary" style="padding: 10px 16px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
                Estimate pages
            </button>
            <button class="btn-primary" style="padding: 10px 24px; font-size: 14px;">Start scan</button>
        </div>
    </div>
</div>

<div class="card p-0" style="overflow: hidden; display: flex; flex-direction: column;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 350px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search scans..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left; flex-grow: 1;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                <th style="padding: 16px 24px;">ID <svg style="display:inline; vertical-align:middle; width:12px; height:12px; opacity: 0.5;" viewBox="0 0 24 24" fill="currentColor"><path d="M7 14l5-5 5 5z"/></svg></th>
                <th style="padding: 16px 16px;">Site <svg style="display:inline; vertical-align:middle; width:12px; height:12px; opacity: 0.5;" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/><path d="M7 14l5-5 5 5z"/></svg></th>
                <th style="padding: 16px 16px;">Status <svg style="display:inline; vertical-align:middle; width:12px; height:12px; opacity: 0.5;" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/><path d="M7 14l5-5 5 5z"/></svg></th>
                <th style="padding: 16px 16px;">PROGRESS</th>
                <th style="padding: 16px 16px;">Trackers <svg style="display:inline; vertical-align:middle; width:12px; height:12px; opacity: 0.5;" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/><path d="M7 14l5-5 5 5z"/></svg></th>
                <th style="padding: 16px 16px;">Started <svg style="display:inline; vertical-align:middle; width:12px; height:12px; opacity: 0.5;" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/><path d="M7 14l5-5 5 5z"/></svg></th>
                <th style="padding: 16px 16px;">Completed <svg style="display:inline; vertical-align:middle; width:12px; height:12px; opacity: 0.5;" viewBox="0 0 24 24" fill="currentColor"><path d="M7 10l5 5 5-5z"/><path d="M7 14l5-5 5 5z"/></svg></th>
                <th style="padding: 16px 24px;"></th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <!-- Row 1 -->
            <tr style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'" onclick="window.location.href='/cookies/scans/11'">
                <td style="padding: 16px 24px; color: var(--text-muted);">#11</td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">https://www.dpdpsecure.in</td>
                <td style="padding: 16px 16px;">
                    <div style="display: flex; align-items: center; gap: 6px; color: #10b981; font-weight: 500;">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        Completed
                    </div>
                </td>
                <td style="padding: 16px 16px;">
                    <span style="font-weight: 600; color: var(--text-main);">1</span> <span style="color: var(--text-muted); font-size: 11px;">pages</span>
                </td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-muted);">--</td>
                <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">09 Sept 2026, 11:52 am</td>
                <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">09 Sept 2026, 11:52 am</td>
                <td style="padding: 16px 24px; text-align: right; color: var(--text-muted);">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="cursor: pointer; margin-right: 12px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="cursor: pointer;"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                </td>
            </tr>
            
            <!-- Row 2 -->
            <tr style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px; color: var(--text-muted);">#1</td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">https://app.dpdpsecure.in</td>
                <td style="padding: 16px 16px;">
                    <div style="display: flex; align-items: center; gap: 6px; color: #10b981; font-weight: 500;">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        Completed
                    </div>
                </td>
                <td style="padding: 16px 16px;">
                    <span style="font-weight: 600; color: var(--text-main);">12</span> <span style="color: var(--text-muted); font-size: 11px;">pages</span>
                </td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">3</td>
                <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">--</td>
                <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;">--</td>
                <td style="padding: 16px 24px; text-align: right; color: var(--text-muted);">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="cursor: pointer; margin-right: 12px;"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="cursor: pointer;"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                </td>
            </tr>
        </tbody>
    </table>
    
    <div class="table-toolbar" style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center; margin-top: auto;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
