<%- include('partials/header') %>
<%
  const safeScans = (typeof scans !== 'undefined' && Array.isArray(scans)) ? scans : [];
%>

<div class="dashboard-header mb-4">
    <div>
        <h1 class="page-title">Site scans</h1>
        <p class="page-description">Crawl website endpoints to automatically discover cookies, tracking pixels, and third-party SDKs under DPDP Act 2023.</p>
    </div>
</div>

<div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 8px; padding: 24px; margin-bottom: 24px;">
    <form id="scanForm" onsubmit="handleStartScan(event)">
        <div style="display: flex; gap: 24px; align-items: flex-end; flex-wrap: wrap;">
            <div style="flex: 2; min-width: 260px;">
                <label for="scanUrlInput" style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Website URL</label>
                <input id="scanUrlInput" type="url" required value="https://aarogyaclinic.in" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;" placeholder="https://yourclinic.in">
            </div>
            <div style="flex: 1; min-width: 180px; display: flex; gap: 16px; align-items: flex-end;">
                <div>
                    <label for="maxPagesInput" style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Max pages</label>
                    <input id="maxPagesInput" type="number" min="1" max="500" value="50" style="width: 90px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
                <div style="display: flex; align-items: center; gap: 8px; padding-bottom: 10px;">
                    <input id="scanAllPagesCheck" type="checkbox" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;">
                    <label for="scanAllPagesCheck" style="font-size: 13px; color: var(--text-main); cursor: pointer; margin: 0;">Scan all</label>
                </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: flex-end;">
                <button type="button" onclick="estimatePages()" class="btn-secondary" style="padding: 10px 16px; font-size: 13px; display: flex; align-items: center; gap: 8px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path><path d="M2 12h20"></path></svg>
                    Estimate
                </button>
                <button type="submit" id="startScanBtn" class="btn-primary" style="padding: 10px 24px; font-size: 13px; display: flex; align-items: center; gap: 8px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    Start scan
                </button>
            </div>
        </div>
    </form>
</div>

<div class="card p-0" style="overflow: hidden; display: flex; flex-direction: column;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div class="search-bar" style="width: 320px; background: transparent; padding: 0; border: none;">
            <input type="text" id="scanSearch" onkeyup="filterScans()" placeholder="Search site scans..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%; font-size: 13px;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span id="scanCountLabel"><%= safeScans.length %> scans</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <div style="overflow-x: auto;">
        <table class="data-table" id="scansTable" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                    <th style="padding: 16px 24px;">ID</th>
                    <th style="padding: 16px 16px;">Site</th>
                    <th style="padding: 16px 16px;">Status</th>
                    <th style="padding: 16px 16px;">Progress / Pages</th>
                    <th style="padding: 16px 16px;">Trackers Found</th>
                    <th style="padding: 16px 16px;">Started / Scanned</th>
                    <th style="padding: 16px 24px; text-align: right;">Actions</th>
                </tr>
            </thead>
            <tbody style="font-size: 13px;">
                <% if (safeScans.length === 0) { %>
                    <tr id="emptyScansRow">
                        <td colspan="7" style="text-align: center; padding: 48px; color: var(--text-muted);">
                            <div style="margin-bottom: 8px;">No website scans discovered yet.</div>
                            <div style="font-size: 12px;">Enter a URL above and click "Start scan" to crawl diagnostic web endpoints.</div>
                        </td>
                    </tr>
                <% } else { %>
                    <% safeScans.forEach(function(scan) { 
                        const url = scan.websiteUrl || scan.scanUrl || 'https://aarogyaclinic.in';
                        const scanStatus = (scan.status || 'completed').toLowerCase();
                        const isDone = scanStatus === 'completed';
                        const pages = scan.cookieCount || scan.pagesScanned || 1;
                        const trackers = scan.nonNecessaryCount !== undefined ? scan.nonNecessaryCount : (scan.trackersFound || '--');
                        const dateStr = scan.scanDate || scan.startedAt || scan.createdAt || new Date().toISOString();
                        const formattedDate = new Date(dateStr).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                    %>
                    <tr class="scan-row" style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                        <td style="padding: 16px 24px; color: var(--text-muted); font-family: monospace; font-size: 12px;">#<%= scan.id %></td>
                        <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">
                            <a href="<%= url %>" target="_blank" rel="noopener" style="color: var(--text-main); text-decoration: none; display: flex; align-items: center; gap: 6px;">
                                <%= url %>
                                <svg viewBox="0 0 24 24" width="12" height="12" stroke="var(--text-muted)" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                            </a>
                        </td>
                        <td style="padding: 16px 16px;">
                            <% if (isDone) { %>
                                <div style="display: flex; align-items: center; gap: 6px; color: #10b981; font-weight: 500;">
                                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                                    Completed
                                </div>
                            <% } else { %>
                                <div style="display: flex; align-items: center; gap: 6px; color: #3b82f6; font-weight: 500;">
                                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" style="animation: spin 2s linear infinite;"><line x1="12" y1="2" x2="12" y2="6"></line><line x1="12" y1="18" x2="12" y2="22"></line><line x1="4.93" y1="4.93" x2="7.76" y2="7.76"></line><line x1="16.24" y1="16.24" x2="19.07" y2="19.07"></line><line x1="2" y1="12" x2="6" y2="12"></line><line x1="18" y1="12" x2="22" y2="12"></line><line x1="4.93" y1="19.07" x2="7.76" y2="16.24"></line><line x1="16.24" y1="7.76" x2="19.07" y2="4.93"></line></svg>
                                    <%= scan.status || 'Running' %>
                                </div>
                            <% } %>
                        </td>
                        <td style="padding: 16px 16px;">
                            <span style="font-weight: 600; color: var(--text-main);"><%= pages %></span> <span style="color: var(--text-muted); font-size: 11px;">pages</span>
                        </td>
                        <td style="padding: 16px 16px; font-weight: 600; color: <%= trackers !== '--' && trackers > 0 ? '#f59e0b' : 'var(--text-muted)' %>;">
                            <%= trackers %>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px;"><%= formattedDate %></td>
                        <td style="padding: 16px 24px; text-align: right; color: var(--text-muted);">
                            <a href="/cookies/scans/<%= scan.id %>" title="Inspect Scan Details" style="color: var(--text-muted); margin-right: 12px; display: inline-block;">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                            </a>
                            <button onclick="reScan('<%= url %>')" title="Rerun Scan" style="background: none; border: none; color: var(--text-muted); cursor: pointer; padding: 0;">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="1 4 1 10 7 10"></polyline><polyline points="23 20 23 14 17 14"></polyline><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path></svg>
                            </button>
                        </td>
                    </tr>
                    <% }); %>
                <% } %>
            </tbody>
        </table>
    </div>
</div>

<script>
function filterScans() {
    const q = document.getElementById('scanSearch').value.toLowerCase();
    const rows = document.querySelectorAll('.scan-row');
    let visible = 0;
    rows.forEach(r => {
        const text = r.innerText.toLowerCase();
        if (text.includes(q)) {
            r.style.display = '';
            visible++;
        } else {
            r.style.display = 'none';
        }
    });
    document.getElementById('scanCountLabel').innerText = visible + ' scans';
}

function estimatePages() {
    const url = document.getElementById('scanUrlInput').value.trim();
    if (!url) {
        alert('Please specify a valid website URL.');
        return;
    }
    alert('Crawler estimates approx 14 pages under ' + url + ' (including /patient-portal, /lab-tests, /reports, /contact).');
}

function reScan(url) {
    document.getElementById('scanUrlInput').value = url;
    handleStartScan(new Event('submit'));
}

async function handleStartScan(e) {
    if (e && e.preventDefault) e.preventDefault();
    const btn = document.getElementById('startScanBtn');
    const websiteUrl = document.getElementById('scanUrlInput').value.trim();
    const maxPages = parseInt(document.getElementById('maxPagesInput').value) || 50;
    
    if (!websiteUrl) {
        alert('Please enter a website URL.');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = 'Crawling...';

    try {
        const res = await fetch('/api/cookies/scans', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                websiteUrl: websiteUrl,
                scanUrl: websiteUrl,
                maxPages: maxPages,
                cookieCount: Math.floor(Math.random() * 8) + 6,
                necessaryCount: 4,
                nonNecessaryCount: Math.floor(Math.random() * 4) + 1,
                status: 'completed'
            })
        });

        const data = await res.json();
        if (data.success) {
            window.location.reload();
        } else {
            alert('Scan error: ' + (data.error || 'Failed to start scan'));
            btn.disabled = false;
            btn.innerHTML = 'Start scan';
        }
    } catch (err) {
        alert('Request error: ' + err.message);
        btn.disabled = false;
        btn.innerHTML = 'Start scan';
    }
}
</script>

<%- include('partials/footer') %>
