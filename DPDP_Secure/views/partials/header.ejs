        <div class="main-wrapper">
            <!-- Topbar -->
            <header class="topbar">
                <div class="breadcrumb">
                    <% if (typeof breadcrumbs !== 'undefined') { %>
                        <% breadcrumbs.forEach((crumb, index) => { %>
                            <% if (index === breadcrumbs.length - 1) { %>
                                <strong><%= crumb %></strong>
                            <% } else { %>
                                <%= crumb %> <span class="divider">&gt;</span>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        Workspace <span class="divider">&gt;</span> <strong>Dashboard</strong>
                    <% } %>
                </div>
                
                <div style="position: relative; flex: 1; max-width: 400px; margin: 0 32px;">
                    <div class="search-bar" style="width: 100%;">
                        <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" class="search-input" placeholder="Search records, modules..." value="te" id="globalSearchInput" style="width: 100%;">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none" style="cursor: pointer; position: absolute; right: 12px; top: 12px;"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </div>
                    
                    <!-- Global Search Dropdown -->
                    <div id="globalSearchDropdown" style="display: none; position: absolute; top: 100%; left: 0; width: 100%; background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 8px; margin-top: 8px; z-index: 200; box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.5); overflow: hidden;">
                        <div style="padding: 8px 0;">
                            <% const searchResults = [
                                {icon: 'search', title: 'Connectors & Scans', sub: 'Data Intelligence'},
                                {icon: 'search', title: 'Data Assets', sub: 'Data Intelligence'},
                                {icon: 'none', title: 'Classification Tags', sub: 'Data Intelligence', highlight: true},
                                {icon: 'search', title: 'Processing Activities', sub: 'Data Intelligence'},
                                {icon: 'search', title: 'Data Lineage', sub: 'Data Intelligence'},
                                {icon: 'search', title: 'Assessment Enrichment', sub: 'Data Intelligence'},
                                {icon: 'search', title: 'Data Processors', sub: 'Data Intelligence'},
                                {icon: 'search', title: 'Retention', sub: 'Data Intelligence'}
                            ] %>
                            <% searchResults.forEach(res => { %>
                                <div style="display: flex; gap: 12px; padding: 12px 16px; align-items: center; cursor: pointer; <%= res.highlight ? 'background: rgba(253, 226, 237, 0.9); color: #831843;' : 'color: white;' %>" class="search-result-item">
                                    <% if (res.icon === 'search') { %>
                                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="opacity: 0.5;"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                                    <% } else { %>
                                        <div style="width: 16px; height: 16px; background: rgba(0,0,0,0.1); border-radius: 4px;"></div>
                                    <% } %>
                                    <div>
                                        <div style="font-size: 13px; font-weight: 600; margin-bottom: 2px; <%= res.highlight ? 'color: #831843;' : 'color: white;' %>"><%= res.title %></div>
                                        <div style="font-size: 11px; font-weight: 500; <%= res.highlight ? 'color: #9d174d;' : 'color: var(--text-muted);' %>"><%= res.sub %></div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
    
                <script>
                const searchInput = document.getElementById('globalSearchInput');
                const searchDropdown = document.getElementById('globalSearchDropdown');
                searchInput.addEventListener('focus', () => { searchDropdown.style.display = 'block'; });
                document.addEventListener('click', (e) => {
                    if (!searchInput.contains(e.target) && !searchDropdown.contains(e.target)) {
                        searchDropdown.style.display = 'none';
                    }
                });
                </script>

