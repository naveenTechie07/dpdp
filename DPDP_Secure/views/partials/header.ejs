<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'DPDP_Secure - Enterprise Privacy Operating System' %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'India DPDP Act 2023 Compliance & Data Protection Suite for Small Businesses' %>">
    <link rel="stylesheet" href="/css/style.css">
    <script>
        (function() {
            var theme = localStorage.getItem('theme');
            if (theme) {
                document.documentElement.setAttribute('data-theme', theme);
            }
        })();
    </script>
</head>
<body>
    <div class="app-container">
        <!-- Sidebar Navigation -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <div class="logo-icon">
                    <svg viewBox="0 0 24 24" width="22" height="22" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div class="logo-text">
                    <h2>DPDP_Secure</h2>
                    <p>SME Privacy Suite &bull; India 2023</p>
                </div>
            </div>

            <!-- Active SME Tenant Profile Card -->
            <div class="sidebar-user">
                <div class="user-icon" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path><polyline points="9 22 9 12 15 12 15 22"></polyline></svg>
                </div>
                <div class="user-info truncate-text">
                    <h3 class="truncate-text"><%= (typeof tenant !== 'undefined' && tenant && tenant.name) ? tenant.name : 'Aarogya Diagnostic Center' %></h3>
                    <p class="truncate-text">Indiranagar &bull; Health SME</p>
                </div>
            </div>

            <nav class="sidebar-nav">
                <!-- 1. WORKSPACE OVERVIEW -->
                <div class="nav-section expanded">
                    <div class="nav-section-header" onclick="toggleNavSection(this)">
                        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        <span class="title">WORKSPACE OVERVIEW</span>
                        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                    <div class="nav-section-content">
                        <a href="/" class="nav-item <%= typeof path !== 'undefined' && path === '/' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                            Executive Dashboard
                        </a>
                        <a href="/profile" class="nav-item <%= typeof path !== 'undefined' && path === '/profile' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            User Profile
                        </a>
                        <a href="/about" class="nav-item <%= typeof path !== 'undefined' && path === '/about' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
                            About Platform
                        </a>
                    </div>
                </div>

                <!-- 2. PILLAR 1: DATA DISCOVERY & ROPA -->
                <div class="nav-section expanded">
                    <div class="nav-section-header" onclick="toggleNavSection(this)">
                        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path></svg>
                        <span class="title">PILLAR 1: DISCOVERY &amp; ROPA</span>
                        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                    <div class="nav-section-content">
                        <a href="/discovery/connectors" class="nav-item <%= typeof path === 'string' && path.includes('/discovery') ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
                            Data Discovery & Connectors
                        </a>
                        <a href="/inventory/ropa" class="nav-item <%= typeof path !== 'undefined' && path === '/inventory/ropa' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
                            RoPA Register (Section 8)
                        </a>
                        <a href="/inventory/assets" class="nav-item <%= typeof path !== 'undefined' && path === '/inventory/assets' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path></svg>
                            Data Assets Catalog
                        </a>
                        <a href="/inventory/tags" class="nav-item <%= typeof path !== 'undefined' && path === '/inventory/tags' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path><line x1="7" y1="7" x2="7.01" y2="7"></line></svg>
                            Classification Tags (PII)
                        </a>
                        <a href="/inventory/lineage" class="nav-item <%= typeof path !== 'undefined' && path === '/inventory/lineage' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"></line></svg>
                            Data Lineage
                        </a>
                    </div>
                </div>

                <!-- 3. PILLAR 2: CONSENT & NOTICES -->
                <div class="nav-section expanded">
                    <div class="nav-section-header" onclick="toggleNavSection(this)">
                        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><polyline points="9 11 12 14 22 4"></polyline><path d="M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11"></path></svg>
                        <span class="title">PILLAR 2: CONSENT &amp; NOTICES</span>
                        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                    <div class="nav-section-content">
                        <a href="/consent/collection-points" class="nav-item <%= typeof path !== 'undefined' && path === '/consent/collection-points' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="9" y1="3" x2="9" y2="21"></line></svg>
                            Multilingual Section 5 Notices
                        </a>
                        <a href="/consent/ledger" class="nav-item <%= typeof path !== 'undefined' && path === '/consent/ledger' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                            Consent Event Ledger (SHA-256)
                        </a>
                        <a href="/consent/purposes" class="nav-item <%= typeof path !== 'undefined' && path === '/consent/purposes' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                            Specified Purpose Library
                        </a>
                        <a href="/cookies/dashboard" class="nav-item <%= typeof path === 'string' && path.includes('/cookies') ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                            Cookie Governance
                        </a>
                    </div>
                </div>

                <!-- 4. PILLAR 3: CITIZEN RIGHTS & DSR -->
                <div class="nav-section expanded">
                    <div class="nav-section-header" onclick="toggleNavSection(this)">
                        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                        <span class="title">PILLAR 3: CITIZEN RIGHTS (DSR)</span>
                        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                    <div class="nav-section-content">
                        <a href="/privacy/requests" class="nav-item <%= typeof path !== 'undefined' && path === '/privacy/requests' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line></svg>
                            Section 11/12 Requests Queue
                        </a>
                        <a href="/privacy/workflows" class="nav-item <%= typeof path !== 'undefined' && path === '/privacy/workflows' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="18" cy="5" r="3"></circle><circle cx="6" cy="12" r="3"></circle><circle cx="18" cy="19" r="3"></circle><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"></line></svg>
                            Tax-Lock Collision Workflows
                        </a>
                        <a href="/dsr" target="_blank" class="nav-item">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                            Public Citizen Portal (/dsr)
                        </a>
                    </div>
                </div>

                <!-- 5. PILLAR 4: BREACH TRIAGE & DPBI -->
                <div class="nav-section expanded">
                    <div class="nav-section-header" onclick="toggleNavSection(this)">
                        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>
                        <span class="title">PILLAR 4: BREACH &amp; DPBI</span>
                        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                    <div class="nav-section-content">
                        <a href="/incidents/management" class="nav-item <%= typeof path !== 'undefined' && path === '/incidents/management' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                            Incident Command &amp; Triage
                        </a>
                        <a href="/incidents/dashboard" class="nav-item <%= typeof path !== 'undefined' && path === '/incidents/dashboard' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="20" x2="18" y2="10"></line><line x1="12" y1="20" x2="12" y2="4"></line><line x1="6" y1="20" x2="6" y2="14"></line></svg>
                            Breach Posture Dashboard
                        </a>
                        <a href="/notifications/center" class="nav-item <%= typeof path !== 'undefined' && path === '/notifications/center' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                            72h DPBI &amp; Citizen Dispatch
                        </a>
                    </div>
                </div>

                <!-- SYSTEM ADMINISTRATION & GOVERNANCE -->
                <div class="nav-section">
                    <div class="nav-section-header" onclick="toggleNavSection(this)">
                        <svg class="icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"></path></svg>
                        <span class="title">ADMINISTRATION</span>
                        <svg class="chevron" viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="6 9 12 15 18 9"></polyline></svg>
                    </div>
                    <div class="nav-section-content">
                        <a href="/governance/processors" class="nav-item <%= typeof path !== 'undefined' && path === '/governance/processors' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><rect x="1" y="3" width="15" height="13"></rect><polygon points="16 8 20 8 23 11 23 16 16 16 8"></polygon></svg>
                            Data Processors
                        </a>
                        <a href="/governance/security-controls" class="nav-item <%= typeof path !== 'undefined' && path === '/governance/security-controls' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                            Security Controls
                        </a>
                        <a href="/settings/general" class="nav-item <%= typeof path !== 'undefined' && path === '/settings/general' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 20h9"></path><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"></path></svg>
                            General Settings
                        </a>
                        <a href="/settings/audit-log" class="nav-item <%= typeof path !== 'undefined' && path === '/settings/audit-log' ? 'active' : '' %>">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line></svg>
                            Audit Log
                        </a>
                    </div>
                </div>
            </nav>
        </aside>

        <script>
            function toggleNavSection(headerEl) {
                const section = headerEl.parentElement;
                section.classList.toggle('expanded');
            }
        </script>

        <!-- Main Content Wrapper -->
        <div class="main-wrapper">
            <!-- Topbar Header -->
            <header class="topbar">
                <div class="breadcrumb">
                    <% if (typeof breadcrumbs !== 'undefined' && Array.isArray(breadcrumbs)) { %>
                        <% breadcrumbs.forEach((crumb, index) => { %>
                            <% if (index === breadcrumbs.length - 1) { %>
                                <strong><%= crumb %></strong>
                            <% } else { %>
                                <%= crumb %> <span class="divider">&gt;</span>
                            <% } %>
                        <% }) %>
                    <% } else { %>
                        Workspace <span class="divider">&gt;</span> <strong>Dashboard</strong>
                    <% } %>
                </div>

                <!-- SME Tenant & Real-Time Statutory Health Status -->
                <div class="topbar-status-badge badge-pill success" style="margin: 0 16px;">
                    <span class="status-dot-active"></span>
                    <span><%= (typeof tenant !== 'undefined' && tenant && tenant.name) ? tenant.name : 'Aarogya Diagnostic Center' %></span>
                    <span style="opacity: 0.5;">&bull;</span>
                    <strong>DPDP Compliance: <%= typeof complianceScore !== 'undefined' ? complianceScore : 84 %>%</strong>
                </div>

                <!-- Global Quick Action Command Bar (Ctrl + K) -->
                <div style="position: relative; flex: 1; max-width: 380px; margin: 0 16px;">
                    <div class="search-bar" style="width: 100%;">
                        <svg class="search-icon" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                        <input type="text" class="search-input" placeholder="Search silos, Aadhaar, DSR tickets... (Ctrl + K)" id="globalSearchInput" style="width: 100%;">
                    </div>
                </div>

                <!-- User Profile & Action Dropdown -->
                <div class="topbar-actions">
                    <a href="/notifications/center" class="icon-btn" title="Notification Alerts">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>
                    </a>
                    <div class="user-profile" onclick="window.location.href='/profile'" id="topbarUserProfile" title="Logged in as <%= (typeof currentUser !== 'undefined' && currentUser && currentUser.name) ? currentUser.name : 'Ramesh Kumar' %>">
                        <div class="avatar" id="topbarUserAvatar"><%= (typeof currentUser !== 'undefined' && currentUser && currentUser.name) ? currentUser.name.charAt(0) : 'R' %></div>
                        <span class="email truncate-text" id="topbarUserName" style="max-width: 180px;"><%= (typeof currentUser !== 'undefined' && currentUser && currentUser.name) ? currentUser.name : 'Ramesh Kumar' %> (<%= (typeof currentUser !== 'undefined' && currentUser && currentUser.role) ? currentUser.role : 'SME_OWNER' %>)</span>
                    </div>
                    <script>
                        (function() {
                            try {
                                const profileStr = localStorage.getItem('dpdp_user_profile');
                                const profile = profileStr ? JSON.parse(profileStr) : null;
                                const first = (profile && profile.firstName) || localStorage.getItem('user_firstName');
                                const last = (profile && profile.lastName) || localStorage.getItem('user_lastName');
                                if (first || last) {
                                    const full = `${first || ''} ${last || ''}`.trim();
                                    const avatar = document.getElementById('topbarUserAvatar');
                                    const name = document.getElementById('topbarUserName');
                                    if (avatar && full) avatar.textContent = full.charAt(0).toUpperCase();
                                    if (name && full) name.textContent = full + ' (SME_OWNER)';
                                }
                            } catch (e) {}
                        })();
                    </script>
                    <a href="/auth/logout" class="icon-btn" title="Logout" style="color: var(--text-muted);">
                        <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path><polyline points="16 17 21 12 16 7"></polyline><line x1="21" y1="12" x2="9" y2="12"></line></svg>
                    </a>
                </div>
            </header>

            <!-- Page Content Injection -->
            <main class="content">
