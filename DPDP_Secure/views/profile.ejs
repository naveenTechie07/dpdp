<%- include('partials/header') %>

<div class="dashboard-header mb-4">
    <div class="title-group">
        <h1>User Profile</h1>
        <p>Manage your account information</p>
    </div>
</div>

<div class="profile-layout" style="max-width: 800px;">
    <!-- Appearance Section -->
    <div class="card p-4 mb-4">
        <h2 class="section-title mb-2">Appearance</h2>
        <p class="section-subtitle mb-4">Choose how DPDP_Secure looks on this device. Saved in this browser.</p>
        
        <div class="segmented-control">
            <label class="segment">
                <input type="radio" name="theme" value="light">
                <span>Light</span>
            </label>
            <label class="segment">
                <input type="radio" name="theme" value="dark">
                <span>Dark</span>
            </label>
            <label class="segment active">
                <input type="radio" name="theme" value="auto" checked>
                <span>Auto</span>
            </label>
        </div>
    </div>

    <!-- Personal Information Form -->
    <div class="card p-4">
        <form id="profileForm" onsubmit="handleSaveProfile(event)">
            <div class="form-group mb-3">
                <label for="firstName" style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px; display: block;">First Name</label>
                <input type="text" id="firstName" class="form-control" placeholder="Enter your first name" style="width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 14px; border-radius: 6px; font-size: 14px;">
            </div>

            <div class="form-group mb-3">
                <label for="lastName" style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px; display: block;">Last Name</label>
                <input type="text" id="lastName" class="form-control" placeholder="Enter your last name" style="width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 14px; border-radius: 6px; font-size: 14px;">
            </div>

            <div class="form-group mb-3">
                <label for="email" style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px; display: block;">Email Address</label>
                <input type="email" id="email" class="form-control" placeholder="Enter your email address" style="width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 14px; border-radius: 6px; font-size: 14px;">
            </div>

            <div class="form-group mb-3">
                <label for="phone" style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px; display: block;">Phone</label>
                <input type="tel" id="phone" class="form-control" placeholder="Enter your phone number" style="width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 14px; border-radius: 6px; font-size: 14px;">
            </div>

            <div class="form-group mb-3">
                <label for="jobTitle" style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px; display: block;">Job Title</label>
                <input type="text" id="jobTitle" class="form-control" placeholder="Enter your job title" style="width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 14px; border-radius: 6px; font-size: 14px;">
            </div>

            <div class="form-group mb-4">
                <label for="department" style="font-weight: 600; font-size: 13px; color: var(--text-main); margin-bottom: 6px; display: block;">Department</label>
                <input type="text" id="department" class="form-control" placeholder="Enter your department" style="width: 100%; background: rgba(0,0,0,0.25); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 14px; border-radius: 6px; font-size: 14px;">
            </div>

            <!-- Save Success Alert Banner -->
            <div id="saveSuccessAlert" style="display: none; padding: 12px 16px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); border-radius: 8px; color: #10b981; font-size: 13px; font-weight: 600; margin-bottom: 16px; align-items: center; gap: 8px; transition: all 0.3s ease;">
                <svg viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2.5" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                <span id="saveAlertText">User profile successfully saved in Chrome local storage!</span>
            </div>

            <button type="submit" id="saveProfileBtn" class="btn-primary-large w-100" style="padding: 12px; font-size: 14px; font-weight: 700; border-radius: 8px; cursor: pointer; transition: all 0.2s ease;">
                Save Changes
            </button>
        </form>
    </div>
</div>

<script>
// Key names for localStorage
const STORAGE_KEY = 'dpdp_user_profile';

function loadProfileFromStorage() {
    try {
        const storedStr = localStorage.getItem(STORAGE_KEY);
        let profile = storedStr ? JSON.parse(storedStr) : null;

        // If no object yet, check individual keys or initialize defaults
        const firstName = (profile && profile.firstName) || localStorage.getItem('user_firstName') || 'Ramesh';
        const lastName = (profile && profile.lastName) || localStorage.getItem('user_lastName') || 'Kumar';
        const email = (profile && profile.email) || localStorage.getItem('user_email') || 'ramesh.kumar@aarogyaclinic.in';
        const phone = (profile && profile.phone) || localStorage.getItem('user_phone') || '+91 98450 12345';
        const jobTitle = (profile && profile.jobTitle) || localStorage.getItem('user_jobTitle') || 'SME Clinic Owner';
        const department = (profile && profile.department) || localStorage.getItem('user_department') || 'Executive Administration';

        document.getElementById('firstName').value = firstName;
        document.getElementById('lastName').value = lastName;
        document.getElementById('email').value = email;
        document.getElementById('phone').value = phone;
        document.getElementById('jobTitle').value = jobTitle;
        document.getElementById('department').value = department;

        updateTopbar(firstName, lastName);
    } catch (e) {
        console.error('Error reading profile from localStorage:', e);
    }
}

function saveProfileToStorage(showAlert = true) {
    const firstName = document.getElementById('firstName').value.trim();
    const lastName = document.getElementById('lastName').value.trim();
    const email = document.getElementById('email').value.trim();
    const phone = document.getElementById('phone').value.trim();
    const jobTitle = document.getElementById('jobTitle').value.trim();
    const department = document.getElementById('department').value.trim();
    const theme = localStorage.getItem('theme') || 'auto';

    const profileData = {
        firstName,
        lastName,
        email,
        phone,
        jobTitle,
        department,
        theme,
        role: 'SME_OWNER',
        updatedAt: new Date().toISOString()
    };

    try {
        // Save as single comprehensive JSON object
        localStorage.setItem(STORAGE_KEY, JSON.stringify(profileData));

        // Also save as individual keys for maximum compatibility
        localStorage.setItem('user_firstName', firstName);
        localStorage.setItem('user_lastName', lastName);
        localStorage.setItem('user_email', email);
        localStorage.setItem('user_phone', phone);
        localStorage.setItem('user_jobTitle', jobTitle);
        localStorage.setItem('user_department', department);

        // Instantly update header avatar & name
        updateTopbar(firstName, lastName);

        if (showAlert) {
            const alertBox = document.getElementById('saveSuccessAlert');
            const btn = document.getElementById('saveProfileBtn');
            const origHtml = 'Save Changes';

            alertBox.style.display = 'flex';
            btn.innerHTML = '✓ Saved in Local Storage!';
            btn.style.background = '#10b981';

            setTimeout(() => {
                alertBox.style.display = 'none';
                btn.innerHTML = origHtml;
                btn.style.background = '';
            }, 2500);
        }
    } catch (e) {
        console.error('Failed to save profile to localStorage:', e);
    }
}

function updateTopbar(first, last) {
    const full = `${first || ''} ${last || ''}`.trim();
    const avatarEl = document.getElementById('topbarUserAvatar');
    const nameEl = document.getElementById('topbarUserName');
    if (avatarEl && full) {
        avatarEl.textContent = full.charAt(0).toUpperCase();
    }
    if (nameEl && full) {
        nameEl.textContent = full + ' (SME_OWNER)';
    }
}

function handleSaveProfile(e) {
    if (e && e.preventDefault) e.preventDefault();
    saveProfileToStorage(true);
}

document.addEventListener('DOMContentLoaded', () => {
    // 1. Load initial profile fields
    loadProfileFromStorage();

    // 2. Real-time auto-save as user types in any field
    const inputs = ['firstName', 'lastName', 'email', 'phone', 'jobTitle', 'department'];
    inputs.forEach(id => {
        const el = document.getElementById(id);
        if (el) {
            el.addEventListener('input', () => {
                saveProfileToStorage(false);
            });
        }
    });

    // 3. Theme switch handler
    const themeRadios = document.querySelectorAll('input[name="theme"]');
    const segments = document.querySelectorAll('.segment');
    
    const savedTheme = localStorage.getItem('theme') || 'auto';
    const initialRadio = document.querySelector(`input[name="theme"][value="${savedTheme}"]`);
    if (initialRadio) {
        initialRadio.checked = true;
        segments.forEach(seg => seg.classList.remove('active'));
        initialRadio.closest('.segment').classList.add('active');
    }

    themeRadios.forEach(radio => {
        radio.addEventListener('change', (e) => {
            const theme = e.target.value;
            
            segments.forEach(seg => seg.classList.remove('active'));
            e.target.closest('.segment').classList.add('active');
            
            if (theme === 'auto') {
                localStorage.removeItem('theme');
                document.documentElement.removeAttribute('data-theme');
            } else {
                localStorage.setItem('theme', theme);
                document.documentElement.setAttribute('data-theme', theme);
            }
            saveProfileToStorage(false);
        });
    });
});
</script>

<%- include('partials/footer') %>
