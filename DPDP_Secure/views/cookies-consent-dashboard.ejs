<%- include('partials/header') %>
<%
  const safeCookies = (typeof cookies !== 'undefined' && Array.isArray(cookies)) ? cookies : [];
  const safeStats = (typeof stats !== 'undefined' && stats) ? stats : {};
  const totalCookies = safeCookies.length;
  const necessaryCount = safeCookies.filter(c => c.category === 'NECESSARY').length;
  const nonNecessaryCount = safeCookies.filter(c => c.category !== 'NECESSARY').length;
  const highRiskCount = inventory.filter(c => c.category === 'MARKETING' || c.category === 'TRACKING').length;
  
  const ratingColor = complianceRating === 'A' ? '#10b981' : complianceRating === 'B' ? '#f59e0b' : '#ef4444';
%>

<div class="dashboard-header mb-6">
    <div class="dashboard-header-left">
        <h1 class="page-title">Data Protection &amp; Cookie Management</h1>
        <p class="page-description">Scan websites for cookies, manage consent, and maintain DPDP Act 2023 compliance.</p>
    </div>
    <div class="dashboard-header-actions">
        <button onclick="openScannerModal()" class="btn-primary" style="padding: 10px 20px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><path d="M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4M3 9V5a2 2 0 0 1 2-2h4"></path><circle cx="12" cy="12" r="3"></circle></svg>
            Scan Website
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="dashboard-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; margin-bottom: 24px;">
    <div class="card p-4">
        <div class="card-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; background: rgba(59, 130, 246, 0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" style="color: #3b82f6;">
                    <circle cx="12" cy="12" r="10"></circle><path d="M1 12h22"></path>
                </svg>
            </div>
            <div>
                <div style="font-size: 12px; font-weight: 600; color: #94a3b8; margin-bottom: 4px;">Total Cookies</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--text-main);"><%= totalCookies %></div>
            </div>
        </div>
    </div>
    <div class="card p-4">
        <div class="card-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; background: rgba(16, 185, 129, 0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" style="color: #10b981;"><circle cx="12" cy="12" r="10"></circle><path d="M1 12h22"/></svg>
            </div>
            <div>
                <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Necessary Cookies</div>
                <div style="font-size: 2rem; font-weight: 700; color: #10b981;"><%= necessaryCount %></div>
            </div>
        </div>
    </div>
    <div class="card p-4">
        <div class="card-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; background: rgba(249, 117, 246, 0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" style="color: #a855f7;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
            </div>
            <div>
                <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Non-Necessary Cookies</div>
                <div style="font-size: 2rem; font-weight: 700; color: #f59e0b;"><%= nonNecessaryCount %></div>
            </div>
        </div>
    </div>
    <div class="card p-4">
        <div class="card-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; background: rgba(139, 92, 246, 0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" style="color: #a855f7;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
            </div>
            <div>
                <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">High Risk Trackers</div>
                <div style="font-size: 2rem; font-weight: 700; color: #ef4444;"><%= highRiskCount %></div>
            </div>
        </div>
    </div>
    <div class="card p-4">
        <div class="card-header" style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
            <div style="width: 40px; height: 40px; background: rgba(59, 130, 246, 0.15); border-radius: 10px; display: flex; align-items: center; justify-content: center;">
                <svg width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" style="color: #3b82f6;"><path d="M22 12h-4l-5 9 7-7 5-6-5-4 1-1 12 12z"/></svg>
            </div>
            <div>
                <div style="font-size: 12px; font-weight: 600; color: var(--text-muted); margin-bottom: 4px;">Compliance Score</div>
                <div style="font-size: 2rem; font-weight: 700; color: <%= ratingColor %>;"><%= complianceRating %></div>
            </div>
        </div>
    </div>
</div>

<div class="dashboard-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 24px;">
    <!-- Cookie Inventory -->
    <div class="card p-0">
        <div class="card-header" style="padding: 20px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin-bottom: 4px;">Cookie Inventory</h3>
                <p style="color: var(--text-muted); font-size: 13px;">All tracked cookies across scanned websites</div>
            </div>
            <button onclick="openAddCookieModal()" class="btn-primary" style="padding: 8px 16px; font-size: 13px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                Add Cookie
            </button>
        </div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="cookieTable" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                        <th style="padding: 14px 20px;">Cookie Name</th>
                        <th style="padding: 14px 20px;">Domain</th>
                        <th style="padding: 14px 20px;">Provider</th>
                        <th style="padding: 14px 20px;">Category</th>
                        <th style="padding: 14px 20px;">Legal Basis</th>
                        <th style="padding: 14px 20px;">Retention</th>
                        <th style="padding: 14px 20px; text-align: right;">Status</th>
                        <th style="padding: 14px 20px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="cookieTableBody">
                    <!-- Cookies loaded via JS -->
                </tbody>
            </table>
        </div>
    </div>

    <!-- Notice Consent Banner Simulator -->
    <div class="card p-0">
        <div class="card-header" style="padding: 20px 24px; border-bottom: 1px solid var(--border-color);">
            <h3 style="font-size: 15px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Cookie Consent Banner Simulator</h3>
            <p style="color: var(--text-muted); font-size: 13px;">Simulate how the consent banner will appear to visitors under DPDP Act 2023 Section 6.</p>
        </div>
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 24px;">
            <!-- Banner Preview -->
            <div style="background: rgba(0,0,0,0.05); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; height: 400px; display: flex; flex-direction: column; justify-content: space-between;">
                <div style="border-radius: 8px; background: rgba(255,255,255,0.95); padding: 20px; max-width: 360px; box-shadow: 0 20px 40px -10px rgba(0,0,0,0.3);">
                    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                        <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(59,130,246,0.1); border: 1px solid rgba(59,130,246,0.2); display: flex; align-items: center; justify-content: center;">
                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
                        </div>
                        <div style="flex: 1;">
                            <div style="font-weight: 700; color: #0f172a; font-size: 16px;">Aarogya Diagnostic Center</div>
                            <div style="font-size: 11px; color: #64748b; margin-top: 2px;">We use cookies to enhance your experience.</div>
                        </div>
                    </div>
                    <div style="font-size: 13px; color: #475569; line-height: 1.6; margin-bottom: 16px;">
                        This website uses cookies to improve your browsing experience, analyze site traffic, and show personalized advertising. Some cookies are essential for the site to function properly. You can choose to accept or decline non-essential cookies.
                    </div>
                    <div style="display: flex; gap: 8px; align-items: center; margin-bottom: 12px;">
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" id="simNecessary" checked disabled style="width: 14px; height: 14px;">
                            <span style="font-size: 13px; color: #475569;">Strictly Necessary Cookies</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px;">
                            <input type="checkbox" id="simAnalytics" style="width: 16px; height: 16px;" checked>
                            <span style="font-size: 13px; color: #475569;">Analytics Cookies</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 12px;">
                            <input type="checkbox" id="category-marketing" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;">
                            <label style="font-size: 13px; color: #fff;">Marketing Cookies</span>
                            <span style="margin-left: auto; font-size: 11px; color: rgba(255,255,255,0.7);">Personalized ads</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 10px;">
                            <input type="checkbox" id="category-functional" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;">
                            <label style="font-size: 13px; color: #fff;">Functional Cookies</span>
                            <span style="margin-left: auto; font-size: 11px; color: rgba(255,255,255,0.7);">Remember preferences</span>
                        </div>
                    </div>
                    <div style="margin-top: 16px; padding: 12px 16px; background: rgba(0,0,0,0.05); border-radius: 6px; font-size: 11px; color: #64748b; line-height: 1.5;">
                        By clicking "Accept", you agree to the storing of cookies on your device to enhance site navigation, analyze site usage, and assist in our marketing efforts as described in our Cookie Policy.
                    </div>
                    <div style="display: flex; gap: 8px; margin-top: 16px;">
                        <button onclick="acceptAll()" class="btn-primary" style="padding: 10px 24px; font-size: 14px; font-weight: 600; width: 48%;">
                            Accept All
                        </button>
                        <button onclick="acceptEssentialOnly()" class="btn-secondary" style="padding: 10px 24px; font-size: 14px; flex: 1;">
                            Reject Non-Essential
                        </button>
                        <button onclick="closeBanner()" class="btn-secondary" style="padding: 10px 24px; font-size: 14px;">
                            Customize
                        </button>
                    </div>
                </div>
            </div>
            <!-- SHA-256 Receipt -->
            <div style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); border-radius: 8px; padding: 16px; margin-top: 16px;">
                <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                        <circle cx="12" cy="12" r="10"></circle><path d="M1 12h22"/></svg>
                        <span style="font-weight: 600; color: var(--text-main); font-size: 13px;">Consent Receipt (SHA-256)</span>
                    </div>
                    <div style="background: rgba(0,0,0,0.1); border-radius: 6px; padding: 12px; font-family: monospace; font-size: 11px; color: #3b82f6; word-break: break-all;" id="sha256Receipt">
                        Click "Accept All" to generate receipt...
                    </div>
                    <div style="margin-top: 12px; text-align: right;">
                        <button onclick="copyReceipt()" class="btn-secondary" style="padding: 6px 16px; font-size: 12px;">Copy Receipt</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- JS for simulator logic -->
<script>
(function() {
    const categoryCheckboxes = {
        necessary: document.getElementById('category-necessary'),
        analytics: document.getElementById('category-analytics'),
        marketing: document.getElementById('category-marketing'),
        functional: document.getElementById('category-functional')
    };

    function updateHash() {
        const timestamp = new Date().toISOString();
        const visitorId = 'visitor-' + Math.floor(Math.random() * 1000000);
        const accepted = Object.entries(currentConsent)
            .filter(([key, val]) => val)
            .map(([key]) => key);
        
        // Simple SHA-256
        const hashString = `${tenantId}:${visitorId}:${accepted.join(',')}:${timestamp}`;
        const hash = sha256(hashString);
        
        document.getElementById('sha256Receipt').textContent = hash;
        
        // Add to consent log via API
        addConsentLog(visitorId, accepted.join(', '), hash);
    }

    async function sha256(str) {
        const encoder = new TextEncoder();
        const data = encoder.encode(str);
        const hashBuffer = await crypto.subtle.digest('SHA-256', data);
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        return hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
    }

    async function acceptAll() {
        currentConsent = { necessary: true, analytics: true, marketing: true, functional: true, security: true };
        document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = true);
        await computeHash();
        alert('Consent accepted for all categories!');
    }

    function acceptEssentialOnly() {
        currentConsent = { necessary: true, analytics: false, marketing: false, functional: false, security: true };
        document.querySelectorAll('input[type="checkbox"]').forEach((cb, idx) => {
            cb.checked = ['necessary', 'security'].includes(cb.id.split('-')[1]);
        });
        computeHash();
        alert('Only essential cookies accepted.');
    }

    function closeBanner() {
        computeHash();
        alert('Banner closed. Choices saved.');
    }

    async function addConsentLog(sessionId, categories, hash) {
        try {
            const res = await fetch('/api/cookies/consent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId: sessionId,
                    cookieCategories: categories,
                    sha256Hash: hash
                })
            });
            if (res.ok) {
                loadConsentLogs();
            }
        } catch (err) {
            console.error('Failed to log consent:', err);
        }
    }

    async function loadConsentLogs() {
        try {
            const res = await fetch('/api/cookies/consent-logs');
            const data = await res.json();
            const tbody = document.getElementById('consentLogBody');
            tbody.innerHTML = '';
            (data.consents || []).forEach(log => {
                const row = document.createElement('tr');
                row.innerHTML = `<td style="padding: 14px 20px; font-size: 12px; color: var(--text-muted);">${new Date(log.timestamp).toLocaleString()}</td>
                    <td style="padding: 14px 20px; font-size: 12px; font-family: monospace; color: var(--text-muted);">${log.sessionId}</td>
                    <td style="padding: 14px 20px; color: var(--text-main);">${log.action}</td>
                    <td style="padding: 14px 20px; color: var(--text-secondary);">${log.categories}</td>
                    <td style="padding: 14px 20px; font-family: monospace; font-size: 10px; color: #3b82f6;">${log.sha256Hash}</td>
                `;
                tbody.insertBefore(row, tbody.firstChild);
            });
        } catch (err) {
            console.error('Failed to load consent logs:', err);
        }
    }

    async function loadStats() {
        try {
            const res = await fetch('/api/cookies/stats');
            const data = await res.json();
            // Stats already loaded server-side
        } catch (err) {
            console.error('Failed to load stats:', err);
        }
    }

    async function loadCookies() {
        try {
            const res = await fetch('/api/cookies/inventory');
            const data = await res.json();
            renderCookies(data.data || []);
        } catch (err) {
            console.error('Failed to load cookies:', err);
        }
    }

    function renderCookies(cookies) {
        const tbody = document.getElementById('cookieTableBody');
        tbody.innerHTML = '';
        cookies.forEach(cookie => {
            const row = document.createElement('tr');
            row.className = 'border-bottom';
            row.innerHTML = `
                <td style="padding: 14px 20px; font-weight: 600; color: var(--text-main);">${cookie.cookieName}</td>
                <td style="padding: 14px 20px; color: var(--text-muted); font-size: 12px; font-family: monospace;">${cookie.domain}</td>
                <td style="padding: 14px 20px; color: var(--text-main);">${cookie.provider}</td>
                <td style="padding: 14px 20px;">
                    <span style="background: ${getCategoryColor(cookie.category)}20; color: ${getCategoryColor(cookie.category)}; padding: 4px 10px; border-radius: 10px; font-size: 11px; font-weight: 700;">${cookie.category}</span>
                </td>
                <td style="padding: 14px 20px; color: var(--text-muted); font-size: 12px;">${cookie.legalBasis}</td>
                <td style="padding: 14px 20px; color: var(--text-main); font-weight: 600;">${cookie.expiresDays ? cookie.expiresDays + ' days' : 'Session'}</td>
                <td style="padding: 14px 20px;">
                    <span style="background: rgba(59,130,246,0.15); color: #3b82f6; padding: 4px 8px; border-radius: 10px; font-size: 11px; font-weight: 700;">${cookie.consentRequired ? 'Consent Required' : 'Exempt'}</span>
                </td>
                <td style="padding: 14px 20px; text-align: right;">
                    <button onclick="editCookie('${escapeHtml(cookie.cookieName)}', '${escapeHtml(cookie.domain)}', '${escapeHtml(cookie.provider)}', '${escapeHtml(cookie.category)}', '${escapeHtml(cookie.legalBasis)}', '${escapeHtml(cookie.purpose)}', '${cookie.expiresDays}', '${cookie.isSecure ? 1 : 0}', '${cookie.isHttpOnly ? 1 : 0}')" class="btn-sm btn-primary" style="padding: 6px 12px; font-size: 11px;">Edit</button>
                </td>
            `;
            tbody.innerHTML += row.innerHTML;
        });
    }

    function getCategoryColor(category) {
        const colors = {
            'NECESSARY': '#10b981',
            'ANALYTICS': '#3b82f6',
            'MARKETING': '#ef4444',
            'FUNCTIONAL': '#8b5cf6',
            'PREFERENCES': '#a855f7',
            'SECURITY': '#ef4444'
        };
        return colors[category] || '#6b7280';
    }

    function escapeHtml(text) {
        return String(text).replace(/[&<"'>]/g, (m) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]));
    }

    function editCookie(name, domain, provider, category, legalBasis, purpose, expiresDays, isSecure, isHttpOnly) {
        alert(`Editing cookie: ${name}\nDomain: ${domain}\nProvider: ${provider}\nCategory: ${category}\nLegal Basis: ${legalBasis}\nPurpose: ${purpose}\nExpires: ${expiresDays} days\nSecure: ${isSecure === 1 ? 'Yes' : 'No'}\nHttpOnly: ${isHttpOnly ? 1 : 'No'}`);
    }

    function closeCookieModal() {
        document.getElementById('cookieEditModal').style.display = 'none';
    }

    window.addEventListener('click', (e) => {
        if (e.target === document.getElementById('cookieEditModal')) closeCookieModal();
    });

    document.getElementById('cookieEditForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editCookieId').value;
        const data = {
            cookieName: document.getElementById('editCookieName').value,
            domain: document.getElementById('editCookieDomain').value,
            provider: document.getElementById('editCookieProvider').value,
            category: document.getElementById('editCookieCategory').value,
            legalBasis: document.getElementById('editCookieLegalBasis').value,
            purpose: document.getElementById('editCookiePurpose').value,
            expiresDays: document.getElementById('editCookieExpiresDays').value,
            isSecure: document.getElementById('editCookieIsSecure').checked,
            isHttpOnly: document.getElementById('editCookieIsHttpOnly').checked
        };

        try {
            const res = await fetch('/api/cookies/inventory/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                alert('Cookie updated successfully!');
                closeCookieModal();
                window.location.reload();
            } else {
                alert('Failed to update cookie.');
            }
        } catch (err) {
            alert('Request failed: ' + err.message);
        }
    });
</script>

</div>

<%- include('partials/footer') %>