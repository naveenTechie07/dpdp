<%- include('partials/header') %>
<%
  const safeConsents = (typeof consents !== 'undefined' && Array.isArray(consents)) ? consents : [];
%>

<div class="dashboard-header mb-4">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1 class="page-title">Cookie Consent Banner Simulator</h1>
            <p class="page-description">Interactive banner simulator. Test consent flows, category toggling, and SHA-256 receipt generation. Preview how your cookie banner will appear to visitors.</p>
        </div>
        <button onclick="window.location.href='/cookies/scans'" class="btn-secondary" style="padding: 8px 16px; font-size: 13px;">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><path d="M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4M3 9V5a2 2 0 0 1 2-2h4"></path><circle cx="12" cy="12" r="3"></circle></svg>
            Back to Scanner
        </button>
    </div>
</div>

<!-- Banner Simulator Panel -->
<div class="card p-0">
    <div style="padding: 20px; border-bottom: 1px solid var(--border-color);">
        <h3 style="font-size: 15px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Banner Simulator</h3>
        <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 0;">Test how your cookie consent banner will appear and function on your website.</p>
    </div>

    <!-- Live Banner Preview -->
    <div style="position: fixed; bottom: 24px; right: 24px; z-index: 9999; max-width: 380px; background: #ffffff; border: 1px solid var(--border-color); border-radius: 16px; box-shadow: 0 20px 60px -12px rgba(0, 0, 0, 0.5); animation: slideUp 0.4s ease-out;">
        <div style="padding: 24px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 16px;">
                <div style="width: 32px; height: 32px; border-radius: 8px; background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); display: flex; align-items: center; justify-content: center;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#3b82f6" stroke-width="2">
                        <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                        <line x1="3" y1="9" x2="21" y2="9"></line>
                        <line x1="9" y1="21" x2="9" y2="9"></line>
                    </svg>
                </div>
                <div>
                    <div style="font-size: 15px; font-weight: 700; color: #0f172a; margin-bottom: 2px;">Aarogya Diagnostic Center</div>
                    <div style="font-size: 11px; color: rgba(255,255,255,0.7);">We use cookies to improve your experience.</div>
                </div>
            </div>
            <div style="font-size: 13px; color: #475569; line-height: 1.6; margin-bottom: 20px;">
                We use cookies and similar technologies to analyze traffic, personalize content, and show personalized advertising. By continuing to use our site, you agree to our use of cookies. Learn more in our <a href="#" style="color: #3b82f6; text-decoration: underline;">Cookie Policy</a>.
            </div>

            <div style="display: flex; flex-direction: column; gap: 8px; margin-bottom: 20px;">
                <div style="display: flex; align-items: center; gap: 12px;">
                    <input type="checkbox" id="bannerCategory-necessary" checked disabled style="width: 16px; height: 16px;">
                    <label style="font-size: 13px; color: #334155;">Strictly Necessary Cookies</span>
                    <span style="margin-left: auto; font-size: 11px; color: #94a3b8;">Always active</span>
                </div>
                <div style="display: flex; align-items: center; gap: 12px;">
                    <input type="checkbox" id="bannerCategory-analytics" style="width: 16px; height: 16px;" checked>
                    <label style="font-size: 13px; color: #475569;">Analytics Cookies</span>
                    <span style="margin-left: auto; font-size: 10px; color: #94a3b8;">Google Analytics</span>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="bannerCategory-marketing" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;">
                    <label style="font-size: 13px; color: #fff;">Marketing Cookies</span>
                    <span style="margin-left: auto; font-size: 11px; color: rgba(255,255,255,0.7);">Personalized ads</span>
                </div>
                <div style="display: flex; align-items: center; gap: 10px;">
                    <input type="checkbox" id="bannerCategory-functional" style="width: 16px; height: 16px; accent-color: var(--primary-color); cursor: pointer;">
                    <label style="font-size: 13px; color: #fff;">Functional Cookies</span>
                    <span style="margin-left: auto; font-size: 11px; color: rgba(255,255,255,0.7);">Remember preferences</span>
                </div>
            </div>

            <div style="display: flex; gap: 12px; margin-top: 24px;">
                <button onclick="acceptAll()" class="btn-primary" style="padding: 10px 24px; font-size: 14px; font-weight: 600; width: 48%;">
                    Accept All
                </button>
                <button onclick="acceptEssentialOnly()" class="btn-secondary" style="padding: 10px 24px; font-size: 14px; width: 48%;">
                    Reject Non-Essential
                </button>
                <button onclick="closeBanner()" class="btn-secondary" style="padding: 10px 24px; font-size: 14px;">
                    Close
                </button>
            </div>
        </div>

        <!-- SHA-256 Receipt Section -->
        <div style="background: rgba(16,185,129,0.1); border: 1px solid rgba(16,185,129,0.3); border-radius: 12px; padding: 20px; margin-top: 24px;">
            <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 12px;">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2">
                    <path d="M12 22s8-4 8-8V5l-8-3-8 4 8 6z"/>
                    <path d="M12 18v4M12 2v4"></path>
                </svg>
                <span style="font-size: 13px; font-weight: 600; color: #10b981;">SHA-256 Consent Receipt</span>
            </div>
            <div style="background: rgba(0,0,0,0.15); border: 1px solid rgba(16,185,129,0.3); border-radius: 8px; padding: 14px; margin-bottom: 12px;">
                <div style="font-family: monospace; font-size: 11px; color: #3b82f6; word-break: break-all; line-height: 1.4;" id="sha256Receipt">
                    <span style="color: #94a3b8; font-size: 10px;">Generate consent receipt by configuring cookies above</span>
                </div>
            </div>
            <div style="margin-top: 12px;">
                <button onclick="copyReceipt()" class="btn-secondary" style="padding: 6px 12px; font-size: 11px;">Copy SHA-256</button>
            </div>
        </div>
    </div>

    <!-- Consent Log Table -->
    <div class="card p-0">
        <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 24px; border-bottom: 1px solid var(--border-color);">
            <h3 style="font-size: 15px; font-weight: 600; color: var(--text-main); margin: 0;">Consent Log</h3>
            <button onclick="location.reload()" class="btn-secondary" style="padding: 6px 16px; font-size: 13px;">Refresh</button>
        </div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="consentTable" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                        <th style="padding: 14px 20px;">Timestamp</th>
                        <th style="padding: 14px 20px;">Session ID</th>
                        <th style="padding: 14px 20px;">Action</th>
                        <th style="padding: 14px 20px;">Categories</th>
                        <th style="padding: 14px 20px; text-align: right;">SHA-256 Hash</th>
                    </tr>
                </thead>
                <tbody id="consentLogBody">
                    <!-- Consent logs will be populated here -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    // Current consent state
    let currentConsent = {
        necessary: true,
        analytics: false,
        marketing: false,
        functional: false,
        security: true
    };

    function toggleCategory(category, checkbox) {
        currentConsent[category] = checkbox.checked;
        updateHash();
    }

    function updateHash() {
        const timestamp = new Date().toISOString();
        const visitorId = 'visitor-' + Math.floor(Math.random() * 1000000);
        const accepted = Object.entries(currentConsent)
            .filter(([key, val]) => val)
            .map(([key]) => key);
        
        const hashString = `tenant-id:${visitorId}:${accepted.join(',')}:${timestamp}`;
        const hash = sha256(hashString);
        
        document.getElementById('sha256Receipt').textContent = hash;
        
        // Add to consent log
        addConsentLog(visitorId, accepted.join(', '), hash);
    }

    function sha256(str) {
        // Simple SHA-256 implementation
        const encoder = new TextEncoder();
        const data = encoder.encode(str);
        return crypto.subtle.digest('SHA-256', data).then(hash => {
            return Array.from(new Uint8Array(hash))
                .map(b => b.toString(16).padStart(2, '0'))
                .join('');
        }).catch(() => 'sha256-error');
    }

    async function computeHash() {
        const timestamp = new Date().toISOString();
        const visitorId = 'visitor-' + Math.floor(Math.random() * 1000000);
        const accepted = Object.entries(currentConsent)
            .filter(([key, val]) => val)
            .map(([key]) => key);
        
        const hashString = `${tenantId}:${visitorId}:${accepted.join(',')}:${timestamp}`;
        const hashBuffer = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(hashString));
        const hashArray = Array.from(new Uint8Array(hashBuffer));
        const hash = hashArray.map(b => b.toString(16).padStart(2, '0')).join('');
        
        document.getElementById('sha256Receipt').textContent = hash;
        
        // Add to consent log
        addConsentLog(visitorId, accepted.join(', '), hash);
    }

    async function acceptAll() {
        currentConsent = { necessary: true, analytics: true, marketing: true, functional: true, security: true };
        document.querySelectorAll('input[type="checkbox"]').forEach(cb => cb.checked = true);
        await computeHash();
        alert('Consent accepted for all categories!');
    }

    function acceptEssentialOnly() {
        currentConsent = { necessary: true, analytics: false, marketing: false, functional: false, security: true };
        document.querySelectorAll('input[type="checkbox"]').forEach((cb, idx) => {
            cb.checked = ['necessary', 'security'].includes(cb.id.split('-')[1]);
        });
        computeHash();
        alert('Only essential cookies accepted.');
    }

    function closeBanner() {
        computeHash();
        alert('Banner closed. Choices saved.');
    }

    async function addConsentLog(sessionId, categories, hash) {
        try {
            const res = await fetch('/api/cookies/consent', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    sessionId: sessionId,
                    cookieCategories: categories,
                    sha256Hash: hash
                })
            });
            if (res.ok) {
                loadConsentLogs();
            }
        } catch (err) {
            console.error('Failed to log consent:', err);
        }
    }

    async function loadConsentLogs() {
        try {
            const res = await fetch('/api/cookies/consent-logs');
            const data = await res.json();
            const tbody = document.getElementById('consentLogBody');
            tbody.innerHTML = '';
            
            (data.consents || []).forEach(log => {
                const row = document.createElement('tr');
                row.innerHTML = `
                    <td style="padding: 14px 20px; font-size: 12px; color: var(--text-muted);">${new Date(log.timestamp).toLocaleString()}</td>
                    <td style="padding: 14px 20px; font-size: 12px; font-family: monospace; color: var(--text-muted);">${log.sessionId}</td>
                    <td style="padding: 14px 20px; color: var(--text-main);">${log.action}</td>
                    <td style="padding: 14px 20px; color: var(--text-secondary);">${log.categories}</td>
                    <td style="padding: 14px 20px; font-family: monospace; font-size: 10px; color: #3b82f6;">${log.sha256Hash}</td>
                `;
                tbody.insertBefore(row, tbody.firstChild);
            });
        } catch (err) {
            console.error('Failed to load consent logs:', err);
        }
    }

    async function loadStats() {
        try {
            const res = await fetch('/api/cookies/stats');
            const data = await res.json();
            // Update stats display if needed
        } catch (err) {
            console.error('Failed to load stats:', err);
        }
    }

    function closeCookieModal() {
        document.getElementById('cookieEditModal').style.display = 'none';
    }

    window.addEventListener('click', (e) => {
        if (e.target === document.getElementById('cookieEditModal')) closeCookieModal();
    });

    document.getElementById('cookieEditForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('editCookieId').value;
        const data = {
            cookieName: document.getElementById('editCookieName').value,
            domain: document.getElementById('editCookieDomain').value,
            provider: document.getElementById('editCookieProvider').value,
            category: document.getElementById('editCookieCategory').value,
            legalBasis: document.getElementById('editCookieLegalBasis').value,
            purpose: document.getElementById('editCookiePurpose').value,
            expiresDays: document.getElementById('editCookieExpiresDays').value,
            isSecure: document.getElementById('editCookieIsSecure').checked,
            isHttpOnly: document.getElementById('editCookieIsHttpOnly').checked
        };

        try {
            const res = await fetch('/api/cookies/inventory/' + id, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(data)
            });
            if (res.ok) {
                alert('Cookie updated successfully!');
                closeCookieModal();
                window.location.reload();
            } else {
                alert('Failed to update cookie.');
            }
        } catch (err) {
            alert('Request failed: ' + err.message);
        }
    });
</script>

<%- include('partials/footer') %>