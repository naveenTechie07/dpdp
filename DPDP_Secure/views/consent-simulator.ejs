<%- include('partials/header') %>
<% var notices = (typeof notices !== 'undefined' && Array.isArray(notices)) ? notices : []; %>
<% var events = (typeof events !== 'undefined' && Array.isArray(events)) ? events : []; %>
<% var purposes = (typeof purposes !== 'undefined' && Array.isArray(purposes)) ? purposes : []; %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          DPDP Act Section 5 & Section 6
        </span>
        <span class="text-xs text-slate-400">Pillar 2: WhatsApp Consent Simulator</span>
      </div>
      <h1 class="text-2xl font-bold text-white tracking-tight mt-1">Live WhatsApp Consent & Notice Simulator</h1>
      <p class="text-sm text-slate-400 mt-1">
        Interactive demonstration of Section 5 statutory notice dispatch and Section 6 citizen 1-click opt-in / revocation for Aarogya Diagnostic Center.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/consent/ledger" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-white text-sm font-semibold transition-colors border border-slate-700">
        <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
        </svg>
        <span>View Full Consent Ledger</span>
      </a>
      <a href="/consent/collection-points" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-sm font-semibold transition-colors shadow-lg shadow-emerald-900/30">
        <span>Notice Builder</span>
      </a>
    </div>
  </div>

  <!-- Dual-Pane Workspace -->
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
    
    <!-- Left Pane: Receptionist Dispatch Console (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-slate-900/70 border border-slate-800 rounded-2xl p-6 shadow-xl backdrop-blur">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4 mb-5">
          <div class="flex items-center gap-2">
            <div class="w-8 h-8 rounded-lg bg-emerald-500/10 border border-emerald-500/20 flex items-center justify-center text-emerald-400 font-bold text-sm">
              🏥
            </div>
            <div>
              <h2 class="text-base font-bold text-white">Clinic Reception Console</h2>
              <p class="text-xs text-slate-400">Aarogya Diagnostic Center, Indiranagar</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded text-[11px] font-semibold bg-blue-500/10 text-blue-400 border border-blue-500/20">
            Staff Role
          </span>
        </div>

        <form id="dispatchForm" class="space-y-4">
          <!-- Language Selector -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Statutory Notice Language (Schedule 8)
            </label>
            <div class="grid grid-cols-3 gap-2">
              <button
                type="button"
                id="btnLangEn"
                onclick="selectLanguage('English')"
                class="lang-btn px-3 py-2 rounded-lg text-xs font-semibold border transition-all text-center bg-emerald-500/20 text-emerald-300 border-emerald-500/40"
              >
                English
              </button>
              <button
                type="button"
                id="btnLangKn"
                onclick="selectLanguage('Kannada')"
                class="lang-btn px-3 py-2 rounded-lg text-xs font-semibold border transition-all text-center bg-slate-800/80 text-slate-300 border-slate-700 hover:bg-slate-800"
              >
                ಕನ್ನಡ (Kannada)
              </button>
              <button
                type="button"
                id="btnLangHi"
                onclick="selectLanguage('Hindi')"
                class="lang-btn px-3 py-2 rounded-lg text-xs font-semibold border transition-all text-center bg-slate-800/80 text-slate-300 border-slate-700 hover:bg-slate-800"
              >
                हिन्दी (Hindi)
              </button>
            </div>
          </div>

          <!-- Patient Name -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Patient / Data Principal Name
            </label>
            <input
              type="text"
              id="patientName"
              value="Deepa Nair"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950/80 border border-slate-700 text-white text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 focus:outline-none transition-colors"
              placeholder="e.g. Ramesh Sharma"
            />
          </div>

          <!-- Patient Phone -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Citizen WhatsApp Mobile Number
            </label>
            <div class="relative">
              <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-500 text-sm font-mono select-none">
                🇮🇳
              </span>
              <input
                type="text"
                id="patientPhone"
                value="+91 98450 12345"
                class="w-full pl-10 pr-3.5 py-2.5 rounded-xl bg-slate-950/80 border border-slate-700 text-white text-sm font-mono focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 focus:outline-none transition-colors"
                placeholder="+91 98450 12345"
              />
            </div>
          </div>

          <!-- Purpose -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 uppercase tracking-wider mb-1.5">
              Itemised Processing Purpose (Sec 5(1))
            </label>
            <select
              id="purposeCode"
              class="w-full px-3.5 py-2.5 rounded-xl bg-slate-950/80 border border-slate-700 text-white text-sm focus:border-emerald-500 focus:ring-1 focus:ring-emerald-500 focus:outline-none transition-colors"
            >
              <option value="PURP-DIAGNOSTIC-REPORTING" selected>
                PURP-DIAGNOSTIC-REPORTING — Blood/Lab Report Dispatch via WhatsApp
              </option>
              <option value="PURP-STATUTORY-BILLING">
                PURP-STATUTORY-BILLING — GST E-Invoice & Payment Receipt
              </option>
              <option value="PURP-APPOINTMENT-REMINDERS">
                PURP-APPOINTMENT-REMINDERS — Follow-up & Fasting Instructions
              </option>
            </select>
          </div>

          <!-- Action Button -->
          <div class="pt-2">
            <button
              type="button"
              id="btnDispatchNotice"
              onclick="dispatchNoticeToSimulator()"
              class="w-full py-3 px-4 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white font-bold text-sm shadow-lg shadow-emerald-900/40 flex items-center justify-center gap-2 transition-all transform active:scale-98"
            >
              <span>⚡ Send Section 5 WhatsApp Notice</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </button>
          </div>
        </form>

        <div class="mt-5 p-3 rounded-xl bg-slate-950/50 border border-slate-800 text-xs text-slate-400 space-y-1">
          <div class="flex items-center gap-1.5 text-emerald-400 font-semibold">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
            <span>Legal Compliance Assurance</span>
          </div>
          <p>
            Notices adhere strictly to DPDP Act Section 5 itemised specifications. Consent capture is cryptographically signed and logged with zero third-party cloud data leakage.
          </p>
        </div>
      </div>
    </div>

    <!-- Right Pane: Interactive WhatsApp Mobile Mockup (7 cols) -->
    <div class="lg:col-span-7 flex justify-center">
      <div class="w-full max-w-[420px] bg-slate-950 border-4 border-slate-800 rounded-[40px] shadow-2xl overflow-hidden p-2">
        <!-- Phone Speaker & Camera Notch -->
        <div class="flex justify-center mb-2">
          <div class="w-24 h-4 bg-slate-800 rounded-full flex items-center justify-center">
            <div class="w-3 h-3 bg-slate-900 rounded-full mr-2"></div>
            <div class="w-10 h-1 bg-slate-700 rounded-full"></div>
          </div>
        </div>

        <!-- WhatsApp Chat Window -->
        <div class="bg-[#0b141a] text-slate-100 rounded-[28px] overflow-hidden flex flex-col h-[650px] border border-slate-800 shadow-inner">
          <!-- WhatsApp Top Bar -->
          <div class="bg-[#1f2c34] px-4 py-3 flex items-center justify-between border-b border-slate-700/60">
            <div class="flex items-center gap-3">
              <div class="w-9 h-9 rounded-full bg-emerald-600 flex items-center justify-center text-white font-bold text-sm shadow">
                🏥
              </div>
              <div>
                <div class="flex items-center gap-1.5">
                  <span class="text-sm font-semibold text-white">Aarogya Diagnostic</span>
                  <svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                  </svg>
                </div>
                <div class="text-[11px] text-emerald-400 flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
                  <span>Official Business Account</span>
                </div>
              </div>
            </div>
            <div class="flex items-center gap-3 text-slate-400 text-sm">
              <span>🔒</span>
            </div>
          </div>

          <!-- Chat Messages Body (Wallpaper background) -->
          <div id="chatBody" class="flex-1 p-4 overflow-y-auto space-y-3 bg-[#0b141a] bg-opacity-95" style="background-image: radial-gradient(#1f2c34 1px, transparent 1px); background-size: 20px 20px;">
            <!-- Encryption Notice -->
            <div class="text-center">
              <span class="inline-block px-3 py-1 rounded-lg bg-[#182229] text-[10px] text-amber-300/80 border border-amber-900/30">
                🔒 Messages are end-to-end encrypted under Section 8(5) safeguards.
              </span>
            </div>

            <!-- Date Separator -->
            <div class="text-center">
              <span class="inline-block px-2.5 py-0.5 rounded-md bg-[#182229] text-[11px] text-slate-400">
                TODAY
              </span>
            </div>

            <!-- Incoming Section 5 Notice Bubble -->
            <div id="noticeBubble" class="bg-[#1f2c34] rounded-2xl rounded-tl-none p-3.5 max-w-[92%] shadow-md border border-slate-700/50 space-y-2">
              <div class="flex items-center justify-between border-b border-slate-700/40 pb-1.5">
                <span class="text-[11px] font-bold text-emerald-400 flex items-center gap-1">
                  <span>📋 STATUTORY DATA NOTICE</span>
                </span>
                <span id="currentNoticeBadge" class="text-[10px] text-slate-400 font-mono">EN · Sec 5(1)</span>
              </div>
              <div id="noticeTextContainer" class="text-xs text-slate-200 leading-relaxed whitespace-pre-line font-sans">
                <!-- Dynamically populated notice text -->
              </div>
              <div class="text-right text-[10px] text-slate-400 pt-1 flex items-center justify-end gap-1">
                <span id="noticeTimestamp">10:42 AM</span>
                <span class="text-sky-400">✓✓</span>
              </div>
            </div>

            <!-- Quick Reply Buttons Container -->
            <div id="quickReplyContainer" class="space-y-1.5 pt-1">
              <div class="text-[11px] text-slate-400 px-1 font-semibold flex items-center gap-1">
                <span>Quick Responses:</span>
              </div>
              <div class="grid grid-cols-2 gap-2">
                <button
                  type="button"
                  id="btnOptInYes"
                  onclick="submitCitizenOptIn()"
                  class="py-2.5 px-3 rounded-xl bg-[#00a884] hover:bg-[#029071] text-white font-bold text-xs flex items-center justify-center gap-1.5 shadow transition-all active:scale-95"
                >
                  <span id="btnOptInLabel">✅ YES (Confirm)</span>
                </button>
                <button
                  type="button"
                  id="btnOptOutStop"
                  onclick="submitCitizenOptOut()"
                  class="py-2.5 px-3 rounded-xl bg-rose-950/80 hover:bg-rose-900 border border-rose-600/50 text-rose-200 font-bold text-xs flex items-center justify-center gap-1.5 shadow transition-all active:scale-95"
                >
                  <span id="btnOptOutLabel">⛔ STOP (Revoke)</span>
                </button>
              </div>
            </div>

            <!-- Dynamic Response Bubbles (Appended via JS) -->
            <div id="dynamicReplies" class="space-y-3"></div>
          </div>

          <!-- Bottom Fake WhatsApp Input Bar -->
          <div class="bg-[#1f2c34] p-3 flex items-center gap-2 border-t border-slate-700/60">
            <div class="flex-1 bg-[#2a3942] rounded-full px-4 py-2 text-xs text-slate-400 flex items-center justify-between">
              <span id="chatInputPlaceholder">Type 'YES' to consent or 'STOP' to withdraw...</span>
              <span class="text-slate-500">📎</span>
            </div>
            <div class="w-9 h-9 rounded-full bg-[#00a884] flex items-center justify-center text-white text-sm shadow">
              🎤
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Real-Time Consent Ledger Updates (Bottom Pane) -->
  <div class="bg-slate-900/70 border border-slate-800 rounded-2xl overflow-hidden shadow-xl mt-8">
    <div class="p-4 sm:p-5 border-b border-slate-800 flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-slate-900/90">
      <div>
        <h3 class="text-base font-bold text-white flex items-center gap-2">
          <span>Real-Time Audit Ledger</span>
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        </h3>
        <p class="text-xs text-slate-400 mt-0.5">
          Live stream of citizen consent grants and revocations with instantaneous Section 6(1) Passbook generation.
        </p>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-xs text-slate-400">Total Entries:</span>
        <span id="ledgerCountBadge" class="px-2 py-0.5 rounded bg-slate-800 text-xs font-mono font-bold text-white">
          <%= events ? events.length : 0 %>
        </span>
      </div>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-800 bg-slate-950/50 text-slate-400 font-semibold uppercase tracking-wider">
            <th class="py-3 px-4">Receipt / Event ID</th>
            <th class="py-3 px-4">Citizen (Data Principal)</th>
            <th class="py-3 px-4">Specified Purpose</th>
            <th class="py-3 px-4">Channel</th>
            <th class="py-3 px-4">Status (Sec 6)</th>
            <th class="py-3 px-4">SHA-256 Non-Repudiation Proof</th>
            <th class="py-3 px-4 text-right">Statutory Action</th>
          </tr>
        </thead>
        <tbody id="simulatorLedgerBody" class="divide-y divide-slate-800 text-slate-300">
          <% if (events && events.length > 0) { %>
            <% events.slice(0, 8).forEach(function(evt) { %>
              <tr class="hover:bg-slate-800/40 transition-colors">
                <td class="py-3 px-4 font-mono font-bold text-sky-400">
                  <%= evt.id %>
                </td>
                <td class="py-3 px-4 font-medium text-white">
                  <%= evt.dataPrincipalPhone || evt.phone || '+91 9845012345' %>
                </td>
                <td class="py-3 px-4 font-mono text-[11px] text-slate-300">
                  <%= evt.purposeCode || 'PURP-DIAGNOSTIC-REPORTING' %>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">
                    <%= evt.channel || 'WhatsApp Business' %>
                  </span>
                </td>
                <td class="py-3 px-4">
                  <% if (evt.status === 'ACTIVE' || evt.status === 'GRANTED') { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-semibold text-[10px]">
                      ● ACTIVE
                    </span>
                  <% } else { %>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 font-semibold text-[10px]">
                      ● WITHDRAWN
                    </span>
                  <% } %>
                </td>
                <td class="py-3 px-4 font-mono text-[11px] text-slate-400">
                  <%= (evt.sha256Proof || '').slice(0, 10) %>...<%= (evt.sha256Proof || '').slice(-6) %>
                </td>
                <td class="py-3 px-4 text-right">
                  <a
                    href="/api/consent/download-passbook/<%= evt.id %>"
                    target="_blank"
                    class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-sky-950 hover:bg-sky-900 text-sky-300 border border-sky-600/40 text-[11px] font-semibold transition-colors shadow"
                  >
                    <span>📄 Passbook</span>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr id="emptyLedgerRow">
              <td colspan="7" class="py-8 text-center text-slate-400">
                No consent events recorded in this session yet. Click <strong>"Send Section 5 Notice"</strong> above to begin.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- Interactive Simulator Client Logic -->
<script>
  // Statutory Section 5 Notices Database
  const NOTICES_BY_LANG = {
    'English': {
      code: 'EN',
      badge: 'EN · Sec 5(1)',
      btnYes: '✅ YES (Confirm)',
      btnStop: '⛔ STOP (Revoke)',
      text: `Aarogya Diagnostic Center — Data Protection Notice (DPDP Act, 2023 Section 5):

1. Itemised Personal Data Collected: Patient Name, Mobile Number, Age, and Diagnostic Test Name (Blood Sugar, Lipid Profile, Thyroid, Biopsy).
2. Specified Lawful Purpose: Delivery of requested medical lab reports and appointment coordination via WhatsApp.
3. Right to Withdraw (Section 6(4)): You may withdraw your consent at any time by replying 'STOP' or contacting our clinic.
4. Grievance Redressal: Clinic Data Protection Officer: Ramesh Kumar (dpo@aarogyaclinic.in, +91 9845012345).

To confirm your consent, please reply 'YES'.`
    },
    'Kannada': {
      code: 'KN',
      badge: 'KN · Sec 5(1)',
      btnYes: '✅ ಒಪ್ಪುತ್ತೇನೆ (YES)',
      btnStop: '⛔ ನಿಲ್ಲಿಸಿ (STOP)',
      text: `ಆರೋಗ್ಯ ಡಯಾಗ್ನೋಸ್ಟಿಕ್ ಸೆಂಟರ್ — ಡೇಟಾ ರಕ್ಷಣೆ ಸೂಚನೆ (DPDP ಕಾಯ್ದೆ 2023 ಸೆಕ್ಷನ್ 5):

1. ಸಂಗ್ರಹಿಸಿದ ವೈಯಕ್ತಿಕ ದತ್ತಾಂಶ: ರೋಗಿಯ ಹೆಸರು, ಮೊಬೈಲ್ ಸಂಖ್ಯೆ, ವಯಸ್ಸು ಮತ್ತು ರಕ್ತ ಪರೀಕ್ಷಾ ವಿವರಗಳು.
2. ಉದ್ದೇಶ: ರೋಗಿಯ ಅಧಿಕೃತ ವೈದ್ಯಕೀಯ ಲ್ಯಾಬ್ ಪರೀಕ್ಷಾ ವರದಿಗಳನ್ನು ವಾಟ್ಸಾಪ್ ಮೂಲಕ ತಲುಪಿಸುವುದು.
3. ಹಿಂಪಡೆಯುವ ಹಕ್ಕು (ಸೆಕ್ಷನ್ 6(4)): ನೀವು ಯಾವುದೇ ಸಮಯದಲ್ಲಿ 'STOP' ಎಂದು ಉತ್ತರಿಸುವ ಮೂಲಕ ಸಮ್ಮತಿಯನ್ನು ಹಿಂಪಡೆಯಬಹುದು.
4. ಕುಂದುಕೊರತೆ ನಿವಾರಣೆ: ಕ್ಲಿನಿಕ್ ಅಧಿಕಾರಿ: ರಮೇಶ್ ಕುಮಾರ್ (dpo@aarogyaclinic.in, +91 9845012345).

ವಾಟ್ಸಾಪ್ ಮೂಲಕ ವರದಿಗಳನ್ನು ಸ್ವೀಕರಿಸಲು ದಯವಿಟ್ಟು 'YES' ಎಂದು ಉತ್ತರಿಸಿ.`
    },
    'Hindi': {
      code: 'HI',
      badge: 'HI · Sec 5(1)',
      btnYes: '✅ सहमत हूँ (YES)',
      btnStop: '⛔ रोकें (STOP)',
      text: `आरोग्य डायग्नोस्टिक सेंटर — डेटा गोपनीयता सूचना (DPDP अधिनियम 2023 धारा 5):

1. एकत्रित व्यक्तिगत डेटा: रोगी का नाम, मोबाइल नंबर, आयु और रक्त जांच रिपोर्ट विवरण।
2. विशिष्ट उद्देश्य: रोगी द्वारा मांगी गई मेडिकल लैब रिपोर्ट को व्हाट्सएप पर सुरक्षित रूप से भेजना।
3. सहमति वापस लेने का अधिकार (धारा 6(4)): आप किसी भी समय 'STOP' भेजकर अपनी सहमति वापस ले सकते हैं।
4. शिकायत निवारण: क्लिनिक शिकायत अधिकारी: रमेश कुमार (dpo@aarogyaclinic.in, +91 9845012345)।

व्हाट्सएप पर रिपोर्ट प्राप्त करने के लिए 'YES' लिखकर भेजें।`
    }
  };

  let currentSelectedLang = 'English';

  function selectLanguage(lang) {
    currentSelectedLang = lang;
    ['btnLangEn', 'btnLangKn', 'btnLangHi'].forEach(id => {
      const btn = document.getElementById(id);
      if (btn) {
        btn.classList.remove('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
        btn.classList.add('bg-slate-800/80', 'text-slate-300', 'border-slate-700');
      }
    });

    const activeId = lang === 'English' ? 'btnLangEn' : (lang === 'Kannada' ? 'btnLangKn' : 'btnLangHi');
    const activeBtn = document.getElementById(activeId);
    if (activeBtn) {
      activeBtn.classList.remove('bg-slate-800/80', 'text-slate-300', 'border-slate-700');
      activeBtn.classList.add('bg-emerald-500/20', 'text-emerald-300', 'border-emerald-500/40');
    }

    const noticeData = NOTICES_BY_LANG[lang];
    document.getElementById('noticeTextContainer').textContent = noticeData.text;
    document.getElementById('currentNoticeBadge').textContent = noticeData.badge;
    document.getElementById('btnOptInLabel').textContent = noticeData.btnYes;
    document.getElementById('btnOptOutLabel').textContent = noticeData.btnStop;
  }

  function getFormattedTime() {
    const d = new Date();
    let h = d.getHours();
    let m = d.getMinutes();
    const ampm = h >= 12 ? 'PM' : 'AM';
    h = h % 12 || 12;
    m = m < 10 ? '0' + m : m;
    return `${h}:${m} ${ampm}`;
  }

  function dispatchNoticeToSimulator() {
    const phone = document.getElementById('patientPhone').value;
    const name = document.getElementById('patientName').value;
    const timeStr = getFormattedTime();

    document.getElementById('noticeTimestamp').textContent = timeStr;
    const dynamicReplies = document.getElementById('dynamicReplies');
    
    // Add dispatch log bubble
    const dispatchAlert = document.createElement('div');
    dispatchAlert.className = 'text-center my-2';
    dispatchAlert.innerHTML = `<span class="inline-block px-3 py-1 rounded bg-emerald-950/80 text-[10px] text-emerald-300 border border-emerald-700/50">
      ⚡ Section 5 Notice dispatched to ${phone} (${name}) via WhatsApp Business API
    </span>`;
    dynamicReplies.appendChild(dispatchAlert);

    // Scroll chat to bottom
    const chatBody = document.getElementById('chatBody');
    chatBody.scrollTop = chatBody.scrollHeight;
  }

  async function submitCitizenOptIn() {
    const phone = document.getElementById('patientPhone').value || '+91 98450 12345';
    const purpose = document.getElementById('purposeCode').value || 'PURP-DIAGNOSTIC-REPORTING';
    const timeStr = getFormattedTime();

    // 1. Render Citizen outgoing "YES" bubble
    const dynamicReplies = document.getElementById('dynamicReplies');
    const citizenBubble = document.createElement('div');
    citizenBubble.className = 'flex justify-end';
    citizenBubble.innerHTML = `
      <div class="bg-[#005c4b] text-white rounded-2xl rounded-tr-none p-3 max-w-[80%] shadow border border-emerald-700/40">
        <div class="text-xs font-semibold">YES</div>
        <div class="text-right text-[10px] text-emerald-200 pt-1 flex items-center justify-end gap-1">
          <span>${timeStr}</span>
          <span class="text-sky-300">✓✓</span>
        </div>
      </div>
    `;
    dynamicReplies.appendChild(citizenBubble);

    // 2. Call Backend API
    try {
      const res = await fetch('/api/consent/record-consent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          phone: phone,
          purposeCode: purpose,
          channel: 'WhatsApp Business API',
          language: currentSelectedLang
        })
      });
      const data = await res.json();

      if (data.success) {
        // 3. Render Clinic automated confirmation receipt in chat
        setTimeout(() => {
          const receiptBubble = document.createElement('div');
          receiptBubble.className = 'bg-[#1f2c34] rounded-2xl rounded-tl-none p-3.5 max-w-[90%] shadow border border-emerald-600/40 space-y-1.5';
          receiptBubble.innerHTML = `
            <div class="text-xs font-bold text-emerald-400 flex items-center gap-1.5">
              <span>✅ Consent Recorded (Section 6(1))</span>
            </div>
            <p class="text-xs text-slate-200 leading-normal">
              Thank you, your consent for <strong>${purpose}</strong> has been securely logged into the cryptographic ledger.
            </p>
            <div class="p-2 rounded bg-slate-900/80 border border-slate-700 font-mono text-[10px] text-slate-300 break-all">
              <span class="text-slate-400">SHA-256 Proof:</span><br/>${data.sha256Proof || 'COMPLIANT-HASH'}
            </div>
            <div class="pt-1">
              <a href="/api/consent/download-passbook/${data.eventId}" target="_blank" class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-[10px] transition shadow">
                📄 View Citizen Passbook
              </a>
            </div>
            <div class="text-right text-[10px] text-slate-400 pt-0.5">
              <span>${getFormattedTime()}</span>
            </div>
          `;
          dynamicReplies.appendChild(receiptBubble);

          // Prepend to bottom table
          prependLedgerRow(data.eventId, phone, purpose, 'ACTIVE', data.sha256Proof);

          const chatBody = document.getElementById('chatBody');
          chatBody.scrollTop = chatBody.scrollHeight;
        }, 500);
      }
    } catch (err) {
      console.error('Error submitting consent:', err);
    }
  }

  async function submitCitizenOptOut() {
    const phone = document.getElementById('patientPhone').value || '+91 98450 12345';
    const purpose = document.getElementById('purposeCode').value || 'PURP-DIAGNOSTIC-REPORTING';
    const timeStr = getFormattedTime();

    // 1. Render Citizen outgoing "STOP" bubble
    const dynamicReplies = document.getElementById('dynamicReplies');
    const citizenBubble = document.createElement('div');
    citizenBubble.className = 'flex justify-end';
    citizenBubble.innerHTML = `
      <div class="bg-[#005c4b] text-white rounded-2xl rounded-tr-none p-3 max-w-[80%] shadow border border-emerald-700/40">
        <div class="text-xs font-semibold text-rose-300">STOP</div>
        <div class="text-right text-[10px] text-emerald-200 pt-1 flex items-center justify-end gap-1">
          <span>${timeStr}</span>
          <span class="text-sky-300">✓✓</span>
        </div>
      </div>
    `;
    dynamicReplies.appendChild(citizenBubble);

    // 2. Call Backend API
    try {
      const res = await fetch('/api/consent/withdraw-consent', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          phone: phone,
          purposeCode: purpose
        })
      });
      const data = await res.json();

      if (data.success) {
        setTimeout(() => {
          const revokeBubble = document.createElement('div');
          revokeBubble.className = 'bg-[#1f2c34] rounded-2xl rounded-tl-none p-3.5 max-w-[90%] shadow border border-amber-600/40 space-y-1.5';
          revokeBubble.innerHTML = `
            <div class="text-xs font-bold text-amber-400 flex items-center gap-1.5">
              <span>⛔ Consent Withdrawn (Section 6(4))</span>
            </div>
            <p class="text-xs text-slate-200 leading-normal">
              Your consent for <strong>${purpose}</strong> has been revoked. All informal dispatches to ${phone} have been ceased immediately.
            </p>
            <div class="p-2 rounded bg-slate-900/80 border border-slate-700 font-mono text-[10px] text-slate-300 break-all">
              <span class="text-slate-400">Revocation Proof:</span><br/>${data.sha256Proof || 'REVOKED-HASH'}
            </div>
            <div class="text-right text-[10px] text-slate-400 pt-0.5">
              <span>${getFormattedTime()}</span>
            </div>
          `;
          dynamicReplies.appendChild(revokeBubble);

          prependLedgerRow(data.eventId, phone, purpose, 'WITHDRAWN', data.sha256Proof);

          const chatBody = document.getElementById('chatBody');
          chatBody.scrollTop = chatBody.scrollHeight;
        }, 500);
      }
    } catch (err) {
      console.error('Error withdrawing consent:', err);
    }
  }

  function prependLedgerRow(id, phone, purpose, status, hash) {
    const tbody = document.getElementById('simulatorLedgerBody');
    const emptyRow = document.getElementById('emptyLedgerRow');
    if (emptyRow) emptyRow.remove();

    const tr = document.createElement('tr');
    tr.className = 'hover:bg-slate-800/40 transition-colors bg-emerald-950/20';

    const shortHash = hash ? `${hash.slice(0, 10)}...${hash.slice(-6)}` : 'VALID-PROOF';
    const statusBadge = status === 'ACTIVE'
      ? `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 font-semibold text-[10px]">● ACTIVE</span>`
      : `<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-amber-500/10 text-amber-400 border border-amber-500/30 font-semibold text-[10px]">● WITHDRAWN</span>`;

    tr.innerHTML = `
      <td class="py-3 px-4 font-mono font-bold text-sky-400">${id}</td>
      <td class="py-3 px-4 font-medium text-white">${phone}</td>
      <td class="py-3 px-4 font-mono text-[11px] text-slate-300">${purpose}</td>
      <td class="py-3 px-4">
        <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 text-[10px]">
          WhatsApp Business
        </span>
      </td>
      <td class="py-3 px-4">${statusBadge}</td>
      <td class="py-3 px-4 font-mono text-[11px] text-slate-400">${shortHash}</td>
      <td class="py-3 px-4 text-right">
        <a href="/api/consent/download-passbook/${id}?phone=${encodeURIComponent(phone)}&purpose=${encodeURIComponent(purpose)}&status=${status}" target="_blank" class="inline-flex items-center gap-1 px-2.5 py-1 rounded bg-sky-950 hover:bg-sky-900 text-sky-300 border border-sky-600/40 text-[11px] font-semibold transition-colors shadow">
          <span>📄 Passbook</span>
        </a>
      </td>
    `;
    tbody.insertBefore(tr, tbody.firstChild);

    // Update count badge
    const countBadge = document.getElementById('ledgerCountBadge');
    if (countBadge) {
      countBadge.textContent = parseInt(countBadge.textContent || '0') + 1;
    }
  }

  // Initialize with English notice
  document.addEventListener('DOMContentLoaded', () => {
    selectLanguage('English');
    dispatchNoticeToSimulator();
  });
</script>

