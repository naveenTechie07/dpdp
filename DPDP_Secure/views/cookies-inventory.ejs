<%- include('partials/header') %>
<%
  const safeCookies = (typeof cookies !== 'undefined' && Array.isArray(cookies)) ? cookies : [];
  const categories = {};
  safeCookies.forEach(c => {
    categories[c.category] = (categories[c.category] || 0) + 1;
  });
%>

<div class="dashboard-header mb-6">
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <h1 class="page-title">Data Protection &amp; Cookie Management</h1>
            <p class="page-description">Manage cookie inventory, consent banners, and regulatory compliance under the Digital Personal Data Protection Act, 2023.</p>
        </div>
        <div style="display: flex; gap: 12px;">
            <button onclick="window.location.href='/cookies/scans'" class="btn-primary" style="padding: 10px 24px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><path d="M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4M3 9V5a2 2 0 0 1 2-2h4"></path><circle cx="12" cy="12" r="3"></circle></svg>
                Run Website Scan
            </button>
            <button onclick="window.location.href='/cookies/consent'" class="btn-secondary" style="padding: 10px 24px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><path d="M9 17l4-4 4 4M17 17v-2a2 2 0 0 0-2-2h-2a2 2 0 0 0-2 2v2a2 2 0 0 1-2 2h-2a2 2 0 0 1-2-2z"/></svg>
                Consent Banner Simulator
            </button>
        </div>
    </div>
</div>

<!-- KPI Cards -->
<div style="display: grid; grid-template-columns: repeat(5, 1fr); gap: 16px; margin-bottom: 24px;">
    <div class="card p-4">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase;">Total Cookies</div>
                <div style="font-size: 2rem; font-weight: 700; color: var(--text-main); margin-bottom: 8px;"><%= safeCookies.length || 0 %></div>
                <div style="color: var(--text-muted); font-size: 11px;">Total tracked cookies</div>
            </div>
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none" style="opacity: 0.3;"><rect x="1" y="3" width="18" height="18" rx="2" ry="2"></rect><path d="M2 21h4.5c1.1 0 2-.9 2-2v-3.6c0-.6-.4-1-1-1H3a2 2 0 0 0-2 2v3c0 1.1.9 2 2 2zM16 11h6c1.1 0 2 .9 2 2v2a2 2 0 0 1-2 2h-6c-1.1 0-2-.9-2-2v-2a2 2 0 0 1 2-2z" transform="translate(15 10) scale(0.5)"/></svg>
        </div>
    </div>
    <div class="card p-4">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Necessary Cookies</div>
                <div style="font-size: 2rem; font-weight: 700; color: #10b981; margin-bottom: 8px;"><%= safeCookies.filter(c => c.category === 'NECESSARY').length || 0 %></div>
                <div style="color: var(--text-muted); font-size: 11px;">No consent required</div>
            </div>
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="#10b981" stroke-width="2" fill="none" style="opacity: 0.3;"><circle cx="12" cy="12" r="10"></circle><path d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5v19l15-3v-5a2 2 0 0 0 2-2zm0 0V9.41a2 2 0 0 0-1.41-.59l-7.39 7.38-.71-.71-.02-.02a6 6 0 0 0-.99-2.1c0-1.11.86-2 1.97-2h3a1 1 0 0 1 1 1v3a2 2 0 0 1-1.11 1.76z" transform="translate(15 10) scale(0.5)"/></svg>
        </div>
    </div>
    <div class="card p-4">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Marketing/Tracking</div>
                <div style="font-size: 2rem; font-weight: 700; color: #ef4444; margin-bottom: 8px;"><%= safeCookies.filter(c => c.category === 'MARKETING').length || 0 %></div>
                <div style="color: var(--text-muted); font-size: 11px;">Require explicit consent</div>
            </div>
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="#ef4444" stroke-width="2" fill="none" style="opacity: 0.3;"><path d="M19 21l-7-12v10l4-5h6a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2z"/></svg>
        </div>
    </div>
    <div class="card p-4">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Consent Rate</div>
                <div style="font-size: 2rem; font-weight: 700; color: #10b981; margin-bottom: 8px;">96%</div>
                <div style="color: var(--text-muted); font-size: 11px;">Opt-in rate from visitors</div>
            </div>
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="#10b981" stroke-width="2" fill="none" style="opacity: 0.3;"><path d="M22 11v1a10 10 0 0 1-5.93-5.93H11l-4 4v5a10 10 0 0 0-2-10v-1a10 10 0 0 0 11-10z"/></svg>
        </div>
    </div>
    <div class="card p-4">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.5px;">Compliance Score</div>
                <div style="font-size: 2rem; font-weight: 700; color: #3b82f6; margin-bottom: 8px;">A</div>
                <div style="color: var(--text-muted); font-size: 11px;">DPDP Act 2023 ready</div>
            </div>
            <svg viewBox="0 0 24 24" width="24" height="24" stroke="#3b82f6" stroke-width="2" fill="none" style="opacity: 0.3;"><path d="M22 12h-4l-5 9 7-7 5-6-5-4 1-1 12 12z"/></svg>
        </div>
    </div>
</div>

<!-- Main Content Grid -->
<div style="display: grid; grid-template-columns: 3fr 2fr; gap: 24px; margin-bottom: 24px;">
    <!-- Cookie Inventory Table -->
    <div class="card p-0">
        <div class="card-header" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <div>
                <h3 style="font-size: 15px; font-weight: 600; color: var(--text-main);">Cookie Inventory</h3>
                <p style="color: var(--text-muted); font-size: 12px;">All tracked cookies across scanned websites</div>
            </div>
            <div style="display: flex; gap: 8px;">
                <input type="text" id="cookieSearch" placeholder="Search cookies..." style="padding: 8px 12px; border: 1px solid var(--border-color); border-radius: 6px; color: var(--text-main); width: 200px; background: rgba(0,0,0,0.2);" onkeyup="filterCookies()"/>
                <button onclick="refreshCookies()" class="btn-secondary" style="padding: 8px 16px; font-size: 13px;">Refresh</button>
            </div>
        </div>
        <div style="overflow-x: auto;">
            <table class="data-table" id="cookieTable" style="width: 100%; border-collapse: collapse;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                        <th style="padding: 14px 20px;">Cookie Name</th>
                        <th style="padding: 14px 20px;">Domain</th>
                        <th style="padding: 14px 20px;">Provider</th>
                        <th style="padding: 14px 20px;">Category</th>
                        <th style="padding: 14px 20px;">Legal Basis</th>
                        <th style="padding: 14px 20px;">Retention</th>
                        <th style="padding: 14px 20px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody id="cookieTableBody">
                    <!-- Cookies loaded via JS -->
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Quick Stats Sidebar -->
<div class="card p-0" style="height: fit-content;">
    <div style="padding: 20px;">
        <h3 style="font-size: 15px; font-weight: 600; color: var(--text-main); margin-bottom: 20px;">Compliance Breakdown</h3>
        <div style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="font-size: 13px; color: var(--text-muted);">Necessary Cookies</span>
                <span style="font-size: 13px; font-weight: 600; color: #10b981;"><%= safeCookies.filter(c => c.category === 'NECESSARY').length || 0 %></span>
            </div>
            <div style="background: rgba(16,185,129,0.1); height: 6px; border-radius: 3px; overflow: hidden;">
                <div style="background: #10b981; height: 100%; width: 100%;"></div>
            </div>
        </div>
        <div style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="font-size: 13px; color: var(--text-muted);">Non-Necessary Cookies</span>
                <span style="font-size: 13px; font-weight: 600; color: #f59e0b;"><%= safeCookies.filter(c => c.category !== 'NECESSARY').length || 0 %></span>
            </div>
            <div style="background: rgba(245,158,11,0.1); height: 6px; border-radius: 3px; overflow: hidden;">
                <div style="background: #f59e0b; height: 100%; width: <%= Math.min(100, Math.round((safeCookies.filter(c => c.category !== 'NECESSARY').length || 0) / Math.max(safeCookies.length,1) * 100)) %>%;"></div>
            </div>
        </div>
        <div style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="font-size: 13px; color: var(--text-muted);">Total Sites Scanned</span>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-main);"><%= typeof totalScans !== 'undefined' ? totalScans : 0 %></span>
            </div>
            <div style="background: rgba(59,130,246,0.1); height: 6px; border-radius: 3px; overflow: hidden;">
                <div style="background: #3b82f6; height: 100%; width: <%= Math.min(100, Math.round(((typeof totalScans !== 'undefined' ? totalScans : 0)) / 20 * 100)) %>%;"></div>
            </div>
        </div>
        <div style="margin-bottom: 20px;">
            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                <span style="font-size: 13px; color: var(--text-muted);">Total Consents Recorded</span>
                <span style="font-size: 13px; font-weight: 600; color: var(--text-main);"><%= typeof totalConsents !== 'undefined' ? totalConsents : 0 %></span>
            </div>
            <div style="background: rgba(139,92,246,0.1); height: 6px; border-radius: 3px; overflow: hidden;">
                <div style="background: #8b5cf6; height: 100%; width: <%= Math.min(100, Math.round(((typeof totalConsents !== 'undefined' ? totalConsents : 0)) / 100 * 100)) %>%;"></div>
            </div>
        </div>
    </div>
</div>

<script>
const cookieData = <%- JSON.stringify(safeCookies) %>;

document.addEventListener('DOMContentLoaded', () => {
    const tableBody = document.getElementById('cookieTableBody');
    renderCookies(cookieData);
});

function renderCookies(cookies) {
    const tableBody = document.getElementById('cookieTableBody');
    tableBody.innerHTML = '';

    cookies.forEach(cookie => {
        const row = document.createElement('tr');
        row.className = 'border-bottom';
        row.innerHTML = `
            <td style="padding: 14px 20px; font-weight: 600; color: var(--text-main);">${cookie.cookieName}</td>
            <td style="padding: 14px 20px; color: var(--text-muted); font-size: 12px; font-family: monospace;">${cookie.domain}</td>
            <td style="padding: 14px 20px; color: var(--text-main);">${cookie.provider}</td>
            <td style="padding: 14px 20px;">
                <span style="background: ${getCategoryColor(cookie.category)}20; color: ${getCategoryColor(cookie.category)}; padding: 4px 10px; border-radius: 10px; font-size: 11px; font-weight: 700;">${cookie.category}</span>
            </td>
            <td style="padding: 14px 20px; color: var(--text-muted); font-size: 12px;">${cookie.legalBasis}</td>
            <td style="padding: 14px 20px; color: var(--text-main); font-weight: 600;">${cookie.expiresDays ? cookie.expiresDays + ' days' : 'Session'}</td>
            <td style="padding: 14px 20px;">
                <span style="background: rgba(59,130,246,0.15); color: #3b82f6; padding: 4px 8px; border-radius: 10px; font-size: 11px; font-weight: 700;">${cookie.consentRequired ? 'Consent Required' : 'Exempt'}</span>
            </td>
            <td style="padding: 14px 20px; text-align: right;">
                <button onclick="editCookie('${escapeHtml(cookie.cookieName)}', '${escapeHtml(cookie.domain)}', '${escapeHtml(cookie.provider)}', '${escapeHtml(cookie.category)}', '${escapeHtml(cookie.legalBasis)}', '${escapeHtml(cookie.purpose)}', '${cookie.expiresDays}', '${cookie.isSecure ? 1 : 0}', '${cookie.isHttpOnly ? 1 : 0}')" class="btn-sm btn-primary" style="padding: 6px 12px; font-size: 11px;">Edit</button>
                <button onclick="deleteCookie('${escapeHtml(cookie.cookieName)}')" class="btn-sm btn-danger" style="padding: 6px 12px; font-size: 11px;">Delete</button>
            </td>
        </tr>
        `;
        tableBody.innerHTML += row.innerHTML;
    });
}

function getCategoryColor(category) {
    const colors = {
        'NECESSARY': '#10b981',
        'ANALYTICS': '#3b82f6',
        'MARKETING': '#ef4444',
        'FUNCTIONAL': '#8b5cf6',
        'PREFERENCES': '#a855f7',
        'SECURITY': '#ef4444'
    };
    return colors[category] || '#6b7280';
}

function escapeHtml(text) {
    return String(text).replace(/[&<"'>]/g, (m) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]);
}

function filterCookies() {
    const q = document.getElementById('cookieSearch').value.toLowerCase();
    const rows = document.querySelectorAll('#cookieTableBody tr');
    rows.forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(q) ? '' : 'none';
    });
}

function editCookie(name, domain, provider, category, legalBasis, purpose, expiresDays, isSecure, isHttpOnly) {
    alert(`Editing cookie: ${name}\nDomain: ${domain}\nProvider: ${provider}\nCategory: ${category}\nLegal Basis: ${legalBasis}\nPurpose: ${purpose}\nExpires: ${expiresDays} days\nSecure: ${isSecure === 1 ? 'Yes' : 'No'}\nHttpOnly: ${isHttpOnly === 1 ? 'Yes' : 'No'}\n\nIn production, this would open an edit form.`);
}

function deleteCookie(name) {
    if (confirm('Are you sure you want to delete cookie "' + name + '"?')) {
        alert('Cookie ' + name + ' deleted successfully (demo mode).');
        // In production: fetch('/api/cookies/inventory/' + name, { method: 'DELETE' }).then(() => window.location.reload());
    }
}

</script>

<%- include('partials/footer') %>