<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-sky-500/10 text-sky-400 border border-sky-500/20">
          DPDP Act Section 11 & 12
        </span>
        <span class="text-xs text-slate-400">Pillar 3: Data Principal Rights (DSR)</span>
      </div>
      <h1 class="text-2xl font-bold text-white tracking-tight mt-1">Data Rights Requests Operations Queue</h1>
      <p class="text-sm text-slate-400 mt-1">
        Manage citizen requests under Section 11 (Access) & Section 12 (Erasure/Correction), inspect informal silo occurrences, and resolve tax-lock collisions.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/privacy/workflows" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors">
        <svg class="w-4 h-4 text-sky-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path></svg>
        <span>View DSR Workflows</span>
      </a>
      <a href="/dsr" target="_blank" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-sm font-semibold transition-colors shadow-lg shadow-sky-900/30">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
        </svg>
        <span>Open Public Citizen Portal (/dsr)</span>
      </a>
    </div>
  </div>

  <!-- Operational Metric Cards -->
  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <span class="text-xs font-medium text-slate-400">Total DSR Requests</span>
      <div class="text-2xl font-bold text-white mt-1"><%= requests ? requests.length : 3 %></div>
      <div class="text-[11px] text-slate-400 mt-1">Active citizen inquiries</div>
    </div>
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <span class="text-xs font-medium text-slate-400">Awaiting Tax Review</span>
      <div class="text-2xl font-bold text-amber-400 mt-1">
        <%= requests ? requests.filter(r => (r.status || '').toUpperCase().includes('TAX') || (r.status || '').toUpperCase().includes('AWAITING')).length : 1 %>
      </div>
      <div class="text-[11px] text-amber-400 mt-1">CGST Sec 36 Collision</div>
    </div>
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <span class="text-xs font-medium text-slate-400">Access Summaries (Sec 11)</span>
      <div class="text-2xl font-bold text-sky-400 mt-1">
        <%= requests ? requests.filter(r => (r.requestType || '').includes('11') || (r.requestType || '').includes('ACCESS')).length : 1 %>
      </div>
      <div class="text-[11px] text-sky-400 mt-1">Disclosed to citizens</div>
    </div>
    <div class="p-4 rounded-xl bg-slate-900/60 border border-slate-800">
      <span class="text-xs font-medium text-slate-400">Statutory SLA Compliance</span>
      <div class="text-2xl font-bold text-emerald-400 mt-1">100%</div>
      <div class="text-[11px] text-emerald-400 mt-1">Within 7-day window</div>
    </div>
  </div>

  <!-- Filter Toolbar -->
  <div class="flex items-center justify-between border-b border-slate-800 pb-3">
    <div class="flex items-center gap-2">
      <button type="button" class="dsr-filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-sky-500/20 text-sky-400 border border-sky-500/40">
        All Requests
      </button>
      <button type="button" class="dsr-filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900/40 text-slate-400 border border-slate-800 hover:text-white">
        Awaiting Tax Review (Deepa Nair)
      </button>
      <button type="button" class="dsr-filter-tab px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-slate-900/40 text-slate-400 border border-slate-800 hover:text-white">
        Completed
      </button>
    </div>
    <span class="text-xs text-slate-400 font-mono">
      SLA Standard: <strong class="text-white">7 Working Days</strong>
    </span>
  </div>

  <!-- Main DSR Queue Table -->
  <div class="bg-slate-900/60 border border-slate-800 rounded-2xl overflow-hidden shadow-xl">
    <div class="overflow-x-auto">
      <table class="w-full text-left border-collapse text-xs">
        <thead>
          <tr class="border-b border-slate-800 text-[11px] font-semibold text-slate-400 uppercase tracking-wider bg-slate-950/40">
            <th class="py-3.5 px-4">Ticket ID</th>
            <th class="py-3.5 px-4">Data Principal & Contact</th>
            <th class="py-3.5 px-4">Statutory Right</th>
            <th class="py-3.5 px-4">Status</th>
            <th class="py-3.5 px-4">Informal Silo Occurrence</th>
            <th class="py-3.5 px-4">Created Date</th>
            <th class="py-3.5 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 font-mono text-slate-300">
          <% if (requests && requests.length > 0) { %>
            <% requests.forEach(function(reqItem) { %>
              <tr class="hover:bg-slate-800/20 transition-colors" id="row-<%= reqItem.ticketNumber || reqItem.id %>">
                <td class="py-3.5 px-4 font-bold text-sky-400 whitespace-nowrap">
                  <%= reqItem.ticketNumber || reqItem.id %>
                </td>
                <td class="py-3.5 px-4 font-sans">
                  <div class="font-bold text-white"><%= reqItem.principalName %></div>
                  <div class="text-[11px] text-slate-400 font-mono"><%= reqItem.principalPhone %> · <%= reqItem.principalEmail || 'No email' %></div>
                </td>
                <td class="py-3.5 px-4 font-sans whitespace-nowrap">
                  <% if ((reqItem.requestType || '').includes('ERASURE') || (reqItem.requestType || '').includes('12')) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-950/80 text-rose-300 border border-rose-500/30">
                      SECTION 12: ERASURE
                    </span>
                  <% } else if ((reqItem.requestType || '').includes('ACCESS') || (reqItem.requestType || '').includes('11')) { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-950/80 text-sky-300 border border-sky-500/30">
                      SECTION 11: ACCESS
                    </span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-950/80 text-amber-300 border border-amber-500/30">
                      SECTION 12: CORRECTION
                    </span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4 whitespace-nowrap status-cell">
                  <% if ((reqItem.status || '').toUpperCase().includes('AWAITING') || (reqItem.status || '').toUpperCase().includes('TAX')) { %>
                    <span class="status-badge px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-amber-950/80 text-amber-400 border border-amber-500/40 flex items-center gap-1 w-max">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span>
                      <span>Awaiting Tax Review</span>
                    </span>
                  <% } else if ((reqItem.status || '').toUpperCase() === 'COMPLETED' || (reqItem.status || '').toUpperCase() === 'TAX_LOCKED') { %>
                    <span class="status-badge px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 flex items-center gap-1 w-max">
                      <span>✓ TAX LOCKED · DONE</span>
                    </span>
                  <% } else { %>
                    <span class="status-badge px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-sky-950/80 text-sky-400 border border-sky-500/30">
                      IN PROGRESS
                    </span>
                  <% } %>
                </td>
                <td class="py-3.5 px-4 font-sans text-xs">
                  <% if ((reqItem.principalName || '').includes('Deepa') || (reqItem.ticketNumber || '').includes('8819')) { %>
                    <div class="text-amber-300 font-semibold flex items-center gap-1">
                      <span>⚠️ 3 Silos (WhatsApp, Leads, Tax Invoicing)</span>
                    </div>
                    <div class="text-[10px] text-slate-400 font-mono">Invoice INV-2024-309 Collision</div>
                  <% } else { %>
                    <div class="text-slate-400">1 Silo (WhatsApp Chat)</div>
                  <% } %>
                </td>
                <td class="py-3.5 px-4 text-slate-400 whitespace-nowrap">
                  <%= reqItem.createdAt ? new Date(reqItem.createdAt).toLocaleDateString('en-IN', { dateStyle: 'medium' }) : '2024-10-18' %>
                </td>
                <td class="py-3.5 px-4 text-right font-sans whitespace-nowrap">
                  <div class="inline-flex items-center gap-2 justify-end">
                    <% if ((reqItem.principalName || '').includes('Deepa') || (reqItem.ticketNumber || '').includes('8819') || (reqItem.status || '').includes('TAX')) { %>
                      <button
                        type="button"
                        class="btn-trigger-smart-erasure px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-xs transition-colors shadow-lg shadow-emerald-900/40 flex items-center gap-1.5"
                        data-ticket="<%= reqItem.ticketNumber || reqItem.id %>"
                        data-principal="<%= reqItem.principalName %>"
                        data-phone="<%= reqItem.principalPhone %>"
                        title="Open Dual-Track Statutory Collision Resolver Modal"
                      >
                        <span>🛡️</span>
                        <span>Execute Smart Erasure</span>
                      </button>
                    <% } %>

                    <button
                      type="button"
                      class="btn-open-occurrences px-3 py-1.5 rounded-lg bg-sky-600 hover:bg-sky-500 text-white font-semibold text-xs transition-colors shadow"
                      data-ticket="<%= reqItem.ticketNumber || reqItem.id %>"
                      data-principal="<%= reqItem.principalName %>"
                    >
                      🔍 Locate Occurrences
                    </button>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Smart Resolution Modal (Dual-Track Statutory Collision Resolver) -->
  <div id="smartResolutionModal" class="fixed inset-0 bg-slate-950/85 backdrop-blur-md z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border-2 border-emerald-500/50 rounded-2xl max-w-4xl w-full max-h-[92vh] flex flex-col shadow-2xl overflow-hidden animate-in fade-in duration-200">
      <!-- Modal Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/80">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/40">
              STATUTORY COLLISION RESOLVER · PILLAR 3
            </span>
            <span id="modalTicketBadge" class="text-xs font-mono font-bold text-sky-400">DSR-2026-8819</span>
          </div>
          <h2 class="text-lg font-bold text-white mt-1 flex items-center gap-2">
            <span>Dual-Track Statutory Resolution:</span>
            <span id="modalPrincipalTitle" class="text-sky-300">Deepa Nair (+91 9988776655)</span>
          </h2>
          <p class="text-xs text-slate-400 mt-0.5">
            Reconciliation: DPDP Act Section 12(3) Erasure vs. Central Goods & Services Tax (CGST) Act Section 36 6-Year Tax Lock.
          </p>
        </div>
        <button type="button" id="btnCloseSmartModal" class="text-slate-400 hover:text-white p-1.5 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Modal Body -->
      <div class="p-6 overflow-y-auto space-y-5">
        <!-- Statutory Banners -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Green Banner: Informal Erasure -->
          <div class="p-4 rounded-xl bg-emerald-950/50 border border-emerald-500/40 text-xs space-y-1.5">
            <div class="font-bold text-emerald-300 flex items-center gap-2 text-sm">
              <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
              <span>Track A: WhatsApp Chat & Lead Sheet Redacted Permanently</span>
            </div>
            <p class="text-slate-300 leading-relaxed">
              Statutory erasure executed under <strong>DPDP Act Section 12(3)</strong>. All informal occurrences in WhatsApp reception chats and CSV lead records have been atomically overwritten with <code>[REDACTED-DPDP-SEC-12]</code>.
            </p>
          </div>

          <!-- Amber Banner: CGST Tax Lock -->
          <div class="p-4 rounded-xl bg-amber-950/50 border border-amber-500/40 text-xs space-y-1.5">
            <div class="font-bold text-amber-300 flex items-center gap-2 text-sm">
              <span class="w-2 h-2 rounded-full bg-amber-400"></span>
              <span>Track B: Statutory Tax Lock Activated on Invoice INV-2024-309</span>
            </div>
            <p class="text-slate-300 leading-relaxed">
              Protected under <strong>CGST Act, 2017 Section 36</strong> (mandatory 72-month retention) read with <strong>DPDP Act Section 8(7)</strong> until <strong>2030-12-31</strong>. Personal phone masked to <code>+91 99XXXXXX55</code> while GST audit fields are preserved.
            </p>
          </div>
        </div>

        <!-- Before / After Visual File Breakdown -->
        <div class="space-y-3">
          <div class="flex items-center justify-between">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span>🔍 Atomic File Redaction vs Statutory Retention Breakdown</span>
            </h3>
            <span class="text-[11px] text-slate-400 font-mono">Formula-Safe · Atomic Write Guaranteed</span>
          </div>

          <!-- File 1: WhatsApp Chat -->
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-emerald-400 flex items-center gap-1.5">
                💬 1. WhatsApp Reception Chat (clinic_reception_chat.txt · Line 14)
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-500/30">
                ATOMIC REDACTION · TRACK A
              </span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-[11px] font-mono">
              <div class="bg-rose-950/30 border border-rose-500/30 p-2.5 rounded text-rose-200">
                <span class="block text-[10px] font-bold text-rose-400 uppercase mb-1">&minus; BEFORE ERASURE (EXPOSED PII)</span>
                [14/10/24, 11:32:00 AM] <strong class="text-white">Deepa Nair</strong>: Hello, I sent samples for Lipid Panel test under mobile <strong class="text-white">+91 9988776655</strong>. Please confirm dispatch.
              </div>
              <div class="bg-emerald-950/30 border border-emerald-500/40 p-2.5 rounded text-emerald-200">
                <span class="block text-[10px] font-bold text-emerald-400 uppercase mb-1">&plus; AFTER ATOMIC REDACTION</span>
                [14/10/24, 11:32:00 AM] <strong class="text-emerald-300">[REDACTED-DPDP-SEC-12]</strong>: Hello, I sent samples for Lipid Panel test under mobile +91 <strong class="text-emerald-300">[REDACTED-DPDP-SEC-12]</strong>. Please confirm dispatch.
              </div>
            </div>
          </div>

          <!-- File 2: Customer Leads CSV -->
          <div class="p-4 rounded-xl bg-slate-950 border border-slate-800 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-sky-400 flex items-center gap-1.5">
                📊 2. Customer Leads Spreadsheet (customer_leads.csv · Row 5)
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-500/30">
                ATOMIC REDACTION · TRACK A
              </span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-[11px] font-mono">
              <div class="bg-rose-950/30 border border-rose-500/30 p-2.5 rounded text-rose-200">
                <span class="block text-[10px] font-bold text-rose-400 uppercase mb-1">&minus; BEFORE ERASURE (EXPOSED PII)</span>
                L-104, <strong class="text-white">Deepa Nair</strong>, <strong class="text-white">9988776655</strong>, deepa.nair@corp.com, Bengaluru, Aadhaar: <strong class="text-white">6734 5234 8901</strong>, PAN: <strong class="text-white">PQRST3456D</strong>
              </div>
              <div class="bg-emerald-950/30 border border-emerald-500/40 p-2.5 rounded text-emerald-200">
                <span class="block text-[10px] font-bold text-emerald-400 uppercase mb-1">&plus; AFTER ATOMIC REDACTION</span>
                L-104, <strong class="text-emerald-300">[REDACTED-DPDP-SEC-12]</strong>, <strong class="text-emerald-300">[REDACTED-DPDP-SEC-12]</strong>, <strong class="text-emerald-300">[REDACTED-DPDP-SEC-12]</strong>, Bengaluru, Aadhaar: <strong class="text-emerald-300">[REDACTED-DPDP-SEC-12]</strong>, PAN: <strong class="text-emerald-300">[REDACTED-DPDP-SEC-12]</strong>
              </div>
            </div>
          </div>

          <!-- File 3: Invoices Billing CSV -->
          <div class="p-4 rounded-xl bg-slate-950 border border-amber-500/40 space-y-2">
            <div class="flex items-center justify-between text-xs">
              <span class="font-bold text-amber-400 flex items-center gap-1.5">
                🧾 3. Financial & Tax Invoice (invoices_billing.csv · INV-2024-309)
              </span>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-500/40">
                MANDATORY STATUTORY TAX LOCK · TRACK B
              </span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-[11px] font-mono">
              <div class="bg-slate-900 border border-slate-700 p-2.5 rounded text-slate-300">
                <span class="block text-[10px] font-bold text-slate-400 uppercase mb-1">ORIGINAL INVOICE RECORD</span>
                INV-2024-309, 2024-09-15, Deepa Nair, <strong class="text-white">9988776655</strong>, GSTIN: 29DDDDD3333D1Z1, Rs. 12,000.00
              </div>
              <div class="bg-amber-950/30 border border-amber-500/40 p-2.5 rounded text-amber-200">
                <span class="block text-[10px] font-bold text-amber-400 uppercase mb-1">STATUTORY TAX LOCK APPLIED</span>
                INV-2024-309, 2024-09-15, Deepa Nair, <strong class="text-amber-300">+91 99XXXXXX55</strong>, GSTIN: 29DDDDD3333D1Z1, Rs. 12,000.00 <span class="text-xs text-amber-400 font-bold">[LOCKED UNTIL 2030-12-31]</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Cryptographic Proof Box (SHA-256) -->
        <div id="cryptoProofCard" class="p-4 rounded-xl bg-slate-950/80 border border-sky-500/30 space-y-2">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold text-sky-400 flex items-center gap-1.5">
              <span>🔒 SHA-256 Digital Fingerprint Non-Repudiation Proof</span>
            </span>
            <span id="certIdDisplay" class="text-xs font-mono font-bold text-emerald-400">CERT-ERASURE-2026-8819</span>
          </div>
          <div id="certHashDisplay" class="font-mono text-xs text-sky-200 bg-slate-900/90 p-2.5 rounded border border-slate-800 break-all select-all">
            e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
          </div>
          <div class="text-[11px] text-slate-400">
            Hash computed over: <code>ticketId + principalPhone + informalRedactionsCount (2) + taxLockedCount (1) + timestamp</code>. Verifiable by data principal and tax authorities under Section 8(7).
          </div>
        </div>
      </div>

      <!-- Modal Footer -->
      <div class="p-4 border-t border-slate-800 bg-slate-950/80 flex flex-col sm:flex-row items-center justify-between gap-3">
        <div class="text-xs text-slate-400 font-mono">
          Status: <strong id="resolutionStatusText" class="text-emerald-400">Ready for Execution</strong>
        </div>
        <div class="flex items-center gap-3">
          <button
            type="button"
            id="btnRunDualTrack"
            class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-all shadow-lg shadow-emerald-900/40 flex items-center gap-2"
          >
            <span>⚡</span>
            <span>Execute Dual-Track Erasure</span>
          </button>
          <a
            id="btnDownloadCertPdf"
            href="/api/privacy/download-cert/CERT-ERASURE-2026-8819"
            target="_blank"
            class="px-4 py-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold transition-all shadow-lg shadow-sky-900/40 flex items-center gap-2"
          >
            <span>📥</span>
            <span>Download Cryptographic Erasure Certificate (PDF)</span>
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Slide-Out Silo Occurrence Drawer (Section 11 Inspector) -->
  <div id="occurrenceModal" class="fixed inset-0 bg-slate-950/80 backdrop-blur-sm z-50 hidden flex items-center justify-center p-4">
    <div class="bg-slate-900 border border-slate-700 rounded-2xl max-w-3xl w-full max-h-[90vh] flex flex-col shadow-2xl overflow-hidden">
      <!-- Drawer Header -->
      <div class="p-5 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
        <div>
          <div class="flex items-center gap-2">
            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-950 text-sky-400 border border-sky-500/30">OCCURRENCE LOCATOR</span>
            <span id="drawerTicketId" class="text-xs font-mono font-bold text-white">DSR-2026-8819</span>
          </div>
          <h2 id="drawerPrincipal" class="text-base font-bold text-white mt-1">Deepa Nair (+91 9988776655)</h2>
        </div>
        <button type="button" id="btnCloseDrawer" class="text-slate-400 hover:text-white p-1 rounded-lg transition-colors">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>

      <!-- Drawer Content -->
      <div class="p-5 overflow-y-auto space-y-4">
        <!-- Collision Warning Banner -->
        <div class="p-3.5 rounded-xl bg-amber-950/60 border border-amber-500/40 text-xs text-amber-200 space-y-1">
          <div class="font-bold text-amber-300 flex items-center gap-1.5">
            <span>⚖️ Statutory Conflict Detected: DPDP Act Section 12 vs CGST Act Section 36</span>
          </div>
          <p class="text-slate-300">
            Citizen requests complete erasure. While informal WhatsApp and spreadsheet records can be redacted, financial invoice <strong>INV-2024-309</strong> must be preserved for 72 months (6 years) under tax retention laws.
          </p>
        </div>

        <!-- Discovered Silos List -->
        <div class="space-y-3">
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">Discovered Occurrences Across Data Silos</h3>

          <!-- Silo 1: WhatsApp -->
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-1.5">
            <div class="flex items-center justify-between text-xs">
              <div class="font-bold text-emerald-400 flex items-center gap-1.5">
                <span>💬 WhatsApp Reception Chat (clinic_reception_chat.txt)</span>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-950 text-rose-300 border border-rose-500/30">INFORMAL SILO · ERASE</span>
            </div>
            <div class="font-mono text-[11px] text-slate-300 bg-slate-900/80 p-2.5 rounded border border-slate-800">
              <strong class="text-sky-400">Line 14:</strong> [14/10/24, 11:32:00 AM] Deepa Nair: Hello, I sent samples for Lipid Panel test under mobile +91 9988776655. Please confirm dispatch.
            </div>
          </div>

          <!-- Silo 2: Leads Spreadsheet -->
          <div class="p-3.5 rounded-xl bg-slate-950 border border-slate-800 space-y-1.5">
            <div class="flex items-center justify-between text-xs">
              <div class="font-bold text-sky-400 flex items-center gap-1.5">
                <span>📊 Customer Leads Spreadsheet (customer_leads.csv)</span>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-950 text-rose-300 border border-rose-500/30">EXCEL SILO · ERASE</span>
            </div>
            <div class="font-mono text-[11px] text-slate-300 bg-slate-900/80 p-2.5 rounded border border-slate-800">
              <strong class="text-sky-400">Row 5:</strong> L-104, Deepa Nair, 9988776655, deepa.nair@corp.com, Bengaluru, Aadhaar: 6734 5234 8901, PAN: PQRST3456D
            </div>
          </div>

          <!-- Silo 3: Tally Billing Export -->
          <div class="p-3.5 rounded-xl bg-slate-950 border border-amber-500/40 space-y-1.5">
            <div class="flex items-center justify-between text-xs">
              <div class="font-bold text-amber-400 flex items-center gap-1.5">
                <span>🧾 Tally Billing Export (invoices_billing.csv)</span>
              </div>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-950 text-amber-300 border border-amber-500/40">STATUTORY TAX LOCK · PRESERVE</span>
            </div>
            <div class="font-mono text-[11px] text-slate-300 bg-slate-900/80 p-2.5 rounded border border-slate-800">
              <strong class="text-amber-400">Row 5:</strong> INV-2024-309 | Date: 2024-09-15 | Customer: Deepa Nair | Amount: Rs. 12,000 | GSTIN: 29DDDDD3333D1Z1
            </div>
            <div class="text-[11px] text-amber-300/90 italic">
              Mandatory tax lock active until 2030-12-31 under CGST Act Section 36 read with DPDP Act Section 8(7).
            </div>
          </div>
        </div>
      </div>

      <!-- Drawer Actions Footer -->
      <div class="p-4 border-t border-slate-800 bg-slate-950/60 flex items-center justify-between gap-3">
        <a id="btnDownloadSummary" href="/api/privacy/dsr/DSR-2026-8819/summary" target="_blank" class="px-3 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors">
          📄 Download Section 11 Summary (JSON)
        </a>
        <div class="flex items-center gap-2">
          <button type="button" id="btnDrawerTriggerResolver" class="px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition-colors shadow-lg shadow-emerald-900/40">
            🛡️ Open Smart Resolution Modal &rarr;
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    // Modal Elements
    const occurrenceModal = document.getElementById('occurrenceModal');
    const closeDrawerBtn = document.getElementById('btnCloseDrawer');
    const drawerTicketId = document.getElementById('drawerTicketId');
    const drawerPrincipal = document.getElementById('drawerPrincipal');
    const btnDownloadSummary = document.getElementById('btnDownloadSummary');
    const occurrenceButtons = document.querySelectorAll('.btn-open-occurrences');
    const btnDrawerTriggerResolver = document.getElementById('btnDrawerTriggerResolver');

    const smartModal = document.getElementById('smartResolutionModal');
    const closeSmartModalBtn = document.getElementById('btnCloseSmartModal');
    const smartErasureButtons = document.querySelectorAll('.btn-trigger-smart-erasure');
    const modalTicketBadge = document.getElementById('modalTicketBadge');
    const modalPrincipalTitle = document.getElementById('modalPrincipalTitle');
    const btnRunDualTrack = document.getElementById('btnRunDualTrack');
    const btnDownloadCertPdf = document.getElementById('btnDownloadCertPdf');
    const certIdDisplay = document.getElementById('certIdDisplay');
    const certHashDisplay = document.getElementById('certHashDisplay');
    const resolutionStatusText = document.getElementById('resolutionStatusText');

    let currentTicket = 'DSR-2026-8819';
    let currentPhone = '+91 9988776655';

    // 1. Occurrence Drawer Handling
    occurrenceButtons.forEach((btn) => {
      btn.addEventListener('click', async () => {
        const ticket = btn.getAttribute('data-ticket');
        const principal = btn.getAttribute('data-principal');

        currentTicket = ticket;
        if (drawerTicketId) drawerTicketId.textContent = ticket;
        if (drawerPrincipal) drawerPrincipal.textContent = principal;
        if (btnDownloadSummary) btnDownloadSummary.href = `/api/privacy/dsr/${ticket}/summary`;

        occurrenceModal.classList.remove('hidden');

        try {
          const res = await fetch(`/api/privacy/dsr/${ticket}/occurrences`);
          const data = await res.json();
          if (data.success && data.principal) {
            drawerPrincipal.textContent = data.principal;
          }
        } catch (e) {
          // Keep pre-loaded fallback
        }
      });
    });

    if (closeDrawerBtn) {
      closeDrawerBtn.addEventListener('click', () => occurrenceModal.classList.add('hidden'));
    }
    occurrenceModal.addEventListener('click', (e) => {
      if (e.target === occurrenceModal) occurrenceModal.classList.add('hidden');
    });

    // 2. Open Smart Resolution Modal from Occurrence Drawer
    if (btnDrawerTriggerResolver) {
      btnDrawerTriggerResolver.addEventListener('click', () => {
        occurrenceModal.classList.add('hidden');
        openSmartModal(currentTicket, 'Deepa Nair', currentPhone);
      });
    }

    // 3. Open Smart Resolution Modal from Table Row Button
    smartErasureButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const ticket = btn.getAttribute('data-ticket') || 'DSR-2026-8819';
        const principal = btn.getAttribute('data-principal') || 'Deepa Nair';
        const phone = btn.getAttribute('data-phone') || '+91 9988776655';
        openSmartModal(ticket, principal, phone);
      });
    });

    function openSmartModal(ticket, principal, phone) {
      currentTicket = ticket;
      currentPhone = phone;

      if (modalTicketBadge) modalTicketBadge.textContent = ticket;
      if (modalPrincipalTitle) modalPrincipalTitle.textContent = `${principal} (${phone})`;
      
      const certId = `CERT-ERASURE-2026-${ticket.includes('-') ? ticket.split('-').pop() : '8819'}`;
      if (certIdDisplay) certIdDisplay.textContent = certId;
      if (btnDownloadCertPdf) btnDownloadCertPdf.href = `/api/privacy/download-cert/${certId}`;

      smartModal.classList.remove('hidden');
    }

    if (closeSmartModalBtn) {
      closeSmartModalBtn.addEventListener('click', () => smartModal.classList.add('hidden'));
    }
    smartModal.addEventListener('click', (e) => {
      if (e.target === smartModal) smartModal.classList.add('hidden');
    });

    // 4. Execute Dual-Track Statutory Collision Erasure
    if (btnRunDualTrack) {
      btnRunDualTrack.addEventListener('click', async () => {
        btnRunDualTrack.disabled = true;
        btnRunDualTrack.innerHTML = '<span>⏳</span><span>Executing Atomic Redaction & Tax Lock...</span>';
        if (resolutionStatusText) {
          resolutionStatusText.textContent = 'Processing Atomic Writes...';
          resolutionStatusText.className = 'text-amber-400 animate-pulse';
        }

        try {
          const res = await fetch('/api/privacy/execute-erasure', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              ticketId: currentTicket,
              principalPhone: currentPhone
            })
          });

          const data = await res.json();
          if (data.success) {
            if (resolutionStatusText) {
              resolutionStatusText.textContent = 'Statutory Resolution Complete (Tax Locked)';
              resolutionStatusText.className = 'text-emerald-400 font-bold';
            }

            if (certIdDisplay) certIdDisplay.textContent = data.certificateId;
            if (certHashDisplay) certHashDisplay.textContent = data.certHash || data.sha256Fingerprint;
            if (btnDownloadCertPdf) {
              btnDownloadCertPdf.href = data.certUrl || `/api/privacy/download-cert/${data.certificateId}`;
              btnDownloadCertPdf.classList.add('ring-2', 'ring-emerald-400', 'animate-bounce');
              setTimeout(() => btnDownloadCertPdf.classList.remove('animate-bounce'), 2000);
            }

            btnRunDualTrack.disabled = false;
            btnRunDualTrack.innerHTML = '<span>✓</span><span>Re-Verify Statutory Erasure</span>';

            // Update row status badge in table
            const row = document.getElementById(`row-${currentTicket}`);
            if (row) {
              const statusCell = row.querySelector('.status-cell');
              if (statusCell) {
                statusCell.innerHTML = `
                  <span class="status-badge px-2.5 py-1 rounded-full text-[10px] font-bold uppercase tracking-wider bg-emerald-950/80 text-emerald-400 border border-emerald-500/30 flex items-center gap-1 w-max">
                    <span>✓ TAX LOCKED · DONE</span>
                  </span>
                `;
              }
            }
          } else {
            alert(data.error || 'Statutory collision erasure failed.');
            btnRunDualTrack.disabled = false;
            btnRunDualTrack.innerHTML = '<span>⚡</span><span>Execute Dual-Track Erasure</span>';
          }
        } catch (err) {
          alert(`Network error executing erasure: ${err.message}`);
          btnRunDualTrack.disabled = false;
          btnRunDualTrack.innerHTML = '<span>⚡</span><span>Execute Dual-Track Erasure</span>';
        }
      });
    }
  })();
</script>

