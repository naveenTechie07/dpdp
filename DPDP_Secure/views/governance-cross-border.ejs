<%- include('partials/header') %>

<% 
const transfersList = (typeof transfers !== 'undefined' && Array.isArray(transfers)) ? transfers : [];
const totalTransfers = transfersList.length;
const lowRiskCount = transfersList.filter(t => t.riskLevel === 'LOW').length;
const medRiskCount = transfersList.filter(t => t.riskLevel === 'MEDIUM').length;
const highRiskCount = transfersList.filter(t => t.riskLevel === 'HIGH' || t.riskLevel === 'CRITICAL').length;
%>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Active Transfers</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalTransfers %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Adequate Destinations</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #10b981;"><%= lowRiskCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Medium Risk / Under Review</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #f59e0b;"><%= medRiskCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">DPDP Sec 16 Restrictions</span>
            <h2 class="metric-value" style="margin-top: 8px; color: <%= highRiskCount > 0 ? '#ef4444' : '#10b981' %>;"><%= highRiskCount %></h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between; display: flex;">
    <div class="title-group">
        <h1 class="page-title"><%= (typeof title !== 'undefined' ? title : 'Cross-Border Transfers').split(' - ')[0] %></h1>
        <p class="page-description">Track international data transfers, Section 16 Central Government negative list compliance, and standard clauses.</p>
    </div>
    <button class="btn-primary" onclick="document.getElementById('add-transfer-modal').style.display='flex'" style="padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Transfer
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" id="transfer-search" placeholder="Search cross-border transfers..." onkeyup="filterTransfers()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalTransfers %> transfers</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="transfers-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 14px 24px; font-weight: 600;">Destination Country &#9652;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Recipient Entity &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Data Categories &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Transfer Mechanism</th>
                <th style="padding: 14px 16px; font-weight: 600;">Risk Tier &#8597;</th>
                <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (transfersList.length === 0) { %>
                <tr>
                    <td colspan="6" style="padding: 32px; text-align: center; color: var(--text-muted);">No cross-border transfers recorded. All data is processed within Indian sovereign borders.</td>
                </tr>
            <% } else { %>
                <% transfersList.forEach(tr => { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="transfer-row">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="#3b82f6" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                                <span><%= tr.destinationCountry %></span>
                            </div>
                        </td>
                        <td style="padding: 16px 16px; font-weight: 500; color: var(--text-main);"><%= tr.recipientName %></td>
                        <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px; max-width: 220px;"><%= tr.dataCategories %></td>
                        <td style="padding: 16px 16px;">
                            <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">
                                <%= tr.transferMechanism || 'SCC' %>
                            </span>
                        </td>
                        <td style="padding: 16px 16px;">
                            <% if (tr.riskLevel === 'LOW') { %>
                                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">LOW</span>
                            <% } else if (tr.riskLevel === 'MEDIUM') { %>
                                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">MEDIUM</span>
                            <% } else { %>
                                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;"><%= tr.riskLevel || 'HIGH' %></span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteTransfer('<%= tr.id %>')" title="Delete Transfer" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<!-- Add Transfer Modal Overlay -->
<div id="add-transfer-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card p-0" style="width: 520px; background: #0f172a; border: 1px solid #334155; box-shadow: 0 20px 30px rgba(0,0,0,0.6); border-radius: 12px; overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; background: #1e293b;">
            <h2 style="font-size: 16px; font-weight: 600; color: #f8fafc; margin: 0;">Record Cross-Border Transfer</h2>
            <button onclick="document.getElementById('add-transfer-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <form id="add-tr-form" onsubmit="handleAddTransfer(event)" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Destination Country *</label>
                <input type="text" id="trCountry" required placeholder="e.g. United Kingdom / Singapore" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Recipient Organization / Hospital *</label>
                <input type="text" id="trRecipient" required placeholder="e.g. Kings College Tele-Radiology Group (London)" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Transfer Mechanism</label>
                    <select id="trMechanism" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        <option value="Standard Contractual Clauses (SCC)">Standard Contractual Clauses (SCC)</option>
                        <option value="Binding Corporate Rules (BCR)">Binding Corporate Rules (BCR)</option>
                        <option value="Explicit Patient Consent">Explicit Patient Consent</option>
                        <option value="Adequacy Decision">Adequacy Decision</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Risk Tier</label>
                    <select id="trRisk" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        <option value="LOW">LOW</option>
                        <option value="MEDIUM">MEDIUM</option>
                        <option value="HIGH">HIGH (Notification Required)</option>
                    </select>
                </div>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Data Categories Transferred</label>
                <input type="text" id="trCategories" placeholder="e.g. Anonymized DICOM imaging, Patient age/gender" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Record Transfer</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('add-transfer-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: #334155; border: 1px solid #475569; color: #f8fafc;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterTransfers() {
    const q = document.getElementById('transfer-search').value.toLowerCase();
    document.querySelectorAll('.transfer-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function handleAddTransfer(e) {
    e.preventDefault();
    const destinationCountry = document.getElementById('trCountry').value.trim();
    const recipientName = document.getElementById('trRecipient').value.trim();
    const transferMechanism = document.getElementById('trMechanism').value;
    const riskLevel = document.getElementById('trRisk').value;
    const dataCategories = document.getElementById('trCategories').value.trim();

    try {
        const res = await fetch('/api/governance/cross-border', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ destinationCountry, recipientName, transferMechanism, riskLevel, dataCategories })
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error creating transfer: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error submitting transfer');
    }
}

async function deleteTransfer(id) {
    if (!confirm('Are you sure you want to delete this transfer record?')) return;
    try {
        const res = await fetch(`/api/governance/cross-border/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting transfer: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting transfer');
    }
}
</script>

<%- include('partials/footer') %>
