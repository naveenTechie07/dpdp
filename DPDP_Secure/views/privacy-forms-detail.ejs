<%- include('partials/header') %>
<% var tab = (typeof tab !== 'undefined' && tab) ? tab : 'designer'; %>

<div class="dashboard-header mb-4" style="border-bottom: 1px solid var(--border-color); padding-bottom: 16px; margin-bottom: 24px;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
        <div>
            <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 8px;">
                <a href="/privacy/forms" style="color: var(--text-muted); display: flex; align-items: center; text-decoration: none; gap: 4px;">
                    <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
                    Back
                </a>
                <h1 class="page-title" style="margin-bottom: 0;"><%= title.split(' - ')[0] %></h1>
                <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">ACTIVE</span>
                <span style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-color); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600; display: flex; align-items: center; gap: 4px;">
                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
                    Hosted Web Form
                </span>
            </div>
            <p class="page-description" style="margin-bottom: 0;">Draft v1 &middot; Published v1 &middot; Updated 29 Aug 2026, 03:03 pm</p>
        </div>
        <button class="btn-secondary" style="padding: 8px 16px; font-size: 13px; color: #fef08a; background: rgba(254, 240, 138, 0.1); border: 1px solid rgba(254, 240, 138, 0.2); display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
            Create new draft to edit
        </button>
    </div>

    <!-- Tabs -->
    <div style="display: flex; gap: 2px; margin-top: 24px; justify-content: center;">
        <div style="display: flex; background: rgba(255,255,255,0.05); padding: 4px; border-radius: 8px; border: 1px solid var(--border-color);">
            <a href="?tab=designer" style="padding: 6px 16px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: <%= tab === 'designer' ? 'white' : 'var(--text-muted)' %>; background: <%= tab === 'designer' ? 'rgba(255,255,255,0.1)' : 'transparent' %>;">Form Designer</a>
            <a href="?tab=branding" style="padding: 6px 16px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: <%= tab === 'branding' ? 'white' : 'var(--text-muted)' %>; background: <%= tab === 'branding' ? 'rgba(255,255,255,0.1)' : 'transparent' %>;">Branding</a>
            <a href="?tab=settings" style="padding: 6px 16px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: <%= tab === 'settings' ? 'white' : 'var(--text-muted)' %>; background: <%= tab === 'settings' ? 'rgba(255,255,255,0.1)' : 'transparent' %>;">Settings</a>
            <a href="?tab=analytics" style="padding: 6px 16px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: <%= tab === 'analytics' ? 'white' : 'var(--text-muted)' %>; background: <%= tab === 'analytics' ? 'rgba(255,255,255,0.1)' : 'transparent' %>;">Analytics</a>
            <a href="?tab=translations" style="padding: 6px 16px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: <%= tab === 'translations' ? 'white' : 'var(--text-muted)' %>; background: <%= tab === 'translations' ? 'rgba(255,255,255,0.1)' : 'transparent' %>;">Translations</a>
            <a href="?tab=integrations" style="padding: 6px 16px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: <%= tab === 'integrations' ? 'white' : 'var(--text-muted)' %>; background: <%= tab === 'integrations' ? 'rgba(255,255,255,0.1)' : 'transparent' %>;">Integrations</a>
            <a href="?tab=workflow" style="padding: 6px 16px; font-size: 13px; font-weight: 500; text-decoration: none; border-radius: 6px; color: <%= tab === 'workflow' ? 'white' : 'var(--text-muted)' %>; background: <%= tab === 'workflow' ? 'rgba(255,255,255,0.1)' : 'transparent' %>;">Workflow</a>
        </div>
    </div>
</div>

<% if (tab === 'designer') { %>
    <div style="display: flex; gap: 24px;">
        <div style="flex: 3; display: flex; flex-direction: column; gap: 16px;">
            <!-- Form Details Card -->
            <div class="card">
                <h2 style="font-size: 16px; font-weight: 600; color: var(--text-main); margin-top: 0; margin-bottom: 16px;">Form Details</h2>
                <div style="display: flex; gap: 16px;">
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Form Name</label>
                        <input type="text" value="DPDP_Secure Data Rights Intake" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                    </div>
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Description</label>
                        <input type="text" value="DPDPA 2023 data rights form" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                    </div>
                </div>
            </div>

            <!-- Sections Card -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <h2 style="font-size: 16px; font-weight: 600; color: var(--text-main); margin: 0;">Sections</h2>
                    <button class="btn-secondary" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-muted); padding: 6px 12px; border-radius: 6px; font-size: 12px; display: flex; align-items: center; gap: 6px;">
                        <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        Add Section
                    </button>
                </div>
                <div style="color: var(--text-muted); font-size: 13px;">
                    No sections &mdash; fields are ungrouped.
                </div>
            </div>

            <!-- Form Fields Card -->
            <div class="card">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
                    <div>
                        <h2 style="font-size: 16px; font-weight: 600; color: var(--text-main); margin: 0;">Form Fields</h2>
                        <div style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">0 fields &middot; drag to reorder</div>
                    </div>
                    <button class="btn-primary" style="background: rgba(219, 39, 119, 0.2); border: 1px solid rgba(219, 39, 119, 0.4); color: #ec4899; padding: 6px 12px; border-radius: 6px; font-size: 13px; display: flex; align-items: center; gap: 6px;">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="8" x2="12" y2="16"></line><line x1="8" y1="12" x2="16" y2="12"></line></svg>
                        Add Field
                    </button>
                </div>
                <div style="border: 1px dashed var(--border-color); border-radius: 8px; padding: 48px; text-align: center; color: var(--text-muted);">
                    <svg viewBox="0 0 24 24" width="32" height="32" stroke="currentColor" stroke-width="2" fill="none" style="margin-bottom: 12px; opacity: 0.5;"><polyline points="4 7 4 4 20 4 20 7"></polyline><line x1="9" y1="20" x2="15" y2="20"></line><line x1="12" y1="4" x2="12" y2="20"></line></svg>
                    <div style="font-size: 14px;">No fields yet &mdash; click <strong>Add Field</strong> to start.</div>
                </div>
            </div>
        </div>

        <div style="flex: 2;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px; color: var(--text-muted); font-weight: 600; font-size: 13px;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                Live Preview
            </div>
            <!-- Preview Box -->
            <div style="background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); overflow: hidden; height: 500px;">
                <div style="padding: 24px; border-bottom: 1px solid #e5e7eb; display: flex; gap: 16px; align-items: center;">
                    <div style="width: 48px; height: 48px; border-radius: 8px; background: #6366f1;"></div>
                    <div>
                        <div style="font-size: 16px; font-weight: 600; color: #111827;">Your Brand</div>
                        <div style="font-size: 12px; color: #6b7280;">Data Principal Rights Request</div>
                    </div>
                </div>
                <div style="padding: 24px; background: #f8fafc; height: 100%;">
                    <div style="border: 1px dashed #cbd5e1; border-radius: 8px; padding: 48px 24px; text-align: center; color: #94a3b8; background: white; font-size: 14px;">
                        Add fields using the designer on the left
                    </div>
                </div>
            </div>
        </div>
    </div>
<% } else if (tab === 'branding') { %>
    <div style="display: flex; gap: 24px;">
        <div style="flex: 3;">
            <div class="card">
                <h2 style="font-size: 16px; font-weight: 600; color: var(--text-main); margin-top: 0; margin-bottom: 24px;">Form Branding</h2>
                
                <div style="margin-bottom: 24px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Brand Name</label>
                    <input type="text" value="Your Organisation" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>

                <div style="margin-bottom: 24px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Logo</label>
                    <div style="display: flex; gap: 16px; align-items: center; margin-bottom: 12px;">
                        <button class="btn-secondary" style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-muted); padding: 8px 16px; border-radius: 6px; font-size: 13px; display: flex; align-items: center; gap: 8px;">
                            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>
                            Upload image
                        </button>
                        <span style="font-size: 11px; color: var(--text-muted);">JPEG, PNG, WebP, SVG or GIF - max 2 MB. Or enter a URL below.</span>
                    </div>
                    <input type="text" value="https://example.com/logo.png" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>

                <div style="display: flex; gap: 24px; margin-bottom: 24px;">
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Primary Color</label>
                        <div style="display: flex; gap: 8px;">
                            <div style="width: 38px; height: 38px; background: #6366f1; border-radius: 6px; border: 1px solid var(--border-color);"></div>
                            <input type="text" value="#6366f1" style="flex: 1; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        </div>
                    </div>
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Accent Soft Color</label>
                        <div style="display: flex; gap: 8px;">
                            <div style="width: 38px; height: 38px; background: #4f46e5; border-radius: 6px; border: 1px solid var(--border-color);"></div>
                            <input type="text" value="#4f46e5" style="flex: 1; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        </div>
                    </div>
                </div>

                <div style="display: flex; gap: 24px; margin-bottom: 24px;">
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Background Top</label>
                        <div style="display: flex; gap: 8px;">
                            <div style="width: 38px; height: 38px; background: #f8fafc; border-radius: 6px; border: 1px solid var(--border-color);"></div>
                            <input type="text" value="#f8fafc" style="flex: 1; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        </div>
                    </div>
                    <div style="flex: 1;">
                        <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Background Middle</label>
                        <div style="display: flex; gap: 8px;">
                            <div style="width: 38px; height: 38px; background: #eff6ff; border-radius: 6px; border: 1px solid var(--border-color);"></div>
                            <input type="text" value="#eff6ff" style="flex: 1; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        </div>
                    </div>
                </div>

                <div style="margin-bottom: 24px;">
                    <label style="display: block; font-size: 12px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Background Bottom</label>
                    <div style="display: flex; gap: 8px; width: 48%;">
                        <div style="width: 38px; height: 38px; background: #ffffff; border-radius: 6px; border: 1px solid var(--border-color);"></div>
                        <input type="text" value="#ffffff" style="flex: 1; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                    </div>
                </div>
            </div>
        </div>
        
        <div style="flex: 2;">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px; color: var(--text-muted); font-weight: 600; font-size: 13px;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                Live Preview
            </div>
            <!-- Preview Box -->
            <div style="background: white; border-radius: 12px; box-shadow: 0 10px 25px rgba(0,0,0,0.2); overflow: hidden; height: 500px;">
                <div style="padding: 24px; border-bottom: 1px solid #e5e7eb; display: flex; gap: 16px; align-items: center;">
                    <div style="width: 48px; height: 48px; border-radius: 8px; background: #6366f1; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; font-weight: 700;">B</div>
                    <div>
                        <div style="font-size: 16px; font-weight: 600; color: #111827;">Your Brand</div>
                        <div style="font-size: 12px; color: #6b7280;">Rights Request Portal</div>
                    </div>
                </div>
                <div style="padding: 24px; background: linear-gradient(to bottom, #f8fafc, #eff6ff, #ffffff); height: 100%;">
                    <div style="font-size: 14px; font-weight: 600; color: #111827; margin-bottom: 16px; opacity: 0.2;">Submit a Data Principal Rights Request</div>
                    <div style="background: rgba(99, 102, 241, 0.3); border: 1px solid rgba(99, 102, 241, 0.4); padding: 16px; border-radius: 8px; color: #4f46e5; margin-bottom: 16px; font-size: 13px;">
                        This is how accent / card backgrounds will appear.
                    </div>
                    <button style="width: 100%; background: #6366f1; color: white; border: none; padding: 12px; border-radius: 8px; font-weight: 600; font-size: 14px;">
                        Submit Request
                    </button>
                </div>
            </div>
        </div>
    </div>
<% } else if (tab === 'settings') { %>
    <div style="max-width: 800px; margin: 0 auto;">
        <div class="card" style="margin-bottom: 24px;">
            <h2 style="font-size: 16px; font-weight: 600; color: var(--text-main); margin-top: 0; margin-bottom: 24px;">Form Settings</h2>
            
            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Submit Button Label</label>
                <input type="text" value="Submit Request" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Success Message</label>
                <input type="text" value="Your request has been submitted successfully." style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: flex; gap: 24px; margin-bottom: 24px;">
                <div style="flex: 1;">
                    <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Success Redirect URL</label>
                    <input type="text" value="https://example.com/thank-you" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
                <div style="flex: 1;">
                    <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Error Redirect URL</label>
                    <input type="text" value="https://example.com/error" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); padding: 20px; border-radius: 8px; margin-bottom: 24px;">
                <h3 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin-top: 0; margin-bottom: 4px;">Form Layout</h3>
                <p style="color: var(--text-muted); font-size: 12px; margin-bottom: 16px;">Choose how fields are arranged on the page. Set each field's width on the Fields tab once two-column is selected.</p>
                <div style="display: inline-flex; background: rgba(0,0,0,0.3); padding: 4px; border-radius: 8px;">
                    <button style="background: rgba(219, 39, 119, 0.4); color: white; border: none; padding: 6px 16px; border-radius: 6px; font-size: 13px; font-weight: 500;">Single column</button>
                    <button style="background: transparent; color: var(--text-muted); border: none; padding: 6px 16px; border-radius: 6px; font-size: 13px; font-weight: 500;">Two column</button>
                </div>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; padding: 16px 0; border-top: 1px solid var(--border-color);">
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0 0 4px 0;">Bot Protection (Turnstile)</h3>
                    <p style="color: var(--text-muted); font-size: 12px; margin: 0;">Protect the form from automated submissions</p>
                </div>
                <!-- Toggle Switch -->
                <div style="width: 44px; height: 24px; background: white; border-radius: 12px; position: relative; cursor: pointer;">
                    <div style="width: 20px; height: 20px; background: #d1d5db; border-radius: 50%; position: absolute; top: 2px; right: 2px;"></div>
                </div>
            </div>
        </div>

        <div class="card" style="margin-bottom: 24px; border: 1px solid rgba(16, 185, 129, 0.3);">
            <div style="display: flex; gap: 16px; align-items: flex-start; margin-bottom: 24px;">
                <div style="width: 40px; height: 40px; border-radius: 8px; background: rgba(59, 130, 246, 0.1); color: #3b82f6; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                    <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path></svg>
                </div>
                <div>
                    <h3 style="font-size: 16px; font-weight: 600; color: var(--text-main); margin-top: 0; margin-bottom: 4px;">Feature settings</h3>
                    <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Choose which designer capabilities are active for this form.</p>
                </div>
            </div>

            <div style="display: flex; flex-direction: column;">
                <div style="padding: 16px 0; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px;">Honeypot protection</div>
                        <div style="color: var(--text-muted); font-size: 12px;">Add a hidden trap field to deter simple bots.</div>
                    </div>
                    <input type="checkbox" style="width: 18px; height: 18px; opacity: 0.5;">
                </div>
                <div style="padding: 16px 0; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px;">Form analytics</div>
                        <div style="color: var(--text-muted); font-size: 12px;">Track views, starts, completions, and drop-off.</div>
                    </div>
                    <input type="checkbox" checked style="width: 18px; height: 18px; accent-color: var(--primary-color);">
                </div>
                <div style="padding: 16px 0; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                    <div>
                        <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px;">Custom embed</div>
