<%- include('partials/header') %>

<% 
const tmplList = (typeof templates !== 'undefined' && Array.isArray(templates)) ? templates : [];
const totalTemplates = tmplList.length;
const activeCount = tmplList.filter(t => t.isActive === 1 || t.isActive === '1' || t.isActive === true).length;
const totalQuestions = tmplList.reduce((acc, t) => acc + (parseInt(t.questionCount) || 0), 0);
%>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Total Frameworks</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalTemplates %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Active Templates</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #10b981;"><%= activeCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Total Question Bank</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #3b82f6;"><%= totalQuestions %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Statutory Standard</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #f59e0b;">DPDP Act 2023</h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between; display: flex;">
    <div class="title-group">
        <h1 class="page-title"><%= (typeof title !== 'undefined' ? title : 'Assessment Templates').split(' - ')[0] %></h1>
        <p class="page-description">Standardized question frameworks for DPDP Act 2023, informal data silos, and vendor laboratory risk audits.</p>
    </div>
    <button class="btn-primary" onclick="document.getElementById('new-template-modal').style.display='flex'" style="padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Template
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" id="template-search" placeholder="Search templates..." onkeyup="filterTemplates()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalTemplates %> templates</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="templates-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 14px 24px; font-weight: 600;">Template Name &#9652;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Framework &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Questions</th>
                <th style="padding: 14px 16px; font-weight: 600;">Status &#8597;</th>
                <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (tmplList.length === 0) { %>
                <tr>
                    <td colspan="5" style="padding: 32px; text-align: center; color: var(--text-muted);">No assessment templates found. Click "New Template" to configure a question framework.</td>
                </tr>
            <% } else { %>
                <% tmplList.forEach(t => { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="tmpl-row">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">
                            <div style="display: flex; align-items: center; gap: 8px;">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="#3b82f6" stroke-width="2" fill="none"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>
                                <span><%= t.templateName %></span>
                            </div>
                        </td>
                        <td style="padding: 16px 16px;">
                            <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">
                                <%= t.framework || 'CUSTOM' %>
                            </span>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted); font-weight: 600;">
                            <%= t.questionCount || 20 %> items
                        </td>
                        <td style="padding: 16px 16px;">
                            <% if (t.isActive !== 0) { %>
                                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                            <% } else { %>
                                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Inactive</span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteTemplate('<%= t.id %>')" title="Delete Template" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<!-- New Template Modal Overlay -->
<div id="new-template-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card p-0" style="width: 520px; background: #0f172a; border: 1px solid #334155; box-shadow: 0 20px 30px rgba(0,0,0,0.6); border-radius: 12px; overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; background: #1e293b;">
            <h2 style="font-size: 16px; font-weight: 600; color: #f8fafc; margin: 0;">Create Assessment Template</h2>
            <button onclick="document.getElementById('new-template-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <form id="add-tmpl-form" onsubmit="handleCreateTemplate(event)" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Template Title *</label>
                <input type="text" id="tmplTitle" required placeholder="e.g. Healthcare Informal Silos & Unstructured PII Framework" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 24px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Framework Type</label>
                    <select id="tmplFramework" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                        <option value="DPDP_ACT_2023">DPDP Act 2023 SME Standard</option>
                        <option value="HEALTHCARE_PII">Healthcare Informal Systems</option>
                        <option value="ISO_27701">ISO 27701 / Privacy Info</option>
                        <option value="VENDOR_RISK">Vendor Laboratory Audit</option>
                    </select>
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Number of Questions</label>
                    <input type="number" id="tmplQuestions" value="20" min="1" max="100" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Save Template</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('new-template-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: #334155; border: 1px solid #475569; color: #f8fafc;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterTemplates() {
    const q = document.getElementById('template-search').value.toLowerCase();
    document.querySelectorAll('.tmpl-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function handleCreateTemplate(e) {
    e.preventDefault();
    const templateName = document.getElementById('tmplTitle').value.trim();
    const framework = document.getElementById('tmplFramework').value;
    const questionCount = parseInt(document.getElementById('tmplQuestions').value) || 20;

    try {
        const res = await fetch('/api/assessment/templates', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ templateName, framework, questionCount, isActive: 1 })
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error creating template: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error submitting template');
    }
}

async function deleteTemplate(id) {
    if (!confirm('Are you sure you want to delete this assessment template?')) return;
    try {
        const res = await fetch(`/api/assessment/templates/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting template: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting template');
    }
}
</script>

<%- include('partials/footer') %>
