<%- include('partials/header') %>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Preference Centers</h1>
        <p>Configure which purposes are shown in the privacy portal preference centre.</p>
    </div>
    <button class="btn-primary" style="background-color: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New preference center
    </button>
</div>

<div class="alert mb-4" style="background: rgba(59, 130, 246, 0.1); border: 1px solid rgba(59, 130, 246, 0.2); padding: 12px 16px; border-radius: 6px; display: flex; gap: 12px; align-items: flex-start;">
    <svg viewBox="0 0 24 24" width="16" height="16" stroke="#3b82f6" stroke-width="2" fill="none" style="margin-top: 2px;"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
    <div style="font-size: 13px; color: var(--text-muted); line-height: 1.5;">
        Each preference center is linked to one collection point. For it to appear in the Privacy Portal, the linked collection point must also have <strong style="color: #3b82f6; font-weight: 600;">Show in Privacy Portal</strong> enabled (Collection Point &rarr; Build &rarr; Settings) and the preference center status must be <strong style="color: var(--text-main); font-weight: 600;">PUBLISHED</strong>.
    </div>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search preference centers..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 12px 24px; font-weight: 600;">Name &#9652;</th>
                <th style="padding: 12px 16px; font-weight: 600;">COLLECTION POINT</th>
                <th style="padding: 12px 16px; font-weight: 600;">Layout &#8597;</th>
                <th style="padding: 12px 16px; font-weight: 600;">Status &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Updated &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;"></th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <!-- Row 1 -->
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 16px 24px; width: 300px;">
                    <a href="#" style="font-weight: 600; color: #3b82f6; text-decoration: none;">DPDP_Secure Mobile App Preference Centre</a>
                </td>
                <td style="padding: 16px 16px; color: var(--text-main);">
                    DPDP_Secure Mobile App
                </td>
                <td style="padding: 16px 16px;">
                    <span style="border: 1px solid var(--text-muted); color: var(--text-muted); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600; text-transform: uppercase;">CENTER</span>
                </td>
                <td style="padding: 16px 16px;">
                    <span class="badge" style="background: #fef3c7; color: #b45309; padding: 4px 12px; border-radius: 12px; font-size: 10px; font-weight: 700; text-transform: uppercase;">Draft</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted); font-size: 12px;">
                    08 Sept 2026, 10:17 am
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; gap: 12px; justify-content: flex-end;">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                </td>
            </tr>
            
            <!-- Row 2 -->
            <tr style="border-bottom: 1px solid var(--border-color); background: rgba(255,255,255,0.02);">
                <td style="padding: 16px 24px; width: 300px;">
                    <a href="#" style="font-weight: 600; color: #3b82f6; text-decoration: none;">DPDP_Secure Privacy Preference Centre</a>
                </td>
                <td style="padding: 16px 16px; color: var(--text-main);">
                    DPDP_Secure Web Banking Portal
                </td>
                <td style="padding: 16px 16px;">
                    <span style="border: 1px solid var(--text-muted); color: var(--text-muted); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600; text-transform: uppercase;">CENTER</span>
                </td>
                <td style="padding: 16px 16px;">
                    <span class="badge" style="background: rgba(255,255,255,0.1); color: #10b981; padding: 4px 12px; border-radius: 12px; font-size: 10px; font-weight: 700; text-transform: uppercase; border: 1px solid rgba(16,185,129,0.3);">Published</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted); font-size: 12px;">
                    08 Sept 2026, 07:15 am
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; gap: 12px; justify-content: flex-end;">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                </td>
            </tr>

            <!-- Row 3 -->
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 16px 24px; width: 300px;">
                    <a href="#" style="font-weight: 600; color: #3b82f6; text-decoration: none;">DPDP_Secure WhatsApp Preference Centre</a>
                </td>
                <td style="padding: 16px 16px; color: var(--text-main); display: flex; align-items: center; gap: 8px;">
                    DPDP_Secure WhatsApp Bot
                    <span style="background: #fef3c7; color: #b45309; font-size: 9px; padding: 2px 6px; border-radius: 4px; font-weight: 600; text-transform: uppercase;">Portal off</span>
                </td>
                <td style="padding: 16px 16px;">
                    <span style="border: 1px solid var(--text-muted); color: var(--text-muted); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600; text-transform: uppercase;">CENTER</span>
                </td>
                <td style="padding: 16px 16px;">
                    <span class="badge" style="background: #fef3c7; color: #b45309; padding: 4px 12px; border-radius: 12px; font-size: 10px; font-weight: 700; text-transform: uppercase;">Draft</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted); font-size: 12px;">
                    29 Aug 2026, 03:03 pm
                </td>
                <td style="padding: 16px 24px; text-align: right;">
                    <div style="display: flex; gap: 12px; justify-content: flex-end;">
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path><circle cx="12" cy="12" r="3"></circle></svg>
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                        <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                    </div>
                </td>
            </tr>
        </tbody>
    </table>
</div>

<%- include('partials/footer') %>
