                <td class="py-3 px-4 font-mono text-slate-400">#NOTIF-1002</td>
                <td class="py-3 px-4 font-bold text-white">DSR Erasure Certificate Delivered (Ref: DSR-2026-8819)</td>
                <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-950 text-sky-400 border border-sky-500/30">SMS + EMAIL</span></td>
                <td class="py-3 px-4 font-mono text-slate-400">+91 9988776655</td>
                <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">✓ DELIVERED</span></td>
                <td class="py-3 px-4 text-right text-slate-400 font-mono">Earlier Today</td>
              </tr>
              <tr class="hover:bg-slate-800/20 transition-colors">
                <td class="py-3 px-4 font-mono text-slate-400">#NOTIF-1001</td>
                <td class="py-3 px-4 font-bold text-white">Section 5 Itemised WhatsApp Consent Notice</td>
                <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">WHATSAPP</span></td>
                <td class="py-3 px-4 font-mono text-slate-400">+91 9845012345</td>
                <td class="py-3 px-4"><span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">✓ DELIVERED</span></td>
                <td class="py-3 px-4 text-right text-slate-400 font-mono">Yesterday</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    <!-- TAB 5: BRANDING -->
