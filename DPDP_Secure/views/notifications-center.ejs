<%- include('partials/header') %>

<style>
.tab-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 13px;
    font-weight: 600;
    padding: 8px 16px;
    border-radius: 6px;
}
.tab-link.active {
    background: rgba(255,255,255,0.05);
    color: white;
}
.tab-link:hover:not(.active) {
    color: white;
}

.modal-overlay {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.7);
    backdrop-filter: blur(4px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 100;
}
.modal-overlay.active {
    display: flex;
}
.modal-content {
    background: var(--bg-surface);
    border: 1px solid var(--border-color);
    border-radius: 12px;
    width: 100%;
    max-width: 600px;
}
.key-form-label {
    font-size: 13px;
    font-weight: 600;
    color: var(--text-main);
    margin-bottom: 8px;
    display: block;
}
.key-input {
    width: 100%;
    background: rgba(0,0,0,0.2);
    border: 1px solid var(--border-color);
    color: var(--text-main);
    padding: 10px 12px;
    border-radius: 6px;
    font-size: 13px;
    margin-bottom: 24px;
}
.pill-status {
    display: inline-block; padding: 2px 8px; border-radius: 12px; font-size: 11px; font-weight: 600; background: rgba(255,255,255,0.05); color: var(--text-muted);
}
.pill-channel {
    display: inline-block; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600; background: rgba(255,255,255,0.05); color: var(--text-muted);
}
</style>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    
    <!-- Top Metrics -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 32px;">
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">PROVIDERS</div>
            <div style="font-size: 28px; font-weight: 700; color: white;">2</div>
        </div>
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">TEMPLATES</div>
            <div style="font-size: 28px; font-weight: 700; color: white;">24</div>
        </div>
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">MESSAGES SENT</div>
            <div style="font-size: 28px; font-weight: 700; color: white;">3</div>
        </div>
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">DEFAULT BRANDING</div>
            <div style="font-size: 28px; font-weight: 700; color: white;">Not set</div>
        </div>
    </div>

    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px;">
        <div>
            <h1 style="font-size: 20px; font-weight: 700; color: var(--text-main); margin: 0 0 8px 0;">Notification Center</h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Configure providers, message templates, and test sends for email, SMS, WhatsApp, and in-app channels.</p>
        </div>
        <% if (activeTab === 'providers') { %>
        <button class="btn-primary" style="background: #be185d; border: 1px solid #9d174d; color: white; padding: 8px 16px; border-radius: 6px; font-size: 13px; font-weight: 600; display: flex; align-items: center; gap: 6px;">
            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Provider
        </button>
        <% } %>
    </div>

    <div class="card p-0">
        <!-- Tabs -->
        <div style="padding: 16px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: center;">
            <div style="display: inline-flex; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 8px; padding: 4px;">
                <a href="?tab=providers" class="tab-link <%= activeTab === 'providers' ? 'active' : '' %>">Providers</a>
                <a href="?tab=templates" class="tab-link <%= activeTab === 'templates' ? 'active' : '' %>">Templates</a>
                <a href="?tab=history" class="tab-link <%= activeTab === 'history' ? 'active' : '' %>">Message History</a>
                <a href="?tab=branding" class="tab-link <%= activeTab === 'branding' ? 'active' : '' %>">Branding</a>
            </div>
        </div>
        
        <% if (activeTab === 'providers') { %>
            <div style="padding: 20px 24px; border-bottom: 1px solid var(--border-color);">
                <label style="display: flex; align-items: flex-start; gap: 12px; cursor: pointer;">
                    <input type="checkbox" style="margin-top: 2px;">
                    <div>
                        <div style="font-size: 13px; font-weight: 600; color: white; margin-bottom: 2px;">Send plain-text-only emails</div>
                        <div style="font-size: 12px; color: var(--text-muted);">By default, every email includes both an HTML and plain-text version &mdash; the recipient's mail client picks the one it supports. Enable this to suppress the HTML version entirely for this tenant.</div>
                    </div>
                </label>
            </div>
            
            <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                <input type="text" placeholder="Search providers..." style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; font-size: 13px; width: 300px;">
                <div style="display: flex; gap: 16px; align-items: center; color: var(--text-muted); font-size: 13px;">
                    <span>2 rows</span>
                    <span>Previous</span>
                    <span style="font-weight: 600; color: var(--text-main);">Page 1 of 1</span>
                    <span>Next</span>
                </div>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="padding-left: 24px; width: 80px;">ID <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle;"><path d="M18 15l-6-6-6 6"/></svg></th>
                            <th>Provider <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                            <th>Channel <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                            <th>Status <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                            <th style="padding-right: 24px; text-align: right;"><svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding-left: 24px; color: var(--text-muted);">#1</td>
                            <td style="font-weight: 600; color: white;">
                                DPDP_Secure SMTP Relay 
                                <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" style="margin-left: 8px; color: var(--text-muted); cursor: pointer;" onclick="openModal()"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </td>
                            <td><span class="pill-channel">EMAIL</span></td>
                            <td><span class="pill-status">ENABLED</span></td>
                            <td style="padding-right: 24px; text-align: right; color: var(--text-muted);">
                                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding-left: 24px; color: var(--text-muted);">#2</td>
                            <td style="font-weight: 600; color: white;">
                                DPDP_Secure MSG91 
                                <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none" style="margin-left: 8px; color: var(--text-muted);"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                            </td>
                            <td><span class="pill-channel">SMS</span></td>
                            <td><span class="pill-status">ENABLED</span></td>
                            <td style="padding-right: 24px; text-align: right; color: var(--text-muted);">
                                <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div style="padding: 16px 24px; display: flex; justify-content: flex-end; align-items: center; gap: 16px; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: 13px;">
                <span>Previous</span>
                <span style="font-weight: 600; color: var(--text-main);">Page 1 of 1</span>
                <span>Next</span>
            </div>
            
            <!-- Modal Overlay -->
            <div class="modal-overlay" id="editProviderModal">
                <div class="modal-content">
                    <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                        <h2 style="font-size: 16px; font-weight: 700; color: white; margin: 0;">Edit Provider</h2>
                        <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" style="color: var(--text-muted); cursor: pointer;" onclick="closeModal()"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </div>
                    
                    <div style="padding: 24px;">
                        <label class="key-form-label">Channel</label>
                        <select class="key-input" style="appearance: none;">
                            <option>EMAIL</option>
                        </select>
                        
                        <label class="key-form-label">Provider Name</label>
                        <input type="text" class="key-input" value="DPDP_Secure SMTP Relay">
                        
                        <label class="key-form-label">Config JSON</label>
                        <textarea class="key-input" style="height: 120px; font-family: monospace; resize: vertical;">{
  "from": "privacy@dpdpsecure.in",
  "sender_name": "DPDP_Secure Privacy Team"
}</textarea>
                    </div>
                    
                    <div style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; gap: 12px;">
                        <button class="btn-primary" style="background: #be185d; border: 1px solid #9d174d; color: white; padding: 10px 20px; border-radius: 6px; font-size: 14px; font-weight: 600; width: 50%;">Save Provider</button>
                        <button onclick="closeModal()" class="action-btn" style="padding: 10px 20px; font-size: 14px; background: rgba(255,255,255,0.05); border-color: rgba(255,255,255,0.1); border-radius: 6px; width: 50%;">Cancel</button>
                    </div>
                </div>
            </div>
            <script>
            function openModal() { document.getElementById('editProviderModal').classList.add('active'); }
            function closeModal() { document.getElementById('editProviderModal').classList.remove('active'); }
            </script>
        <% } else if (activeTab === 'templates') { %>
            <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                <input type="text" placeholder="Search templates..." style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; font-size: 13px; width: 300px;">
                <div style="display: flex; gap: 16px; align-items: center; color: var(--text-muted); font-size: 13px;">
                    <span>24 rows</span>
                    <span>Previous</span>
                    <span style="font-weight: 600; color: var(--text-main);">Page 1 of 3</span>
                    <span>Next</span>
                </div>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="padding-left: 24px; width: 80px;">ID <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle;"><path d="M18 15l-6-6-6 6"/></svg></th>
                            <th>Name <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                            <th>Key <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                            <th>Channel <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                            <th>Status <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
                            <th></th>
                            <th style="padding-right: 24px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% const templates = [
                            {id: '#1', name: 'DSR Request Received', key: 'dsr_received'},
                            {id: '#2', name: 'DSR Request In Progress', key: 'dsr_in_progress'},
                            {id: '#3', name: 'DSR Request Completed', key: 'dsr_completed'},
                            {id: '#4', name: 'DSR Overdue Reminder', key: 'dsr_overdue_reminder'},
                            {id: '#5', name: 'Consent Confirmation', key: 'consent_granted'},
                            {id: '#6', name: 'Consent Withdrawal Confirmation', key: 'consent_withdrawn'},
                            {id: '#7', name: 'DPIA Review Required', key: 'dpia_review_required'},
                            {id: '#8', name: 'SLA Breach Alert', key: 'dprr_sla_breach'}
                        ] %>
                        <% templates.forEach(t => { %>
                        <tr>
                            <td style="padding-left: 24px; color: var(--text-muted);"><%= t.id %></td>
                            <td style="font-weight: 600; color: white;"><%= t.name %></td>
                            <td style="color: var(--text-muted); font-family: monospace; font-size: 12px;"><%= t.key %></td>
                            <td><span class="pill-channel">EMAIL</span></td>
                            <td><span class="pill-status">ACTIVE</span></td>
                            <td style="text-align: right;">
                                <button style="background: transparent; border: 1px solid rgba(255,255,255,0.1); color: white; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
                                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                    Customise
                                </button>
                            </td>
                            <td style="padding-right: 24px; text-align: right;">
                                <div style="display: inline-flex; align-items: center; gap: 6px; color: var(--text-muted); font-size: 11px; font-weight: 500; background: rgba(255,255,255,0.05); padding: 4px 12px; border-radius: 4px;">
                                    <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>
                                    System
                                </div>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
            
            <div style="padding: 16px 24px; display: flex; justify-content: flex-end; align-items: center; gap: 16px; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: 13px;">
                <span>Previous</span>
                <span style="font-weight: 600; color: var(--text-main);">Page 1 of 3</span>
                <span>Next</span>
            </div>

        <% } else if (activeTab === 'history') { %>
            <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
                <input type="text" placeholder="Search messages..." style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; font-size: 13px; width: 300px;">
                <div style="display: flex; gap: 16px; align-items: center; color: var(--text-muted); font-size: 13px;">
                    <span>Previous</span>
                    <span>Next</span>
                </div>
            </div>
            
            <div style="overflow-x: auto;">
                <table class="table">
                    <thead>
                        <tr>
                            <th style="padding-left: 24px;">ID</th>
                            <th>SUBJECT</th>
                            <th>CHANNEL</th>
                            <th>RECIPIENT</th>
                            <th>STATUS</th>
                            <th>CREATED</th>
                            <th style="padding-right: 24px;">SENT</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td style="padding-left: 24px; color: var(--text-muted);">#14</td>
                            <td style="font-weight: 600; color: white;">(no subject)</td>
                            <td><span class="pill-channel">IN_APP</span></td>
                            <td style="color: var(--text-muted);">01a04e0b-c1b4-7e04-bf01-2add5c840877</td>
                            <td><span class="pill-status">SENT</span></td>
                            <td style="color: var(--text-muted); font-size: 12px;">09 Sept 2026, 11:52 am</td>
                            <td style="padding-right: 24px; color: var(--text-muted); font-size: 12px;">09 Sept 2026, 11:52 am</td>
                        </tr>
                        <tr>
                            <td style="padding-left: 24px; color: var(--text-muted);">#2</td>
                            <td style="font-weight: 600; color: white;">Action required: BNPL Credit Scoring AI DPIA review due in 5 days</td>
                            <td><span class="pill-channel">EMAIL</span></td>
                            <td style="color: var(--text-muted);">dpo@dpdpsecure.in</td>
                            <td><span class="pill-status">SIMULATED</span></td>
                            <td style="color: var(--text-muted); font-size: 12px;">29 Aug 2026, 03:03 pm</td>
                            <td style="padding-right: 24px; color: var(--text-muted); font-size: 12px;">22 Aug 2026, 03:03 pm</td>
                        </tr>
                        <tr>
                            <td style="padding-left: 24px; color: var(--text-muted);">#1</td>
                            <td style="font-weight: 600; color: white;">Your data rights request has been received &mdash; Ref: PR-1001</td>
                            <td><span class="pill-channel">EMAIL</span></td>
                            <td style="color: var(--text-muted);">rajesh.kumar@gmail.com</td>
                            <td><span class="pill-status">SIMULATED</span></td>
                            <td style="color: var(--text-muted); font-size: 12px;">29 Aug 2026, 03:03 pm</td>
                            <td style="padding-right: 24px; color: var(--text-muted); font-size: 12px;">15 Aug 2026, 03:03 pm</td>
                        </tr>
                    </tbody>
                </table>
            </div>
            
            <div style="padding: 16px 24px; display: flex; justify-content: flex-end; align-items: center; gap: 16px; border-top: 1px solid var(--border-color); color: var(--text-muted); font-size: 13px;">
                <span>Previous</span>
                <span>Next</span>
            </div>

        <% } else if (activeTab === 'branding') { %>
            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 32px; padding: 24px;">
                <!-- Left: Branding Form -->
                <div>
                    <h2 style="font-size: 14px; font-weight: 600; color: white; margin: 0 0 4px 0;">Default Notification Branding</h2>
                    <p style="color: var(--text-muted); font-size: 12px; margin: 0 0 24px 0;">Applied to all notification emails. Template-specific branding overrides this.</p>
                    
                    <label class="key-form-label">Logo URL</label>
                    <input type="text" class="key-input" placeholder="https://example.com/logo.png" style="margin-bottom: 16px;">
                    
                    <label class="key-form-label">Or Upload Logo</label>
                    <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 24px;">
                        <button style="background: rgba(255,255,255,0.1); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; font-size: 13px;">Choose File</button>
                        <span style="font-size: 13px; color: var(--text-muted);">No file chosen</span>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                        <div>
                            <label class="key-form-label">Primary Colour</label>
                            <div style="display: flex; gap: 12px; align-items: center; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); padding: 6px 12px; border-radius: 6px;">
                                <div style="width: 20px; height: 20px; background: #6366f1; border-radius: 4px;"></div>
                                <input type="text" value="#4F46E5" style="background: transparent; border: none; color: white; font-size: 13px; width: 100%; outline: none; text-transform: uppercase;">
                            </div>
                        </div>
                        <div>
                            <label class="key-form-label">Secondary Colour</label>
