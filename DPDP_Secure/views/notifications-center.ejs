            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1">DPO Grievance Email</label>
              <input type="text" value="privacy@aarogyaclinic.in" class="w-full bg-slate-900 border border-slate-700 rounded-lg p-2.5 text-xs text-white" readonly>
