<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-indigo-500/10 text-indigo-400 border border-indigo-500/20">
          DPDP Act Section 8(6) & Section 5
        </span>
        <span class="text-xs text-slate-400">Pillar 4: Dual-Channel Citizen Notification Suite</span>
      </div>
      <h1 class="text-2xl font-bold text-white tracking-tight mt-1">Notification Center</h1>
      <p class="text-sm text-slate-400 mt-1">
        Configure delivery providers, inspect regional citizen breach advisories (English, Kannada, Hindi), and monitor statutory dispatch queues.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/incidents/management" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors">
        <span>🚨</span>
        <span>Incident Operations &rarr;</span>
      </a>
      <a href="/incidents/dossier/INC-2026-9921" target="_blank" class="inline-flex items-center gap-2 px-3.5 py-2 rounded-lg bg-sky-600 hover:bg-sky-500 text-white text-xs font-bold transition-all shadow-lg shadow-sky-900/30">
        <span>📄</span>
        <span>Print Form DPBI-IR1</span>
      </a>
    </div>
  </div>

  <% const currentTab = (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'breach_alerts'; %>
  <% const dispatchList = (typeof dispatches !== 'undefined' && dispatches) ? dispatches : []; %>
  <% const totalDispatched = 3 + dispatchList.reduce((acc, d) => acc + (d.deliveredCount || 0), 0); %>

  <!-- Top Metrics 4-Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>ACTIVE PROVIDERS</span>
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      </div>
      <div class="text-3xl font-extrabold text-white">2</div>
      <div class="text-xs text-slate-400 mt-1">Twilio SMS Gateway &bull; WhatsApp Cloud API</div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>NOTICE TEMPLATES</span>
        <span class="w-2 h-2 rounded-full bg-indigo-400"></span>
      </div>
      <div class="text-3xl font-extrabold text-indigo-400">27</div>
      <div class="text-xs text-indigo-400/80 mt-1">Includes EN, KN, HI Regional Breach Notices</div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>MESSAGES DELIVERED</span>
        <span class="w-2 h-2 rounded-full bg-sky-400"></span>
      </div>
      <div class="text-3xl font-extrabold text-sky-400"><%= totalDispatched %></div>
      <div class="text-xs text-sky-400/80 mt-1">Simulated SMS & WhatsApp deliveries</div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>VULNERABILITY CONCEALMENT</span>
        <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      </div>
      <div class="text-2xl font-bold text-emerald-400">100% Enforced</div>
      <div class="text-xs text-emerald-400/80 mt-1">Zero technical CVE leak policy</div>
    </div>
  </div>

  <!-- Tabbed Navigation Bar -->
  <div class="bg-slate-900/80 border border-slate-800 rounded-2xl shadow-xl overflow-hidden backdrop-blur">
    <div class="p-3 border-b border-slate-800 flex items-center justify-between bg-slate-950/40 flex-wrap gap-2">
      <div class="inline-flex rounded-xl bg-slate-900 p-1 border border-slate-800 text-xs">
        <a href="?tab=providers" class="px-4 py-2 rounded-lg font-semibold transition-colors <%= currentTab === 'providers' ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-white' %>">
          Delivery Providers
        </a>
        <a href="?tab=breach_alerts" class="px-4 py-2 rounded-lg font-semibold transition-colors flex items-center gap-1.5 <%= currentTab === 'breach_alerts' ? 'bg-rose-600 text-white shadow' : 'text-slate-400 hover:text-white' %>">
          <span>📢</span>
          <span>Breach Advisories & Queue</span>
          <span class="px-1.5 py-0.2 rounded text-[10px] bg-rose-950 text-rose-300 font-bold border border-rose-500/30">New</span>
        </a>
        <a href="?tab=templates" class="px-4 py-2 rounded-lg font-semibold transition-colors <%= currentTab === 'templates' ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-white' %>">
          Message Templates
        </a>
        <a href="?tab=history" class="px-4 py-2 rounded-lg font-semibold transition-colors <%= currentTab === 'history' ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-white' %>">
          Dispatch History
        </a>
        <a href="?tab=branding" class="px-4 py-2 rounded-lg font-semibold transition-colors <%= currentTab === 'branding' ? 'bg-indigo-600 text-white shadow' : 'text-slate-400 hover:text-white' %>">
          Branding & Headers
        </a>
      </div>
      <div class="text-xs text-slate-400 font-mono">
        Tenant: <span class="text-white font-bold">Aarogya Diagnostic Center</span>
      </div>
    </div>

    <!-- TAB 1: BREACH ALERTS & REGIONAL QUEUE -->
    <% if (currentTab === 'breach_alerts') { %>
      <div class="p-6 space-y-6">
        <!-- Explanatory Banner -->
        <div class="p-4 rounded-xl bg-gradient-to-r from-rose-950/40 via-slate-900 to-amber-950/30 border border-rose-500/30 flex items-start gap-4">
          <div class="w-10 h-10 rounded-lg bg-rose-500/20 border border-rose-500/30 text-rose-400 text-xl flex items-center justify-center flex-shrink-0">
            🛡️
          </div>
          <div>
            <div class="flex items-center gap-2">
              <h2 class="text-sm font-bold text-white">DPDP Act Section 8(6) Citizen Reassurance Engine</h2>
              <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-300 border border-emerald-500/30">
                VULNERABILITY CONCEALMENT ENFORCED
              </span>
            </div>
            <p class="text-xs text-slate-300 mt-1 leading-relaxed">
              When personal data is exposed in informal systems (e.g. lost phone, misdirected chat), the Data Fiduciary must notify impacted Data Principals in clear, reassuring language without technical jargon or revealing exploitable vulnerabilities.
            </p>
          </div>
        </div>

        <!-- Multi-Lingual Regional Templates Showcase -->
        <div>
          <div class="flex items-center justify-between mb-3">
            <h3 class="text-sm font-bold text-white uppercase tracking-wider">Multi-Lingual Citizen Reassurance Templates</h3>
            <span class="text-xs text-slate-400">English, Kannada (ಕನ್ನಡ), Hindi (हिन्दी)</span>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <!-- English Card -->
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-950 text-sky-400 border border-sky-500/30">ENGLISH (EN)</span>
                  <span class="text-[10px] font-mono text-slate-400">SMS: ~382 chars</span>
                </div>
                <div class="text-xs font-bold text-white mb-2">Patient Phone Misplacement Reassurance</div>
                <div class="p-3 rounded-lg bg-slate-900 text-slate-300 text-xs font-sans leading-relaxed border border-slate-800">
                  "Dear Aarogya Clinic Patient, on [Date], a clinic front-desk mobile phone was reported lost. Your contact and appointment record were stored on the device. We immediately triggered a remote wipe and locked the phone. No unauthorized access has been confirmed. As a precaution, please ignore any suspicious payment messages claiming to be from our clinic. For queries, contact our DPO at privacy@aarogyaclinic.in."
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
                <span>Channels: <strong>SMS &bull; WhatsApp</strong></span>
                <span class="text-emerald-400 font-semibold">✓ Verified</span>
              </div>
            </div>

            <!-- Kannada Card -->
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-950 text-amber-400 border border-amber-500/30">KANNADA (ಕನ್ನಡ - KN)</span>
                  <span class="text-[10px] font-mono text-slate-400">SMS: ~288 chars</span>
                </div>
                <div class="text-xs font-bold text-white mb-2">ರೋಗಿಗಳಿಗೆ ಪ್ರಮುಖ ಸುರಕ್ಷತಾ ಸೂಚನೆ</div>
                <div class="p-3 rounded-lg bg-slate-900 text-slate-300 text-xs font-sans leading-relaxed border border-slate-800">
                  "ಆರೋಗ್ಯ ಕ್ಲಿನಿಕ್ ರೋಗಿಗಳಿಗೆ ಪ್ರಮುಖ ಸೂಚನೆ: ನಮ್ಮ ಕ್ಲಿನಿಕ್ನ ರಿಸೆಪ್ಷನ್ ಮೊಬೈಲ್ ಕಳೆದುಹೋಗಿದ್ದು, ಸುರಕ್ಷತಾ ಕ್ರಮವಾಗಿ ಅದನ್ನು ತಕ್ಷಣ ದೂರದಿಂದಲೇ ಲಾಕ್ ಮತ್ತು ವೈಪ್ ಮಾಡಲಾಗಿದೆ. ಯಾವುದೇ ಅನಧಿಕೃತ ಸಂದೇಶಗಳು ಅಥವಾ ಹಣ ಪಾವತಿ ಬೇಡಿಕೆಗಳು ಬಂದರೆ ದಯವಿಟ್ಟು ಗಮನಿಸಬೇಡಿ. ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗೆ ನಮ್ಮ ಅಧಿಕಾರಿಯನ್ನು ಸಂಪರ್ಕಿಸಿ: privacy@aarogyaclinic.in"
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
                <span>Channels: <strong>SMS &bull; WhatsApp</strong></span>
                <span class="text-emerald-400 font-semibold">✓ Verified</span>
              </div>
            </div>

            <!-- Hindi Card -->
            <div class="p-4 rounded-xl bg-slate-950/60 border border-slate-800 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">HINDI (हिन्दी - HI)</span>
                  <span class="text-[10px] font-mono text-slate-400">SMS: ~264 chars</span>
                </div>
                <div class="text-xs font-bold text-white mb-2">मरीजों के लिए आवश्यक सुरक्षा सूचना</div>
                <div class="p-3 rounded-lg bg-slate-900 text-slate-300 text-xs font-sans leading-relaxed border border-slate-800">
                  "आरोग्य क्लिनिक के सम्मानित मरीज, आपको सूचित किया जाता है कि क्लिनिक का एक फोन खो गया था जिसे सुरक्षा के तहत तुरंत ब्लॉक और रिमोट वाइप कर दिया गया है। किसी अनधिकೃತ पहुंच की पुष्टि नहीं हुई है। एहतियात के तौर पर, कृपया किसी भी संदिग्ध भुगतान संदेश पर ध्यान न दें। संपर्क: privacy@aarogyaclinic.in"
                </div>
              </div>
              <div class="mt-3 pt-3 border-t border-slate-800/80 flex items-center justify-between text-[11px] text-slate-400">
                <span>Channels: <strong>SMS &bull; WhatsApp</strong></span>
                <span class="text-emerald-400 font-semibold">✓ Verified</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Recent Breach Dispatch Queue Table -->
        <div class="pt-4 border-t border-slate-800">
          <div class="flex items-center justify-between mb-3">
            <div>
              <h3 class="text-sm font-bold text-white uppercase tracking-wider">Live Breach Alert Dispatch Queue</h3>
              <p class="text-xs text-slate-400 mt-0.5">Cryptographically logged multi-channel alerts with delivery receipts</p>
            </div>
            <a href="/incidents/management" class="text-xs text-rose-400 hover:text-rose-300 font-semibold flex items-center gap-1">
              <span>Trigger Dispatch from Operations</span> &rarr;
            </a>
          </div>

          <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/40">
            <table class="w-full text-left text-xs">
              <thead class="text-slate-400 uppercase tracking-wider border-b border-slate-800 bg-slate-950/60 font-semibold">
                <tr>
                  <th class="py-3 px-4">Dispatch ID</th>
                  <th class="py-3 px-4">Incident Association</th>
                  <th class="py-3 px-4">Channels</th>
                  <th class="py-3 px-4">Languages</th>
                  <th class="py-3 px-4">Recipients</th>
                  <th class="py-3 px-4">Status</th>
                  <th class="py-3 px-4">Timestamp</th>
                  <th class="py-3 px-4 text-right">SHA-256 Proof</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-800/60 text-slate-300">
                <% if (dispatchList && dispatchList.length > 0) { %>
                  <% dispatchList.forEach(function(d) { %>
                    <tr class="hover:bg-slate-800/30 transition-colors">
                      <td class="py-3 px-4 font-mono font-bold text-rose-400"><%= d.id %></td>
                      <td class="py-3 px-4 font-sans max-w-xs">
                        <div class="font-bold text-white truncate"><%= d.incidentTitle %></div>
                        <div class="text-[11px] text-slate-400 font-mono"><%= d.incidentId %></div>
                      </td>
                      <td class="py-3 px-4">
                        <% (d.channels || []).forEach(function(c) { %>
                          <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-slate-800 text-slate-300 border border-slate-700 mr-1"><%= c %></span>
                        <% }); %>
                      </td>
                      <td class="py-3 px-4 font-mono text-[11px] text-sky-400">
                        <%= (d.languages || []).join(', ') %>
                      </td>
                      <td class="py-3 px-4 font-bold text-white font-mono">
                        ~<%= d.deliveredCount || 250 %> patients
                      </td>
                      <td class="py-3 px-4">
                        <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">
                          ✓ <%= d.status || 'DELIVERED' %>
                        </span>
                      </td>
                      <td class="py-3 px-4 text-slate-400 font-mono text-[11px]">
                        <%= new Date(d.dispatchedAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata', dateStyle: 'short', timeStyle: 'short' }) %>
                      </td>
                      <td class="py-3 px-4 text-right font-mono text-[10px] text-slate-400 truncate max-w-[120px]" title="<%= d.sha256Proof %>">
                        <%= (d.sha256Proof || '').slice(0, 12) %>...
                      </td>
                    </tr>
                  <% }); %>
                <% } else { %>
                  <tr>
                    <td colspan="8" class="py-6 text-center text-slate-500">
                      No citizen breach alerts in queue. Clean compliance operational state.
                    </td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </div>

    <!-- TAB 2: DELIVERY PROVIDERS -->
    <% } else if (currentTab === 'providers') { %>
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-sm font-bold text-white uppercase tracking-wider">Configured Messaging Delivery Providers</h2>
            <p class="text-xs text-slate-400 mt-0.5">Multi-channel routing for SMS, WhatsApp Cloud API, and SMTP email</p>
          </div>
          <button class="px-3.5 py-1.5 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-semibold shadow">
            + Add Provider
          </button>
        </div>

        <div class="overflow-x-auto rounded-xl border border-slate-800 bg-slate-950/40">
          <table class="w-full text-left text-xs">
            <thead class="text-slate-400 uppercase tracking-wider border-b border-slate-800 bg-slate-950/60 font-semibold">
              <tr>
                <th class="py-3 px-4">ID</th>
                <th class="py-3 px-4">Provider Name</th>
                <th class="py-3 px-4">Channel</th>
                <th class="py-3 px-4">Endpoint Status</th>
                <th class="py-3 px-4">Latency</th>
                <th class="py-3 px-4 text-right">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-800/60 text-slate-300">
              <tr class="hover:bg-slate-800/20 transition-colors">
                <td class="py-3 px-4 font-mono text-slate-400">#PRV-01</td>
                <td class="py-3 px-4 font-bold text-white">
                  Twilio Telecom SMS Gateway (DLT Certified)
                  <div class="text-[11px] text-slate-400 font-normal">Sender ID: AAROGY &bull; India DLT Entity Registered</div>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-sky-950 text-sky-400 border border-sky-500/30">SMS</span>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">ONLINE &bull; ACTIVE</span>
                </td>
                <td class="py-3 px-4 font-mono text-slate-400">120ms</td>
                <td class="py-3 px-4 text-right">
                  <button class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px]">Configure</button>
                </td>
              </tr>
              <tr class="hover:bg-slate-800/20 transition-colors">
                <td class="py-3 px-4 font-mono text-slate-400">#PRV-02</td>
                <td class="py-3 px-4 font-bold text-white">
                  Meta WhatsApp Business Cloud API
                  <div class="text-[11px] text-slate-400 font-normal">Verified Business Account &bull; Indiranagar Clinic Number</div>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">WHATSAPP</span>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">ONLINE &bull; ACTIVE</span>
                </td>
                <td class="py-3 px-4 font-mono text-slate-400">85ms</td>
                <td class="py-3 px-4 text-right">
                  <button class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px]">Configure</button>
                </td>
              </tr>
              <tr class="hover:bg-slate-800/20 transition-colors">
                <td class="py-3 px-4 font-mono text-slate-400">#PRV-03</td>
                <td class="py-3 px-4 font-bold text-white">
                  DPDP_Secure Local SMTP Relay
                  <div class="text-[11px] text-slate-400 font-normal">privacy@aarogyaclinic.in (TLS Encrypted)</div>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-indigo-950 text-indigo-400 border border-indigo-500/30">EMAIL</span>
                </td>
                <td class="py-3 px-4">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-950 text-emerald-400 border border-emerald-500/30">ONLINE &bull; ACTIVE</span>
                </td>
                <td class="py-3 px-4 font-mono text-slate-400">45ms</td>
                <td class="py-3 px-4 text-right">
                  <button class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-slate-300 text-[11px]">Configure</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

    <!-- TAB 3: MESSAGE TEMPLATES -->
    <% } else if (currentTab === 'templates') { %>
      <div class="p-6">
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-sm font-bold text-white uppercase tracking-wider">Statutory & Operational Notice Templates</h2>
            <p class="text-xs text-slate-400 mt-0.5">Pre-cleared legal templates for Section 5 notices, DSR status, and Section 8(6) breach notifications</p>
          </div>
          <span class="text-xs text-slate-400 font-mono">Total: 27 templates</span>
        </div>

        <div class="space-y-3">
          <!-- Featured Breach Alert Template -->
          <div class="p-4 rounded-xl bg-gradient-to-r from-rose-950/30 via-slate-900 to-slate-950 border border-rose-500/40">
            <div class="flex items-center justify-between mb-2">
              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/20 text-rose-300 border border-rose-500/30">
                  STATUTORY SECTION 8(6)
                </span>
                <span class="text-xs font-bold text-white">Personal Data Breach Citizen Reassurance Notice</span>
              </div>
              <span class="text-[11px] text-slate-400 font-mono">key: breach_citizen_reassurance</span>
            </div>
            <p class="text-xs text-slate-300 leading-relaxed">
              Dispatched upon confirmation of a security incident impacting informal data repositories. Formatted across English, Kannada, and Hindi with actionable precautions (ignore unsolicited payment links, verify clinic communications).
            </p>
            <div class="mt-3 flex items-center justify-between pt-2 border-t border-slate-800 text-xs">
              <span class="text-slate-400">Supported Channels: <strong class="text-white">SMS &bull; WhatsApp</strong></span>
