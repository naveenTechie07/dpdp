                <thead>
                    <tr>
                        <th style="padding-left: 24px; width: 35%;">Tool <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-bottom: 2px;"><path d="M18 15l-6-6-6 6"/></svg></th>
                        <th>Category <svg viewBox="0 0 24 24" width="10" height="10" stroke="currentColor" stroke-width="2" fill="none" style="display: inline-block; vertical-align: middle; margin-left: 4px; opacity: 0.5;"><path d="M7 15l5 5 5-5M7 9l5-5 5 5"/></svg></th>
