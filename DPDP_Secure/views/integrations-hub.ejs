<%- include('partials/header') %>

<% 
const connList = (typeof connectors !== 'undefined' && Array.isArray(connectors)) ? connectors : [];
const totalConn = connList.length;
const activeConn = connList.filter(c => c.isActive === 1 || c.isActive === '1' || c.isActive === true).length;
%>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 28px;">
        <div>
            <h1 style="font-size: 22px; font-weight: 700; color: var(--text-main); margin: 0 0 8px 0;"><%= (typeof title !== 'undefined' ? title : 'Integrations Hub').split(' - ')[0] %></h1>
            <p style="color: var(--text-muted); font-size: 13px; margin: 0;">Connect DPDP_Secure to your business tools &mdash; WhatsApp Cloud API, Tally Prime ERP, and Ayushman Bharat ABDM health gateways.</p>
        </div>
        <button class="btn-primary" onclick="document.getElementById('add-hub-modal').style.display='flex'" style="padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Add Connector
        </button>
    </div>

    <!-- Top Metrics -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 24px;">
        <div class="card metric-card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">TOTAL CONNECTORS</div>
            <div style="font-size: 28px; font-weight: 700; color: white;"><%= totalConn %></div>
        </div>
        <div class="card metric-card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">ACTIVE DATA PIPELINES</div>
            <div style="font-size: 28px; font-weight: 700; color: #10b981;"><%= activeConn %></div>
        </div>
        <div class="card metric-card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 8px;">OFFLINE-FIRST EGRESS</div>
            <div style="font-size: 28px; font-weight: 700; color: #3b82f6;">0 Bytes (Protected)</div>
        </div>
    </div>

    <div class="card p-0" style="overflow: hidden;">
        <!-- Filters -->
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
            <input type="text" id="hub-search" placeholder="Search connectors..." onkeyup="filterHub()" style="background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 8px 12px; border-radius: 6px; font-size: 13px; width: 300px;">
            
            <div style="display: flex; gap: 16px; align-items: center; color: var(--text-muted); font-size: 13px;">
                <span><%= totalConn %> connectors</span>
                <span>Page 1 of 1</span>
            </div>
        </div>
        
        <!-- Table -->
        <div style="overflow-x: auto;">
            <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
                <thead>
                    <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                        <th style="padding: 14px 24px; width: 35%;">Connector Name &#9652;</th>
                        <th style="padding: 14px 16px;">Type &#8597;</th>
                        <th style="padding: 14px 16px;">Pipeline Status &#8597;</th>
                        <th style="padding: 14px 16px;">Configuration Summary</th>
                        <th style="padding: 14px 24px; text-align: right;">Actions</th>
                    </tr>
                </thead>
                <tbody style="font-size: 13px;">
                    <% if (connList.length === 0) { %>
                        <tr>
                            <td colspan="5" style="padding: 32px; text-align: center; color: var(--text-muted);">No integration connectors registered. Click "Add Connector" to configure a tool.</td>
                        </tr>
                    <% } else { %>
                        <% connList.forEach(c => { %>
                            <tr style="border-bottom: 1px solid var(--border-color);" class="hub-row">
                                <td style="padding: 16px 24px;">
                                    <div style="font-weight: 600; color: white; margin-bottom: 2px;"><%= c.connectorName %></div>
                                    <div style="font-size: 11px; color: var(--text-muted);"><%= c.id %></div>
                                </td>
                                <td style="padding: 16px 16px;">
                                    <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; padding: 4px 10px; border-radius: 12px; font-size: 10px; font-weight: 700;">
                                        <%= c.connectorType %>
                                    </span>
                                </td>
                                <td style="padding: 16px 16px;">
                                    <% if (c.isActive !== 0) { %>
                                        <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                                    <% } else { %>
                                        <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #ef4444; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Inactive</span>
                                    <% } %>
                                </td>
                                <td style="padding: 16px 16px; color: var(--text-muted); font-family: monospace; font-size: 11px; max-width: 300px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                    <%= typeof c.config === 'object' ? JSON.stringify(c.config) : c.config %>
                                </td>
                                <td style="padding: 16px 24px; text-align: right;">
                                    <button onclick="deleteConnector('<%= c.id %>')" title="Delete Connector" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                        <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                                    </button>
                                </td>
                            </tr>
                        <% }); %>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Add Connector Modal Overlay -->
<div id="add-hub-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card p-0" style="width: 520px; background: #0f172a; border: 1px solid #334155; box-shadow: 0 20px 30px rgba(0,0,0,0.6); border-radius: 12px; overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; background: #1e293b;">
            <h2 style="font-size: 16px; font-weight: 600; color: #f8fafc; margin: 0;">Add Integration Connector</h2>
            <button onclick="document.getElementById('add-hub-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <form id="add-hub-form" onsubmit="handleCreateConnector(event)" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Connector Name *</label>
                <input type="text" id="hubName" required placeholder="e.g. WhatsApp Cloud API Webhook Dispatcher" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Connector Type</label>
                <select id="hubType" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                    <option value="MESSAGING">MESSAGING (WhatsApp / SMS)</option>
                    <option value="HEALTHCARE_GATEWAY">HEALTHCARE_GATEWAY (ABDM / ABDM-M1)</option>
                    <option value="ACCOUNTING_ERP">ACCOUNTING_ERP (Tally Prime XML)</option>
                    <option value="WEBHOOK">WEBHOOK (Audit Stream)</option>
                </select>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Config JSON</label>
                <textarea id="hubConfig" placeholder='{"endpoint": "https://aarogyaclinic.in/webhook", "rateLimit": "100/min"}' style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 12px; font-family: monospace; min-height: 80px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Save Connector</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('add-hub-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: #334155; border: 1px solid #475569; color: #f8fafc;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterHub() {
    const q = document.getElementById('hub-search').value.toLowerCase();
    document.querySelectorAll('.hub-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function handleCreateConnector(e) {
    e.preventDefault();
    const connectorName = document.getElementById('hubName').value.trim();
    const connectorType = document.getElementById('hubType').value;
    const configRaw = document.getElementById('hubConfig').value.trim() || '{}';

    try {
        const res = await fetch('/api/integrations/hub', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ connectorName, connectorType, config: configRaw, isActive: 1 })
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error adding connector: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error submitting connector');
    }
}

async function deleteConnector(id) {
    if (!confirm('Are you sure you want to delete this connector?')) return;
    try {
        const res = await fetch(`/api/integrations/hub/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting connector: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting connector');
    }
}
</script>

<%- include('partials/footer') %>
