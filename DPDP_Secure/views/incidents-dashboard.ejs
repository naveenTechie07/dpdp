<%- include('partials/header') %>

<div style="padding: 24px; max-width: 1400px; margin: 0 auto;">
    <div style="margin-bottom: 32px;">
        <h1 style="font-size: 24px; font-weight: 700; color: var(--text-main); margin: 0 0 8px 0;">Incidents & Breaches</h1>
        <p style="color: var(--text-muted); font-size: 14px; margin: 0;">Breach notification compliance under DPDPA Section 8(6). Track incidents, assess notifiability, and manage DPBI submissions.</p>
    </div>

    <!-- Top Metrics -->
    <div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-bottom: 24px;">
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">TOTAL OPEN</div>
            <div style="font-size: 28px; font-weight: 700; color: white;">1</div>
        </div>
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">CRITICAL / HIGH OPEN</div>
            <div style="font-size: 28px; font-weight: 700; color: #f43f5e;">1</div>
        </div>
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">PENDING DPBI NOTICE</div>
            <div style="font-size: 28px; font-weight: 700; color: #fbbf24;">0</div>
        </div>
        <div class="card" style="padding: 20px;">
            <div style="font-size: 11px; font-weight: 600; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 12px;">OVERDUE DPBI</div>
            <div style="font-size: 28px; font-weight: 700; color: #ef4444;">0</div>
        </div>
    </div>

    <!-- Charts -->
    <div style="display: grid; grid-template-columns: 1fr 2fr; gap: 24px; margin-bottom: 24px;">
        <div class="card">
            <h2 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0 0 4px 0;">Incidents by Severity</h2>
            <p style="color: var(--text-muted); font-size: 12px; margin: 0 0 32px 0;">All-time breakdown</p>
            
            <div style="display: flex; flex-direction: column; align-items: center; margin-bottom: 32px;">
                <!-- CSS Donut Chart -->
                <div style="width: 160px; height: 160px; border-radius: 50%; background: conic-gradient(#f97316 0% 50%, #9ca3af 50% 100%); position: relative; display: flex; align-items: center; justify-content: center;">
                    <div style="width: 110px; height: 110px; border-radius: 50%; background: var(--bg-surface);"></div>
                </div>
            </div>
            
            <div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 8px; height: 8px; border-radius: 50%; background: #f97316;"></div>
                        <span style="font-size: 13px; color: var(--text-main);">High</span>
                    </div>
                    <span style="font-size: 13px; font-weight: 600; color: white;">1</span>
                </div>
                <div style="display: flex; justify-content: space-between; align-items: center; padding: 8px 0;">
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <div style="width: 8px; height: 8px; border-radius: 50%; background: #9ca3af;"></div>
                        <span style="font-size: 13px; color: var(--text-main);">Low</span>
                    </div>
                    <span style="font-size: 13px; font-weight: 600; color: white;">1</span>
                </div>
            </div>
        </div>
        
        <div class="card">
            <h2 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0 0 4px 0;">Open Incidents by Status</h2>
            <p style="color: var(--text-muted); font-size: 12px; margin: 0 0 32px 0;">Closed incidents excluded</p>
            
            <div style="height: 250px; display: flex; flex-direction: column; justify-content: flex-end; position: relative;">
                <!-- Y-axis lines -->
                <div style="position: absolute; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; pointer-events: none;">
                    <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%; height: 0; position: relative;"><span style="position: absolute; left: -16px; top: -8px; font-size: 11px; color: var(--text-muted);">4</span></div>
                    <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%; height: 0; position: relative;"><span style="position: absolute; left: -16px; top: -8px; font-size: 11px; color: var(--text-muted);">3</span></div>
                    <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%; height: 0; position: relative;"><span style="position: absolute; left: -16px; top: -8px; font-size: 11px; color: var(--text-muted);">2</span></div>
                    <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%; height: 0; position: relative;"><span style="position: absolute; left: -16px; top: -8px; font-size: 11px; color: var(--text-muted);">1</span></div>
                    <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%; height: 0; position: relative;"><span style="position: absolute; left: -16px; top: -8px; font-size: 11px; color: var(--text-muted);">0</span></div>
                </div>
                
                <!-- Bar Container -->
                <div style="display: flex; justify-content: space-around; width: 100%; height: 100%; align-items: flex-end; padding-bottom: 0px; padding-left: 20px; z-index: 1;">
                    <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
                        <div style="width: 32px; height: 25%; background: #a855f7; border-radius: 4px 4px 0 0;"></div>
                        <div style="font-size: 11px; color: var(--text-muted);">Notifying</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Module Cards -->
    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
        <div class="card" style="display: flex; flex-direction: column; height: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0 0 4px 0;">Incident Management</h3>
                    <p style="color: var(--text-muted); font-size: 12px; margin: 0; line-height: 1.4;">View, create, and manage all incidents and data breaches.</p>
                </div>
                <div style="color: white; padding: 4px;">
                    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
            </div>
            <div style="margin-bottom: auto;">
                <div style="font-size: 24px; font-weight: 700; color: white;">2</div>
                <div style="font-size: 13px; color: var(--text-muted);">1 open</div>
            </div>
            <div style="margin-top: 24px;">
                <a href="/incidents/management" style="color: #ec4899; text-decoration: none; font-size: 13px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">Go to screen &rarr;</a>
            </div>
        </div>
        
        <div class="card" style="display: flex; flex-direction: column; height: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0 0 4px 0;">DPBI Notifications</h3>
                    <p style="color: var(--text-muted); font-size: 12px; margin: 0; line-height: 1.4;">Manage regulatory notifications to the Data Protection Board of India.</p>
                </div>
                <div style="color: white; padding: 4px;">
                    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="12" y1="8" x2="12" y2="12"></line><line x1="12" y1="16" x2="12.01" y2="16"></line></svg>
                </div>
            </div>
            <div style="margin-bottom: auto;">
                <div style="font-size: 24px; font-weight: 700; color: white;">0</div>
                <div style="font-size: 13px; color: var(--text-muted);">pending submissions</div>
            </div>
            <div style="margin-top: 24px;">
                <a href="#" style="color: #ec4899; text-decoration: none; font-size: 13px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">Manage notifications &rarr;</a>
            </div>
        </div>
        
        <div class="card" style="display: flex; flex-direction: column; height: 100%;">
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px;">
                <div>
                    <h3 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin: 0 0 4px 0;">72-Hour Compliance</h3>
                    <p style="color: var(--text-muted); font-size: 12px; margin: 0; line-height: 1.4;">DPDPA mandates DPBI notification without undue delay (typically 72 h) from breach discovery.</p>
                </div>
                <div style="color: white; padding: 4px;">
                    <svg viewBox="0 0 24 24" width="24" height="24" stroke="currentColor" stroke-width="2" fill="none"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                </div>
            </div>
            <div style="margin-bottom: auto;">
                <div style="font-size: 24px; font-weight: 700; color: white;">0</div>
                <div style="font-size: 13px; color: var(--text-muted);">overdue</div>
            </div>
            <div style="margin-top: 24px;">
                <a href="#" style="color: #ec4899; text-decoration: none; font-size: 13px; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">View overdue &rarr;</a>
            </div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
