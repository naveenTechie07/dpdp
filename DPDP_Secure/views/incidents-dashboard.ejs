<%- include('partials/header') %>

<div class="space-y-6">
  <!-- Page Header -->
  <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4 border-b border-slate-800 pb-5">
    <div>
      <div class="flex items-center gap-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-semibold bg-rose-500/10 text-rose-400 border border-rose-500/20">
          DPDP Act Section 8(6) & Rule 7
        </span>
        <span class="text-xs text-slate-400">Pillar 4: Executive Breach Dashboard</span>
      </div>
      <h1 class="text-2xl font-bold text-white tracking-tight mt-1">Incidents & Breaches Dashboard</h1>
      <p class="text-sm text-slate-400 mt-1">
        Breach notification compliance under DPDP Act Section 8(6) & DPDP Rules, 2025. Track incidents, assess notifiability, and manage DPBI submissions.
      </p>
    </div>
    <div class="flex items-center gap-3">
      <a href="/incidents/management" class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white text-xs font-bold transition-all shadow-lg shadow-indigo-900/30">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"></path></svg>
        <span>Incident Management Workspace &rarr;</span>
      </a>
    </div>
  </div>

  <!-- Top Metrics 4-Grid -->
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>TOTAL OPEN</span>
        <span class="w-2 h-2 rounded-full bg-sky-400"></span>
      </div>
      <div class="text-3xl font-extrabold text-white"><%= stats.totalOpen || 0 %></div>
      <div class="text-xs text-slate-400 mt-1">Active security incidents</div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>CRITICAL / HIGH OPEN</span>
        <span class="w-2 h-2 rounded-full bg-rose-500 animate-pulse"></span>
      </div>
      <div class="text-3xl font-extrabold text-rose-400"><%= stats.criticalHigh || 0 %></div>
      <div class="text-xs text-rose-400/80 mt-1">Requires immediate triage</div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>PENDING DPBI NOTICE</span>
        <span class="w-2 h-2 rounded-full bg-amber-400"></span>
      </div>
      <div class="text-3xl font-extrabold text-amber-400"><%= stats.pendingDpbi || 0 %></div>
      <div class="text-xs text-amber-400/80 mt-1">Within 72h statutory window</div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
      <div class="text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2 flex items-center justify-between">
        <span>OVERDUE DPBI</span>
        <span class="w-2 h-2 rounded-full <%= (stats.overdueDpbi || 0) > 0 ? 'bg-red-500 animate-ping' : 'bg-emerald-400' %>"></span>
      </div>
      <div class="text-3xl font-extrabold <%= (stats.overdueDpbi || 0) > 0 ? 'text-red-500' : 'text-emerald-400' %>">
        <%= stats.overdueDpbi || 0 %>
      </div>
      <div class="text-xs <%= (stats.overdueDpbi || 0) > 0 ? 'text-red-400' : 'text-slate-400' %> mt-1">
        <%= (stats.overdueDpbi || 0) > 0 ? 'Statutory deadline breached!' : '100% on-time compliance' %>
      </div>
    </div>
  </div>

  <!-- Charts & Analytics Breakdown -->
  <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
    <!-- Donut Severity Breakdown -->
    <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-white">Incidents by Severity</h2>
            <p class="text-xs text-slate-400 mt-0.5">All-time risk distribution</p>
          </div>
          <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-slate-800 text-slate-300 border border-slate-700">
            Rule 7 Matrix
          </span>
        </div>

        <%
          const totalInc = (stats.totalOpen || 1);
          const cCount = stats.criticalCount || 0;
          const hCount = stats.highCount || 0;
          const mCount = stats.mediumCount || 0;
          const lCount = stats.lowCount || 0;
          
          const cPct = Math.round((cCount / totalInc) * 100);
          const hPct = Math.round((hCount / totalInc) * 100);
          const mPct = Math.round((mCount / totalInc) * 100);
          const lPct = Math.max(0, 100 - cPct - hPct - mPct);
        %>

        <div class="flex flex-col items-center justify-center my-6">
          <div class="relative w-40 h-40 rounded-full flex items-center justify-center shadow-inner"
               style="background: conic-gradient(#f43f5e 0% <%= cPct %>%, #f97316 <%= cPct %>% <%= cPct + hPct %>%, #eab308 <%= cPct + hPct %>% <%= cPct + hPct + mPct %>%, #10b981 <%= cPct + hPct + mPct %>% 100%);">
            <div class="w-28 h-28 rounded-full bg-slate-900 border border-slate-800 flex flex-col items-center justify-center">
              <span class="text-2xl font-bold text-white"><%= stats.totalOpen || 0 %></span>
              <span class="text-[10px] text-slate-400 uppercase tracking-wider">Incidents</span>
            </div>
          </div>
        </div>
      </div>

      <div class="space-y-2 pt-2 border-t border-slate-800 text-xs">
        <div class="flex items-center justify-between py-1">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-rose-500"></span>
            <span class="text-slate-300">Critical (Aadhaar / Clinical Data)</span>
          </div>
          <span class="font-bold text-white"><%= cCount %></span>
        </div>
        <div class="flex items-center justify-between py-1">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-orange-500"></span>
            <span class="text-slate-300">High (Direct Identifiers > 100)</span>
          </div>
          <span class="font-bold text-white"><%= hCount %></span>
        </div>
        <div class="flex items-center justify-between py-1">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-amber-500"></span>
            <span class="text-slate-300">Medium (Financial / Invoices)</span>
          </div>
          <span class="font-bold text-white"><%= mCount %></span>
        </div>
        <div class="flex items-center justify-between py-1">
          <div class="flex items-center gap-2">
            <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
            <span class="text-slate-300">Low (Encrypted / Anonymized)</span>
          </div>
          <span class="font-bold text-white"><%= lCount %></span>
        </div>
      </div>
    </div>

    <!-- Status & Response Pipeline -->
    <div class="lg:col-span-2 p-6 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur flex flex-col justify-between">
      <div>
        <div class="flex items-center justify-between mb-4">
          <div>
            <h2 class="text-base font-bold text-white">Statutory Response Pipeline & SLA</h2>
            <p class="text-xs text-slate-400 mt-0.5">72-Hour DPBI Intimation & Citizen Notification lifecycle</p>
          </div>
          <a href="/incidents/management" class="text-xs text-sky-400 hover:text-sky-300 font-medium">Manage Pipeline &rarr;</a>
        </div>

        <!-- 3-Stage Lifecycle Flow -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-3 my-4">
          <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span>Stage 1: Containment</span>
              <span class="text-sky-400 font-semibold">Active</span>
            </div>
            <div class="text-lg font-bold text-white">Immediate Lockdown</div>
            <p class="text-[11px] text-slate-400 mt-1">Google Find My Device wipe, WhatsApp session revoking, network isolation.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span>Stage 2: Regulatory</span>
              <span class="text-amber-400 font-semibold"><%= stats.pendingDpbi %> Pending</span>
            </div>
            <div class="text-lg font-bold text-white">DPBI 72-Hour Dossier</div>
            <p class="text-[11px] text-slate-400 mt-1">Form DPBI-IR1 submission with impact score and mitigations under Rule 7.</p>
          </div>

          <div class="p-3.5 rounded-xl bg-slate-950/60 border border-slate-800">
            <div class="flex items-center justify-between text-xs text-slate-400 mb-1">
              <span>Stage 3: Principals</span>
              <span class="text-emerald-400 font-semibold">Advisories</span>
            </div>
            <div class="text-lg font-bold text-white">Citizen Reassurance</div>
            <p class="text-[11px] text-slate-400 mt-1">Plain-language Kannada / English notices advising safe security precautions.</p>
          </div>
        </div>

        <!-- Visual Bar Chart of Incidents by Category -->
        <div class="mt-6 space-y-3">
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">WhatsApp & Informal Device Leaks (Pillar 1/4 vector)</span>
              <span class="text-slate-400 font-mono">Critical Risk</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2.5">
              <div class="bg-rose-500 h-2.5 rounded-full" style="width: 75%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Misdirected Clinical Health Reports</span>
              <span class="text-slate-400 font-mono">High Risk</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2.5">
              <div class="bg-orange-500 h-2.5 rounded-full" style="width: 50%"></div>
            </div>
          </div>
          <div>
            <div class="flex justify-between text-xs mb-1">
              <span class="text-slate-300">Billing Workstation Malware (Air-gapped)</span>
              <span class="text-slate-400 font-mono">Medium Risk</span>
            </div>
            <div class="w-full bg-slate-800 rounded-full h-2.5">
              <div class="bg-amber-500 h-2.5 rounded-full" style="width: 30%"></div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-6 pt-4 border-t border-slate-800 flex items-center justify-between text-xs text-slate-400">
        <span>Statutory Authority: Data Protection Board of India (DPBI)</span>
        <span class="font-mono text-slate-300">DPDP Rules, 2025</span>
      </div>
    </div>
  </div>

  <!-- Active Incidents Overview Table -->
  <div class="p-6 rounded-2xl bg-slate-900/80 border border-slate-800 shadow-lg backdrop-blur">
    <div class="flex items-center justify-between mb-4">
      <div>
        <h2 class="text-base font-bold text-white">Active Incidents Queue</h2>
        <p class="text-xs text-slate-400 mt-0.5">Chronologically logged data breach incidents</p>
      </div>
      <a href="/incidents/management" class="px-3 py-1.5 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold border border-slate-700 transition-colors">
        Open Interactive Triage &rarr;
      </a>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="text-slate-400 uppercase tracking-wider border-b border-slate-800 bg-slate-950/40">
          <tr>
            <th class="py-3 px-4">Incident ID & Title</th>
            <th class="py-3 px-4">Severity</th>
            <th class="py-3 px-4">Impacted Data</th>
            <th class="py-3 px-4">Affected Count</th>
            <th class="py-3 px-4">Discovered At</th>
            <th class="py-3 px-4 text-right">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-800/60 text-slate-300">
          <% if (incidents && incidents.length > 0) { %>
            <% incidents.forEach(function(inc) { %>
              <tr class="hover:bg-slate-800/30 transition-colors">
                <td class="py-3 px-4">
                  <div class="font-bold text-white"><%= inc.incidentTitle %></div>
                  <div class="text-[11px] text-slate-400 font-mono"><%= inc.id %></div>
                </td>
                <td class="py-3 px-4">
                  <% if (inc.severity === 'CRITICAL') { %>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-rose-500/10 text-rose-400 border border-rose-500/30">CRITICAL</span>
                  <% } else if (inc.severity === 'HIGH') { %>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-orange-500/10 text-orange-400 border border-orange-500/30">HIGH</span>
                  <% } else if (inc.severity === 'MEDIUM') { %>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">MEDIUM</span>
                  <% } else { %>
                    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/30">LOW</span>
                  <% } %>
                </td>
                <td class="py-3 px-4 text-slate-400 max-w-xs truncate">
                  <%= inc.dataCategories || 'Aadhaar, Contact, Clinical Health' %>
                </td>
                <td class="py-3 px-4 font-mono font-bold text-white">
                  <%= inc.affectedCount || 0 %> individuals
                </td>
                <td class="py-3 px-4 text-slate-400 font-mono text-[11px]">
                  <%= inc.discoveredAt ? new Date(inc.discoveredAt).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) : 'Just now' %>
                </td>
                <td class="py-3 px-4 text-right">
                  <a href="/incidents/management" class="px-2.5 py-1 rounded bg-slate-800 hover:bg-slate-700 text-sky-400 text-[11px] font-medium border border-slate-700">
                    Triage &rarr;
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="6" class="py-6 text-center text-slate-500">
                No security incidents reported. System operating under clean compliance.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Bottom Regulatory Guidance Cards -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 shadow flex flex-col justify-between">
      <div>
        <div class="w-9 h-9 rounded-lg bg-rose-500/10 border border-rose-500/20 text-rose-400 flex items-center justify-center mb-3">
          ⏱️
        </div>
        <h3 class="text-sm font-bold text-white">72-Hour DPBI Intimation</h3>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
          DPDP Rules, 2025 (Rule 7) mandates personal data breach intimation to the Data Protection Board within 72 hours of becoming aware.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-800/80">
        <a href="/incidents/management" class="text-xs font-semibold text-rose-400 hover:text-rose-300 flex items-center gap-1">
          Open 72h countdown &rarr;
        </a>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 shadow flex flex-col justify-between">
      <div>
        <div class="w-9 h-9 rounded-lg bg-sky-500/10 border border-sky-500/20 text-sky-400 flex items-center justify-center mb-3">
          💬
        </div>
        <h3 class="text-sm font-bold text-white">Citizen Reassurance Notices</h3>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
          Inform affected patients via WhatsApp/SMS without technical jargon, providing clear advice to rotate UPI pins or monitor test orders.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-800/80">
        <a href="/incidents/management" class="text-xs font-semibold text-sky-400 hover:text-sky-300 flex items-center gap-1">
          Review advisory drafts &rarr;
        </a>
      </div>
    </div>

    <div class="p-5 rounded-2xl bg-slate-900/60 border border-slate-800 shadow flex flex-col justify-between">
      <div>
        <div class="w-9 h-9 rounded-lg bg-emerald-500/10 border border-emerald-500/20 text-emerald-400 flex items-center justify-center mb-3">
          🔒
        </div>
        <h3 class="text-sm font-bold text-white">Immutable Audit Chronology</h3>
        <p class="text-xs text-slate-400 mt-1.5 leading-relaxed">
          Initial discovery timestamps are permanently locked in SQLite. No administrative overrides can alter statutory audit chronology.
        </p>
      </div>
      <div class="mt-4 pt-3 border-t border-slate-800/80">
        <a href="/audit-vault" class="text-xs font-semibold text-emerald-400 hover:text-emerald-300 flex items-center gap-1">
          Verify Cryptographic Audit Vault &rarr;
        </a>
      </div>
    </div>
  </div>
</div>

<%- include('partials/footer') %>
