<%- include('partials/header') %>

<div class="dashboard-header mb-4">
    <div>
        <h1 class="page-title">Cookie Dashboard</h1>
        <p class="page-description">Summary counts for this module. Each card opens a dedicated screen with one primary table.</p>
    </div>
</div>

<div style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; margin-bottom: 24px;">
    <!-- Site Scans Card -->
    <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; position: relative; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px;">
            <div>
                <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px;">Site scans</div>
                <div style="color: var(--text-muted); font-size: 11px;">Discovered cookies by property.</div>
            </div>
            <svg viewBox="0 0 24 24" width="32" height="32" stroke="var(--text-main)" stroke-width="2" fill="none" style="opacity: 0.8;"><path d="M15 3h4a2 2 0 0 1 2 2v4M21 15v4a2 2 0 0 1-2 2h-4M9 21H5a2 2 0 0 1-2-2v-4M3 9V5a2 2 0 0 1 2-2h4"></path><circle cx="12" cy="12" r="3"></circle></svg>
        </div>
        <div>
            <div style="font-size: 32px; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">2</div>
            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Open scan list</div>
            <div style="color: #ec4899; font-size: 13px; font-weight: 600;">Go to screen &rarr;</div>
        </div>
    </div>

    <!-- Consent Logs Card -->
    <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; position: relative; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px;">
            <div>
                <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px;">Consent logs</div>
                <div style="color: var(--text-muted); font-size: 11px;">Recorded consent decisions.</div>
            </div>
            <svg viewBox="0 0 24 24" width="32" height="32" stroke="var(--text-main)" stroke-width="2" fill="none" style="opacity: 0.8;"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>
        </div>
        <div>
            <div style="font-size: 32px; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">10</div>
            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Open log table</div>
            <div style="color: #ec4899; font-size: 13px; font-weight: 600;">Go to screen &rarr;</div>
        </div>
    </div>

    <!-- Banners Card -->
    <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; position: relative; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px;">
            <div>
                <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px;">Banners</div>
                <div style="color: var(--text-muted); font-size: 11px;">Banner copy and placement.</div>
            </div>
            <svg viewBox="0 0 24 24" width="32" height="32" stroke="var(--text-main)" stroke-width="2" fill="none" style="opacity: 0.8;"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><line x1="3" y1="9" x2="21" y2="9"></line><line x1="9" y1="21" x2="9" y2="9"></line></svg>
        </div>
        <div>
            <div style="font-size: 32px; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">2</div>
            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Open banners</div>
            <div style="color: #ec4899; font-size: 13px; font-weight: 600;">Go to screen &rarr;</div>
        </div>
    </div>

    <!-- Geo Rules Card -->
    <div style="background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 12px; padding: 24px; position: relative; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.05)'" onmouseout="this.style.background='rgba(255,255,255,0.03)'">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 32px;">
            <div>
                <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 4px;">Geo rules</div>
                <div style="color: var(--text-muted); font-size: 11px;">Regional defaults.</div>
            </div>
            <svg viewBox="0 0 24 24" width="32" height="32" stroke="var(--text-main)" stroke-width="2" fill="none" style="opacity: 0.8;"><circle cx="12" cy="12" r="10"></circle><line x1="2" y1="12" x2="22" y2="12"></line><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path></svg>
        </div>
        <div>
            <div style="font-size: 32px; font-weight: 700; color: var(--text-main); margin-bottom: 8px;">1</div>
            <div style="color: var(--text-muted); font-size: 13px; margin-bottom: 16px;">Open geo rules</div>
            <div style="color: #ec4899; font-size: 13px; font-weight: 600;">Go to screen &rarr;</div>
        </div>
    </div>
</div>

<div class="card p-4">
    <div style="margin-bottom: 32px;">
        <h3 style="font-size: 14px; font-weight: 600; color: var(--text-main); margin-bottom: 4px;">Module Activity</h3>
        <p style="color: var(--text-muted); font-size: 13px;">Record counts across cookie management areas</p>
    </div>

    <!-- Chart -->
    <div style="position: relative; height: 300px; padding-left: 24px; padding-bottom: 32px;">
        <!-- Y Axis Labels -->
        <div style="position: absolute; left: 0; top: 0; height: calc(100% - 32px); display: flex; flex-direction: column; justify-content: space-between; font-size: 11px; color: var(--text-muted);">
            <div>12</div>
            <div>9</div>
            <div>6</div>
            <div>3</div>
            <div>0</div>
        </div>
        
        <!-- Grid Lines -->
        <div style="position: absolute; left: 24px; right: 0; top: 0; height: calc(100% - 32px); display: flex; flex-direction: column; justify-content: space-between;">
            <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%;"></div>
            <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%;"></div>
            <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%;"></div>
            <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%;"></div>
            <div style="border-top: 1px dashed rgba(255,255,255,0.2); width: 100%;"></div>
        </div>

        <!-- Bars -->
        <div style="position: absolute; left: 24px; right: 0; top: 0; height: calc(100% - 32px); display: flex; justify-content: space-around; align-items: flex-end;">
            <!-- Scans -->
            <div style="display: flex; flex-direction: column; align-items: center; width: 60px;">
                <div style="width: 32px; height: 16.6%; background: #3b82f6; border-radius: 4px 4px 0 0;"></div>
            </div>
            <!-- Logs -->
            <div style="display: flex; flex-direction: column; align-items: center; width: 60px;">
                <div style="width: 32px; height: 83.3%; background: #10b981; border-radius: 4px 4px 0 0;"></div>
            </div>
            <!-- Banners -->
            <div style="display: flex; flex-direction: column; align-items: center; width: 60px;">
                <div style="width: 32px; height: 16.6%; background: #8b5cf6; border-radius: 4px 4px 0 0;"></div>
            </div>
            <!-- Geo Rules -->
            <div style="display: flex; flex-direction: column; align-items: center; width: 60px;">
                <div style="width: 32px; height: 8.3%; background: #f59e0b; border-radius: 4px 4px 0 0;"></div>
            </div>
        </div>
        
        <!-- X Axis Labels -->
        <div style="position: absolute; left: 24px; right: 0; bottom: 0; height: 32px; display: flex; justify-content: space-around; align-items: center; font-size: 12px; color: var(--text-muted);">
            <div style="width: 60px; text-align: center;">Scans</div>
            <div style="width: 60px; text-align: center;">Logs</div>
            <div style="width: 60px; text-align: center;">Banners</div>
            <div style="width: 60px; text-align: center;">Geo Rules</div>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
