                <td style="padding: 16px 24px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; display: flex; gap: 12px; align-items: center; justify-content: flex-end;">
