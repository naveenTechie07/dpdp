<%- include('partials/header') %>

<% 
const assetsList = (typeof assets !== 'undefined' && Array.isArray(assets)) ? assets : [];
const totalAssets = assetsList.length;
const systemAssets = assetsList.filter(a => a.assetType !== 'CONTAINER').length;
const totalElements = assetsList.reduce((acc, a) => acc + (parseInt(a.elements) || 0), 0);
const highSensAssets = assetsList.filter(a => a.sensitivity === 'HIGH' || a.sensitivity === 'RESTRICTED' || a.sensitivity === 'HIGH_RISK' || a.sensitivity === 'CONFIDENTIAL').length;
%>

<!-- Top Metrics -->
<div class="metrics-grid mb-4">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">TOTAL ASSETS</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalAssets %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">SYSTEM ASSETS</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= systemAssets %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">DATA ELEMENTS</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalElements %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">HIGH SENSITIVITY</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= highSensAssets %></h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Data Assets</h1>
        <p>Inventory of all data systems and containers with classified elements and sensitivity tiers.</p>
    </div>
    <button class="btn-primary" style="background-color: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;" onclick="window.location.href='/inventory/assets/create'">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Asset
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" id="asset-search" placeholder="Search assets..." onkeyup="filterAssets()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div style="background: rgba(255,255,255,0.05); padding: 4px; border-radius: 6px; display: flex; align-items: center;">
            <div style="padding: 6px 16px; font-size: 12px; font-weight: 600; background: var(--bg-card); color: var(--text-main); border-radius: 4px;">Systems (<%= systemAssets %>)</div>
            <div style="padding: 6px 16px; font-size: 12px; font-weight: 500; color: var(--text-muted);">Total (<%= totalAssets %>)</div>
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalAssets %> rows</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="assets-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 12px 24px; font-weight: 600;">Asset Name &#9652;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Type &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Source System &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Sensitivity</th>
                <th style="padding: 12px 24px; font-weight: 600;">Elements</th>
                <th style="padding: 12px 24px; font-weight: 600;">Status &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (assetsList.length === 0) { %>
                <tr>
                    <td colspan="7" style="padding: 32px; text-align: center; color: var(--text-muted);">No data assets found. Click "New Asset" to register a system.</td>
                </tr>
            <% } else { %>
                <% assetsList.forEach(asset => { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="asset-row">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">
                            <div><%= asset.assetName %></div>
                            <% if (asset.description) { %>
                                <div style="font-size: 11px; color: var(--text-muted); font-weight: normal; margin-top: 2px;"><%= asset.description %></div>
                            <% } %>
                        </td>
                        <td style="padding: 16px 24px;">
                            <span class="badge" style="background: #bfdbfe; color: #1e3a8a; padding: 4px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;"><%= asset.assetType %></span>
                        </td>
                        <td style="padding: 16px 24px; font-family: monospace; color: var(--text-muted);"><%= asset.sourceSystem || 'Local' %></td>
                        <td style="padding: 16px 24px;">
                            <span style="background: <%= (asset.sensitivity === 'RESTRICTED' || asset.sensitivity === 'HIGH_RISK') ? 'rgba(239, 68, 68, 0.2); color: #ef4444;' : (asset.sensitivity === 'CONFIDENTIAL' ? 'rgba(245, 158, 11, 0.2); color: #f59e0b;' : 'rgba(255,255,255,0.1); color: var(--text-muted);') %> padding: 4px 8px; border-radius: 4px; font-size: 10px; font-weight: 700;"><%= asset.sensitivity %></span>
                        </td>
                        <td style="padding: 16px 24px; color: var(--text-main); font-weight: 500;"><%= asset.elements %></td>
                        <td style="padding: 16px 24px;">
                            <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 600;"><%= asset.status %></span>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteAsset('<%= asset.id %>')" title="Delete Asset" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
    
    <!-- Table Footer -->
    <div class="table-toolbar" style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<script>
function filterAssets() {
    const q = document.getElementById('asset-search').value.toLowerCase();
    document.querySelectorAll('.asset-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function deleteAsset(id) {
    if (!confirm('Are you sure you want to delete this data asset?')) return;
    try {
        const res = await fetch(`/api/assets/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting asset: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting asset');
    }
}
</script>

<%- include('partials/footer') %>
