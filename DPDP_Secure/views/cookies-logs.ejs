                <th style="padding: 16px 16px;">USER</th>
                <th style="padding: 16px 16px;">CATEGORY</th>
                <th style="padding: 16px 16px;">CONSENT</th>
                <th style="padding: 16px 16px;">POLICY</th>
                <th style="padding: 16px 24px;">TIME</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <!-- Row 1 -->
            <tr style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px; color: var(--text-muted);">#70</td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">user@example.com</td>
                <td style="padding: 16px 16px; color: var(--text-muted);">ANALYTICS</td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Accepted</span>
                </td>
                <td style="padding: 16px 16px; color: var(--text-muted);">v1</td>
