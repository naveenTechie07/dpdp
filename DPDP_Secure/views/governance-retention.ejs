<%- include('partials/header') %>

<% 
const policiesList = (typeof policies !== 'undefined' && Array.isArray(policies)) ? policies : [];
const totalPolicies = policiesList.length;
const autoDeleteCount = policiesList.filter(p => p.autoDelete === 1 || p.autoDelete === '1' || p.autoDelete === true).length;
const taxLockCount = policiesList.filter(p => (p.legalBasis && p.legalBasis.includes('CGST')) || (p.policyName && p.policyName.includes('Tax'))).length;
%>

<!-- Top Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Total Policies</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalPolicies %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Auto-Purge Schedules</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #10b981;"><%= autoDeleteCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Statutory Tax Locks</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #f59e0b;"><%= taxLockCount %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px; text-transform: uppercase;">Legal Compliance</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #3b82f6;">DPDP & CGST</h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between; display: flex;">
    <div class="title-group">
        <h1 class="page-title"><%= (typeof title !== 'undefined' ? title : 'Retention').split(' - ')[0] %></h1>
        <p class="page-description">Retention schedules, statutory tax collision holds (CGST Sec 36), and purpose-limitation purges.</p>
    </div>
    <button class="btn-primary" onclick="document.getElementById('new-policy-modal').style.display='flex'" style="padding: 10px 20px; font-size: 13px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Policy
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" id="policy-search" placeholder="Search retention policies..." onkeyup="filterPolicies()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalPolicies %> policies</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="policies-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 14px 24px; font-weight: 600;">Policy Name &#9652;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Data Category &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Period &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Legal Basis &#8597;</th>
                <th style="padding: 14px 16px; font-weight: 600;">Auto-Purge</th>
                <th style="padding: 14px 24px; font-weight: 600; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (policiesList.length === 0) { %>
                <tr>
                    <td colspan="6" style="padding: 32px; text-align: center; color: var(--text-muted);">No retention policies defined. Click "New Policy" to set up lifecycle rules.</td>
                </tr>
            <% } else { %>
                <% policiesList.forEach(pol => { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="pol-row">
                        <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">
                            <div><%= pol.policyName %></div>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted);"><%= pol.dataCategory || 'General Records' %></td>
                        <td style="padding: 16px 16px;">
                            <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">
                                <%= pol.retentionPeriod %>
                            </span>
                        </td>
                        <td style="padding: 16px 16px; color: var(--text-muted); font-size: 12px; max-width: 280px;">
                            <%= pol.legalBasis %>
                        </td>
                        <td style="padding: 16px 16px;">
                            <% if (pol.autoDelete === 1 || pol.autoDelete === '1' || pol.autoDelete === true) { %>
                                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #10b981; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Auto Purge</span>
                            <% } else { %>
                                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #f59e0b; padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 700;">Manual Review</span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deletePolicy('<%= pol.id %>')" title="Delete Policy" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<!-- New Policy Modal Overlay -->
<div id="new-policy-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <div class="card p-0" style="width: 520px; background: #0f172a; border: 1px solid #334155; box-shadow: 0 20px 30px rgba(0,0,0,0.6); border-radius: 12px; overflow: hidden;">
        <div style="padding: 18px 24px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; background: #1e293b;">
            <h2 style="font-size: 16px; font-weight: 600; color: #f8fafc; margin: 0;">Create Retention Policy</h2>
            <button onclick="document.getElementById('new-policy-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <form id="new-pol-form" onsubmit="handleCreatePolicy(event)" style="padding: 24px;">
            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Policy Name *</label>
                <input type="text" id="polName" required placeholder="e.g. Clinical Laboratory Diagnostic Reports Retention" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 16px;">
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Data Category</label>
                    <input type="text" id="polCategory" placeholder="e.g. Diagnostic Lab Reports" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
                <div>
                    <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Retention Period *</label>
                    <input type="text" id="polPeriod" required placeholder="e.g. 36 Months / 6 Years" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                </div>
            </div>

            <div style="margin-bottom: 16px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Legal Basis / Statutory Requirement *</label>
                <input type="text" id="polBasis" required placeholder="e.g. National Medical Commission Code / CGST Act 2017 Sec 36" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 6px;">Action on Expiration</label>
                <select id="polAutoDelete" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                    <option value="0">Retain on Legal Hold / Manual Review</option>
                    <option value="1">Automated Cryptographic Purge / Redaction</option>
                </select>
            </div>

            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Save Policy</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('new-policy-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: #334155; border: 1px solid #475569; color: #f8fafc;">Cancel</button>
            </div>
        </form>
    </div>
</div>

<script>
function filterPolicies() {
    const q = document.getElementById('policy-search').value.toLowerCase();
    document.querySelectorAll('.pol-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function handleCreatePolicy(e) {
    e.preventDefault();
    const policyName = document.getElementById('polName').value.trim();
    const dataCategory = document.getElementById('polCategory').value.trim();
    const retentionPeriod = document.getElementById('polPeriod').value.trim();
    const legalBasis = document.getElementById('polBasis').value.trim();
    const autoDelete = parseInt(document.getElementById('polAutoDelete').value) || 0;

    try {
        const res = await fetch('/api/governance/retention', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ policyName, dataCategory, retentionPeriod, legalBasis, autoDelete })
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error creating policy: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error submitting policy');
    }
}

async function deletePolicy(id) {
    if (!confirm('Are you sure you want to delete this retention policy?')) return;
    try {
        const res = await fetch(`/api/governance/retention/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting policy: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting policy');
    }
}
</script>

<%- include('partials/footer') %>
