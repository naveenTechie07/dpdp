<%- include('partials/header') %>

<!-- Top Metrics -->
<div class="metrics-grid mb-4">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">CONNECTORS</span>
            <h2 class="metric-value" style="margin-top: 8px;">2</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">ACTIVE</span>
            <h2 class="metric-value" style="margin-top: 8px;">2</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">PENDING ASSET REVIEWS</span>
            <h2 class="metric-value" style="margin-top: 8px;">5</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">PENDING ELEMENT REVIEWS</span>
            <h2 class="metric-value" style="margin-top: 8px;">11</h2>
        </div>
    </div>
</div>

<div class="dashboard-header mb-4" style="align-items: center;">
    <div class="title-group">
        <h1>Data Discovery</h1>
        <p>Connect data sources, run scans, and review PII findings before importing into inventory.</p>
    </div>
    <button class="btn-primary" style="background-color: var(--primary); color: white; border: none; padding: 8px 16px; border-radius: 6px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 6px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        Add Connector
    </button>
</div>

<div class="card p-0" style="overflow: hidden;">
    <!-- Tabs -->
    <div class="table-tabs" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; gap: 24px; align-items: center;">
        <div class="tab-item active" style="background: rgba(255,255,255,0.05); padding: 6px 12px; border-radius: 6px; font-size: 13px; font-weight: 600; color: var(--text-main); cursor: pointer;">Connectors</div>
        <div class="tab-item" style="font-size: 13px; font-weight: 500; color: var(--text-muted); cursor: pointer;">Scans</div>
        <div class="tab-item" style="font-size: 13px; font-weight: 500; color: var(--text-muted); cursor: pointer;">Asset Findings (5)</div>
        <div class="tab-item" style="font-size: 13px; font-weight: 500; color: var(--text-muted); cursor: pointer;">Element Findings (11)</div>
        <div class="tab-item" style="font-size: 13px; font-weight: 500; color: var(--text-muted); cursor: pointer;">Settings</div>
        <div class="tab-item" style="font-size: 13px; font-weight: 500; color: var(--text-muted); cursor: pointer;">Agents</div>
    </div>

    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 300px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search connectors..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span>2 rows</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                <th style="padding: 12px 24px; font-weight: 600;">Name &#9652;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Type &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Status &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Last Tested &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">Assigned Agent &#8597;</th>
                <th style="padding: 12px 24px; font-weight: 600;">&#8597;</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <tr style="border-bottom: 1px solid var(--border-color);">
                <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">DPDP_Secure KYC Documents S3 Bucket</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: #fef08a; color: #854d0e; padding: 4px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">S3</span></td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">Never</td>
                <td style="padding: 16px 24px;">
                    <select style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main); padding: 6px 8px; border-radius: 4px; outline: none; font-size: 12px;">
                        <option>Shared cloud pool</option>
                    </select>
                </td>
                <td style="padding: 16px 24px; display: flex; gap: 12px; align-items: center;">
                    <button style="background: #ffffff; color: #000; border: none; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                        <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        Test
                    </button>
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </td>
            </tr>
            <tr>
                <td style="padding: 16px 24px; font-weight: 600; color: var(--text-main);">DPDP_Secure Loan Origination System DB</td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: #bfdbfe; color: #1e3a8a; padding: 4px 8px; border-radius: 12px; font-size: 10px; font-weight: 700;">POSTGRESQL</span></td>
                <td style="padding: 16px 24px;"><span class="badge" style="background: rgba(255,255,255,0.1); color: var(--text-muted); padding: 4px 12px; border-radius: 12px; font-size: 11px;">active</span></td>
                <td style="padding: 16px 24px; color: var(--text-muted);">Never</td>
                <td style="padding: 16px 24px;">
                    <select style="background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main); padding: 6px 8px; border-radius: 4px; outline: none; font-size: 12px;">
                        <option>Shared cloud pool</option>
                    </select>
                </td>
                <td style="padding: 16px 24px; display: flex; gap: 12px; align-items: center;">
                    <button style="background: #ffffff; color: #000; border: none; padding: 4px 12px; border-radius: 4px; font-size: 11px; font-weight: 600; display: flex; align-items: center; gap: 4px; cursor: pointer;">
                        <svg viewBox="0 0 24 24" width="12" height="12" stroke="currentColor" stroke-width="2" fill="none"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                        Test
                    </button>
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>
                    <svg viewBox="0 0 24 24" width="14" height="14" stroke="var(--text-muted)" stroke-width="2" fill="none" style="cursor: pointer;"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                </td>
            </tr>
        </tbody>
    </table>
    
    <!-- Table Footer -->
    <div class="table-toolbar" style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: flex-end; align-items: center;">
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>
</div>

<%- include('partials/footer') %>
