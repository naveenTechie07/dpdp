<%- include('partials/header') %>

<!-- Top Discovery & Connector Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(6, 1fr); gap: 12px;">
    <div class="card metric-card p-3">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px;">ACTIVE CONNECTORS</span>
            <h2 class="metric-value" style="margin-top: 6px; font-size: 20px;"><%= (typeof stats !== 'undefined' && stats.connectorsCount) ? stats.connectorsCount : 7 %> <span style="font-size: 11px; font-weight: 500; color: #10b981;">&#9679; Connected</span></h2>
        </div>
    </div>
    <div class="card metric-card p-3">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px;">CONTAINERS & TABLES</span>
            <h2 class="metric-value" style="margin-top: 6px; font-size: 20px; color: #60a5fa;"><%= (typeof catalogStats !== 'undefined' && catalogStats.totalTables) ? catalogStats.totalTables : 17 %> <span style="font-size: 11px; font-weight: 500; color: var(--text-muted);">Cataloged</span></h2>
        </div>
    </div>
    <div class="card metric-card p-3">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px;">DISCOVERED INDIAN PII</span>
            <h2 class="metric-value" id="tickerRecords" style="margin-top: 6px; font-size: 20px; color: #fbbf24;"><%= (typeof stats !== 'undefined' && stats.totalPiiCount) ? stats.totalPiiCount.toLocaleString() : '2,840' %></h2>
        </div>
    </div>
    <div class="card metric-card p-3">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px;">AADHAAR (VERHOEFF D5)</span>
            <h2 class="metric-value" id="tickerAadhaar" style="margin-top: 6px; font-size: 20px; color: #f87171;"><%= (typeof stats !== 'undefined' && stats.aadhaarTokens) ? stats.aadhaarTokens : 64 %></h2>
        </div>
    </div>
    <div class="card metric-card p-3">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px;">SECTION 2(t) HEALTH DATA</span>
            <h2 class="metric-value" id="tickerHealth" style="margin-top: 6px; font-size: 20px; color: #fb7185;"><%= (typeof stats !== 'undefined' && stats.healthTokens) ? stats.healthTokens : 98 %></h2>
        </div>
    </div>
    <div class="card metric-card p-3">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 700; letter-spacing: 0.5px;">AIR-GAPPED COMPLIANCE</span>
            <h2 class="metric-value" style="margin-top: 6px; font-size: 20px; color: #34d399;">100% <span style="font-size: 11px; font-weight: 500; color: #34d399;">0 Egress</span></h2>
        </div>
    </div>
</div>

<!-- Header with Action Bar -->
<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
    <div class="title-group">
        <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
            <span style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; border: 1px solid rgba(99, 102, 241, 0.4); font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 4px;">PILLAR 1: DATA DISCOVERY & CONNECTORS</span>
            <span style="font-size: 12px; color: var(--text-muted);">Aarogya Diagnostic Center &bull; GSTIN: 29AAAAA0000A1Z5</span>
        </div>
        <h1 style="font-size: 24px; font-weight: 800; color: #ffffff; margin: 0;">Multi-Connector Data Discovery & Schema Studio</h1>
        <p style="font-size: 13px; color: var(--text-muted); margin: 4px 0 0 0;">
            Continuous, 100% offline-first discovery across enterprise databases, claim archives, spreadsheets, clinical PDFs, and informal silos.
        </p>
    </div>
    <div style="display: flex; gap: 10px; flex-wrap: wrap;">
        <button id="btnScanAll" class="btn-primary" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white; border: none; padding: 10px 18px; border-radius: 8px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            ⚡ Scan All Connectors (Deep Discovery)
        </button>
        <button id="btnOpenNewConnector" onclick="openNewConnectorModal()" class="btn-secondary" style="background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid var(--border-color); padding: 10px 16px; border-radius: 8px; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
            Connect Data Source
        </button>
        <a href="/inventory/ropa" class="btn-secondary" style="background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid var(--border-color); padding: 10px 16px; border-radius: 8px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 8px;">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line></svg>
            RoPA Register &rarr;
        </a>
    </div>
</div>

<!-- Progress Bar Indicator -->
<div id="scanProgressContainer" class="card mb-4 p-4" style="display: none; background: rgba(17, 24, 39, 0.95); border: 1px solid var(--primary); box-shadow: 0 8px 32px rgba(99, 102, 241, 0.2);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <div style="display: flex; align-items: center; gap: 8px;">
            <div class="spinner-border" style="width: 14px; height: 14px; border: 2px solid rgba(255,255,255,0.2); border-top-color: #6366f1; border-radius: 50%; animation: spin 0.8s linear infinite;"></div>
            <span id="scanStatusText" style="font-size: 13px; font-weight: 600; color: #ffffff;">Scanning active data silos across Claims DB, Policy Admin DB, Excel, PDFs, Docs, and Cloud Storage...</span>
        </div>
        <span style="font-size: 11px; color: #10b981; font-weight: 600; display: flex; align-items: center; gap: 4px;">
            <span>✓</span> Air-Gapped Local Execution (Zero External Cloud Egress)
        </span>
    </div>
    <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
        <div id="scanProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #6366f1, #3b82f6, #10b981); transition: width 0.3s ease;"></div>
    </div>
</div>

<!-- ========================================== -->
<!-- 1. HIGH-IMPACT PLATFORM ARCHITECTURE & TOPOLOGY GRAPH -->
<!-- ========================================== -->
<div class="card p-4 mb-4" style="background: rgba(15, 23, 42, 0.8); border: 1px solid var(--border-color); position: relative; overflow: hidden;">
    <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 16px; flex-wrap: wrap; gap: 12px;">
        <div>
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 10px; font-weight: 700;">IN-DEPTH PLATFORM ARCHITECTURE</span>
                <span style="font-size: 11px; color: var(--text-muted);">&#9679; Click any node to inspect live telemetry</span>
            </div>
            <h2 style="font-size: 18px; font-weight: 800; color: #ffffff; margin: 0;">How DPDP_Secure Discovers, Protects & Maps Your SME Data</h2>
            <p style="font-size: 13px; color: var(--text-muted); margin: 4px 0 0 0;">
                Visual interactive graph: from heterogeneous enterprise & informal data connectors to verifiable DPDP Act 2023 compliance.
            </p>
        </div>
        <div style="display: flex; gap: 10px; align-items: center; flex-wrap: wrap;">
            <!-- View Selector Tabs -->
            <div style="display: inline-flex; background: rgba(0,0,0,0.4); border: 1px solid var(--border-color); border-radius: 8px; padding: 3px; gap: 4px;">
                <button id="tabViewTopology" class="view-switch-btn active" onclick="switchDiscoveryView('topology')" style="background: #4f46e5; color: #ffffff; border: none; padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                    <span>🌐</span> Topology Map
                </button>
                <button id="tabViewLifecycle" class="view-switch-btn" onclick="switchDiscoveryView('lifecycle')" style="background: transparent; color: var(--text-muted); border: none; padding: 6px 12px; border-radius: 6px; font-size: 11px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 6px;">
                    <span>🔄</span> Discovery Decision Lifecycle
                </button>
            </div>
            <!-- Pipeline Filter Buttons (active for topology view) -->
            <div id="topologyFilterGroup" style="display: flex; gap: 6px;">
                <button class="graph-filter-btn active" data-flow="ALL" style="background: rgba(255,255,255,0.1); border: 1px solid var(--border-color); color: var(--text-main); padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">All Pipelines</button>
                <button class="graph-filter-btn" data-flow="DB" style="background: transparent; border: 1px solid var(--border-color); color: #60a5fa; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Claims & Policy DBs</button>
                <button class="graph-filter-btn" data-flow="FILES" style="background: transparent; border: 1px solid var(--border-color); color: #fbbf24; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Files, PDFs & Cloud</button>
                <button class="graph-filter-btn" data-flow="GOV" style="background: transparent; border: 1px solid var(--border-color); color: #34d399; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Governance & Locks</button>
            </div>
        </div>
    </div>

    <!-- Interactive SVG Architecture Topology Graph -->
    <div style="overflow-x: auto; padding: 8px 0;">
        <svg id="architectureGraph" viewBox="0 0 1120 340" style="width: 100%; min-width: 980px; height: auto;" xmlns="http://www.w3.org/2000/svg">
            <defs>
                <linearGradient id="gBlue" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#1e3a8a" stop-opacity="0.9"/>
                    <stop offset="100%" stop-color="#3b82f6" stop-opacity="0.3"/>
                </linearGradient>
                <linearGradient id="gPurple" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#581c87" stop-opacity="0.9"/>
                    <stop offset="100%" stop-color="#a855f7" stop-opacity="0.3"/>
                </linearGradient>
                <linearGradient id="gAmber" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#78350f" stop-opacity="0.9"/>
                    <stop offset="100%" stop-color="#f59e0b" stop-opacity="0.3"/>
                </linearGradient>
                <linearGradient id="gGreen" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#064e3b" stop-opacity="0.9"/>
                    <stop offset="100%" stop-color="#10b981" stop-opacity="0.3"/>
                </linearGradient>
                <linearGradient id="gRed" x1="0%" y1="0%" x2="100%" y2="100%">
                    <stop offset="0%" stop-color="#7f1d1d" stop-opacity="0.9"/>
                    <stop offset="100%" stop-color="#ef4444" stop-opacity="0.3"/>
                </linearGradient>

                <filter id="glow" x="-20%" y="-20%" width="140%" height="140%">
                    <feGaussianBlur stdDeviation="4" result="blur" />
                    <feComposite in="SourceGraphic" in2="blur" operator="over" />
                </filter>
            </defs>

            <!-- CONNECTOR FLOW PATHS (Curved Animated SVG Paths) -->
            <!-- Stage 1 -> Stage 2 -->
            <path class="flow-line flow-db" d="M 230 50 C 300 50, 300 160, 380 160" stroke="#3b82f6" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.75"/>
            <path class="flow-line flow-db" d="M 230 110 C 300 110, 300 160, 380 160" stroke="#3b82f6" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.75"/>
            <path class="flow-line flow-files" d="M 230 170 C 300 170, 300 170, 380 170" stroke="#f59e0b" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.75"/>
            <path class="flow-line flow-files" d="M 230 230 C 300 230, 300 180, 380 180" stroke="#f59e0b" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.75"/>
            <path class="flow-line flow-files" d="M 230 290 C 300 290, 300 180, 380 180" stroke="#06b6d4" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.75"/>

            <!-- Stage 2 -> Stage 3 (Air-Gapped to Indian PII Engine) -->
            <path class="flow-line" d="M 490 170 L 570 170" stroke="#10b981" stroke-width="2.5" fill="none" marker-end="url(#arrow)"/>

            <!-- Stage 3 -> Stage 4 (PII Engine to Governance & Statutory Dual-Track) -->
            <path class="flow-line flow-gov" d="M 700 140 C 760 140, 760 80, 830 80" stroke="#a855f7" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.8"/>
            <path class="flow-line flow-gov" d="M 700 170 C 760 170, 760 170, 830 170" stroke="#10b981" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.8"/>
            <path class="flow-line flow-gov" d="M 700 200 C 760 200, 760 260, 830 260" stroke="#ef4444" stroke-width="2" fill="none" stroke-dasharray="4,4" opacity="0.8"/>

            <!-- Stage 4 -> Stage 5 (Trust & SHA-256 Merkle Ledger) -->
            <path class="flow-line" d="M 970 80 C 1010 80, 1010 160, 1040 160" stroke="#3b82f6" stroke-width="2" fill="none" opacity="0.7"/>
            <path class="flow-line" d="M 970 170 L 1040 170" stroke="#10b981" stroke-width="2" fill="none" opacity="0.7"/>
            <path class="flow-line" d="M 970 260 C 1010 260, 1010 180, 1040 180" stroke="#ef4444" stroke-width="2" fill="none" opacity="0.7"/>

            <!-- COLUMN 1: CONNECTORS & SOURCES -->
            <!-- Claims DB Node -->
            <g class="graph-node" data-node="CLAIMS_DB" style="cursor: pointer;">
                <rect x="20" y="25" width="210" height="50" rx="8" fill="url(#gBlue)" stroke="#3b82f6" stroke-width="1.5"/>
                <circle cx="40" cy="50" r="10" fill="#3b82f6" fill-opacity="0.3"/>
                <text x="40" y="54" font-size="11" text-anchor="middle" fill="#60a5fa">&#128450;</text>
                <text x="60" y="44" fill="#ffffff" font-size="12" font-weight="700">Claims Database</text>
                <text x="60" y="60" fill="#94a3b8" font-size="10">claims &bull; policyholders &bull; med_hist</text>
            </g>

            <!-- Policy Admin DB Node -->
            <g class="graph-node" data-node="POLICY_ADMIN_DB" style="cursor: pointer;">
                <rect x="20" y="85" width="210" height="50" rx="8" fill="url(#gBlue)" stroke="#3b82f6" stroke-width="1.5"/>
                <circle cx="40" cy="110" r="10" fill="#3b82f6" fill-opacity="0.3"/>
                <text x="40" y="114" font-size="11" text-anchor="middle" fill="#60a5fa">&#128737;</text>
                <text x="60" y="104" fill="#ffffff" font-size="12" font-weight="700">Policy Administration DB</text>
                <text x="60" y="120" fill="#94a3b8" font-size="10">customers &bull; policies &bull; nominees</text>
            </g>

            <!-- Excel Files Node -->
            <g class="graph-node" data-node="EXCEL_FILES" style="cursor: pointer;">
                <rect x="20" y="145" width="210" height="50" rx="8" fill="url(#gAmber)" stroke="#f59e0b" stroke-width="1.5"/>
                <circle cx="40" cy="170" r="10" fill="#f59e0b" fill-opacity="0.3"/>
                <text x="40" y="174" font-size="11" text-anchor="middle" fill="#fbbf24">&#128202;</text>
                <text x="60" y="164" fill="#ffffff" font-size="12" font-weight="700">Excel Files & Spreadsheets</text>
                <text x="60" y="180" fill="#94a3b8" font-size="10">agent_payouts &bull; tpa_net &bull; leads</text>
            </g>

            <!-- PDFs & Reports Node -->
            <g class="graph-node" data-node="PDFS" style="cursor: pointer;">
                <rect x="20" y="205" width="210" height="50" rx="8" fill="url(#gRed)" stroke="#ef4444" stroke-width="1.5"/>
                <circle cx="40" cy="230" r="10" fill="#ef4444" fill-opacity="0.3"/>
                <text x="40" y="234" font-size="11" text-anchor="middle" fill="#f87171">&#128196;</text>
                <text x="60" y="224" fill="#ffffff" font-size="12" font-weight="700">PDFs & Diagnostic Reports</text>
                <text x="60" y="240" fill="#94a3b8" font-size="10">blood_panels &bull; discharge &bull; kyc</text>
            </g>

            <!-- Cloud Storage & Docs Node -->
            <g class="graph-node" data-node="CLOUD_STORAGE" style="cursor: pointer;">
                <rect x="20" y="265" width="210" height="50" rx="8" fill="url(#gPurple)" stroke="#06b6d4" stroke-width="1.5"/>
                <circle cx="40" cy="290" r="10" fill="#06b6d4" fill-opacity="0.3"/>
                <text x="40" y="294" font-size="11" text-anchor="middle" fill="#38bdf8">&#9729;</text>
                <text x="60" y="284" fill="#ffffff" font-size="12" font-weight="700">Cloud Storage & Docs</text>
                <text x="60" y="300" fill="#94a3b8" font-size="10">s3://vault &bull; gcs://claims &bull; .docx</text>
            </g>

            <!-- COLUMN 2: AIR-GAPPED ISOLATION PIPELINE -->
            <g class="graph-node" data-node="AIR_GAPPED_PIPELINE" style="cursor: pointer;">
                <rect x="370" y="105" width="130" height="130" rx="12" fill="rgba(15, 23, 42, 0.95)" stroke="#10b981" stroke-width="2" filter="url(#glow)"/>
                <circle cx="435" cy="140" r="18" fill="#10b981" fill-opacity="0.2"/>
                <text x="435" y="146" font-size="18" text-anchor="middle" fill="#10b981">&#128274;</text>
                <text x="435" y="174" fill="#ffffff" font-size="11" font-weight="800" text-anchor="middle">AIR-GAPPED</text>
                <text x="435" y="190" fill="#34d399" font-size="10" font-weight="700" text-anchor="middle">INGESTION</text>
                <text x="435" y="210" fill="#94a3b8" font-size="9" text-anchor="middle">0 Cloud Egress</text>
                <text x="435" y="222" fill="#94a3b8" font-size="8" text-anchor="middle">CSV Injection Safe</text>
            </g>

            <!-- COLUMN 3: DETERMINISTIC INDIAN PII ENGINE -->
            <g class="graph-node" data-node="PII_ENGINE" style="cursor: pointer;">
                <rect x="560" y="90" width="150" height="160" rx="12" fill="rgba(30, 27, 75, 0.95)" stroke="#6366f1" stroke-width="2" filter="url(#glow)"/>
                <circle cx="635" cy="125" r="18" fill="#6366f1" fill-opacity="0.2"/>
                <text x="635" y="131" font-size="16" text-anchor="middle" fill="#a5b4fc">&#9881;</text>
                <text x="635" y="158" fill="#ffffff" font-size="12" font-weight="800" text-anchor="middle">INDIAN PII ENGINE</text>
                <text x="635" y="176" fill="#f87171" font-size="9" font-weight="700" text-anchor="middle">&bull; Verhoeff Aadhaar D5</text>
                <text x="635" y="192" fill="#fbbf24" font-size="9" font-weight="700" text-anchor="middle">&bull; PAN 4th Char P Entity</text>
                <text x="635" y="208" fill="#fb7185" font-size="9" font-weight="700" text-anchor="middle">&bull; Sec 2(t) Clinical Health</text>
                <text x="635" y="224" fill="#818cf8" font-size="9" font-weight="700" text-anchor="middle">&bull; Phone (+91) & UPI VPA</text>
                <text x="635" y="238" fill="#34d399" font-size="8" text-anchor="middle">Zero False Positives</text>
            </g>

            <!-- COLUMN 4: GOVERNANCE & STATUTORY DUAL-TRACK RESOLVER -->
            <!-- RoPA Node -->
            <g class="graph-node" data-node="ROPA_REGISTER" style="cursor: pointer;">
                <rect x="820" y="55" width="160" height="55" rx="8" fill="url(#gPurple)" stroke="#a855f7" stroke-width="1.5"/>
                <text x="835" y="76" fill="#ffffff" font-size="12" font-weight="700">Section 8(4) RoPA</text>
                <text x="835" y="94" fill="#cbd5e1" font-size="10">Auto Purpose Binding</text>
                <circle cx="960" cy="82" r="8" fill="#a855f7" fill-opacity="0.3"/>
                <text x="960" y="86" font-size="10" text-anchor="middle" fill="#e9d5ff">&#10003;</text>
            </g>

            <!-- Multilingual Consent Node -->
            <g class="graph-node" data-node="CONSENT_GATEWAY" style="cursor: pointer;">
                <rect x="820" y="145" width="160" height="55" rx="8" fill="url(#gGreen)" stroke="#10b981" stroke-width="1.5"/>
                <text x="835" y="166" fill="#ffffff" font-size="12" font-weight="700">Multilingual Consent</text>
                <text x="835" y="184" fill="#cbd5e1" font-size="10">8 Indian Languages (Sec 5)</text>
                <circle cx="960" cy="172" r="8" fill="#10b981" fill-opacity="0.3"/>
                <text x="960" y="176" font-size="10" text-anchor="middle" fill="#a7f3d0">&#10003;</text>
            </g>

            <!-- Dual-Track Tax Collision Shield -->
            <g class="graph-node" data-node="COLLISION_RESOLVER" style="cursor: pointer;">
                <rect x="820" y="235" width="160" height="55" rx="8" fill="url(#gRed)" stroke="#ef4444" stroke-width="1.5"/>
                <text x="835" y="254" fill="#ffffff" font-size="11" font-weight="800">CGST Sec 36 Tax Lock</text>
                <text x="835" y="272" fill="#cbd5e1" font-size="9">72-Mo Lock vs DPBI Erasure</text>
                <circle cx="960" cy="262" r="8" fill="#ef4444" fill-opacity="0.3"/>
                <text x="960" y="266" font-size="10" text-anchor="middle" fill="#fecaca">&#9878;</text>
            </g>

            <!-- COLUMN 5: CRYPTOGRAPHIC MERKLE AUDIT LEDGER -->
            <g class="graph-node" data-node="MERKLE_AUDIT" style="cursor: pointer;">
                <rect x="1030" y="125" width="75" height="90" rx="8" fill="rgba(15, 23, 42, 0.95)" stroke="#3b82f6" stroke-width="1.5"/>
