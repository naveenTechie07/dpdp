<%- include('partials/header') %>

<!-- Top Discovery Metrics -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">INFORMAL REPOSITORIES</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= (typeof silos !== 'undefined' && silos) ? silos.length : 3 %> <span style="font-size: 12px; font-weight: 400; color: var(--success);">&#9679; Active</span></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">DISCOVERED INDIAN PII</span>
            <h2 class="metric-value" id="tickerRecords" style="margin-top: 8px; color: var(--warning);"><%= (typeof stats !== 'undefined' && stats.totalPiiCount) ? stats.totalPiiCount.toLocaleString() : '1,420' %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">AADHAAR TOKENS (D5 VALID)</span>
            <h2 class="metric-value" id="tickerAadhaar" style="margin-top: 8px; color: #f87171;">18</h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">SECTION 2(t) HEALTH DATA</span>
            <h2 class="metric-value" id="tickerHealth" style="margin-top: 8px; color: #fb7185;">24</h2>
        </div>
    </div>
</div>

<!-- Header with 1-Click Fast Track Button -->
<div class="dashboard-header mb-4" style="align-items: center; justify-content: space-between;">
    <div class="title-group">
        <h1>Data Discovery & PII Scanner Studio</h1>
        <p>100% Offline-first detection for informal systems (WhatsApp chats, Lead spreadsheets, Tally exports) under DPDP Act 2023.</p>
    </div>
    <div style="display: flex; gap: 12px;">
        <button id="btnScanSample" class="btn-primary" style="background: linear-gradient(135deg, #6366f1 0%, #4f46e5 100%); color: white; border: none; padding: 10px 20px; border-radius: 8px; font-weight: 700; cursor: pointer; display: flex; align-items: center; gap: 8px; box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);">
            <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2.5" fill="none"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
            ⚡ Scan Pre-Loaded Aarogya Clinic Files
        </button>
    </div>
</div>

<!-- Progress Bar Indicator -->
<div id="scanProgressContainer" class="card mb-4 p-4" style="display: none; background: rgba(17, 24, 39, 0.85); border: 1px solid var(--primary);">
    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
        <span id="scanStatusText" style="font-size: 13px; font-weight: 600; color: var(--text-main);">Scanning data silos...</span>
        <span style="font-size: 12px; color: var(--text-muted);">Zero Cloud Egress Guaranteed</span>
    </div>
    <div style="width: 100%; height: 6px; background: rgba(255,255,255,0.1); border-radius: 3px; overflow: hidden;">
        <div id="scanProgressBar" style="width: 0%; height: 100%; background: linear-gradient(90deg, #6366f1, #10b981); transition: width 0.3s ease;"></div>
    </div>
</div>

<!-- Connector Overview Grid (4 Cards) -->
<div class="metrics-grid mb-4" style="grid-template-columns: repeat(4, 1fr);">
    <div class="card p-4" style="border-top: 3px solid #ef4444;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #f87171; font-size: 10px; font-weight: 700;">WHATSAPP EXPORTS</span>
                <h3 style="font-size: 14px; margin-top: 8px; font-weight: 600;">Reception WhatsApp Backup</h3>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;"><code>clinic_reception_chat.txt</code></p>
            </div>
            <span style="color: #ef4444; font-size: 10px; font-weight: 700;">CRITICAL RISK</span>
        </div>
        <div style="margin-top: 14px; font-size: 12px; color: var(--text-muted); display: flex; justify-content: space-between;">
            <span>840 PII findings</span>
            <span style="color: var(--success);">&#10003; Verhoeff Aadhaar</span>
        </div>
    </div>

    <div class="card p-4" style="border-top: 3px solid #f59e0b;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; font-size: 10px; font-weight: 700;">SPREADSHEETS</span>
                <h3 style="font-size: 14px; margin-top: 8px; font-weight: 600;">Customer Leads Tracker</h3>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;"><code>customer_leads.csv</code></p>
            </div>
            <span style="color: #fbbf24; font-size: 10px; font-weight: 700;">HIGH RISK</span>
        </div>
        <div style="margin-top: 14px; font-size: 12px; color: var(--text-muted); display: flex; justify-content: space-between;">
            <span>420 PII findings</span>
            <span style="color: var(--success);">&#10003; PAN Entity Filter</span>
        </div>
    </div>

    <div class="card p-4" style="border-top: 3px solid #10b981;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <span class="badge" style="background: rgba(16, 185, 129, 0.15); color: #34d399; font-size: 10px; font-weight: 700;">BILLING SYSTEM</span>
                <h3 style="font-size: 14px; margin-top: 8px; font-weight: 600;">Tally Invoices & Billing</h3>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;"><code>invoices_billing.csv</code></p>
            </div>
            <span style="color: #34d399; font-size: 10px; font-weight: 700;">STATUTORY TAX</span>
        </div>
        <div style="margin-top: 14px; font-size: 12px; color: var(--text-muted); display: flex; justify-content: space-between;">
            <span>160 PII findings</span>
            <span style="color: #34d399;">CGST Sec 36 Lock</span>
        </div>
    </div>

    <div class="card p-4" style="border-top: 3px solid #6366f1;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start;">
            <div>
                <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 10px; font-weight: 700;">LOCAL STORAGE</span>
                <h3 style="font-size: 14px; margin-top: 8px; font-weight: 600;">Desktop Reception PC</h3>
                <p style="font-size: 11px; color: var(--text-muted); margin-top: 4px;">Lab Requisitions & Reports</p>
            </div>
            <span style="color: #818cf8; font-size: 10px; font-weight: 700;">ON-PREMISE</span>
        </div>
        <div style="margin-top: 14px; font-size: 12px; color: var(--text-muted); display: flex; justify-content: space-between;">
            <span>Air-Gapped Vault</span>
            <span style="color: var(--success);">&#10003; 0 Cloud Egress</span>
        </div>
    </div>
</div>

<!-- Drag & Drop Upload Zone -->
<div class="card mb-4 p-4">
    <div id="siloDropzone" style="border: 2px dashed var(--border-color); border-radius: 8px; padding: 28px; text-align: center; cursor: pointer; transition: all 0.2s ease;">
        <input type="file" id="siloFileInput" style="display: none;" accept=".txt,.csv,.xlsx">
        <svg viewBox="0 0 24 24" width="36" height="36" stroke="var(--primary)" stroke-width="1.5" fill="none" style="margin-bottom: 8px;"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path><polyline points="17 8 12 3 7 8"></polyline><line x1="12" y1="3" x2="12" y2="15"></line></svg>
        <h4 style="font-size: 14px; font-weight: 600; color: var(--text-main);">Drop your informal files here, or <span style="color: var(--primary);">browse</span></h4>
        <p style="font-size: 12px; color: var(--text-muted); margin-top: 4px;">Supports WhatsApp Chat Exports (.txt), Spreadsheets (.csv, .xlsx) up to 10MB. Protected against CSV Formula Injection.</p>
    </div>
</div>

<!-- Interactive Findings Table & Radar -->
<div class="card p-0" style="overflow: hidden;">
    <!-- Filter Tabs Header -->
    <div class="table-tabs" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
        <div style="display: flex; gap: 12px; align-items: center;">
            <span style="font-size: 13px; font-weight: 700; color: var(--text-main); margin-right: 8px;">Filter Findings:</span>
            <button class="discovery-filter-tab active" data-filter="ALL" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); color: var(--text-main); padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">All Findings</button>
            <button class="discovery-filter-tab" data-filter="HEALTH" style="background: transparent; border: 1px solid var(--border-color); color: #fb7185; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">Critical Health</button>
            <button class="discovery-filter-tab" data-filter="AADHAAR" style="background: transparent; border: 1px solid var(--border-color); color: #f87171; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">Aadhaar & KYC</button>
            <button class="discovery-filter-tab" data-filter="PAN" style="background: transparent; border: 1px solid var(--border-color); color: #fbbf24; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">PAN Cards</button>
            <button class="discovery-filter-tab" data-filter="UPI" style="background: transparent; border: 1px solid var(--border-color); color: #818cf8; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">Financial / UPI</button>
            <button class="discovery-filter-tab" data-filter="PHONE" style="background: transparent; border: 1px solid var(--border-color); color: #60a5fa; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">Contacts</button>
        </div>
        <div>
            <span id="findingsCountBadge" class="badge" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; padding: 6px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">
                <%= (typeof findings !== 'undefined' && findings) ? findings.length : 5 %> findings
            </span>
        </div>
    </div>

    <!-- Data Table -->
    <div style="overflow-x: auto;">
        <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                    <th style="padding: 12px 20px; font-weight: 600;">Source Silo</th>
                    <th style="padding: 12px 20px; font-weight: 600;">Data Principal / Entity</th>
                    <th style="padding: 12px 20px; font-weight: 600;">PII Type</th>
                    <th style="padding: 12px 20px; font-weight: 600;">Masked Value</th>
                    <th style="padding: 12px 20px; font-weight: 600;">Verification Proof</th>
                    <th style="padding: 12px 20px; font-weight: 600;">Sensitivity</th>
                </tr>
            </thead>
            <tbody id="findingsTableBody" style="font-size: 13px;">
                <% if (typeof findings !== 'undefined' && findings && findings.length > 0) { %>
                    <% findings.slice(0, 30).forEach(function(f) { %>
                        <tr style="border-bottom: 1px solid var(--border-color);" data-category="<%= (f.piiType || '').toUpperCase() %>">
                            <td style="padding: 14px 20px; font-size: 12px; font-weight: 600; color: var(--text-main);"><%= f.siloName || f.source || 'clinic_reception_chat.txt' %></td>
                            <td style="padding: 14px 20px; font-size: 12px; color: var(--text-muted);"><%= f.entityName || 'Aarogya Patient' %></td>
                            <td style="padding: 14px 20px;">
                                <% if (f.piiType === 'AADHAAR') { %>
                                    <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #f87171; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">AADHAAR</span>
                                <% } else if (f.piiType && f.piiType.includes('PAN')) { %>
                                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;"><%= f.piiType %></span>
                                <% } else if (f.piiType && (f.piiType.includes('HEALTH') || f.piiType.includes('CLINICAL'))) { %>
                                    <span class="badge" style="background: rgba(225, 29, 72, 0.15); color: #fb7185; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">CLINICAL HEALTH</span>
                                <% } else if (f.piiType === 'UPI') { %>
                                    <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">FINANCIAL UPI</span>
                                <% } else { %>
                                    <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">CONTACT PHONE</span>
                                <% } %>
                            </td>
                            <td style="padding: 14px 20px; font-family: monospace; font-size: 12px; color: var(--text-main);"><%= f.maskedValue %></td>
                            <td style="padding: 14px 20px; font-size: 11px; color: var(--success);">&#10003; <%= f.piiType === 'AADHAAR' ? 'Verhoeff D5 Valid' : f.piiType.includes('PAN') ? 'Entity Char P Valid' : 'Lexicon Sec 2(t)' %></td>
                            <td style="padding: 14px 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: <%= f.piiType === 'AADHAAR' || f.piiType.includes('HEALTH') ? '#f87171' : '#fbbf24' %>;">
                                <%= f.piiType === 'AADHAAR' || f.piiType.includes('HEALTH') ? 'CRITICAL' : 'HIGH' %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" data-category="AADHAAR">
                        <td style="padding: 14px 20px; font-size: 12px; font-weight: 600; color: var(--text-main);">clinic_reception_chat.txt</td>
                        <td style="padding: 14px 20px; font-size: 12px; color: var(--text-muted);">Ramesh Sharma</td>
                        <td style="padding: 14px 20px;"><span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #f87171; font-size: 11px; font-weight: 700; padding: 4px 10px; border-radius: 12px;">AADHAAR</span></td>
                        <td style="padding: 14px 20px; font-family: monospace; font-size: 12px; color: var(--text-main);">XXXX-XXXX-2345</td>
                        <td style="padding: 14px 20px; font-size: 11px; color: var(--success);">&#10003; Verhoeff D5 Valid</td>
                        <td style="padding: 14px 20px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: #f87171;">CRITICAL</td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Table Footer with Section 8 Action Link -->
    <div style="padding: 16px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.15);">
        <span style="font-size: 12px; color: var(--text-muted);">Findings automatically synthesize into Section 8(4) RoPA Register.</span>
        <a href="/inventory/ropa" style="background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid var(--border-color); padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px;">
            View Section 8(4) RoPA Register &rarr;
        </a>
    </div>
</div>

<script src="/js/discoveryScanner.js"></script>
<%- include('partials/footer') %>
