<div class="card p-0" style="overflow: hidden; border: 1px solid var(--border-color);">
    <!-- Filter Tabs Header -->
    <div class="table-tabs" style="padding: 16px 20px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; background: rgba(0,0,0,0.2);">
        <div style="display: flex; gap: 8px; align-items: center; flex-wrap: wrap;">
            <span style="font-size: 12px; font-weight: 700; color: var(--text-main); margin-right: 4px;">Filter Source:</span>
            <button class="discovery-filter-tab active" data-filter="ALL" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); color: var(--text-main); padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">All Sources</button>
            <button class="discovery-filter-tab" data-filter="CLAIMS" style="background: transparent; border: 1px solid var(--border-color); color: #60a5fa; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Claims DB</button>
            <button class="discovery-filter-tab" data-filter="POLICY" style="background: transparent; border: 1px solid var(--border-color); color: #fbbf24; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Policy Admin</button>
            <button class="discovery-filter-tab" data-filter="SPREADSHEET" style="background: transparent; border: 1px solid var(--border-color); color: #34d399; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Excel Files</button>
            <button class="discovery-filter-tab" data-filter="PDF" style="background: transparent; border: 1px solid var(--border-color); color: #f87171; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">PDFs</button>
            <button class="discovery-filter-tab" data-filter="DOC" style="background: transparent; border: 1px solid var(--border-color); color: #a78bfa; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Documents</button>
            <button class="discovery-filter-tab" data-filter="CLOUD" style="background: transparent; border: 1px solid var(--border-color); color: #67e8f9; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">Cloud Storage</button>
            <button class="discovery-filter-tab" data-filter="WHATSAPP" style="background: transparent; border: 1px solid var(--border-color); color: #ef4444; padding: 5px 12px; border-radius: 6px; font-size: 11px; font-weight: 600; cursor: pointer;">WhatsApp Chat</button>
        </div>
        <div style="display: flex; gap: 10px; align-items: center;">
            <input type="text" id="findingsSearchInput" placeholder="Search entity, PII value..." style="background: rgba(255,255,255,0.06); border: 1px solid var(--border-color); color: var(--text-main); padding: 5px 12px; border-radius: 6px; font-size: 12px; width: 200px;">
            <span id="findingsCountBadge" class="badge" style="background: rgba(99, 102, 241, 0.2); color: #a5b4fc; padding: 6px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">
                <%= (typeof findings !== 'undefined' && findings) ? findings.length : 21 %> findings
            </span>
        </div>
    </div>

    <!-- Data Table -->
    <div style="overflow-x: auto;">
        <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
            <thead>
                <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                    <th style="padding: 12px 18px; font-weight: 600;">Source Connector / Silo</th>
                    <th style="padding: 12px 18px; font-weight: 600;">Data Principal / Entity</th>
                    <th style="padding: 12px 18px; font-weight: 600;">PII Type</th>
                    <th style="padding: 12px 18px; font-weight: 600;">Masked Value</th>
                    <th style="padding: 12px 18px; font-weight: 600;">Verification Proof</th>
                    <th style="padding: 12px 18px; font-weight: 600;">Statutory Risk</th>
                </tr>
            </thead>
            <tbody id="findingsTableBody" style="font-size: 13px;">
                <% if (typeof findings !== 'undefined' && findings && findings.length > 0) { %>
                    <% findings.forEach(function(f) { %>
                        <tr style="border-bottom: 1px solid var(--border-color);" data-category="<%= (f.piiType || '').toUpperCase() %>" data-silo="<%= (f.siloId || f.siloName || '').toUpperCase() %>">
                            <td style="padding: 12px 18px; font-size: 12px; font-weight: 600; color: var(--text-main);">
                                <span style="color: #60a5fa;">&#128450;</span> <%= f.siloName || f.source || 'Claims Database' %>
                            </td>
                            <td style="padding: 12px 18px; font-size: 12px; color: var(--text-muted);"><%= f.entityName || 'Aarogya Patient' %></td>
                            <td style="padding: 12px 18px;">
                                <% const pType = (f.piiType || '').toUpperCase(); %>
                                <% if (pType === 'AADHAAR') { %>
                                    <span class="badge" style="background: rgba(239, 68, 68, 0.15); color: #f87171; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">AADHAAR</span>
                                <% } else if (pType.includes('PAN')) { %>
                                    <span class="badge" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">INDIVIDUAL PAN</span>
                                <% } else if (pType.includes('HEALTH') || pType.includes('CLINICAL') || pType.includes('DIAGNOSTIC')) { %>
                                    <span class="badge" style="background: rgba(225, 29, 72, 0.15); color: #fb7185; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">HEALTH SEC 2(t)</span>
                                <% } else if (pType === 'UPI_VPA' || pType === 'UPI') { %>
                                    <span class="badge" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">FINANCIAL UPI</span>
                                <% } else { %>
                                    <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa; font-size: 11px; font-weight: 700; padding: 3px 8px; border-radius: 6px;">CONTACT PHONE</span>
                                <% } %>
                            </td>
                            <td style="padding: 12px 18px; font-family: monospace; font-size: 12px; color: var(--text-main);"><%= f.maskedValue %></td>
                            <td style="padding: 12px 18px; font-size: 11px; color: var(--success);">
                                &#10003; <%= pType === 'AADHAAR' ? 'Verhoeff D5 Valid' : pType.includes('PAN') ? 'Entity Char P Valid' : pType.includes('HEALTH') ? 'Lexicon Sec 2(t)' : 'E.164 / VPA Valid' %>
                            </td>
                            <td style="padding: 12px 18px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: <%= pType === 'AADHAAR' || pType.includes('HEALTH') ? '#f87171' : '#fbbf24' %>;">
                                <%= pType === 'AADHAAR' || pType.includes('HEALTH') ? 'CRITICAL' : 'HIGH' %>
                            </td>
                        </tr>
                    <% }); %>
                <% } else { %>
                    <tr style="border-bottom: 1px solid var(--border-color);">
                        <td colspan="6" style="padding: 32px; text-align: center; color: var(--text-muted);">
                            No PII findings detected yet. Click "⚡ Scan All Connectors" to run full discovery across all 7 sources.
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <!-- Table Footer with Section 8 Action Link -->
    <div style="padding: 14px 20px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.15);">
        <span style="font-size: 12px; color: var(--text-muted);">All findings are mapped directly into Section 8(4) RoPA Register with lawful basis tagging.</span>
        <a href="/inventory/ropa" style="background: rgba(255,255,255,0.06); color: var(--text-main); border: 1px solid var(--border-color); padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; text-decoration: none; display: flex; align-items: center; gap: 6px;">
            Open Section 8(4) RoPA Register &rarr;
        </a>
    </div>
</div>

<!-- ========================================== -->
<!-- 5. SCHEMA & LIVE RECORDS INSPECTOR MODAL -->
<!-- ========================================== -->
<div id="schemaModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
    <div class="card p-0" style="width: 100%; max-width: 820px; max-height: 85vh; display: flex; flex-direction: column; background: #0f172a; border: 1px solid var(--border-color); box-shadow: 0 20px 48px rgba(0,0,0,0.8); border-radius: 12px; overflow: hidden;">
        <!-- Modal Header -->
        <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.3);">
            <div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <span id="modalConnectorBadge" class="badge" style="background: rgba(59, 130, 246, 0.2); color: #93c5fd; font-size: 10px; font-weight: 700;">CLAIMS DATABASE</span>
                    <h3 id="modalTableTitle" style="font-size: 16px; font-weight: 800; color: #ffffff; margin: 0;">claims (Table Schema & Sample Data)</h3>
                </div>
                <p id="modalTableDesc" style="font-size: 12px; color: var(--text-muted); margin: 4px 0 0 0;">Table metadata and masked sample rows.</p>
            </div>
            <button onclick="closeSchemaModal()" style="background: transparent; border: none; color: var(--text-muted); font-size: 20px; cursor: pointer;">&times;</button>
        </div>

        <!-- Tabs -->
        <div style="padding: 10px 24px; border-bottom: 1px solid var(--border-color); display: flex; gap: 12px; background: rgba(0,0,0,0.15);">
            <button id="tabBtnSchema" class="btn-schema-tab active" onclick="switchModalTab('schema')" style="background: rgba(255,255,255,0.08); border: 1px solid var(--border-color); color: #ffffff; padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">Column Schema & PII Rules</button>
            <button id="tabBtnRows" class="btn-schema-tab" onclick="switchModalTab('rows')" style="background: transparent; border: 1px solid var(--border-color); color: var(--text-muted); padding: 6px 14px; border-radius: 6px; font-size: 12px; font-weight: 600; cursor: pointer;">Live Masked Records Sample</button>
        </div>

        <!-- Modal Body -->
        <div style="padding: 20px 24px; overflow-y: auto; flex: 1;">
            <!-- Tab 1: Column Schema Table -->
            <div id="modalSchemaTab">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;">
                    <thead>
                        <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-muted); font-size: 11px; text-transform: uppercase;">
                            <th style="padding: 8px 12px;">Column Name</th>
                            <th style="padding: 8px 12px;">Data Type</th>
                            <th style="padding: 8px 12px;">PII Classification</th>
                            <th style="padding: 8px 12px;">Detection Rule</th>
                            <th style="padding: 8px 12px;">Sample Value</th>
                        </tr>
                    </thead>
                    <tbody id="modalColumnsBody">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>

            <!-- Tab 2: Sample Rows Table -->
            <div id="modalRowsTab" style="display: none; overflow-x: auto;">
                <table style="width: 100%; border-collapse: collapse; text-align: left; font-size: 12px;">
                    <thead id="modalRowsHead">
                        <!-- Populated by JavaScript -->
                    </thead>
                    <tbody id="modalRowsBody">
                        <!-- Populated by JavaScript -->
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Modal Footer -->
        <div style="padding: 14px 24px; border-top: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.3);">
            <span style="font-size: 11px; color: var(--text-muted);">&#10003; 100% On-Premise Air-Gapped Simulation</span>
            <div style="display: flex; gap: 8px;">
                <button onclick="closeSchemaModal()" class="btn-secondary" style="padding: 6px 14px; font-size: 12px;">Close</button>
                <button id="btnModalScanTable" class="btn-primary" style="padding: 6px 16px; font-size: 12px;">Scan This Table Now</button>
            </div>
        </div>
    </div>
</div>

<!-- ========================================== -->
<!-- 6. ADD DATA CONNECTOR MODAL -->
<!-- ========================================== -->
<div id="newConnectorModal" style="display: none; position: fixed; inset: 0; background: rgba(0,0,0,0.75); backdrop-filter: blur(4px); z-index: 1000; align-items: center; justify-content: center; padding: 20px;">
    <div class="card p-0" style="width: 100%; max-width: 560px; background: #0f172a; border: 1px solid var(--border-color); box-shadow: 0 20px 48px rgba(0,0,0,0.8); border-radius: 12px; overflow: hidden; position: relative;">
        <div style="padding: 18px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: rgba(0,0,0,0.3);">
            <div>
                <h3 style="font-size: 16px; font-weight: 800; color: #ffffff; margin: 0;">Connect New Data Source</h3>
                <p style="font-size: 12px; color: var(--text-muted); margin: 2px 0 0 0;">Add an enterprise database, cloud bucket, or local folder.</p>
            </div>
            <button type="button" id="btnCloseNewConnector" onclick="document.getElementById('newConnectorModal').style.display='none'; if(typeof closeNewConnectorModal==='function')closeNewConnectorModal();" style="background: transparent; border: none; color: var(--text-muted); font-size: 24px; cursor: pointer; padding: 4px 8px; line-height: 1;">&times;</button>
        </div>
        <form id="newConnectorForm" onsubmit="handleCreateConnector(event)" style="padding: 20px 24px;">
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">CONNECTOR TYPE</label>
                <select id="connTypeSelect" style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #ffffff; padding: 8px 12px; border-radius: 6px; font-size: 13px;">
                    <option value="SQL_DATABASE">Enterprise SQL Database (PostgreSQL / MySQL / Oracle / SQLite)</option>
                    <option value="CLOUD_STORAGE">Cloud Storage Bucket (AWS S3 / Google Cloud Storage / Azure Blob)</option>
                    <option value="FILE_SYSTEM">Local Network Folder / NAS Share (Spreadsheets & Documents)</option>
                </select>
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">CONNECTOR DISPLAY NAME</label>
                <input type="text" id="connNameInput" placeholder="e.g., TPA Cashless Settlement Gateway" required style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #ffffff; padding: 8px 12px; border-radius: 6px; font-size: 13px;">
            </div>
            <div style="margin-bottom: 14px;">
                <label style="display: block; font-size: 11px; font-weight: 600; color: var(--text-muted); margin-bottom: 6px;">CONNECTION URI / FILE PATH</label>
                <input type="text" id="connUriInput" placeholder="e.g., postgresql://claims-read.internal:5432/claims_db" required style="width: 100%; background: rgba(0,0,0,0.3); border: 1px solid var(--border-color); color: #ffffff; padding: 8px 12px; border-radius: 6px; font-size: 13px; font-family: monospace;">
            </div>
            <div style="background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.25); border-radius: 6px; padding: 10px 14px; margin-bottom: 16px; font-size: 12px; color: #6ee7b7; display: flex; align-items: center; gap: 8px;">
                <span>✓</span> Guaranteed 100% on-premise execution with Zero External Cloud Egress.
            </div>
            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <button type="button" id="btnCancelNewConnector" onclick="document.getElementById('newConnectorModal').style.display='none'; if(typeof closeNewConnectorModal==='function')closeNewConnectorModal();" class="btn-secondary" style="padding: 8px 16px; font-size: 12px; cursor: pointer;">Cancel</button>
                <button type="submit" class="btn-primary" style="padding: 8px 18px; font-size: 12px;">Register & Test Connection</button>
            </div>
        </form>
    </div>
</div>

<script>
window.closeNewConnectorModal = function() {
    const modal = document.getElementById('newConnectorModal');
    if (modal) modal.style.display = 'none';
};
window.openNewConnectorModal = function() {
    const modal = document.getElementById('newConnectorModal');
    if (modal) modal.style.display = 'flex';
};
window.addEventListener('click', function(e) {
    const modal = document.getElementById('newConnectorModal');
    if (e.target === modal) {
        closeNewConnectorModal();
    }
    const schemaModal = document.getElementById('schemaModal');
    if (e.target === schemaModal) {
        if (typeof closeSchemaModal === 'function') closeSchemaModal();
        else schemaModal.style.display = 'none';
    }
});
window.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeNewConnectorModal();
        const schemaModal = document.getElementById('schemaModal');
        if (schemaModal) schemaModal.style.display = 'none';
    }
});
window.switchDiscoveryView = function(view) {
    const topologySvg = document.getElementById('architectureGraph');
    const lifecycleSvg = document.getElementById('lifecycleGraph');
    const filterGroup = document.getElementById('topologyFilterGroup');
    const tabTopology = document.getElementById('tabViewTopology');
    const tabLifecycle = document.getElementById('tabViewLifecycle');

    if (view === 'lifecycle') {
        if (topologySvg) topologySvg.style.display = 'none';
        if (lifecycleSvg) lifecycleSvg.style.display = 'block';
        if (filterGroup) filterGroup.style.display = 'none';
        if (tabTopology) {
            tabTopology.style.background = 'transparent';
            tabTopology.style.color = 'var(--text-muted)';
            tabTopology.classList.remove('active');
        }
        if (tabLifecycle) {
            tabLifecycle.style.background = '#4f46e5';
            tabLifecycle.style.color = '#ffffff';
            tabLifecycle.classList.add('active');
        }
    } else {
        if (topologySvg) topologySvg.style.display = 'block';
        if (lifecycleSvg) lifecycleSvg.style.display = 'none';
        if (filterGroup) filterGroup.style.display = 'flex';
        if (tabTopology) {
            tabTopology.style.background = '#4f46e5';
            tabTopology.style.color = '#ffffff';
            tabTopology.classList.add('active');
        }
        if (tabLifecycle) {
            tabLifecycle.style.background = 'transparent';
            tabLifecycle.style.color = 'var(--text-muted)';
            tabLifecycle.classList.remove('active');
        }
    }
};
</script>

<script src="/js/discoveryScanner.js"></script>
