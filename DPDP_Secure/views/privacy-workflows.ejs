<%- include('partials/header') %>

<% 
const workflowsList = (typeof workflows !== 'undefined' && Array.isArray(workflows)) ? workflows : [];
const totalWf = workflowsList.length;
const activeWf = workflowsList.filter(w => w.isActive !== 0).length;
%>

<div class="dashboard-header mb-4" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h1 class="page-title"><%= (typeof title !== 'undefined' ? title : 'Privacy Workflows').split(' - ')[0] %></h1>
        <p class="page-description"><%= typeof description !== 'undefined' ? description : 'Configurable stage-based workflows for Data Principal Rights requests.' %></p>
    </div>
    <button class="btn-primary" onclick="document.getElementById('new-workflow-modal').style.display='flex'" style="padding: 10px 24px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Workflow
    </button>
</div>

<div class="metrics-grid mb-4" style="grid-template-columns: repeat(3, 1fr);">
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">TOTAL WORKFLOWS</span>
            <h2 class="metric-value" style="margin-top: 8px;"><%= totalWf %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">ACTIVE AUTOMATIONS</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #10b981;"><%= activeWf %></h2>
        </div>
    </div>
    <div class="card metric-card">
        <div class="metric-info w-100">
            <span class="metric-label" style="color: var(--text-muted); font-size: 10px; font-weight: 600; letter-spacing: 0.5px;">DEFAULT SLA TARGET</span>
            <h2 class="metric-value" style="margin-top: 8px; color: #3b82f6;">72h / 30d</h2>
        </div>
    </div>
</div>

<div class="card p-0" style="overflow: hidden; display: flex; flex-direction: column;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 350px; background: transparent; padding: 0; border: none;">
            <input type="text" id="wf-search" placeholder="Search workflows..." onkeyup="filterWorkflows()" style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span><%= totalWf %> rows</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" id="workflows-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                <th style="padding: 16px 24px;">Workflow Name &#9652;</th>
                <th style="padding: 16px 16px;">Trigger Event &#8597;</th>
                <th style="padding: 16px 16px;">Status &#8597;</th>
                <th style="padding: 16px 24px; text-align: right;">Actions</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <% if (workflowsList.length === 0) { %>
                <tr>
                    <td colspan="4" style="padding: 32px; text-align: center; color: var(--text-muted);">No privacy workflows defined. Click "New Workflow" to configure an orchestration.</td>
                </tr>
            <% } else { %>
                <% workflowsList.forEach(wf => { %>
                    <tr style="border-bottom: 1px solid var(--border-color);" class="wf-row">
                        <td style="padding: 16px 24px;">
                            <div style="display: flex; gap: 12px; align-items: flex-start;">
                                <svg viewBox="0 0 24 24" width="16" height="16" stroke="#3b82f6" stroke-width="2" fill="none" style="margin-top: 3px; flex-shrink: 0;"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.48" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line></svg>
                                <div>
                                    <div style="font-weight: 600; color: var(--text-main); font-size: 14px; margin-bottom: 3px;"><%= wf.workflowName %></div>
                                    <div style="color: var(--text-muted); font-size: 12px;"><%= wf.actions || wf.description || 'Configured for automated statutory lifecycle' %></div>
                                </div>
                            </div>
                        </td>
                        <td style="padding: 16px 16px;">
                            <span class="badge" style="background: rgba(59, 130, 246, 0.15); color: #3b82f6; border: 1px solid rgba(59, 130, 246, 0.3); padding: 4px 10px; border-radius: 12px; font-size: 11px; font-weight: 600;">
                                <%= wf.triggerEvent || 'MANUAL_TRIGGER' %>
                            </span>
                        </td>
                        <td style="padding: 16px 16px;">
                            <% if (wf.isActive !== 0) { %>
                                <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                            <% } else { %>
                                <span style="background: rgba(239, 68, 68, 0.15); color: #ef4444; border: 1px solid rgba(239, 68, 68, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Inactive</span>
                            <% } %>
                        </td>
                        <td style="padding: 16px 24px; text-align: right;">
                            <button onclick="deleteWorkflow('<%= wf.id %>')" title="Delete Workflow" style="background: none; border: none; color: #ef4444; cursor: pointer; padding: 4px; border-radius: 4px;">
                                <svg viewBox="0 0 24 24" width="15" height="15" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                            </button>
                        </td>
                    </tr>
                <% }); %>
            <% } %>
        </tbody>
    </table>
</div>

<!-- New Workflow Modal Overlay -->
<div id="new-workflow-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.7); z-index: 1000; align-items: center; justify-content: center; backdrop-filter: blur(4px);">
    <!-- Modal Content -->
    <div class="card p-0" style="width: 520px; background: #0f172a; border: 1px solid #334155; box-shadow: 0 20px 30px rgba(0,0,0,0.6); border-radius: 12px; overflow: hidden;">
        
        <!-- Modal Header -->
        <div style="padding: 18px 24px; border-bottom: 1px solid #334155; display: flex; justify-content: space-between; align-items: center; background: #1e293b;">
            <h2 style="font-size: 16px; font-weight: 600; color: #f8fafc; margin: 0;">Create New Privacy Workflow</h2>
            <button onclick="document.getElementById('new-workflow-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #94a3b8; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <!-- Modal Body -->
        <form id="new-workflow-form" onsubmit="handleCreateWorkflow(event)" style="padding: 24px;">
            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 8px;">Workflow Name *</label>
                <input type="text" id="wfName" required placeholder="e.g. Standard Patient Section 12 Erasure Pipeline" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="margin-bottom: 18px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 8px;">Trigger Event *</label>
                <select id="wfTrigger" required style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px;">
                    <option value="DSR_ERASURE_RECEIVED">DSR Erasure Request Received (Sec 12)</option>
                    <option value="DSR_ACCESS_RECEIVED">DSR Access Request Received (Sec 11)</option>
                    <option value="INVOICE_GENERATED">Statutory Tax Invoice Generated (CGST Sec 36)</option>
                    <option value="BREACH_DETECTED">Data Security Incident Detected (DPBI 72h)</option>
                    <option value="CONSENT_WITHDRAWN">Data Principal Withdrew Consent</option>
                </select>
            </div>

            <div style="margin-bottom: 24px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: #e2e8f0; margin-bottom: 8px;">Automated Actions Description</label>
                <textarea id="wfActions" placeholder="e.g. 1. Verify ID -> 2. Check Tax Lock -> 3. Redact WhatsApp Silos -> 4. Issue Cert" style="width: 100%; background: #1e293b; border: 1px solid #475569; color: #f8fafc; padding: 10px 12px; border-radius: 6px; font-size: 13px; min-height: 80px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 16px;">
                <button type="submit" class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Save & Activate Workflow</button>
                <button type="button" class="btn-secondary" onclick="document.getElementById('new-workflow-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: #334155; border: 1px solid #475569; color: #f8fafc;">Cancel</button>
            </div>
        </form>

    </div>
</div>

<script>
function filterWorkflows() {
    const q = document.getElementById('wf-search').value.toLowerCase();
    document.querySelectorAll('.wf-row').forEach(row => {
        row.style.display = row.innerText.toLowerCase().includes(q) ? '' : 'none';
    });
}

async function handleCreateWorkflow(e) {
    e.preventDefault();
    const workflowName = document.getElementById('wfName').value.trim();
    const triggerEvent = document.getElementById('wfTrigger').value;
    const actions = document.getElementById('wfActions').value.trim();

    try {
        const res = await fetch('/api/workflows', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ workflowName, triggerEvent, actions, isActive: 1 })
        });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error creating workflow: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error submitting workflow');
    }
}

async function deleteWorkflow(id) {
    if (!confirm('Are you sure you want to delete this privacy workflow?')) return;
    try {
        const res = await fetch(`/api/workflows/${id}`, { method: 'DELETE' });
        const json = await res.json();
        if (json.success) {
            window.location.reload();
        } else {
            alert('Error deleting workflow: ' + (json.message || 'Unknown error'));
        }
    } catch (err) {
        alert('Network error deleting workflow');
    }
}
</script>

<%- include('partials/footer') %>
