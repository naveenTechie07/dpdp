<%- include('partials/header') %>

<div class="dashboard-header mb-4" style="display: flex; justify-content: space-between; align-items: flex-start;">
    <div>
        <h1 class="page-title"><%= title.split(' - ')[0] %></h1>
        <p class="page-description"><%= description %></p>
    </div>
    <button class="btn-primary" onclick="document.getElementById('new-workflow-modal').style.display='flex'" style="padding: 10px 24px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        New Workflow
    </button>
</div>

<div class="card p-0" style="overflow: hidden; display: flex; flex-direction: column;">
    <!-- Table Toolbar -->
    <div class="table-toolbar" style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center;">
        <div class="search-bar" style="width: 350px; background: transparent; padding: 0; border: none;">
            <input type="text" placeholder="Search..." style="border: 1px solid var(--border-color); padding: 8px 12px; border-radius: 6px; background: transparent; color: var(--text-main); width: 100%;">
        </div>
        
        <div class="pagination" style="display: flex; align-items: center; gap: 12px; font-size: 12px; color: var(--text-muted);">
            <span>4 rows</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Previous</button>
            <span>Page 1 of 1</span>
            <button class="btn-secondary" disabled style="background: rgba(255,255,255,0.05); border: none; color: var(--text-muted); padding: 4px 12px; border-radius: 4px; cursor: not-allowed;">Next</button>
        </div>
    </div>

    <!-- Data Table -->
    <table class="data-table" style="width: 100%; border-collapse: collapse; text-align: left;">
        <thead>
            <tr style="border-bottom: 1px solid var(--border-color); color: var(--text-main); font-size: 11px; font-weight: 700; text-transform: uppercase;">
                <th style="padding: 16px 24px;">Name &uarr;</th>
                <th style="padding: 16px 16px;">Stages &uarr;</th>
                <th style="padding: 16px 16px;">Status &uarr;</th>
                <th style="padding: 16px 24px;">Updated &uarr;</th>
            </tr>
        </thead>
        <tbody style="font-size: 13px;">
            <!-- Row 1 -->
            <tr style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px;" onclick="window.location.href='/privacy/workflows/9'">
                    <div style="display: flex; gap: 12px;">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="#3b82f6" stroke-width="2" fill="none" style="margin-top: 2px;"><circle cx="6" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><line x1="20" y1="4" x2="8.12" y2="15.88"></line><line x1="14.47" y1="14.48" x2="20" y2="20"></line><line x1="8.12" y1="8.12" x2="12" y2="12"></line></svg>
                        <div>
                            <div style="font-weight: 600; color: var(--text-main); margin-bottom: 4px; font-size: 14px;">DPDP_Secure DPDPA Rights Workflow</div>
                            <div style="color: var(--text-muted); font-size: 12px;">DPDPA 2023 rights handling for DPDP_Secure banking customers &mdash; 30-day SLA with RBI data retention checks.</div>
                        </div>
                    </div>
                </td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">3</td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        29 Aug 2026, 03:03 pm
                        <div style="display: flex; gap: 12px; color: var(--text-muted);">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path></svg>
                        </div>
                    </div>
                </td>
            </tr>

            <!-- Row 2 -->
            <tr style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px;">
                    <div style="display: flex; gap: 12px;">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="opacity: 0.5; margin-top: 2px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <div>
                            <div style="font-weight: 600; color: var(--text-main); margin-bottom: 4px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                                Standard Access Request
                                <span style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-color); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600;">System</span>
                            </div>
                            <div style="color: var(--text-muted); font-size: 12px;">Default workflow for DATA ACCESS requests under DPDPA / GDPR.</div>
                        </div>
                    </div>
                </td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">5</td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        29 Aug 2026, 02:37 pm
                        <div style="display: flex; gap: 12px; color: var(--text-muted);">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        </div>
                    </div>
                </td>
            </tr>

            <!-- Row 3 -->
            <tr style="border-bottom: 1px solid var(--border-color); cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px;">
                    <div style="display: flex; gap: 12px;">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="opacity: 0.5; margin-top: 2px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <div>
                            <div style="font-weight: 600; color: var(--text-main); margin-bottom: 4px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                                Standard Correction Request
                                <span style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-color); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600;">System</span>
                            </div>
                            <div style="color: var(--text-muted); font-size: 12px;">Default workflow for DATA CORRECTION requests.</div>
                        </div>
                    </div>
                </td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">4</td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        29 Aug 2026, 02:37 pm
                        <div style="display: flex; gap: 12px; color: var(--text-muted);">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        </div>
                    </div>
                </td>
            </tr>

            <!-- Row 4 -->
            <tr style="border-bottom: 1px solid transparent; cursor: pointer; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.02)'" onmouseout="this.style.background='transparent'">
                <td style="padding: 16px 24px;">
                    <div style="display: flex; gap: 12px;">
                        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" style="opacity: 0.5; margin-top: 2px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <div>
                            <div style="font-weight: 600; color: var(--text-main); margin-bottom: 4px; font-size: 14px; display: flex; align-items: center; gap: 8px;">
                                Standard Deletion Request
                                <span style="background: rgba(255,255,255,0.05); color: var(--text-muted); border: 1px solid var(--border-color); padding: 2px 8px; border-radius: 12px; font-size: 10px; font-weight: 600;">System</span>
                            </div>
                            <div style="color: var(--text-muted); font-size: 12px;">Default workflow for DATA DELETION (right to erasure) requests.</div>
                        </div>
                    </div>
                </td>
                <td style="padding: 16px 16px; font-weight: 600; color: var(--text-main);">4</td>
                <td style="padding: 16px 16px;">
                    <span style="background: rgba(16, 185, 129, 0.15); color: #10b981; border: 1px solid rgba(16, 185, 129, 0.3); padding: 4px 12px; border-radius: 12px; font-size: 11px; font-weight: 700;">Active</span>
                </td>
                <td style="padding: 16px 24px; color: var(--text-muted);">
                    <div style="display: flex; align-items: center; justify-content: space-between;">
                        29 Aug 2026, 02:37 pm
                        <div style="display: flex; gap: 12px; color: var(--text-muted);">
                            <svg viewBox="0 0 24 24" width="14" height="14" stroke="currentColor" stroke-width="2" fill="none"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                        </div>
                    </div>
                </td>
            </tr>

        </tbody>
    </table>
</div>

<!-- New Workflow Modal Overlay -->
<div id="new-workflow-modal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.6); z-index: 1000; align-items: center; justify-content: center;">
    <!-- Modal Content -->
    <div class="card p-0" style="width: 500px; background: var(--bg-color); border: 1px solid var(--border-color); box-shadow: 0 10px 25px rgba(0,0,0,0.5);">
        
        <!-- Modal Header -->
        <div style="padding: 16px 24px; border-bottom: 1px solid var(--border-color); display: flex; justify-content: space-between; align-items: center; background: #e5e7eb; border-radius: 8px 8px 0 0;">
            <h2 style="font-size: 16px; font-weight: 600; color: #1f2937; margin: 0;">New Workflow</h2>
            <button onclick="document.getElementById('new-workflow-modal').style.display='none'" style="background: none; border: none; cursor: pointer; color: #6b7280; padding: 4px;">
                <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
            </button>
        </div>

        <!-- Modal Body -->
        <div style="padding: 24px;">
            <div style="margin-bottom: 20px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Workflow Name *</label>
                <input type="text" placeholder="e.g. Standard GDPR Request Process" style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px;">
            </div>

            <div style="margin-bottom: 32px;">
                <label style="display: block; font-size: 13px; font-weight: 600; color: var(--text-main); margin-bottom: 8px;">Description</label>
                <textarea placeholder="Optional description..." style="width: 100%; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); color: var(--text-main); padding: 10px 12px; border-radius: 6px; font-size: 13px; min-height: 80px; resize: vertical;"></textarea>
            </div>

            <div style="display: flex; gap: 16px;">
                <button class="btn-primary" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center;">Create & Configure Stages</button>
                <button class="btn-secondary" onclick="document.getElementById('new-workflow-modal').style.display='none'" style="flex: 1; padding: 12px; font-size: 14px; justify-content: center; background: rgba(255,255,255,0.05); border: 1px solid var(--border-color); color: var(--text-main);">Cancel</button>
            </div>
        </div>

    </div>
</div>

<%- include('partials/footer') %>
