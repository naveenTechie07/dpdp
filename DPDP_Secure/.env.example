# DPDP_Secure Environment Configuration
PORT=3000
NODE_ENV=development
APP_NAME=DPDP_Secure
SESSION_SECRET=dpdp-secure-session-key-dev-2026-sme-compliance

# AI Provider Configuration (mock | ollama | groq | gemini)
AI_PROVIDER=mock
AI_API_KEY=

# Google OAuth 2.0 Credentials (Optional in local fast-track mode)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Supabase Cloud Database Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_REGION=ap-south-1
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_ANON_KEY=your-anon-jwt
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt
SUPABASE_ENABLED=true

