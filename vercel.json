{
  "version": 2,
  "builds": [
    {
      "src": "DPDP_Secure/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "DPDP_Secure/public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/css/(.*)",
      "dest": "/DPDP_Secure/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/DPDP_Secure/public/js/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/DPDP_Secure/api/index.js"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
